@{
    ViewData["Title"] = "MTO Firmado V2";
    var technicianLabel = User?.Identity?.Name ?? "Técnico autenticado";
    var recoveryOwner = (User?.FindFirst("http://schemas.microsoft.com/identity/claims/tenantid")?.Value ?? User?.FindFirst("tid")?.Value)
        + "/" + (User?.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value ?? User?.FindFirst("oid")?.Value);
}

@section Styles {
    <link rel="stylesheet" href="~/css/copiers-mto-v2.css" asp-append-version="true" />
}

<div class="mto-v2-shell"
     id="copiersMtoV2App"
     data-recovery-owner="@recoveryOwner"
     data-bootstrap-url="/CopiersMtoV2/Bootstrap"
     data-counter-latest-url="/CopiersMtoV2/CounterLatest"
     data-equipment-url="/CopiersMtoV2/Equipment"
     data-supplies-url="/CopiersMtoV2/Supplies"
     data-status-url="/CopiersMtoV2/Status"
     data-save-client-email-url="/CopiersMtoV2/SaveClientEmail"
     data-finalize-url="/CopiersMtoV2/Finalize"
     data-max-files="8"
     data-max-file-bytes="8388608"
     data-max-total-bytes="20971520">
    <header class="mto-v2-hero">
        <div class="mto-v2-hero__copy">
            <span class="mto-v2-eyebrow">Copiers · Servicio en sitio</span>
            <h1>MTO Firmado V2</h1>
            <p>Registra la atención, reúne la evidencia y obtén la conformidad del cliente desde el celular o la tableta.</p>
        </div>
        <div class="mto-v2-user-card" aria-label="Técnico autenticado">
            <span>Técnico</span>
            <strong id="mtoV2TechnicianName">@technicianLabel</strong>
        </div>
    </header>

    <aside id="mtoV2RecoveryStatus" class="alert alert-info" role="status">Comprobando borradores guardados…</aside>

    <aside id="mtoV2PreviousAttempt" class="alert alert-warning" role="status" hidden>
        Hay un envío anterior sin confirmar. Esta página inicia una captura nueva;
        revisa el intento anterior antes de repetir el mismo registro.
        <a href="/Dashboard?tab=copiers&amp;copiersTab=maintenance-v2" target="_blank" rel="noopener">Ver Mantenimiento V2</a>
    </aside>

    <form id="mtoV2Form"
          class="mto-v2-form"
          action="/CopiersMtoV2/Finalize"
          method="post"
          enctype="multipart/form-data"
          novalidate>
        @Html.AntiForgeryToken()

        <input type="hidden" name="SubmissionKey" id="mtoV2SubmissionKey" />
        <input type="hidden" name="RecordId" id="mtoV2RecordId" />
        <input type="hidden" name="ExpectedVersion" id="mtoV2ExpectedVersion" />
        <input type="hidden" name="FormVersion" id="mtoV2FormVersion" value="copiers-mto-v2-2026-09-10" />
        <input type="hidden" name="ActivityKind" id="mtoV2ActivityKind" value="maintenance" />
        <input type="hidden" name="OriginClientId" id="mtoV2OriginClientId" />
        <input type="hidden" name="AnswersJson" id="mtoV2AnswersJson" value="[]" />
        <input type="hidden" name="Title" id="mtoV2Title" />
        <input type="hidden" name="ServiceDate" id="mtoV2ServiceDate" />
        <input type="hidden" name="FormStartedAtUtc" id="mtoV2StartedAtUtc" />
        <input type="hidden" name="DeviceSignedAtUtc" id="mtoV2SignedAtUtc" />
        <input type="hidden" name="ServiceEndedAtUtc" id="mtoV2ServiceEndedAtUtc" />
        <input type="hidden" name="ServiceStartedAtUtc" id="mtoV2ServiceStartedAtUtc" />
        <input type="hidden" name="ClientSubmittedAtUtc" id="mtoV2SubmittedAtUtc" />
        <input type="hidden" name="Latitude" id="mtoV2Latitude" />
        <input type="hidden" name="Longitude" id="mtoV2Longitude" />
        <input type="hidden" name="AccuracyMeters" id="mtoV2Accuracy" />
        <input type="hidden" name="LocationCapturedAtUtc" id="mtoV2GeoCapturedAtUtc" />
        <input type="hidden" name="LocationSource" value="navigator.geolocation" />
        <input type="hidden" name="GeolocationStatus" id="mtoV2GeoStatus" value="pending" />
        <input type="hidden" name="GeolocationVisibility" value="internal-only" />
        <input type="hidden" name="ExcludeGeolocationFromPdf" value="true" />
        <input type="hidden" name="ServiceAddressVisibility" value="internal-only" />
        <input type="hidden" name="ExcludeServiceAddressFromPdf" value="true" />
        <input type="hidden" name="SignaturePointCount" id="mtoV2SignaturePointCount" value="0" />
        <input type="hidden" name="TechnicianDisplayName" value="@technicianLabel" />

        <nav class="mto-v2-progress" aria-label="Progreso del formulario">
            <ol>
                <li class="is-active" data-step-indicator="1">
                    <button type="button" data-step-target="1" aria-current="step">
                        <span>1</span>
                        <strong>Servicio</strong>
                    </button>
                </li>
                <li data-step-indicator="2">
                    <button type="button" data-step-target="2" disabled>
                        <span>2</span>
                        <strong>Trabajo</strong>
                    </button>
                </li>
                <li data-step-indicator="3">
                    <button type="button" data-step-target="3" disabled>
                        <span>3</span>
                        <strong>Evidencia y firma</strong>
                    </button>
                </li>
                <li data-step-indicator="4">
                    <button type="button" data-step-target="4" disabled>
                        <span>4</span>
                        <strong>Revisar y enviar</strong>
                    </button>
                </li>
            </ol>
        </nav>

        <div class="mto-v2-status" id="mtoV2Status" role="status" aria-live="polite"></div>
        <div class="mto-v2-bootstrap-retry">
            <button class="btn btn-outline-primary btn-sm" type="button" id="mtoV2RetryBootstrap" hidden>
                Reintentar carga del catálogo
            </button>
        </div>

        <fieldset class="mto-v2-step is-active" data-step-panel="1">
            <legend>
                <span>Paso 1</span>
                Identificación del servicio
            </legend>
            <p class="mto-v2-step__intro">Elige el tipo de atención, el cliente y el equipo para continuar.</p>

            <div class="mto-v2-grid">
                <label class="mto-v2-field mto-v2-field--wide">
                    <span>Tipo de atención <b aria-hidden="true">*</b></span>
                    <select class="form-select" name="MaintenanceTypeValue" id="mtoV2MaintenanceType" required>
                        <option value="">Selecciona una opción</option>
                    </select>
                </label>
                <div class="mto-v2-field mto-v2-field--wide">
                    <label for="mtoV2ClientName"><span id="mtoV2ClientLabel">Cliente</span> <b aria-hidden="true">*</b></label>
                    <div class="mto-v2-client-picker">
                    <div class="mto-v2-picker">
                    <input class="form-control"
                           type="text"
                           name="ClientName"
                           id="mtoV2ClientName"
                           aria-describedby="mtoV2CatalogFeedback"
                           autocomplete="off"
                           autocapitalize="none"
                           spellcheck="false"
                           required />
                        <div id="mtoV2ClientOptions" class="mto-v2-picker__list" hidden></div>
                    </div>
                        <button class="btn btn-outline-primary mto-v2-client-email-button" type="button" id="mtoV2EditClientEmail"
                                aria-label="Agregar o editar el correo de la persona encargada de Copiers" title="Agregar o editar correo del encargado de Copiers" disabled>+</button>
                    </div>
                    <input type="hidden" name="ClientId" id="mtoV2ClientId" />
                    <small id="mtoV2CatalogFeedback" role="status" aria-live="polite">Cargando clientes de Copiers…</small>
                </div>

                <div class="mto-v2-field">
                    <label for="mtoV2EquipmentSerial">Serial del equipo <b aria-hidden="true">*</b></label>
                    <div class="mto-v2-picker">
                    <input class="form-control"
                           type="text"
                           name="EquipmentSerial"
                           id="mtoV2EquipmentSerial"
                           aria-describedby="mtoV2EquipmentFeedback"
                           autocomplete="off"
                           autocapitalize="none"
                           spellcheck="false"
                           required />
                    <div id="mtoV2EquipmentOptions" class="mto-v2-picker__list" hidden></div>
                    </div>
                    <input type="hidden" name="EquipmentId" id="mtoV2EquipmentId" />
                    <small id="mtoV2EquipmentFeedback">Selecciona primero un cliente.</small>
                    <button class="btn btn-outline-primary btn-sm" type="button" id="mtoV2RetryEquipment" hidden>Reintentar equipos</button>
                </div>

                <label class="mto-v2-field" data-activity-panel="movement" hidden>
                    <span>Cliente de origen</span>
                    <input class="form-control" type="text" id="mtoV2OriginClientName" readonly placeholder="Se completa al seleccionar el equipo" />
                    <small>Origen actual del equipo; el cliente seleccionado arriba será el destino.</small>
                </label>

                <label class="mto-v2-field">
                    <span>Orden o referencia</span>
                    <input class="form-control" type="text" name="ServiceReference" id="mtoV2ServiceReference" placeholder="Se asigna al enviar" readonly />
                    <small>Consecutivo automático del registro.</small>
                </label>

                <label class="mto-v2-field">
                    <span>Inicio de la visita <b aria-hidden="true">*</b></span>
                    <input class="form-control" type="datetime-local" name="ServiceStartedAtLocal" id="mtoV2ServiceStartedAtLocal" required />
                </label>

                <label class="mto-v2-field">
                    <span>Persona que atiende <b aria-hidden="true">*</b></span>
                    <input class="form-control" type="text" name="CustomerContactName" id="mtoV2OnsiteContactName" autocomplete="name" required maxlength="160" />
                    <small id="mtoV2ContactFeedback">Se completa desde el cliente; podrás escribirlo si Copiers no tiene contacto.</small>
                </label>

                <label class="mto-v2-field">
                    <span>Persona encargada de copiers · correo de envío <b aria-hidden="true">*</b></span>
                    <input class="form-control" type="email" name="CustomerEmail" id="mtoV2OnsiteContactEmail" autocomplete="email" required readonly maxlength="250" />
                    <small id="mtoV2CustomerEmailFeedback">Selecciona el cliente. Usa el botón + para agregar o editar su correo de envío.</small>
                </label>

                <label class="mto-v2-field mto-v2-field--wide" data-pdf-exclude="true" data-client-preview-exclude="true">
                    <span>Dirección o sede <em class="mto-v2-field__privacy">Uso interno</em></span>
                    <input class="form-control" type="text" name="ServiceAddress" id="mtoV2ServiceAddress" autocomplete="street-address" maxlength="300" />
                    <small>No se muestra en la vista previa ni debe incluirse en el PDF enviado al cliente.</small>
                </label>
            </div>

            <div class="mto-v2-step__actions">
                <span class="mto-v2-required-note"><b>*</b> Campos obligatorios</span>
                <button class="btn btn-primary" type="button" data-next-step="2">Continuar</button>
            </div>
        </fieldset>

        <fieldset class="mto-v2-step" data-step-panel="2" hidden>
            <legend>
                <span>Paso 2</span>
                Trabajo técnico
            </legend>
            <p class="mto-v2-step__intro">Resume el trabajo realizado con información que el cliente pueda entender.</p>

            <div class="mto-v2-grid">
                <label class="mto-v2-field" data-activity-panel="maintenance">
                    <span>Resultado del servicio <b aria-hidden="true">*</b></span>
                    <select class="form-select" name="ServiceResult" id="mtoV2ServiceResult" required>
                        <option value="">Selecciona una opción</option>
                        <option value="completed">Finalizado y operativo</option>
                        <option value="completed-observation">Finalizado con observaciones</option>
                        <option value="pending-parts">Pendiente por repuesto</option>
                        <option value="pending-approval">Pendiente por autorización</option>
                        <option value="not-completed">No finalizado</option>
                    </select>
                </label>

                <label class="mto-v2-field mto-v2-field--wide" data-activity-panel="maintenance">
                    <span>Trabajo realizado <b aria-hidden="true">*</b></span>
                    <textarea class="form-control" name="WorkPerformed" id="mtoV2WorkPerformed" rows="4" required maxlength="1000" aria-describedby="mtoV2WorkPerformedCount"></textarea>
                    <small id="mtoV2WorkPerformedCount" data-character-count-for="mtoV2WorkPerformed">0 / 1000 caracteres · Resume el servicio para el reporte de una página.</small>
                </label>

            </div>

            <section class="mto-v2-subcard" data-activity-panel="movement" hidden>
                <label class="mto-v2-field">
                    <span>Motivo del movimiento <b aria-hidden="true">*</b></span>
                    <textarea class="form-control" name="MovementReason" id="mtoV2MovementReason" rows="3" maxlength="100" aria-describedby="mtoV2MovementReasonCount" required disabled></textarea>
                    <small id="mtoV2MovementReasonCount" data-character-count-for="mtoV2MovementReason">0 / 100 caracteres</small>
                    <small>Describe la entrega o reasignación del equipo. Máximo 100 caracteres.</small>
                </label>
            </section>

            <section class="mto-v2-subcard" data-activity-panel="toner" hidden>
                <div class="mto-v2-grid">
                    <label class="mto-v2-field">
                        <span>Tóner o insumo <b aria-hidden="true">*</b></span>
                        <select class="form-select" name="SupplyId" id="mtoV2SupplyId" required disabled>
                            <option value="">Selecciona un insumo</option>
                        </select>
                        <small id="mtoV2SupplyStock">Selecciona un insumo para ver su saldo.</small>
                    </label>
                    <label class="mto-v2-field">
                        <span>Cantidad entregada <b aria-hidden="true">*</b></span>
                        <input class="form-control" type="number" name="SupplyQuantity" id="mtoV2SupplyQuantity" min="1" step="1" inputmode="numeric" required disabled />
                    </label>
                </div>
                <div class="mto-v2-counter-status">
                    <small id="mtoV2SupplyFeedback" role="status" aria-live="polite"></small>
                    <button class="btn btn-outline-primary btn-sm" type="button" id="mtoV2RetrySupplies" hidden>Reintentar insumos</button>
                </div>
            </section>

            <section class="mto-v2-subcard" aria-labelledby="mtoV2CountersTitle" data-activity-panel="maintenance">
                <div class="mto-v2-subcard__header">
                    <div>
                        <span class="mto-v2-eyebrow">Lecturas</span>
                        <h2 id="mtoV2CountersTitle">Contadores del equipo</h2>
                    </div>
                    <span>Registra las dos lecturas actuales</span>
                </div>
                <div class="mto-v2-counter-status">
                    <small id="mtoV2CounterFeedback" role="status" aria-live="polite">Selecciona un equipo para consultar su último contador.</small>
                    <button class="btn btn-outline-primary btn-sm" type="button" id="mtoV2RetryCounters" hidden>Reintentar contadores</button>
                </div>
                <div class="mto-v2-grid mto-v2-grid--four">
                    <label class="mto-v2-field">
                        <small class="mto-v2-counter-date" id="mtoV2CopiesBeforeDate">Sin registro previo</small>
                        <span>Impresiones anteriores</span>
                        <input class="form-control" type="number" name="CopiesBefore" id="mtoV2CopiesBefore" min="0" step="1" inputmode="numeric" readonly placeholder="Sin registro" />
                    </label>
                    <label class="mto-v2-field">
                        <span>Impresiones actuales <b aria-hidden="true">*</b></span>
                        <input class="form-control" type="number" name="CopiesAfter" id="mtoV2CopiesAfter" min="0" max="2147483647" step="1" inputmode="numeric" required />
                    </label>
                    <label class="mto-v2-field">
                        <small class="mto-v2-counter-date" id="mtoV2ScansBeforeDate">Sin registro previo</small>
                        <span>Escaneos anteriores</span>
                        <input class="form-control" type="number" name="ScansBefore" id="mtoV2ScansBefore" min="0" step="1" inputmode="numeric" readonly placeholder="Sin registro" />
                    </label>
                    <label class="mto-v2-field">
                        <span>Escaneos actuales <b aria-hidden="true">*</b></span>
                        <input class="form-control" type="number" name="ScansAfter" id="mtoV2ScansAfter" min="0" max="2147483647" step="1" inputmode="numeric" required />
                    </label>
                </div>
            </section>

            <div class="mto-v2-grid">
                <label class="mto-v2-field mto-v2-field--wide" data-activity-panel="maintenance">
                    <span>Recomendaciones al cliente</span>
                    <textarea class="form-control" name="Recommendations" id="mtoV2Recommendations" rows="2" maxlength="250" aria-describedby="mtoV2RecommendationsCount"></textarea>
                    <small id="mtoV2RecommendationsCount" data-character-count-for="mtoV2Recommendations">0 / 250 caracteres · Resume el servicio para el reporte de una página.</small>
                </label>
                <label class="mto-v2-field mto-v2-field--wide">
                    <span>Observaciones internas</span>
                    <textarea class="form-control" name="InternalNotes" id="mtoV2InternalNotes" rows="3" maxlength="4000"></textarea>
                    <small>No se incluirán en la vista previa destinada al cliente.</small>
                </label>
            </div>

            <div class="mto-v2-step__actions">
                <button class="btn btn-outline-secondary" type="button" data-previous-step="1">Atrás</button>
                <button class="btn btn-primary" type="button" data-next-step="3">Continuar</button>
            </div>
        </fieldset>

        <fieldset class="mto-v2-step" data-step-panel="3" hidden>
            <legend>
                <span>Paso 3</span>
                Evidencia y firma del cliente
            </legend>
            <p class="mto-v2-step__intro">Adjunta evidencias y solicita la firma solo después de revisar el trabajo con el cliente.</p>

            <section class="mto-v2-upload-card" aria-labelledby="mtoV2EvidenceTitle">
                <div class="mto-v2-upload-card__copy">
                    <span class="mto-v2-eyebrow">Evidencias</span>
                    <h2 id="mtoV2EvidenceTitle">Evidencia fotográfica</h2>
                    <p>Hasta 8 imágenes · máximo 8 MB por archivo · máximo 20 MB en total. Formatos: JPG, JPEG y PNG.</p>
                </div>
                <div class="mto-v2-evidence-actions">
                <label class="mto-v2-file-picker">
                    <span>Tomar foto</span>
                    <input type="file" id="mtoV2CameraInput" accept="image/*" capture="environment" />
                </label>
                <label class="mto-v2-file-picker">
                    <span>Seleccionar archivos</span>
                    <input type="file"
                           id="mtoV2EvidenceInput"
                           accept=".jpg,.jpeg,.png,image/jpeg,image/png"
                           multiple />
                </label>
                </div>
                <div class="mto-v2-file-summary" id="mtoV2FileSummary">0 de 8 archivos · 0 MB de 20 MB</div>
                <ul class="mto-v2-file-list" id="mtoV2FileList" aria-live="polite"></ul>
            </section>

            <div class="mto-v2-grid">
                <label class="mto-v2-field mto-v2-field--wide">
                    <span>Observaciones del cliente</span>
                    <textarea class="form-control" name="CustomerObservations" id="mtoV2CustomerObservations" rows="2" maxlength="250" aria-describedby="mtoV2CustomerObservationsCount"></textarea>
                    <small id="mtoV2CustomerObservationsCount" data-character-count-for="mtoV2CustomerObservations">0 / 250 caracteres · Resume el servicio para el reporte de una página.</small>
                </label>
                <label class="mto-v2-field">
                    <span>Nombre de quien firma <b aria-hidden="true">*</b></span>
                    <input class="form-control" type="text" name="SignerName" id="mtoV2SignerName" autocomplete="name" required maxlength="160" />
                </label>
                <label class="mto-v2-field">
                    <span>Cargo <b aria-hidden="true">*</b></span>
                    <input class="form-control" type="text" name="SignerRole" id="mtoV2SignerRole" autocomplete="organization-title" required maxlength="150" />
                </label>
            </div>

            <section class="mto-v2-signature-card" aria-labelledby="mtoV2SignatureTitle">
                <dl class="mto-v2-visit-times" aria-label="Horario del servicio que firma el cliente">
                    <div><dt>Hora de entrada</dt><dd id="mtoV2SignatureStartedAt">Pendiente</dd></div>
                    <div><dt>Hora de salida</dt><dd id="mtoV2SignatureEndedAt">Pendiente</dd></div>
                </dl>
                <div class="mto-v2-signature-card__header">
                    <div>
                        <span class="mto-v2-eyebrow">Conformidad</span>
                        <h2 id="mtoV2SignatureTitle">Firma con dedo o lápiz</h2>
                    </div>
                    <button class="btn btn-outline-secondary btn-sm" type="button" id="mtoV2ClearSignature">Limpiar firma</button>
                </div>
                <div class="mto-v2-signature-pad">
                    <canvas id="mtoV2SignatureCanvas"
                            aria-label="Área para la firma del cliente"
                            aria-describedby="mtoV2SignatureFeedback"
                            tabindex="0"
                            role="img"></canvas>
                    <span>Firma aquí</span>
                </div>
                <p class="mto-v2-signature-feedback" id="mtoV2SignatureFeedback">Firma pendiente</p>
            </section>

            <div class="mto-v2-consents">
                <label class="mto-v2-check">
                    <input type="checkbox" name="CustomerAccepted" id="mtoV2CustomerAcceptance" value="true" required />
                    <span>Confirmo que revisé con el técnico la información registrada y acepto firmar este reporte de servicio.</span>
                </label>
            </div>

            <div class="mto-v2-step__actions">
                <button class="btn btn-outline-secondary" type="button" data-previous-step="2">Atrás</button>
                <button class="btn btn-primary" type="button" data-next-step="4">Revisar reporte</button>
            </div>
        </fieldset>

        <fieldset class="mto-v2-step" data-step-panel="4" hidden>
            <legend>
                <span>Paso 4</span>
                Revisión y envío
            </legend>
            <p class="mto-v2-step__intro">Verifica la información visible para el cliente antes de crear el registro y enviar el reporte.</p>

            <div class="mto-v2-review" id="mtoV2Review" aria-live="polite"></div>

            <label class="mto-v2-check mto-v2-check--final">
                <input type="checkbox" name="FinalReviewConfirmed" id="mtoV2FinalReviewConfirmed" value="true" required />
                <span>Confirmo que la vista previa es correcta y autorizo crear el registro y enviar el reporte al correo indicado.</span>
            </label>

            <div class="mto-v2-submit-status" id="mtoV2SubmitStatus" role="status" aria-live="polite"></div>
            <button class="btn btn-outline-primary btn-sm" type="button" id="mtoV2CheckEmailStatus" hidden>Verificar envío del correo</button>

            <div class="mto-v2-step__actions">
                <div class="mto-v2-step__back-actions">
                <button class="btn btn-outline-secondary" type="button" data-previous-step="3">Atrás</button>
                <a class="btn btn-outline-primary" id="mtoV2CreateAnother" href="/CopiersMtoV2" hidden>Crear otro registro</a>
                </div>
                <button class="btn btn-primary mto-v2-submit" type="submit" id="mtoV2SubmitButton">
                    <span data-submit-label>Crear registro y enviar</span>
                    <span class="mto-v2-submit__spinner" aria-hidden="true"></span>
                </button>
            </div>
        </fieldset>
    </form>
    <dialog class="mto-v2-email-dialog" id="mtoV2ClientEmailDialog" aria-labelledby="mtoV2ClientEmailTitle">
        <form id="mtoV2ClientEmailForm" novalidate>
            <span class="mto-v2-eyebrow">Datos del cliente</span>
            <h2 id="mtoV2ClientEmailTitle">Persona encargada de copiers</h2>
            <p id="mtoV2EmailClientName"></p>
            <label class="mto-v2-field" for="mtoV2ClientEmailEditor">
                <span>Correo de envío <b aria-hidden="true">*</b></span>
                <input class="form-control" id="mtoV2ClientEmailEditor" type="email" autocomplete="email" maxlength="250" required />
                <small>Se guardará en el cliente y se usará para enviar sus reportes de mantenimiento.</small>
            </label>
            <div class="mto-v2-status" id="mtoV2EmailSaveStatus" role="status" aria-live="polite"></div>
            <div class="mto-v2-step__actions">
                <button class="btn btn-outline-secondary" id="mtoV2CancelClientEmail" type="button">Cancelar</button>
                <button class="btn btn-primary" id="mtoV2SaveClientEmail" type="submit">Guardar correo</button>
            </div>
        </form>
    </dialog>
</div>

