@model MetricasPageViewModel
@{
    ViewData["Title"] = "Metricas";
}

@section Styles {
    <link rel="stylesheet" href="~/css/metricas.css" asp-append-version="true" />
}

<div class="metrics-shell"
     id="metricasApp"
     data-charts-url="@Url.Action("Charts", "Metricas")"
     data-initial-filter="@Model.InitialFilter.ToKey()"
     data-initial-view="@Model.InitialView.ToKey()"
     data-initial-period="@Model.InitialPeriod.ToKey()">
    <section class="metrics-hero">
        <div class="metrics-hero__content">
            <div>
                <div class="metrics-kicker">Analitica comercial</div>
                <h1 class="metrics-title">Metricas</h1>
                <p class="metrics-subtitle">
                    Series temporales de puntaje y valor de contratos sobre <span class="metrics-highlight">cr07a_contractrecord1</span>,
                    con foco en tendencia, acumulado y composicion por vendedor y vertical.
                </p>
            </div>
            <div class="metrics-user-pill">
                <span class="metrics-user-pill__label">Acceso</span>
                <span>@Model.CurrentUser.Email</span>
            </div>
        </div>
    </section>

    <section class="metrics-card">
        <div class="metrics-view-tabs" role="tablist" aria-label="Vistas de metricas">
            <button type="button" class="btn btn-outline-secondary metrics-view-tab" data-view="global">Globales</button>
            <button type="button" class="btn btn-outline-secondary metrics-view-tab" data-view="individual">Individuales</button>
        </div>
        <div class="metrics-toolbar">
            <div class="metrics-toolbar__controls">
                <div class="metrics-toolbar__group">
                    <label class="metrics-toolbar__label" for="metricsRangeGroup">Rango</label>
                    <div class="metrics-filter-list" id="metricsRangeGroup">
                        <button type="button" class="btn btn-outline-secondary metrics-filter-btn" data-filter="this-month">Este mes</button>
                        <button type="button" class="btn btn-outline-secondary metrics-filter-btn" data-filter="this-year">Este a&ntilde;o</button>
                        <button type="button" class="btn btn-outline-secondary metrics-filter-btn" data-filter="previous-year">A&ntilde;o pasado</button>
                        <button type="button" class="btn btn-outline-secondary metrics-filter-btn" data-filter="all">Todo</button>
                    </div>
                </div>
                <div class="metrics-toolbar__group">
                    <label class="metrics-toolbar__label" for="metricsPeriodGroup">Agrupaci&oacute;n</label>
                    <div class="metrics-filter-list" id="metricsPeriodGroup">
                        <button type="button" class="btn btn-outline-secondary metrics-period-btn" data-period="month">Mes</button>
                        <button type="button" class="btn btn-outline-secondary metrics-period-btn" data-period="quarter">Trimestre</button>
                        <button type="button" class="btn btn-outline-secondary metrics-period-btn" data-period="semester">Semestre</button>
                        <button type="button" class="btn btn-outline-secondary metrics-period-btn" data-period="year">A&ntilde;o</button>
                    </div>
                </div>
                <div class="metrics-toolbar__group metrics-toolbar__group--seller" id="metricsSellerFilterGroup">
                    <label class="metrics-toolbar__label" for="metricsSellerFilter">Vendedor</label>
                    <select id="metricsSellerFilter" class="form-select metrics-select">
                        <option value="">Todos los vendedores</option>
                    </select>
                </div>
            </div>
            <div class="metrics-toolbar__actions">
                <div class="metrics-toolbar__caption">
                    Haz clic en un cuadro de periodo para ver los negocios que componen el puntaje.
                </div>
                <button type="button" class="btn btn-primary" id="refreshMetricsBtn">Actualizar</button>
            </div>
        </div>
        <div class="metrics-insights">
            <article class="metrics-insight">
                <span class="metrics-insight__label">Vista</span>
                <strong class="metrics-insight__value" id="metricsInsightView">Globales</strong>
            </article>
            <article class="metrics-insight">
                <span class="metrics-insight__label">Rango activo</span>
                <strong class="metrics-insight__value" id="metricsInsightRange">Este a&ntilde;o</strong>
            </article>
            <article class="metrics-insight">
                <span class="metrics-insight__label">Vendedor</span>
                <strong class="metrics-insight__value" id="metricsInsightSeller">Todos los vendedores</strong>
            </article>
            <article class="metrics-insight">
                <span class="metrics-insight__label">Resolucion</span>
                <strong class="metrics-insight__value" id="metricsInsightGranularity">Mensual</strong>
            </article>
            <article class="metrics-insight">
                <span class="metrics-insight__label">Ultima actualizacion</span>
                <strong class="metrics-insight__value" id="metricsInsightUpdatedAt">Pendiente</strong>
            </article>
        </div>
    </section>

    <div id="metricsStatusBanner" class="metrics-status" role="status" aria-live="polite"></div>

    <section class="metrics-summary">
        <article class="metrics-summary__card">
            <span class="metrics-summary__label">Registros</span>
            <strong class="metrics-summary__value" id="metricsSummaryRecords">0</strong>
        </article>
        <article class="metrics-summary__card">
            <span class="metrics-summary__label">Vendedores</span>
            <strong class="metrics-summary__value" id="metricsSummarySellers">0</strong>
        </article>
        <article class="metrics-summary__card">
            <span class="metrics-summary__label">Verticales</span>
            <strong class="metrics-summary__value" id="metricsSummaryVerticals">0</strong>
        </article>
        <article class="metrics-summary__card">
            <span class="metrics-summary__label">Puntaje total</span>
            <strong class="metrics-summary__value" id="metricsSummaryScore">0.00</strong>
        </article>
        <article class="metrics-summary__card">
            <span class="metrics-summary__label">Valor contratos</span>
            <strong class="metrics-summary__value" id="metricsSummaryAnnualValue">0</strong>
        </article>
    </section>

    <section class="metrics-grid" id="metricsChartsContainer"></section>

    <div class="metrics-detail-modal" id="metricsDetailModal" hidden aria-hidden="true">
        <div class="metrics-detail-modal__backdrop" data-metrics-modal-close></div>
        <section class="metrics-detail-modal__dialog"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="metricsDetailModalTitle"
                 aria-describedby="metricsDetailModalSubtitle"
                 tabindex="-1">
            <header class="metrics-detail-modal__header">
                <div>
                    <div class="metrics-chart__eyebrow">Detalle del periodo</div>
                    <h2 class="metrics-detail-modal__title" id="metricsDetailModalTitle">Negocios</h2>
                    <p class="metrics-detail-modal__subtitle" id="metricsDetailModalSubtitle"></p>
                </div>
                <button type="button"
                        class="metrics-detail-modal__close"
                        id="metricsDetailModalClose"
                        aria-label="Cerrar detalle"
                        data-metrics-modal-close>&times;</button>
            </header>
            <div class="metrics-detail-modal__summary" id="metricsDetailModalSummary"></div>
            <div class="metrics-detail-modal__table-wrap">
                <table class="metrics-detail-table">
                    <colgroup>
                        <col class="metrics-detail-table__client" />
                        <col class="metrics-detail-table__score" />
                        <col class="metrics-detail-table__value" />
                        <col class="metrics-detail-table__date" />
                        <col class="metrics-detail-table__detail" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th scope="col">Nombre de cliente</th>
                            <th scope="col">Puntaje</th>
                            <th scope="col">Valor de contrato</th>
                            <th scope="col">Fecha de inicio</th>
                            <th scope="col">Detalle</th>
                        </tr>
                    </thead>
                    <tbody id="metricsDetailModalBody"></tbody>
                </table>
                <div class="metrics-detail-modal__empty" id="metricsDetailModalEmpty" hidden>
                    No hay negocios para este periodo.
                </div>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <script src="~/js/metricas.js" asp-append-version="true"></script>
}
