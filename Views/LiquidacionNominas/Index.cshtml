@model NominaPageViewModel
@{
    ViewData["Title"] = "Liquidacion Nominas";
}

@section Styles {
    <link rel="stylesheet" href="~/css/liquidacion-nominas.css" asp-append-version="true" />
}

<div class="payroll-shell"
     id="nominaApp"
     data-preview-url="@Url.Action("Preview", "LiquidacionNominas")"
     data-confirm-url="@Url.Action("Confirm", "LiquidacionNominas")"
     data-draft-owner="@Model.CurrentUser.Email"
     data-initial-period="@Model.InitialPeriodKey"
     data-suggested-payment-date="@Model.SuggestedPaymentDateValue">
    <section class="payroll-hero">
        <div>
            <div class="payroll-kicker">Modulo Dataverse</div>
            <h1 class="payroll-title">Liquidacion Nominas</h1>
            <p class="payroll-subtitle">
                Prepara, revisa y confirma la liquidacion mensual antes de enviarla al proceso contable.
            </p>
        </div>
        <div class="payroll-user-pill">
            <span class="payroll-user-pill__label">Acceso</span>
            <span>@Model.CurrentUser.Email</span>
        </div>
    </section>

    <section class="payroll-card">
        <div class="payroll-toolbar">
            <div class="payroll-toolbar__filters">
                <div class="payroll-field">
                    <label class="form-label" for="periodInput">Mes a liquidar</label>
                    <input class="form-control" id="periodInput" type="month" value="@Model.InitialPeriodKey" />
                </div>
                <div class="payroll-field">
                    <label class="form-label" for="paymentDateInput">Fecha de pago</label>
                    <input class="form-control" id="paymentDateInput" type="date" value="@Model.SuggestedPaymentDateValue" />
                </div>
            </div>
            <div class="payroll-toolbar__actions">
                <p class="payroll-toolbar__hint">
                    Si algo falla veras un detalle claro para corregirlo.
                </p>
                <div class="payroll-toolbar__buttons">
                    <button type="button" class="btn btn-outline-secondary" id="resetNominaBtn">Limpiar vista</button>
                    <button type="button" class="btn btn-outline-secondary" id="saveNominaDraftBtn" disabled>Guardar borrador</button>
                    <button type="button" class="btn btn-primary" id="previewNominaBtn">Preparar liquidacion</button>
                    <button type="button" class="btn btn-success" id="confirmNominaBtn" disabled>Confirmar y enviar</button>
                </div>
            </div>
        </div>
    </section>

    <div id="nominaStatusBanner" class="payroll-status" role="status" aria-live="polite"></div>

    <section class="payroll-summary" id="nominaSummary" hidden>
        <article class="payroll-summary__card">
            <span class="payroll-summary__label">Empleados</span>
            <strong class="payroll-summary__value" id="summaryEmployees">0</strong>
        </article>
        <article class="payroll-summary__card">
            <span class="payroll-summary__label">Total nomina</span>
            <strong class="payroll-summary__value" id="summaryPayroll">0</strong>
        </article>
        <article class="payroll-summary__card">
            <span class="payroll-summary__label">Total cuenta de cobro</span>
            <strong class="payroll-summary__value" id="summaryCuentaCobro">0</strong>
        </article>
        <article class="payroll-summary__card">
            <span class="payroll-summary__label">Total desembolso</span>
            <strong class="payroll-summary__value" id="summaryDisbursement">0</strong>
        </article>
        <article class="payroll-summary__card">
            <span class="payroll-summary__label">Total copiers</span>
            <strong class="payroll-summary__value" id="summaryCopiers">0</strong>
        </article>
        <article class="payroll-summary__card">
            <span class="payroll-summary__label">Total cloud</span>
            <strong class="payroll-summary__value" id="summaryCloud">0</strong>
        </article>
    </section>

    <section class="payroll-card" id="nominaRowsCard" hidden>
        <div class="payroll-section-header">
            <div>
                <div class="payroll-kicker">Preliquidacion</div>
                <h2 class="payroll-section-title">Detalle por empleado</h2>
                <p class="payroll-section-subtitle">Ajusta valores antes de confirmar.</p>
            </div>
            <div class="payroll-section-meta" id="nominaPeriodLabel"></div>
        </div>
        <div class="table-responsive payroll-table-wrap">
            <table class="table align-middle payroll-table">
                <thead>
                    <tr>
                        <th class="text-center">Verificado</th>
                        <th>Empleado</th>
                        <th class="text-end">Monto pagado</th>
                    </tr>
                </thead>
                <tbody id="nominaRowsBody"></tbody>
            </table>
        </div>
    </section>

    <div class="payroll-modal" id="nominaDetailModal" hidden>
        <div class="payroll-modal__backdrop" data-nomina-detail-close></div>
        <form class="payroll-modal__dialog" id="nominaDetailForm" role="dialog" aria-modal="true" aria-labelledby="nominaDetailTitle">
            <div class="payroll-modal__header">
                <div>
                    <div class="payroll-kicker">Detalle empleado</div>
                    <h2 class="payroll-modal__title" id="nominaDetailTitle">Liquidacion</h2>
                    <p class="payroll-modal__subtitle" id="nominaDetailSubtitle"></p>
                </div>
                <button type="button" class="btn btn-outline-secondary" data-nomina-detail-close>Cerrar</button>
            </div>

            <div class="payroll-modal__body">
                <div class="payroll-detail-warnings" id="nominaDetailWarnings" hidden></div>

                <section class="payroll-manual-editor">
                    <div class="payroll-manual-editor__header">
                        <label class="payroll-manual-toggle" for="detailManualEditToggle">
                            <input class="form-check-input" id="detailManualEditToggle" type="checkbox" />
                            <span>Edicion manual</span>
                        </label>
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="detailManualResetBtn">Restaurar automatico</button>
                    </div>
                    <div class="payroll-manual-editor__panel" id="detailManualEditPanel" hidden>
                        <div class="payroll-detail-form-grid" id="detailManualFields"></div>
                    </div>
                </section>

                <section class="payroll-detail-section">
                    <h3 class="payroll-detail-section__title">Valores base</h3>
                    <div class="payroll-detail-grid payroll-detail-grid--base">
                        <div class="payroll-detail-item">
                            <span>Sueldo mensual</span>
                            <strong data-detail-output="monthlySalaryBase">0</strong>
                        </div>
                        <div class="payroll-detail-item">
                            <span>Auxilio mensual</span>
                            <strong data-detail-output="monthlyAuxilio">0</strong>
                        </div>
                        <div class="payroll-detail-item">
                            <span>Comisiones</span>
                            <strong data-detail-output="commissions">0</strong>
                        </div>
                    </div>
                </section>

                <section class="payroll-detail-section">
                    <h3 class="payroll-detail-section__title">Ajustes de liquidacion</h3>
                    <div class="payroll-detail-form-grid">
                        <div class="payroll-field">
                            <label class="form-label" for="detailWorkedDays">Dias trabajados</label>
                            <input class="form-control payroll-detail-input text-end" id="detailWorkedDays" type="number" min="0" step="0.01" data-detail-field="workedDays" />
                        </div>
                        <div class="payroll-field" id="detailAbsenceReasonWrap" hidden>
                            <label class="form-label" for="detailAbsenceReason">Motivo dias no trabajados</label>
                            <select class="form-select payroll-detail-input" id="detailAbsenceReason" data-detail-field="absenceReason">
                                <option value="">Selecciona motivo</option>
                                <option value="ingreso">Ingreso</option>
                                <option value="incapacidad">Incapacidad</option>
                                <option value="vacaciones">Vacaciones</option>
                                <option value="calamidad">Calamidad</option>
                            </select>
                        </div>
                        <div class="payroll-field" id="detailAbsencePaymentWrap" hidden>
                            <label class="form-label" for="detailAbsencePayment" id="detailAbsencePaymentLabel">Valor dias no trabajados</label>
                            <input class="form-control payroll-detail-input text-end" id="detailAbsencePayment" type="number" min="0" step="0.01" data-detail-field="absencePayment" />
                            <div class="payroll-field-hint" id="detailAbsencePaymentHint"></div>
                        </div>
                        <div class="payroll-field">
                            <label class="form-label" for="detailBonusCompliance">Bono</label>
                            <input class="form-control payroll-detail-input text-end" id="detailBonusCompliance" type="number" min="0" step="0.01" data-detail-field="bonusCompliance" />
                        </div>
                        <div class="payroll-field">
                            <label class="form-label" for="detailOtherDeductions">Otras deducciones</label>
                            <input class="form-control payroll-detail-input text-end" id="detailOtherDeductions" type="number" min="0" step="0.01" data-detail-field="otherDeductions" />
                        </div>
                        <div class="payroll-field">
                            <label class="form-label" for="detailLoan">Prestamo</label>
                            <input class="form-control payroll-detail-input text-end" id="detailLoan" type="number" min="0" step="0.01" data-detail-field="loan" />
                        </div>
                        <div class="payroll-field">
                            <label class="form-label" for="detailPayrollWithholding">Rete nomina</label>
                            <input class="form-control payroll-detail-input text-end" id="detailPayrollWithholding" type="number" min="0" step="0.01" data-detail-field="payrollWithholding" />
                        </div>
                        <div class="payroll-field">
                            <label class="form-label" for="detailExternalWithholding">Rete fuente cxc</label>
                            <input class="form-control payroll-detail-input text-end" id="detailExternalWithholding" type="number" min="0" step="0.01" data-detail-field="externalWithholding" readonly />
                        </div>
                    </div>
                </section>

                <section class="payroll-detail-section">
                    <h3 class="payroll-detail-section__title">Aportes y resultado</h3>
                    <div class="payroll-breakdown-card payroll-breakdown-card--result">
                        <div class="payroll-breakdown-meta">
                            <span>Base aportes <strong data-detail-output="contributionBase">0</strong></span>
                            <span>Tope comisional <strong data-detail-output="commissionCap">0</strong></span>
                            <span>Base aplicada <strong data-detail-output="appliedCommissionBase">0</strong></span>
                        </div>
                        <div class="payroll-breakdown-list">
                            <div class="payroll-breakdown-row payroll-breakdown-row--positive">
                                <span class="payroll-breakdown-sign">+</span>
                                <span>Sueldo base proporcional</span>
                                <strong data-detail-output="salaryBase">0</strong>
                            </div>
                            <div class="payroll-breakdown-row payroll-breakdown-row--positive">
                                <span class="payroll-breakdown-sign">+</span>
                                <span>Auxilio proporcional</span>
                                <strong data-detail-output="auxilio">0</strong>
                            </div>
                            <div class="payroll-breakdown-row payroll-breakdown-row--positive">
                                <span class="payroll-breakdown-sign">+</span>
                                <span>Pago dias no trabajados</span>
                                <strong data-detail-output="absencePayment">0</strong>
                            </div>
                            <div class="payroll-breakdown-row payroll-breakdown-row--positive">
                                <span class="payroll-breakdown-sign">+</span>
                                <span>Bono</span>
                                <strong data-detail-output="bonusCompliance">0</strong>
                            </div>
                            <div class="payroll-breakdown-row payroll-breakdown-row--positive">
                                <span class="payroll-breakdown-sign">+</span>
                                <span>Comisiones</span>
                                <strong data-detail-output="commissions">0</strong>
                            </div>
                            <div class="payroll-breakdown-row payroll-breakdown-row--subtotal">
                                <span class="payroll-breakdown-sign">=</span>
                                <span>Sueldo bruto</span>
                                <strong data-detail-output="grossSalary">0</strong>
                            </div>
                            <div class="payroll-breakdown-row payroll-breakdown-row--negative">
                                <span class="payroll-breakdown-sign">-</span>
                                <span>Salud</span>
                                <strong data-detail-output="health">0</strong>
                            </div>
                            <div class="payroll-breakdown-row payroll-breakdown-row--negative">
                                <span class="payroll-breakdown-sign">-</span>
                                <span>Pension</span>
                                <strong data-detail-output="pension">0</strong>
                            </div>
                            <div class="payroll-breakdown-row payroll-breakdown-row--negative">
                                <span class="payroll-breakdown-sign">-</span>
                                <span>Otras deducciones</span>
                                <strong data-detail-output="otherDeductions">0</strong>
                            </div>
                            <div class="payroll-breakdown-row payroll-breakdown-row--negative">
                                <span class="payroll-breakdown-sign">-</span>
                                <span>Prestamo</span>
                                <strong data-detail-output="loan">0</strong>
                            </div>
                            <div class="payroll-breakdown-row payroll-breakdown-row--negative">
                                <span class="payroll-breakdown-sign">-</span>
                                <span>Rete nomina</span>
                                <strong data-detail-output="payrollWithholding">0</strong>
                            </div>
                            <div class="payroll-breakdown-row payroll-breakdown-row--subtotal">
                                <span class="payroll-breakdown-sign">=</span>
                                <span>Monto pagado nomina</span>
                                <strong data-detail-output="netPayroll">0</strong>
                            </div>
                            <div class="payroll-breakdown-row payroll-breakdown-row--positive">
                                <span class="payroll-breakdown-sign">+</span>
                                <span>Cuenta cobro</span>
                                <strong data-detail-output="cuentaDeCobro">0</strong>
                            </div>
                            <div class="payroll-breakdown-row payroll-breakdown-row--negative">
                                <span class="payroll-breakdown-sign">-</span>
                                <span>Rete fuente cxc <small data-detail-output="externalWithholdingRate">0</small></span>
                                <strong data-detail-output="externalWithholding">0</strong>
                            </div>
                            <div class="payroll-breakdown-row payroll-breakdown-row--subtotal">
                                <span class="payroll-breakdown-sign">=</span>
                                <span>Monto pagado cxc</span>
                                <strong data-detail-output="netCuentaDeCobro">0</strong>
                            </div>
                            <div class="payroll-breakdown-row payroll-breakdown-row--total">
                                <span class="payroll-breakdown-sign">=</span>
                                <span>Total desembolso</span>
                                <strong data-detail-output="totalDisbursement">0</strong>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="payroll-detail-section">
                    <h3 class="payroll-detail-section__title">Distribucion por vertical</h3>
                    <div class="payroll-vertical-detail-card">
                        <div class="payroll-vertical-detail-total">
                            <span>Total distribuido</span>
                            <strong data-detail-output="verticalTotal">0</strong>
                        </div>
                        <div class="payroll-vertical-detail-base">
                            Base reparto <strong data-detail-output="verticalBase">0</strong>
                        </div>
                        <div class="payroll-vertical-detail-list">
                            <div class="payroll-vertical-detail-row payroll-vertical-detail-row--copiers">
                                <div class="payroll-vertical-detail-row__head">
                                    <span>Copiers</span>
                                    <strong data-detail-output="totalCopiers">0</strong>
                                </div>
                                <div class="payroll-vertical-detail-row__parts">
                                    <label class="payroll-vertical-detail-field" for="detailFactorCopiers">
                                        <span>% Copiers</span>
                                        <input class="form-control payroll-detail-input text-end" id="detailFactorCopiers" type="number" min="0" step="0.01" data-detail-field="factorCopiers" />
                                    </label>
                                    <span>Base por porcentaje <strong data-detail-output="baseCopiers">0</strong></span>
                                    <span>Comisiones <strong data-detail-output="commissionsCopiersVertical">0</strong></span>
                                </div>
                            </div>
                            <div class="payroll-vertical-detail-row payroll-vertical-detail-row--cloud">
                                <div class="payroll-vertical-detail-row__head">
                                    <span>Cloud</span>
                                    <strong data-detail-output="totalCloud">0</strong>
                                </div>
                                <div class="payroll-vertical-detail-row__parts">
                                    <label class="payroll-vertical-detail-field" for="detailFactorCloud">
                                        <span>% Cloud</span>
                                        <input class="form-control payroll-detail-input text-end" id="detailFactorCloud" type="number" min="0" step="0.01" data-detail-field="factorCloud" />
                                    </label>
                                    <span>Base por porcentaje <strong data-detail-output="baseCloud">0</strong></span>
                                    <span>Comisiones <strong data-detail-output="commissionsCloudVertical">0</strong></span>
                                </div>
                            </div>
                        </div>
                        <div class="payroll-vertical-detail-residual">
                            <span>Comisiones sin vertical</span>
                            <strong data-detail-output="commissionsUnassigned">0</strong>
                        </div>
                    </div>
                </section>
            </div>

            <div class="payroll-modal__footer">
                <div class="payroll-modal__meta" id="nominaDetailMeta">Sin registro previo</div>
                <button type="button" class="btn btn-primary" data-nomina-detail-close>Listo</button>
            </div>
        </form>
    </div>

    <section class="payroll-card" id="nominaVerticalsCard" hidden>
        <div class="payroll-section-header">
            <div>
                <div class="payroll-kicker">Resumen final</div>
                <h2 class="payroll-section-title">Desglose por vertical</h2>
                <p class="payroll-section-subtitle">Vista resumida por empleado. Abre una fila para revisar y ajustar el detalle del calculo vertical.</p>
            </div>
        </div>
        <div class="table-responsive payroll-vertical-wrap">
            <table class="table align-middle payroll-vertical-table">
                <thead>
                    <tr>
                        <th>Empleado</th>
                        <th class="text-end payroll-vertical-column payroll-vertical-column--total">Total</th>
                        <th class="text-end payroll-vertical-column payroll-vertical-column--copiers">Total Copiers</th>
                        <th class="text-end payroll-vertical-column payroll-vertical-column--cloud">Total Cloud</th>
                    </tr>
                </thead>
                <tbody id="nominaVerticalsBody"></tbody>
            </table>
        </div>
    </section>

    <section class="payroll-card" id="nominaLogsCard" hidden>
        <div class="payroll-section-header">
            <div>
                <div class="payroll-kicker">Resultado</div>
                <h2 class="payroll-section-title">Detalle operativo y errores</h2>
                <p class="payroll-section-subtitle">Resumen del proceso y mensajes para correccion.</p>
            </div>
        </div>
        <div id="nominaLogsEmpty" class="payroll-logs__empty">Todavia no hay mensajes del proceso.</div>
        <div id="nominaLogsList" class="payroll-logs"></div>
    </section>
</div>

@section Scripts {
    <script src="~/js/liquidacion-nominas.js" asp-append-version="true"></script>
}
