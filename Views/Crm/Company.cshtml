@model CotizadorInterno.Web.Models.Crm.CrmCompanyDetailViewModel
@using System.Globalization
@using CotizadorInterno.Web.Models.Crm
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = Model.Company.Name;
    var culture = CultureInfo.GetCultureInfo("es-CO");
    string Money(decimal value) => value.ToString("C0", culture);
    TimeZoneInfo BogotaTimeZone()
    {
        foreach (var id in new[] { "SA Pacific Standard Time", "America/Bogota" })
        {
            try
            {
                return TimeZoneInfo.FindSystemTimeZoneById(id);
            }
            catch (TimeZoneNotFoundException)
            {
            }
            catch (InvalidTimeZoneException)
            {
            }
        }

        return TimeZoneInfo.Utc;
    }
    var bogotaTimeZone = BogotaTimeZone();
    DateTimeOffset InBogota(DateTimeOffset value) =>
        TimeZoneInfo.ConvertTime(value, bogotaTimeZone);
    string DateTimeLabel(DateTimeOffset? value) =>
        value.HasValue
            ? InBogota(value.Value).ToString("dd MMM yyyy · HH:mm", culture)
            : "Sin registro";
    string ActivityRelation(CrmActivitySummary activity) =>
        !string.IsNullOrWhiteSpace(activity.DealName) ? activity.DealName :
        !string.IsNullOrWhiteSpace(activity.ContactName) ? activity.ContactName :
        Model.Company.Name;
    string CrmDetailUrlTemplate(string action)
    {
        var sentinel = Guid.Empty.ToString("D");
        return (Url.Action(
                action,
                "Crm",
                new
                {
                    id = Guid.Empty,
                    ViewAsOwnerId = Model.Access.ViewAsOwnerId
                }) ?? "")
            .Replace(sentinel, "__id__", StringComparison.Ordinal);
    }
    var contactLifecycle = Model.Company.LifecycleValue switch
    {
        (int)CrmCompanyLifecycle.ActiveCustomer => (int)CrmContactLifecycle.Customer,
        (int)CrmCompanyLifecycle.Inactive => (int)CrmContactLifecycle.Inactive,
        _ => (int)CrmContactLifecycle.Lead
    };
    ViewData["CrmAllowContact"] = true;
    ViewData["CrmCompanyId"] = Model.Company.Id;
    ViewData["CrmCompanyName"] = Model.Company.Name;
    ViewData["CrmContactLifecycle"] = contactLifecycle;
    ViewData["CrmIsAdministrator"] = Model.Access.IsAdministrator;
    ViewData["CrmViewAsOwnerId"] = Model.Access.ViewAsOwnerId;
    ViewData["CrmScopeOptions"] = Model.Access.Owners
        .Select(owner => new SelectListItem
        {
            Value = owner.Id,
            Text = string.IsNullOrWhiteSpace(owner.Email)
                ? owner.Name
                : $"{owner.Name} · {owner.Email}",
            Selected = string.Equals(owner.Id, Model.Access.ViewAsOwnerId, StringComparison.OrdinalIgnoreCase)
        })
        .ToList();
    ViewData["CrmObjectType"] = "Company";
    ViewData["CrmRecordId"] = Model.Company.Id;
    ViewData["CrmCurrentOwnerName"] = Model.Company.Audit.OwnerName;
    ViewData["CrmOwnerOptions"] = Model.Access.Owners
        .Select(owner => new SelectListItem
        {
            Value = owner.Id,
            Text = string.IsNullOrWhiteSpace(owner.Email)
                ? owner.Name
                : $"{owner.Name} · {owner.Email}",
            Selected = string.Equals(owner.Id, Model.Company.Audit.OwnerId, StringComparison.OrdinalIgnoreCase)
        })
        .ToList();
    ViewData["CrmDealCompanyId"] = Model.Company.Id;
    ViewData["CrmDealCompanyName"] = Model.Company.Name;
    ViewData["CrmDealContactOptions"] = Model.Contacts.Items
        .OrderBy(contact => contact.FullName)
        .Select(contact => new SelectListItem
        {
            Value = contact.Id,
            Text = contact.FullName,
            Group = new SelectListGroup { Name = contact.CompanyId }
        })
        .ToList();
}

@section Styles {
    <link rel="stylesheet" href="~/css/crm.css" asp-append-version="true" />
}

<div class="crm-app crm-detail-app"
     id="crmDetailApp"
     data-record-type="company"
     data-create-contact-url="@Url.Action("CreateContact", "Crm", new { ViewAsOwnerId = Model.Access.ViewAsOwnerId })"
     data-create-activity-url="@Url.Action("CreateActivity", "Crm", new { ViewAsOwnerId = Model.Access.ViewAsOwnerId })"
     data-create-deal-url="@Url.Action("CreateDeal", "Crm", new { ViewAsOwnerId = Model.Access.ViewAsOwnerId })"
     data-update-owner-url="@Url.Action("UpdateOwner", "Crm", new { ViewAsOwnerId = Model.Access.ViewAsOwnerId })"
     data-search-companies-url="@Url.Action("SearchCompanies", "Crm", new { ViewAsOwnerId = Model.Access.ViewAsOwnerId })"
     data-calculator-url="@Url.Action("Index", "Calculator")"
     data-crm-index-url="@Url.Action("Index", "Crm", new { ViewAsOwnerId = Model.Access.ViewAsOwnerId })"
     data-contact-detail-url-template="@CrmDetailUrlTemplate("Contact")"
     data-deal-detail-url-template="@CrmDetailUrlTemplate("Deal")"
     data-activity-detail-url-template="@CrmDetailUrlTemplate("Activity")"
     data-view-as-owner-id="@Model.Access.ViewAsOwnerId"
     data-planned-activity-status="@((int)CrmActivityStatus.Planned)"
     data-completed-activity-status="@((int)CrmActivityStatus.Completed)"
     data-meeting-activity-type="@((int)CrmActivityType.Meeting)">
    @Html.AntiForgeryToken()

    <div class="crm-workspace">
        <partial name="_CrmSidebar" model="@("empresas")" />

        <main class="crm-workspace__main">
            <nav class="crm-breadcrumb" aria-label="Ruta de navegación">
                <a asp-action="Index"
                   asp-controller="Crm"
                   asp-route-viewAsOwnerId="@Model.Access.ViewAsOwnerId"
                   asp-fragment="crm-empresas">Empresas</a>
                <span aria-hidden="true">/</span>
                <span aria-current="page">@Model.Company.Name</span>
            </nav>

            <partial name="_CrmScopeSelector" />

            <header class="crm-record-header">
                <div class="crm-record-header__identity">
                    <span class="crm-record-header__mark" aria-hidden="true">
                        @(string.IsNullOrWhiteSpace(Model.Company.Name) ? "E" : Model.Company.Name[..1].ToUpperInvariant())
                    </span>
                    <div>
                        <span class="crm-eyebrow">Empresa</span>
                        <div class="crm-record-header__title">
                            <h1>@Model.Company.Name</h1>
                            <span class="crm-record-status">@Model.Company.LifecycleLabel</span>
                        </div>
                        <p>@(string.IsNullOrWhiteSpace(Model.Company.TaxId) ? "Sin NIT registrado" : $"NIT {Model.Company.TaxId}")</p>
                    </div>
                </div>
                <div class="crm-record-header__actions">
                    <button class="crm-btn crm-btn--quiet" type="button" data-detail-open-contact>Nuevo contacto</button>
                    <button class="crm-btn crm-btn--soft" type="button" data-detail-open-deal>Nuevo negocio</button>
                    <button class="crm-btn crm-btn--primary" type="button" data-detail-open-activity>Registrar actividad</button>
                </div>
            </header>

            <div class="crm-status" data-detail-global-status role="status" aria-live="polite" hidden></div>

            <section class="crm-record-metrics" aria-label="Resumen de la empresa">
                <article><span>Contactos</span><strong>@Model.Contacts.TotalCount</strong><small>Personas asociadas</small></article>
                <article><span>Negocios</span><strong>@Model.Deals.TotalCount</strong><small>Oportunidades y cotizados</small></article>
                <article><span>Actividad</span><strong>@Model.Activities.TotalCount</strong><small>Registros comerciales</small></article>
            </section>

            <div class="crm-record-layout">
                <div class="crm-record-layout__main">
                    <section class="crm-record-card" aria-labelledby="companyGeneralTitle">
                        <header class="crm-record-card__head">
                            <div>
                                <span class="crm-eyebrow">Hoja de vida</span>
                                <h2 id="companyGeneralTitle">Información general</h2>
                            </div>
                        </header>
                        <dl class="crm-fact-grid">
                            <div><dt>Correo</dt><dd>@(string.IsNullOrWhiteSpace(Model.Company.Email) ? "Sin correo registrado" : Model.Company.Email)</dd></div>
                            <div><dt>Teléfono</dt><dd>@(string.IsNullOrWhiteSpace(Model.Company.Phone) ? "Sin teléfono registrado" : Model.Company.Phone)</dd></div>
                            <div><dt>Ciudad</dt><dd>@(string.IsNullOrWhiteSpace(Model.Company.City) ? "Sin ciudad registrada" : Model.Company.City)</dd></div>
                            <div><dt>Cliente operativo</dt><dd>@(string.IsNullOrWhiteSpace(Model.Company.OperationalClientId) ? "Aún no vinculado" : "Vinculado con operación")</dd></div>
                            <div><dt>Conversión a cliente</dt><dd>@DateTimeLabel(Model.Company.ConvertedAtUtc)</dd></div>
                            <div><dt>Última actualización</dt><dd>@DateTimeLabel(Model.Company.Audit.ModifiedAtUtc)</dd></div>
                        </dl>
                    </section>

                    <section class="crm-association-card" aria-labelledby="companyContactsTitle">
                        <header class="crm-association-card__head">
                            <div><h2 id="companyContactsTitle">Contactos</h2><span>@Model.Contacts.TotalCount asociados</span></div>
                            <button class="crm-association-card__action" type="button" data-detail-open-contact>Nuevo contacto</button>
                        </header>
                        @if (Model.Contacts.Items.Count == 0)
                        {
                            <div class="crm-association-empty"><strong>Sin contactos asociados</strong><span>Crea el primer contacto de esta empresa.</span></div>
                        }
                        else
                        {
                            <div class="crm-associated-list">
                                @foreach (var contact in Model.Contacts.Items)
                                {
                                    <article class="crm-associated-row">
                                        <div class="crm-associated-row__main">
                                            <a asp-action="Contact"
                                               asp-controller="Crm"
                                               asp-route-id="@contact.Id"
                                               asp-route-viewAsOwnerId="@Model.Access.ViewAsOwnerId">@contact.FullName</a>
                                            <span>@(string.IsNullOrWhiteSpace(contact.JobTitle) ? "Sin cargo registrado" : contact.JobTitle)</span>
                                        </div>
                                        <div class="crm-associated-row__meta">
                                            <strong>@contact.LifecycleLabel</strong>
                                            <span>@(string.IsNullOrWhiteSpace(contact.Email) ? contact.Phone : contact.Email)</span>
                                        </div>
                                    </article>
                                }
                            </div>
                        }
                        @if (Model.Contacts.HasPrevious || Model.Contacts.HasNext)
                        {
                            <nav class="crm-detail-pagination" aria-label="Paginación de contactos asociados">
                                @if (Model.Contacts.HasPrevious)
                                {
                                    <a asp-action="Company" asp-route-id="@Model.Company.Id"
                                       asp-route-contactPage="@(Model.Contacts.Page - 1)"
                                       asp-route-dealPage="@Model.Query.DealPage"
                                       asp-route-activityPage="@Model.Query.ActivityPage"
                                       asp-route-viewAsOwnerId="@Model.Access.ViewAsOwnerId"
                                       asp-route-pageSize="@Model.Query.PageSize">Anterior</a>
                                }
                                else
                                {
                                    <span aria-disabled="true">Anterior</span>
                                }
                                <span>Página @Model.Contacts.Page</span>
                                @if (Model.Contacts.HasNext)
                                {
                                    <a asp-action="Company" asp-route-id="@Model.Company.Id"
                                       asp-route-contactPage="@(Model.Contacts.Page + 1)"
                                       asp-route-dealPage="@Model.Query.DealPage"
                                       asp-route-activityPage="@Model.Query.ActivityPage"
                                       asp-route-viewAsOwnerId="@Model.Access.ViewAsOwnerId"
                                       asp-route-pageSize="@Model.Query.PageSize">Siguiente</a>
                                }
                                else
                                {
                                    <span aria-disabled="true">Siguiente</span>
                                }
                            </nav>
                        }
                    </section>

                    <section class="crm-association-card" aria-labelledby="companyDealsTitle">
                        <header class="crm-association-card__head">
                            <div><h2 id="companyDealsTitle">Negocios</h2><span>@Model.Deals.TotalCount asociados</span></div>
                            <button class="crm-association-card__action" type="button" data-detail-open-deal>Nuevo negocio</button>
                        </header>
                        @if (Model.Deals.Items.Count == 0)
                        {
                            <div class="crm-association-empty"><strong>Sin negocios asociados</strong><span>Crea un estimado o continúa desde la calculadora.</span></div>
                        }
                        else
                        {
                            <div class="crm-associated-list">
                                @foreach (var deal in Model.Deals.Items)
                                {
                                    <article class="crm-associated-row">
                                        <div class="crm-associated-row__main">
                                            <a asp-action="Deal"
                                               asp-controller="Crm"
                                               asp-route-id="@deal.Id"
                                               asp-route-viewAsOwnerId="@Model.Access.ViewAsOwnerId">@deal.Name</a>
                                            <span>@deal.KindLabel · @deal.StageLabel</span>
                                        </div>
                                        <div class="crm-associated-row__meta">
                                            <strong>@Money(deal.PipelineValue)</strong>
                                            <span>@deal.Probability.ToString("0", culture)% probabilidad</span>
                                        </div>
                                    </article>
                                }
                            </div>
                        }
                        @if (Model.Deals.HasPrevious || Model.Deals.HasNext)
                        {
                            <nav class="crm-detail-pagination" aria-label="Paginación de negocios asociados">
                                @if (Model.Deals.HasPrevious)
                                {
                                    <a asp-action="Company" asp-route-id="@Model.Company.Id"
                                       asp-route-contactPage="@Model.Query.ContactPage"
                                       asp-route-dealPage="@(Model.Deals.Page - 1)"
                                       asp-route-activityPage="@Model.Query.ActivityPage"
                                       asp-route-viewAsOwnerId="@Model.Access.ViewAsOwnerId"
                                       asp-route-pageSize="@Model.Query.PageSize">Anterior</a>
                                }
                                else
                                {
                                    <span aria-disabled="true">Anterior</span>
                                }
                                <span>Página @Model.Deals.Page</span>
                                @if (Model.Deals.HasNext)
                                {
                                    <a asp-action="Company" asp-route-id="@Model.Company.Id"
                                       asp-route-contactPage="@Model.Query.ContactPage"
                                       asp-route-dealPage="@(Model.Deals.Page + 1)"
                                       asp-route-activityPage="@Model.Query.ActivityPage"
                                       asp-route-viewAsOwnerId="@Model.Access.ViewAsOwnerId"
                                       asp-route-pageSize="@Model.Query.PageSize">Siguiente</a>
                                }
                                else
                                {
                                    <span aria-disabled="true">Siguiente</span>
                                }
                            </nav>
                        }
                    </section>

                    <section class="crm-association-card" aria-labelledby="companyActivitiesTitle">
                        <header class="crm-association-card__head">
                            <div><h2 id="companyActivitiesTitle">Actividad registrada</h2><span>@Model.Activities.TotalCount registros</span></div>
                            <button class="crm-association-card__action" type="button" data-detail-open-activity>Registrar actividad</button>
                        </header>
                        @if (Model.Activities.Items.Count == 0)
                        {
                            <div class="crm-association-empty"><strong>Sin actividad registrada</strong><span>Agrega el primer seguimiento comercial.</span></div>
                        }
                        else
                        {
                            <div class="crm-timeline">
                                @foreach (var activity in Model.Activities.Items)
                                {
                                    <article class="crm-timeline__item">
                                        <span class="crm-timeline__marker" aria-hidden="true"></span>
                                        <div>
                                            <a asp-action="Activity"
                                               asp-controller="Crm"
                                               asp-route-id="@activity.Id"
                                               asp-route-viewAsOwnerId="@Model.Access.ViewAsOwnerId">@activity.Subject</a>
                                            <p>@activity.TypeDisplayLabel · @ActivityRelation(activity)</p>
                                        </div>
                                        <time datetime="@((activity.CompletedAtUtc ?? activity.PlannedAtUtc)?.ToString("O"))">
                                            @DateTimeLabel(activity.CompletedAtUtc ?? activity.PlannedAtUtc)
                                        </time>
                                    </article>
                                }
                            </div>
                        }
                        @if (Model.Activities.HasPrevious || Model.Activities.HasNext)
                        {
                            <nav class="crm-detail-pagination" aria-label="Paginación de actividad asociada">
                                @if (Model.Activities.HasPrevious)
                                {
                                    <a asp-action="Company" asp-route-id="@Model.Company.Id"
                                       asp-route-contactPage="@Model.Query.ContactPage"
                                       asp-route-dealPage="@Model.Query.DealPage"
                                       asp-route-activityPage="@(Model.Activities.Page - 1)"
                                       asp-route-viewAsOwnerId="@Model.Access.ViewAsOwnerId"
                                       asp-route-pageSize="@Model.Query.PageSize">Anterior</a>
                                }
                                else
                                {
                                    <span aria-disabled="true">Anterior</span>
                                }
                                <span>Página @Model.Activities.Page</span>
                                @if (Model.Activities.HasNext)
                                {
                                    <a asp-action="Company" asp-route-id="@Model.Company.Id"
                                       asp-route-contactPage="@Model.Query.ContactPage"
                                       asp-route-dealPage="@Model.Query.DealPage"
                                       asp-route-activityPage="@(Model.Activities.Page + 1)"
                                       asp-route-viewAsOwnerId="@Model.Access.ViewAsOwnerId"
                                       asp-route-pageSize="@Model.Query.PageSize">Siguiente</a>
                                }
                                else
                                {
                                    <span aria-disabled="true">Siguiente</span>
                                }
                            </nav>
                        }
                    </section>
                </div>

                <aside class="crm-record-layout__rail" aria-label="Auditoría del registro">
                    <section class="crm-record-card crm-audit-card">
                        <span class="crm-eyebrow">Auditoría</span>
                        <h2>Historial del registro</h2>
                        <dl>
                            <div>
                                <dt>Propietario</dt>
                                <dd><partial name="_CrmOwnerField" /></dd>
                            </div>
                            <div><dt>Creado por</dt><dd>@(string.IsNullOrWhiteSpace(Model.Company.Audit.CreatedByName) ? "Sin registro" : Model.Company.Audit.CreatedByName)</dd></div>
                            <div><dt>Creación</dt><dd>@DateTimeLabel(Model.Company.Audit.CreatedAtUtc)</dd></div>
                            <div><dt>Modificado por</dt><dd>@(string.IsNullOrWhiteSpace(Model.Company.Audit.ModifiedByName) ? "Sin registro" : Model.Company.Audit.ModifiedByName)</dd></div>
                            <div><dt>Última modificación</dt><dd>@DateTimeLabel(Model.Company.Audit.ModifiedAtUtc)</dd></div>
                        </dl>
                    </section>
                </aside>
            </div>
        </main>
    </div>

    <partial name="_CrmDetailDrawers" />
    <partial name="_CrmDealDrawer" />
</div>

@section Scripts {
    <script src="~/js/crm-detail.js" asp-append-version="true"></script>
}
