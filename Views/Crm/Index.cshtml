                            {
                                <option value="@meetingType.Value">@meetingType.Label</option>
                            }
                        </select>
                    </label>
                    <label class="crm-field">
                        <span>Estado *</span>
                        <select name="Status" required data-activity-status-select>
                            @foreach (var status in Model.ActivityStatuses)
                            {
                                <option value="@status.Value">@status.Label</option>
                            }
                        </select>
                    </label>
                    <label class="crm-field crm-field--wide">
                        <span>Asunto *</span>
                        <input type="text" name="Subject" maxlength="200" required placeholder="Ej. Revisar propuesta comercial" />
                    </label>
                    <label class="crm-field">
                        <span>Fecha planeada</span>
                        <input type="datetime-local" name="PlannedAtUtc" required data-activity-planned-input />
                    </label>
                    <label class="crm-field" data-activity-completed-field hidden>
                        <span>Fecha completada *</span>
                        <input type="datetime-local" name="CompletedAtUtc" data-activity-completed-input />
                    </label>
                    <label class="crm-field">
                        <span>Empresa</span>
                        <select name="CompanyId">
                            <option value="">Sin empresa</option>
                            @foreach (var company in Model.Companies.Items)
                            {
                                <option value="@company.Id">@company.Name</option>
                            }
                        </select>
                    </label>
                    <label class="crm-field">
                        <span>Contacto</span>
                        <select name="ContactId">
                            <option value="">Sin contacto</option>
                            @foreach (var contact in Model.Contacts.Items)
                            {
                                <option value="@contact.Id" data-company-id="@contact.CompanyId">@contact.FullName · @contact.CompanyName</option>
                            }
                        </select>
                    </label>
                    <label class="crm-field crm-field--wide">
                        <span>Negocio</span>
                        <select name="DealId">
                            <option value="">Sin negocio asociado</option>
                            @foreach (var stage in Model.DealStages)
                            {
                                @foreach (var deal in Model.Deals.Items.Where(deal => deal.StageValue == stage.Value))
                                {
                                    <option value="@deal.Id" data-company-id="@deal.CompanyId">@deal.Name · @deal.CompanyName</option>
                                }
                            }
                        </select>
                    </label>
                    <label class="crm-field">
                        <span>Duración estimada</span>
                        <select name="DurationMinutes">
                            <option value="15">15 minutos</option>
                            <option value="30" selected>30 minutos</option>
                            <option value="45">45 minutos</option>
                            <option value="60">1 hora</option>
                        </select>
                    </label>
                    <label class="crm-field crm-field--wide" data-activity-result-field hidden>
                        <span>Resultado *</span>
                        <input type="text" name="Result" maxlength="500" data-activity-result-input placeholder="Ej. Cliente aprobó avanzar a propuesta" />
                    </label>
                    <label class="crm-field crm-field--wide">
                        <span>Notas</span>
                        <textarea name="Notes" rows="5" maxlength="4000" placeholder="Contexto, acuerdos o información para preparar el seguimiento"></textarea>
                    </label>
                </div>

                <footer class="crm-drawer__footer">
                    <button class="crm-btn crm-btn--quiet" type="button" data-close-activity>Cancelar</button>
                    <button class="crm-btn crm-btn--primary" type="submit" data-save-activity>Guardar actividad</button>
                </footer>
            </form>
        </aside>
    </div>
</div>

@section Scripts {
    <script src="~/js/crm.js" asp-append-version="true"></script>
}
