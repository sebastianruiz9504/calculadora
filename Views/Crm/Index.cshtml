                        <select name="Type" required data-activity-first-focus data-activity-type-select>
                            @foreach (var activityType in Model.ActivityTypes)
                            {
                                <option value="@activityType.Value">@activityType.Label</option>
                            }
                        </select>
                    </label>
                    <label class="crm-field" data-activity-meeting-type-field hidden>
                        <span>Tipo de reunión *</span>
                        <select name="MeetingType" data-activity-meeting-type-select disabled>
                            <option value="">Selecciona una opción</option>
