            <div class="crm-table"
                 role="table"
                 aria-label="Empresas"
                 data-company-table
                 @(Model.Companies.Items.Count == 0 ? "hidden" : null)>
                <div class="crm-table__head crm-table__row--companies" role="row">
                    <span role="columnheader">Empresa</span>
                    <span role="columnheader">Datos de contacto</span>
                    <span role="columnheader">Ubicación</span>
                </div>
                <div data-company-list>
                    @foreach (var company in Model.Companies.Items)
                    {
                        <article class="crm-table__row crm-table__row--companies"
                                 role="row"
                                 data-company-row
                                 data-company-id="@company.Id"
                                 data-company-lifecycle="@company.LifecycleValue"
                                 data-search-text="@($"{company.Name} {company.TaxId} {company.City} {company.Email} {company.Phone} {company.LifecycleLabel}".ToLowerInvariant())">
                            <div role="cell">
                                <div class="crm-company__identity">
                                    <strong>
                                        <a class="crm-record-link"
                                           asp-action="Company"
                                           asp-controller="Crm"
                                           asp-route-id="@company.Id"
                                           asp-route-viewAsOwnerId="@Model.Access.ViewAsOwnerId">@company.Name</a>
                                    </strong>
                                    <span class="crm-record-badge" data-company-lifecycle-label>@company.LifecycleLabel</span>
                                </div>
                                <span>@(string.IsNullOrWhiteSpace(company.TaxId) ? "Sin NIT registrado" : $"NIT {company.TaxId}")</span>
                            </div>
                            <div role="cell">
                                <strong>@(string.IsNullOrWhiteSpace(company.Email) ? "Sin correo registrado" : company.Email)</strong>
                                <span>@(string.IsNullOrWhiteSpace(company.Phone) ? "Sin teléfono registrado" : company.Phone)</span>
                            </div>
                            <div role="cell">
                                <strong>@(string.IsNullOrWhiteSpace(company.City) ? "Sin ciudad registrada" : company.City)</strong>
                                <span>Ubicación comercial</span>
                            </div>
                        </article>
                    }
                </div>
            </div>
            <div class="crm-empty crm-empty--small"
                 data-company-empty
                 @(Model.Companies.Items.Count > 0 ? "hidden" : null)>
                <strong>@(Model.Companies.Items.Count == 0 ? "Aún no hay empresas" : "No encontramos empresas")</strong>
                <span>@(Model.Companies.Items.Count == 0 ? "Crea una empresa lead para iniciar su seguimiento comercial." : "Ajusta la búsqueda o el tipo de empresa.")</span>
            </div>
            @if (Model.Companies.HasPrevious || Model.Companies.HasNext)
            {
                <nav class="crm-pagination" aria-label="Paginación de empresas">
                    @if (Model.Companies.HasPrevious)
                    {
                        <a href="@CrmPageUrl(companyPage: Model.Companies.Page - 1)">Anterior</a>
                    }
                    else
                    {
                        <span aria-disabled="true">Anterior</span>
                    }
                    <strong>Página @Model.Companies.Page · @Model.Companies.TotalCount empresas</strong>
                    @if (Model.Companies.HasNext)
                    {
                        <a href="@CrmPageUrl(companyPage: Model.Companies.Page + 1)">Siguiente</a>
                    }
                    else
                    {
                        <span aria-disabled="true">Siguiente</span>
                    }
                </nav>
            }
        </section>
    </div>
    </section>

    <section class="crm-view"
             id="crm-contactos"
             data-crm-view="contactos"
             aria-labelledby="crmNavContactos"
             hidden>
    <div class="crm-directory crm-directory--single">
        <section class="crm-panel crm-directory-card" aria-labelledby="crmContactsTitle">
            <div class="crm-section-head crm-section-head--compact">
                <div>
                    <span class="crm-eyebrow">Personas</span>
                    <h2 id="crmContactsTitle">Contactos</h2>
                </div>
                <div class="crm-section-head__actions">
                    <label class="crm-search crm-search--small">
                        <span class="visually-hidden">Buscar contactos</span>
                        <input type="search" autocomplete="off" placeholder="Buscar contacto" data-contact-search />
                    </label>
                    <button class="crm-btn crm-btn--soft"
                            type="button"
                            data-open-contact
                            @(Model.Companies.Items.Count == 0 ? "disabled" : null)
                            title="@(Model.Companies.Items.Count == 0 ? "Se requiere una empresa existente" : null)">Nuevo contacto</button>
                </div>
            </div>

            <div class="crm-contact-list" data-contact-list>
                @foreach (var contact in Model.Contacts.Items)
                {
                    var companyLifecycleLabel = companyLifecycleById.TryGetValue(contact.CompanyId, out var associatedLifecycle)
                        ? associatedLifecycle
                        : "";
                    <article class="crm-contact"
                             data-contact-row
                             data-contact-id="@contact.Id"
                             data-company-id="@contact.CompanyId"
                             data-search-text="@($"{contact.FullName} {contact.CompanyName} {contact.Email} {contact.JobTitle} {LifecycleLabel(contact)} {companyLifecycleLabel}".ToLowerInvariant())">
                        <div class="crm-contact__avatar" aria-hidden="true">@Initials(contact.FirstName, contact.LastName)</div>
                        <div class="crm-contact__identity">
                            <div class="crm-contact__name">
                                <strong>
                                    <a class="crm-record-link"
                                       asp-action="Contact"
                                       asp-controller="Crm"
                                       asp-route-id="@contact.Id"
                                       asp-route-viewAsOwnerId="@Model.Access.ViewAsOwnerId">@contact.FullName</a>
                                </strong>
                                <span class="crm-record-badge crm-record-badge--lifecycle">@LifecycleLabel(contact)</span>
                            </div>
                            <span>
                                @contact.JobTitle@if (!string.IsNullOrWhiteSpace(contact.CompanyName)){<text> · @contact.CompanyName</text>}@if (!string.IsNullOrWhiteSpace(companyLifecycleLabel)){<text> · @companyLifecycleLabel</text>}
                            </span>
                        </div>
                        <div class="crm-contact__details">
                            @if (!string.IsNullOrWhiteSpace(contact.Email))
                            {
                                <a href="mailto:@contact.Email">@contact.Email</a>
                            }
                            @if (!string.IsNullOrWhiteSpace(contact.Phone))
                            {
                                <a href="tel:@contact.Phone">@contact.Phone</a>
                            }
                        </div>
                    </article>
                }
            </div>
            <div class="crm-empty crm-empty--small" data-contact-empty @(Model.Contacts.Items.Count > 0 ? "hidden" : null)>
                <strong>@(Model.Contacts.Items.Count == 0 ? "Aún no hay contactos" : "No encontramos contactos")</strong>
                <span>@(Model.Contacts.Items.Count == 0 ? "Crea el primer contacto para iniciar el seguimiento comercial." : "Ajusta la búsqueda e inténtalo de nuevo.")</span>
            </div>
            @if (Model.Contacts.HasPrevious || Model.Contacts.HasNext)
            {
                <nav class="crm-pagination" aria-label="Paginación de contactos">
                    @if (Model.Contacts.HasPrevious)
                    {
                        <a href="@CrmPageUrl(contactPage: Model.Contacts.Page - 1)">Anterior</a>
                    }
                    else
                    {
                        <span aria-disabled="true">Anterior</span>
                    }
                    <strong>Página @Model.Contacts.Page · @Model.Contacts.TotalCount contactos</strong>
                    @if (Model.Contacts.HasNext)
                    {
                        <a href="@CrmPageUrl(contactPage: Model.Contacts.Page + 1)">Siguiente</a>
                    }
                    else
                    {
                        <span aria-disabled="true">Siguiente</span>
                    }
                </nav>
            }
        </section>
    </div>
    </section>

    <section class="crm-view"
             id="crm-actividades"
             data-crm-view="actividades"
             aria-labelledby="crmNavActividades"
             hidden>
    <section class="crm-panel crm-activity" aria-labelledby="crmActivityTitle">
        <div class="crm-section-head crm-section-head--compact">
            <div>
                <span class="crm-eyebrow">Seguimiento</span>
                <h2 id="crmActivityTitle">Actividad reciente</h2>
            </div>
            <div class="crm-section-head__actions">
                <label class="crm-search crm-search--small">
                    <span class="visually-hidden">Buscar actividades</span>
                    <input type="search" autocomplete="off" placeholder="Buscar actividad" data-activity-search />
                </label>
                <button class="crm-btn crm-btn--soft" type="button" data-open-activity>Nueva actividad</button>
            </div>
        </div>

        <div class="crm-activity-list" data-activity-list>
            @foreach (var activity in Model.Activities.Items)
            {
                var relation = ActivityRelation(activity);
                <article class="crm-activity-row"
                         data-activity-row
                         data-search-text="@($"{activity.TypeDisplayLabel} {activity.Subject} {relation}".ToLowerInvariant())">
                    <div class="crm-activity-row__marker" aria-hidden="true"></div>
                    <div class="crm-activity-row__main">
                        <strong>
                            <a class="crm-record-link"
                               asp-action="Activity"
                               asp-controller="Crm"
                               asp-route-id="@activity.Id"
                               asp-route-viewAsOwnerId="@Model.Access.ViewAsOwnerId">@activity.Subject</a>
                        </strong>
                        <span>@activity.TypeDisplayLabel</span>
                    </div>
                    <div class="crm-activity-row__owner">
                        <span>Asociado a</span>
                        <strong>@relation</strong>
                    </div>
                    <div class="crm-activity-row__date">
                        <span>@activity.StatusLabel</span>
                        @if (activity.CompletedAtUtc.HasValue || activity.PlannedAtUtc.HasValue)
                        {
                            var activityDate = activity.CompletedAtUtc ?? activity.PlannedAtUtc!.Value;
                            var localActivityDate = InBogota(activityDate);
                            <time datetime="@activityDate.ToString("O")">@localActivityDate.ToString("dd MMM · HH:mm", culture)</time>
                        }
                        else
                        {
                            <time>Sin fecha</time>
                        }
                    </div>
                </article>
            }
        </div>
        <div class="crm-empty crm-empty--small" data-activity-empty hidden>
            <strong>No hay actividades para mostrar</strong>
            <span>Registra una llamada, reunión o tarea de seguimiento.</span>
        </div>
        @if (Model.Activities.HasPrevious || Model.Activities.HasNext)
        {
            <nav class="crm-pagination" aria-label="Paginación de actividades">
                @if (Model.Activities.HasPrevious)
                {
                    <a href="@CrmPageUrl(activityPage: Model.Activities.Page - 1)">Anterior</a>
                }
                else
                {
                    <span aria-disabled="true">Anterior</span>
                }
                <strong>Página @Model.Activities.Page · @Model.Activities.TotalCount actividades</strong>
                @if (Model.Activities.HasNext)
                {
                    <a href="@CrmPageUrl(activityPage: Model.Activities.Page + 1)">Siguiente</a>
                }
                else
                {
                    <span aria-disabled="true">Siguiente</span>
                }
            </nav>
        }
    </section>
    </section>

        </div>
    </div>

    <div class="crm-drawer" data-company-drawer hidden>
        <button class="crm-drawer__backdrop" type="button" aria-label="Cerrar panel" data-close-company></button>
        <aside class="crm-drawer__panel" role="dialog" aria-modal="true" aria-labelledby="crmCompanyPanelTitle">
            <header class="crm-drawer__head">
                <div>
                    <span class="crm-eyebrow">Base comercial</span>
                    <h2 id="crmCompanyPanelTitle">Nueva empresa</h2>
                    <p>Registra una organización para iniciar su gestión comercial.</p>
                </div>
                <button class="crm-drawer__close" type="button" aria-label="Cerrar" data-close-company>×</button>
            </header>

            <div class="crm-status" data-company-status role="status" aria-live="polite" hidden></div>

            <form class="crm-form" data-company-form>
                <div class="crm-form__grid">
                    <label class="crm-field crm-field--wide">
                        <span>Nombre de la empresa *</span>
                        <input type="text"
                               name="Name"
                               maxlength="200"
                               minlength="2"
                               autocomplete="organization"
                               required
                               data-company-first-focus />
                    </label>
                    <label class="crm-field">
                        <span>NIT</span>
                        <input type="text" name="TaxId" maxlength="50" autocomplete="off" />
                    </label>
                    <label class="crm-field">
                        <span>Ciudad</span>
                        <input type="text" name="City" maxlength="100" autocomplete="address-level2" />
                    </label>
                    <label class="crm-field">
                        <span>Correo</span>
                        <input type="email" name="Email" maxlength="254" autocomplete="email" />
                    </label>
                    <label class="crm-field">
                        <span>Teléfono</span>
                        <input type="tel" name="Phone" maxlength="50" autocomplete="tel" />
                    </label>
                    <p class="crm-form-note crm-field--wide">La empresa se registrará como Lead. Podrá convertirse en cliente activo cuando exista una relación comercial vigente.</p>
                </div>

                <footer class="crm-drawer__footer">
                    <button class="crm-btn crm-btn--quiet" type="button" data-close-company>Cancelar</button>
                    <button class="crm-btn crm-btn--primary" type="submit" data-save-company>Crear empresa</button>
                </footer>
            </form>
        </aside>
    </div>

    <div class="crm-drawer" data-contact-drawer hidden>
        <button class="crm-drawer__backdrop" type="button" aria-label="Cerrar panel" data-close-contact></button>
        <aside class="crm-drawer__panel" role="dialog" aria-modal="true" aria-labelledby="crmContactPanelTitle">
            <header class="crm-drawer__head">
                <div>
                    <span class="crm-eyebrow">Base de clientes</span>
                    <h2 id="crmContactPanelTitle">Nuevo contacto</h2>
                    <p>Vincula una persona con una empresa existente.</p>
                </div>
                <button class="crm-drawer__close" type="button" aria-label="Cerrar" data-close-contact>×</button>
            </header>

            <div class="crm-status" data-contact-status role="status" aria-live="polite" hidden></div>

            <form class="crm-form" data-contact-form>
                <div class="crm-form__grid">
                    <label class="crm-field crm-field--wide">
                        <span>Empresa *</span>
                        <select name="CompanyId" required data-contact-first-focus data-contact-company>
                            <option value="">Selecciona una empresa</option>
                            @foreach (var company in Model.Companies.Items.OrderBy(company => company.Name))
                            {
                                <option value="@company.Id"
                                        data-company-lifecycle="@company.LifecycleValue"
                                        data-company-lifecycle-label="@company.LifecycleLabel">@company.Name · @company.LifecycleLabel</option>
                            }
                        </select>
                    </label>
                    <label class="crm-field">
                        <span>Nombre *</span>
                        <input type="text" name="FirstName" maxlength="150" minlength="2" autocomplete="given-name" required />
                    </label>
                    <label class="crm-field">
                        <span>Apellidos</span>
                        <input type="text" name="LastName" maxlength="150" autocomplete="family-name" />
                    </label>
                    <label class="crm-field">
                        <span>Correo</span>
                        <input type="email" name="Email" maxlength="254" autocomplete="email" data-contact-email />
                    </label>
                    <label class="crm-field">
                        <span>Teléfono</span>
                        <input type="tel" name="Phone" maxlength="50" autocomplete="tel" data-contact-phone />
                    </label>
                    <label class="crm-field">
                        <span>Cargo</span>
                        <input type="text" name="JobTitle" maxlength="150" autocomplete="organization-title" />
                    </label>
                    <label class="crm-field">
                        <span>Ciclo de vida *</span>
                        <select name="Lifecycle" required data-contact-lifecycle>
                            @foreach (var lifecycle in Model.ContactLifecycles)
                            {
                                if (lifecycle.Value == (int)CrmContactLifecycle.Customer)
                                {
                                    <option value="@lifecycle.Value" selected>@lifecycle.Label</option>
                                }
                                else
                                {
                                    <option value="@lifecycle.Value">@lifecycle.Label</option>
                                }
                            }
                        </select>
                        <small class="crm-field__help" data-contact-lifecycle-help>El ciclo se ajusta al tipo de empresa seleccionada.</small>
                    </label>
                    <div class="crm-field crm-field--wide">
                        <span>Preferencias</span>
                        <div class="crm-check-grid">
                            <label class="crm-check">
                                <input type="checkbox" name="IsPrimary" />
                                <span>Contacto principal</span>
                            </label>
                            <label class="crm-check">
                                <input type="checkbox" name="DoNotEmail" />
                                <span>No enviar correos</span>
                            </label>
                            <label class="crm-check">
                                <input type="checkbox" name="DoNotCall" />
                                <span>No llamar</span>
                            </label>
                        </div>
                        <small class="crm-field__help">Registra al menos un correo o un teléfono.</small>
                    </div>
                </div>

                <footer class="crm-drawer__footer">
                    <button class="crm-btn crm-btn--quiet" type="button" data-close-contact>Cancelar</button>
                    <button class="crm-btn crm-btn--primary" type="submit" data-save-contact>Crear contacto</button>
                </footer>
            </form>
        </aside>
    </div>

    <partial name="_CrmDealDrawer" />

    <dialog class="crm-loss-dialog"
            data-loss-dialog
            aria-labelledby="crmLossDialogTitle"
            aria-describedby="crmLossDialogDescription">
        <form class="crm-loss-dialog__card" data-loss-form>
            <header class="crm-loss-dialog__head">
                <div>
                    <span class="crm-eyebrow">Cerrar oportunidad</span>
                    <h2 id="crmLossDialogTitle">Registrar negocio perdido</h2>
                </div>
                <button class="crm-drawer__close" type="button" aria-label="Cancelar cambio de etapa" data-cancel-loss>×</button>
            </header>

            <div class="crm-loss-dialog__body">
                <p id="crmLossDialogDescription">
                    Indica por qué se perdió <strong data-loss-deal-name>este negocio</strong>. Esta información quedará en su historial.
                </p>
                <div class="crm-status" data-loss-status role="status" aria-live="polite" hidden></div>
                <label class="crm-field">
                    <span>Motivo de pérdida *</span>
                    <textarea name="Reason"
                              rows="4"
                              maxlength="1000"
                              required
                              data-loss-reason
                              aria-describedby="crmLossReasonHelp"
                              placeholder="Ej. El cliente eligió otra propuesta por precio"></textarea>
                </label>
                <small id="crmLossReasonHelp" class="crm-field__help">Sé concreto para facilitar el análisis comercial posterior.</small>
            </div>

            <footer class="crm-loss-dialog__footer">
                <button class="crm-btn crm-btn--quiet" type="button" data-cancel-loss>Cancelar</button>
                <button class="crm-btn crm-btn--primary" type="submit" data-confirm-loss>Guardar y cerrar negocio</button>
            </footer>
        </form>
    </dialog>

    <div class="crm-drawer" data-activity-drawer hidden>
        <button class="crm-drawer__backdrop" type="button" aria-label="Cerrar panel" data-close-activity></button>
        <aside class="crm-drawer__panel" role="dialog" aria-modal="true" aria-labelledby="crmActivityPanelTitle">
            <header class="crm-drawer__head">
                <div>
                    <span class="crm-eyebrow">Seguimiento comercial</span>
                    <h2 id="crmActivityPanelTitle">Nueva actividad</h2>
