    <section class="crm-view"
             id="crm-empresas"
             data-crm-view="empresas"
             aria-labelledby="crmNavEmpresas"
             hidden>
    <div class="crm-directory crm-directory--single" id="crmEmpresas">
        <section class="crm-panel crm-directory-card" aria-labelledby="crmCompaniesTitle">
            <div class="crm-section-head crm-section-head--compact">
                <div>
                    <span class="crm-eyebrow">Base comercial</span>
                    <h2 id="crmCompaniesTitle">Empresas</h2>
                </div>
                <div class="crm-section-head__actions crm-section-head__actions--companies">
