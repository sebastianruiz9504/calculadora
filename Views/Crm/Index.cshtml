                        <span class="visually-hidden">Filtrar empresas por tipo</span>
                        <select data-company-lifecycle-filter>
                            <option value="">Todas las empresas</option>
                            <option value="@((int)CrmCompanyLifecycle.Lead)">Leads</option>
                            <option value="@((int)CrmCompanyLifecycle.ActiveCustomer)">Clientes activos</option>
                            <option value="@((int)CrmCompanyLifecycle.Inactive)">Inactivas</option>
                        </select>
