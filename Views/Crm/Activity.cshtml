@model CotizadorInterno.Web.Models.Crm.CrmActivityDetailViewModel
@using System.Globalization
@using CotizadorInterno.Web.Models.Crm
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = Model.Activity.Subject;
    var culture = CultureInfo.GetCultureInfo("es-CO");
    TimeZoneInfo BogotaTimeZone()
    {
        foreach (var id in new[] { "SA Pacific Standard Time", "America/Bogota" })
        {
            try
            {
                return TimeZoneInfo.FindSystemTimeZoneById(id);
            }
            catch (TimeZoneNotFoundException)
            {
            }
            catch (InvalidTimeZoneException)
            {
            }
        }

        return TimeZoneInfo.Utc;
    }
    var bogotaTimeZone = BogotaTimeZone();
    DateTimeOffset InBogota(DateTimeOffset value) =>
        TimeZoneInfo.ConvertTime(value, bogotaTimeZone);
    string DateTimeLabel(DateTimeOffset? value) =>
        value.HasValue
            ? InBogota(value.Value).ToString("dd MMM yyyy · HH:mm", culture)
            : "Sin registro";
    string ShortDateTimeLabel(DateTimeOffset? value) =>
        value.HasValue
            ? InBogota(value.Value).ToString("dd MMM", culture)
            : "—";
    string CrmDetailUrlTemplate(string action)
    {
        var sentinel = Guid.Empty.ToString("D");
        return (Url.Action(
                action,
                "Crm",
                new
                {
                    id = Guid.Empty,
                    ViewAsOwnerId = Model.Access.ViewAsOwnerId
                }) ?? "")
            .Replace(sentinel, "__id__", StringComparison.Ordinal);
    }
    var companyId = Model.Company?.Id ?? Model.Activity.CompanyId;
    var companyName = Model.Company?.Name ?? Model.Activity.CompanyName;
    var contactId = Model.Contact?.Id ?? Model.Activity.ContactId;
    var contactName = Model.Contact?.FullName ?? Model.Activity.ContactName;
    var dealId = Model.Deal?.Id ?? Model.Activity.DealId;
    var dealName = Model.Deal?.Name ?? Model.Activity.DealName;
    ViewData["CrmAllowContact"] = false;
    ViewData["CrmCompanyId"] = companyId;
    ViewData["CrmCompanyName"] = companyName;
    ViewData["CrmContactId"] = contactId;
    ViewData["CrmContactName"] = contactName;
    ViewData["CrmDealId"] = dealId;
    ViewData["CrmDealName"] = dealName;
    ViewData["CrmIsAdministrator"] = Model.Access.IsAdministrator;
    ViewData["CrmViewAsOwnerId"] = Model.Access.ViewAsOwnerId;
    ViewData["CrmScopeOptions"] = Model.Access.Owners
        .Select(owner => new SelectListItem
        {
            Value = owner.Id,
            Text = string.IsNullOrWhiteSpace(owner.Email)
                ? owner.Name
                : $"{owner.Name} · {owner.Email}",
            Selected = string.Equals(owner.Id, Model.Access.ViewAsOwnerId, StringComparison.OrdinalIgnoreCase)
        })
        .ToList();
    ViewData["CrmObjectType"] = "Activity";
    ViewData["CrmRecordId"] = Model.Activity.Id;
    ViewData["CrmCurrentOwnerName"] = Model.Activity.Audit.OwnerName;
    ViewData["CrmOwnerOptions"] = Model.Access.Owners
        .Select(owner => new SelectListItem
        {
            Value = owner.Id,
            Text = string.IsNullOrWhiteSpace(owner.Email)
                ? owner.Name
                : $"{owner.Name} · {owner.Email}",
            Selected = string.Equals(owner.Id, Model.Activity.Audit.OwnerId, StringComparison.OrdinalIgnoreCase)
        })
        .ToList();
}

@section Styles {
    <link rel="stylesheet" href="~/css/crm.css" asp-append-version="true" />
}

<div class="crm-app crm-detail-app"
     id="crmDetailApp"
     data-record-type="activity"
     data-create-contact-url="@Url.Action("CreateContact", "Crm", new { ViewAsOwnerId = Model.Access.ViewAsOwnerId })"
     data-create-activity-url="@Url.Action("CreateActivity", "Crm", new { ViewAsOwnerId = Model.Access.ViewAsOwnerId })"
     data-update-owner-url="@Url.Action("UpdateOwner", "Crm", new { ViewAsOwnerId = Model.Access.ViewAsOwnerId })"
     data-crm-index-url="@Url.Action("Index", "Crm", new { ViewAsOwnerId = Model.Access.ViewAsOwnerId })"
     data-contact-detail-url-template="@CrmDetailUrlTemplate("Contact")"
     data-activity-detail-url-template="@CrmDetailUrlTemplate("Activity")"
     data-view-as-owner-id="@Model.Access.ViewAsOwnerId"
     data-planned-activity-status="@((int)CrmActivityStatus.Planned)"
     data-completed-activity-status="@((int)CrmActivityStatus.Completed)"
     data-meeting-activity-type="@((int)CrmActivityType.Meeting)">
    @Html.AntiForgeryToken()

    <div class="crm-workspace">
        <partial name="_CrmSidebar" model="@("actividades")" />

        <main class="crm-workspace__main">
            <nav class="crm-breadcrumb" aria-label="Ruta de navegación">
                <a asp-action="Index"
                   asp-controller="Crm"
                   asp-route-viewAsOwnerId="@Model.Access.ViewAsOwnerId"
                   asp-fragment="crm-actividades">Actividades</a>
                <span aria-hidden="true">/</span>
                <span aria-current="page">@Model.Activity.Subject</span>
            </nav>

            <partial name="_CrmScopeSelector" />

            <header class="crm-record-header">
                <div class="crm-record-header__identity">
                    <span class="crm-record-header__mark" aria-hidden="true">A</span>
                    <div>
                        <span class="crm-eyebrow">@Model.Activity.TypeDisplayLabel</span>
                        <div class="crm-record-header__title">
                            <h1>@Model.Activity.Subject</h1>
                            <span class="crm-record-status">@Model.Activity.StatusLabel</span>
                        </div>
                        <p>@(string.IsNullOrWhiteSpace(dealName) ? (string.IsNullOrWhiteSpace(contactName) ? companyName : contactName) : dealName)</p>
                    </div>
                </div>
                <div class="crm-record-header__actions">
                    <button class="crm-btn crm-btn--primary" type="button" data-detail-open-activity>Nuevo seguimiento</button>
                </div>
            </header>

            <div class="crm-status" data-detail-global-status role="status" aria-live="polite" hidden></div>

            <section class="crm-record-metrics" aria-label="Resumen de la actividad">
                <article><span>Tipo</span><strong>@Model.Activity.TypeDisplayLabel</strong><small>Actividad comercial</small></article>
                <article><span>Duración</span><strong>@(Model.Activity.DurationMinutes.HasValue ? $"{Model.Activity.DurationMinutes} min" : "—")</strong><small>Tiempo registrado</small></article>
                <article><span>Fecha principal</span><strong>@ShortDateTimeLabel(Model.Activity.CompletedAtUtc ?? Model.Activity.PlannedAtUtc)</strong><small>@(Model.Activity.CompletedAtUtc.HasValue ? "Completada" : "Planeada")</small></article>
            </section>

            <div class="crm-record-layout">
                <div class="crm-record-layout__main">
                    <section class="crm-record-card" aria-labelledby="activityGeneralTitle">
                        <header class="crm-record-card__head">
                            <div>
                                <span class="crm-eyebrow">Hoja de vida</span>
                                <h2 id="activityGeneralTitle">Información general</h2>
                            </div>
                        </header>
                        <dl class="crm-fact-grid">
                            <div><dt>Tipo</dt><dd>@Model.Activity.TypeLabel</dd></div>
                            @if (Model.Activity.MeetingTypeValue.HasValue)
                            {
                                <div><dt>Tipo de reunión</dt><dd>@Model.Activity.MeetingTypeLabel</dd></div>
                            }
                            <div><dt>Estado</dt><dd>@Model.Activity.StatusLabel</dd></div>
                            <div><dt>Fecha planeada</dt><dd>@DateTimeLabel(Model.Activity.PlannedAtUtc)</dd></div>
                            <div><dt>Fecha completada</dt><dd>@DateTimeLabel(Model.Activity.CompletedAtUtc)</dd></div>
                            <div><dt>Duración</dt><dd>@(Model.Activity.DurationMinutes.HasValue ? $"{Model.Activity.DurationMinutes} minutos" : "Sin duración registrada")</dd></div>
                            <div><dt>Última actualización</dt><dd>@DateTimeLabel(Model.Activity.Audit.ModifiedAtUtc)</dd></div>
                            <div class="crm-fact-grid__wide"><dt>Resultado</dt><dd>@(string.IsNullOrWhiteSpace(Model.Activity.Result) ? "Sin resultado registrado" : Model.Activity.Result)</dd></div>
                            <div class="crm-fact-grid__wide"><dt>Notas</dt><dd>@(string.IsNullOrWhiteSpace(Model.Activity.Notes) ? "Sin notas registradas" : Model.Activity.Notes)</dd></div>
                        </dl>
                    </section>

                    <section class="crm-association-card" aria-labelledby="activityRelationsTitle">
                        <header class="crm-association-card__head">
                            <div><h2 id="activityRelationsTitle">Objetos asociados</h2><span>Contexto comercial de la actividad</span></div>
                        </header>
                        <div class="crm-related-objects">
                            @if (Model.Company is not null)
                            {
                                <article>
                                    <span>Empresa</span>
                                    <a asp-action="Company"
                                       asp-controller="Crm"
                                       asp-route-id="@Model.Company.Id"
                                       asp-route-viewAsOwnerId="@Model.Access.ViewAsOwnerId">@Model.Company.Name</a>
                                    <small>@Model.Company.LifecycleLabel</small>
                                </article>
                            }
                            @if (Model.Contact is not null)
                            {
                                <article>
                                    <span>Contacto</span>
                                    <a asp-action="Contact"
                                       asp-controller="Crm"
                                       asp-route-id="@Model.Contact.Id"
                                       asp-route-viewAsOwnerId="@Model.Access.ViewAsOwnerId">@Model.Contact.FullName</a>
                                    <small>@(string.IsNullOrWhiteSpace(Model.Contact.JobTitle) ? "Sin cargo registrado" : Model.Contact.JobTitle)</small>
                                </article>
                            }
                            @if (Model.Deal is not null)
                            {
                                <article>
                                    <span>Negocio</span>
                                    <a asp-action="Deal"
                                       asp-controller="Crm"
                                       asp-route-id="@Model.Deal.Id"
                                       asp-route-viewAsOwnerId="@Model.Access.ViewAsOwnerId">@Model.Deal.Name</a>
                                    <small>@Model.Deal.StageLabel</small>
                                </article>
                            }
                            @if (Model.Company is null && Model.Contact is null && Model.Deal is null)
                            {
                                <div class="crm-association-empty"><strong>Sin asociaciones disponibles</strong><span>Los registros relacionados no están accesibles.</span></div>
                            }
                        </div>
                    </section>

                    <section class="crm-association-card" aria-labelledby="relatedActivitiesTitle">
                        <header class="crm-association-card__head">
                            <div><h2 id="relatedActivitiesTitle">Otras actividades</h2><span>@Model.RelatedActivities.TotalCount relacionadas</span></div>
                            <button class="crm-association-card__action" type="button" data-detail-open-activity>Nuevo seguimiento</button>
                        </header>
                        @if (Model.RelatedActivities.Items.Count == 0)
                        {
                            <div class="crm-association-empty"><strong>Sin más actividad</strong><span>Crea un seguimiento conservando las relaciones actuales.</span></div>
                        }
                        else
                        {
                            <div class="crm-timeline">
                                @foreach (var activity in Model.RelatedActivities.Items)
                                {
                                    <article class="crm-timeline__item">
                                        <span class="crm-timeline__marker" aria-hidden="true"></span>
                                        <div>
                                            <a asp-action="Activity"
                                               asp-controller="Crm"
                                               asp-route-id="@activity.Id"
                                               asp-route-viewAsOwnerId="@Model.Access.ViewAsOwnerId">@activity.Subject</a>
                                            <p>@activity.TypeDisplayLabel · @activity.StatusLabel</p>
                                        </div>
                                        <time datetime="@((activity.CompletedAtUtc ?? activity.PlannedAtUtc)?.ToString("O"))">
                                            @DateTimeLabel(activity.CompletedAtUtc ?? activity.PlannedAtUtc)
                                        </time>
                                    </article>
                                }
                            </div>
                        }
                        @if (Model.RelatedActivities.HasPrevious || Model.RelatedActivities.HasNext)
                        {
                            <nav class="crm-detail-pagination" aria-label="Paginación de actividades relacionadas">
                                @if (Model.RelatedActivities.HasPrevious)
                                {
                                    <a asp-action="Activity" asp-route-id="@Model.Activity.Id"
                                       asp-route-activityPage="@(Model.RelatedActivities.Page - 1)"
                                       asp-route-viewAsOwnerId="@Model.Access.ViewAsOwnerId"
                                       asp-route-pageSize="@Model.Query.PageSize">Anterior</a>
                                }
                                else
                                {
                                    <span aria-disabled="true">Anterior</span>
                                }
                                <span>Página @Model.RelatedActivities.Page</span>
                                @if (Model.RelatedActivities.HasNext)
                                {
                                    <a asp-action="Activity" asp-route-id="@Model.Activity.Id"
                                       asp-route-activityPage="@(Model.RelatedActivities.Page + 1)"
                                       asp-route-viewAsOwnerId="@Model.Access.ViewAsOwnerId"
                                       asp-route-pageSize="@Model.Query.PageSize">Siguiente</a>
                                }
                                else
                                {
                                    <span aria-disabled="true">Siguiente</span>
                                }
                            </nav>
                        }
                    </section>
                </div>

                <aside class="crm-record-layout__rail" aria-label="Auditoría del registro">
                    <section class="crm-record-card crm-audit-card">
                        <span class="crm-eyebrow">Auditoría</span>
                        <h2>Historial del registro</h2>
                        <dl>
                            <div>
                                <dt>Propietario</dt>
                                <dd><partial name="_CrmOwnerField" /></dd>
                            </div>
                            <div><dt>Creado por</dt><dd>@(string.IsNullOrWhiteSpace(Model.Activity.Audit.CreatedByName) ? "Sin registro" : Model.Activity.Audit.CreatedByName)</dd></div>
                            <div><dt>Creación</dt><dd>@DateTimeLabel(Model.Activity.Audit.CreatedAtUtc)</dd></div>
                            <div><dt>Modificado por</dt><dd>@(string.IsNullOrWhiteSpace(Model.Activity.Audit.ModifiedByName) ? "Sin registro" : Model.Activity.Audit.ModifiedByName)</dd></div>
                            <div><dt>Última modificación</dt><dd>@DateTimeLabel(Model.Activity.Audit.ModifiedAtUtc)</dd></div>
                        </dl>
                    </section>
                </aside>
            </div>
        </main>
    </div>

    <partial name="_CrmDetailDrawers" />
</div>

@section Scripts {
    <script src="~/js/crm-detail.js" asp-append-version="true"></script>
}
