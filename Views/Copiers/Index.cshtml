@model CotizadorInterno.Web.Models.Copiers.CopiersPageViewModel
@{
    ViewData["Title"] = "Copiers";
    var canEditPreventiveMaintenanceFrequency = CotizadorInterno.Web.Models.Copiers.CopiersAccessPolicy.CanEditPreventiveMaintenanceFrequency(Model.CurrentUser);
}

@section Styles {
    <link rel="stylesheet" href="~/css/copiers.css" asp-append-version="true" />
}

<div class="copiers-shell"
     id="copiersApp"
     data-maintenance-url="@Url.Action("Maintenance", "Copiers")"
     data-save-maintenance-url="@Url.Action("SaveMaintenance", "Copiers")"
     data-upload-maintenance-url="@Url.Action("UploadMaintenanceAttachment", "Copiers")"
     data-download-maintenance-url="@Url.Action("DownloadMaintenanceAttachment", "Copiers")"
     data-preventive-maintenance-url="@Url.Action("PreventiveMaintenance", "Copiers")"
     data-preventive-maintenance-frequency-url="@Url.Action("PreventiveMaintenanceFrequency", "Copiers")"
     data-schedule-preventive-maintenance-url="@Url.Action("SchedulePreventiveMaintenance", "Copiers")"
     data-calendar-consent-url="@Url.Action("CalendarConsent", "Copiers")"
     data-save-counter-url="@Url.Action("SaveCounter", "Copiers")"
     data-upload-counter-url="@Url.Action("UploadCounterAttachment", "Copiers")"
     data-equipment-url="@Url.Action("Equipment", "Copiers")"
     data-equipment-detail-url="@Url.Action("EquipmentDetail", "Copiers")"
     data-equipment-inventory-url="@Url.Action("EquipmentInventory", "Copiers")"
     data-equipment-backup-assignment-url="@Url.Action("EquipmentBackupAssignment", "Copiers")"
     data-equipment-assignment-url="@Url.Action("EquipmentAssignment", "Copiers")"
     data-save-equipment-url="@Url.Action("SaveEquipment", "Copiers")"
     data-register-equipment-movement-url="@Url.Action("RegisterEquipmentMovement", "Copiers")"
     data-upload-equipment-movement-url="@Url.Action("UploadEquipmentMovementAttachment", "Copiers")"
     data-download-equipment-movement-url="@Url.Action("DownloadEquipmentMovementAttachment", "Copiers")"
     data-save-equipment-client-url="@Url.Action("SaveEquipmentClient", "Copiers")"
     data-supplies-url="@Url.Action("Supplies", "Copiers")"
     data-save-supply-quantity-url="@Url.Action("SaveSupplyQuantity", "Copiers")"
     data-pending-invoices-url="@Url.Action("PendingSupplierInvoices", "Copiers")"
     data-approve-invoice-url="@Url.Action("ApproveSupplierInvoice", "Copiers")"
     data-deliveries-url="@Url.Action("Deliveries", "Copiers")"
     data-save-delivery-url="@Url.Action("SaveDelivery", "Copiers")"
     data-upload-delivery-url="@Url.Action("UploadDeliveryAttachment", "Copiers")"
     data-download-delivery-url="@Url.Action("DownloadDeliveryAttachment", "Copiers")"
     data-billing-days-url="@Url.Action("BillingDays", "Copiers")"
     data-equipment-movements-url="@Url.Action("EquipmentMovements", "Copiers")"
     data-line-equipment-assignment-url="@Url.Action("LineEquipmentAssignment", "Copiers")"
     data-line-equipment-assignment-save-url="@Url.Action("LineEquipmentAssignment", "Copiers")"
     data-client-search-url="@Url.Action("ClientSearch", "Copiers")"
     data-can-edit-preventive-frequency="@canEditPreventiveMaintenanceFrequency.ToString().ToLowerInvariant()">
    <section class="copiers-hero">
        <div>
            <div class="copiers-kicker">Operacion</div>
            <h1 class="copiers-title">Copiers</h1>
            <p class="copiers-subtitle">Mantenimientos, equipos, inventario de suministros y entregas en una sola vista operativa.</p>
        </div>
        <div class="copiers-user-pill">
            <span class="copiers-user-pill__label">Usuario</span>
            <span>@Model.CurrentUser.Email</span>
        </div>
    </section>

    <div id="copiersStatus" class="copiers-status" role="status" aria-live="polite"></div>

    <nav class="copiers-tabs" aria-label="Submodulos Copiers">
        <button type="button" class="copiers-tab is-active" data-copiers-tab="maintenance">Mantenimientos</button>
        <button type="button" class="copiers-tab" data-copiers-tab="preventiveMaintenance">Mantenimientos Preventivos</button>
        <button type="button" class="copiers-tab" data-copiers-tab="billingDays">D&iacute;as de facturaci&oacute;n</button>
        <button type="button" class="copiers-tab" data-copiers-tab="movements">Movimientos</button>
        <button type="button" class="copiers-tab" data-copiers-tab="equipment" hidden>Equipos</button>
        <button type="button" class="copiers-tab" data-copiers-tab="equipmentInventory">Inventario equipos</button>
        <button type="button" class="copiers-tab" data-copiers-tab="supplies">Inventario suministros</button>
        <button type="button" class="copiers-tab" data-copiers-tab="deliveries">Entregas</button>
    </nav>

    <section class="copiers-panel is-active" data-copiers-panel="maintenance">
        <div class="copiers-panel__header">
            <div>
                <div class="copiers-kicker">Mis mantenimientos</div>
                <h2 class="copiers-section-title">Mantenimientos asignados</h2>
            </div>
            <div class="copiers-panel__actions">
                <span class="copiers-counter" id="copiersMaintenanceCount">0 registros</span>
                <button type="button" class="btn btn-outline-secondary" id="copiersMaintenanceRefreshBtn">Actualizar</button>
                <a class="btn btn-success" asp-controller="CopiersMtoV2" asp-action="Index">MTO firmado V2</a>
                <button type="button" class="btn btn-primary" id="copiersNewMaintenanceBtn">Nuevo mantenimiento</button>
            </div>
        </div>
        <div class="copiers-table-wrap">
            <table class="table align-middle copiers-table copiers-table--maintenance">
                <thead>
                    <tr>
                        <th>Equipo</th>
                        <th>Cliente</th>
                        <th>Fecha</th>
                        <th>Tipo</th>
                        <th>Estado</th>
                        <th>Tecnico</th>
                        <th>Reporte</th>
                        <th>Descripcion</th>
                    </tr>
                </thead>
                <tbody id="copiersMaintenanceBody"></tbody>
            </table>
        </div>
        <div class="copiers-empty" id="copiersMaintenanceEmpty" hidden>No hay mantenimientos propios para mostrar.</div>
    </section>

    <section class="copiers-panel" data-copiers-panel="preventiveMaintenance" hidden>
        <div class="copiers-panel__header">
            <div>
                <div class="copiers-kicker">Preventivos</div>
                <h2 class="copiers-section-title">Mantenimientos Preventivos</h2>
            </div>
            <div class="copiers-panel__actions">
                <div class="copiers-segmented" aria-label="Periodo de validacion">
                    <button type="button" class="is-active" data-copiers-preventive-period="this-month">Mes vigente</button>
                    <button type="button" data-copiers-preventive-period="previous-month">Mes pasado</button>
                </div>
                <span class="copiers-counter" id="copiersPreventiveCount">0 clientes</span>
                <button type="button" class="btn btn-outline-secondary" id="copiersPreventiveRefreshBtn">Actualizar</button>
            </div>
        </div>
        <div class="copiers-table-wrap">
            <table class="table align-middle copiers-table copiers-table--preventive">
                <thead>
                    <tr>
                        <th>Cliente</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody id="copiersPreventiveBody"></tbody>
            </table>
        </div>
        <div class="copiers-empty" id="copiersPreventiveEmpty" hidden>No hay clientes con productos copiers para mostrar.</div>
    </section>

    <section class="copiers-panel" data-copiers-panel="billingDays" hidden>
        <div class="copiers-panel__header">
            <div>
                <div class="copiers-kicker">Clientes</div>
                <h2 class="copiers-section-title">D&iacute;as de facturaci&oacute;n</h2>
            </div>
            <div class="copiers-panel__actions">
                <span class="copiers-counter" id="copiersBillingDaysCount">0 registros</span>
                <button type="button" class="btn btn-outline-secondary" id="copiersBillingDaysRefreshBtn">Actualizar</button>
            </div>
        </div>
        <div class="copiers-table-wrap">
            <table class="table align-middle copiers-table copiers-table--billing-days">
                <thead>
                    <tr>
                        <th>D&iacute;a fact.</th>
                        <th>Cliente</th>
                        <th>L&iacute;neas</th>
                        <th class="text-end">Cantidad</th>
                        <th>Equipos</th>
                        <th class="text-end">Detalle</th>
                    </tr>
                </thead>
                <tbody id="copiersBillingDaysBody">
                    <tr>
                        <td colspan="6" class="text-center copiers-muted">Abre D&iacute;as de facturaci&oacute;n para cargar los clientes.</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="copiers-empty" id="copiersBillingDaysEmpty" hidden>No hay registros de facturaci&oacute;n copiers disponibles.</div>
    </section>

    <section class="copiers-panel" data-copiers-panel="movements" hidden>
        <div class="copiers-panel__header">
            <div>
                <div class="copiers-kicker">Movimientos</div>
                <h2 class="copiers-section-title">Movimientos de equipos</h2>
            </div>
            <div class="copiers-panel__actions">
                <span class="copiers-counter" id="copiersMovementsCount">0 registros</span>
                <label class="copiers-search copiers-search--compact" for="copiersMovementsSearch">
                    <span>Buscar</span>
                    <input class="form-control" id="copiersMovementsSearch" type="search" placeholder="Filtrar movimientos..." autocomplete="off" />
                </label>
                <button type="button" class="btn btn-outline-secondary" id="copiersMovementsRefreshBtn">Actualizar</button>
            </div>
        </div>
        <div class="copiers-table-wrap">
            <table class="table align-middle copiers-table copiers-table--movements">
                <thead>
                    <tr>
                        <th><button type="button" class="copiers-sort" data-copiers-movement-sort="dateValue">Fecha movimiento</button></th>
                        <th><button type="button" class="copiers-sort" data-copiers-movement-sort="equipmentSerial">Equipo</button></th>
                        <th><button type="button" class="copiers-sort" data-copiers-movement-sort="clientName">Cliente nuevo</button></th>
                        <th><button type="button" class="copiers-sort" data-copiers-movement-sort="reason">Motivo movimiento</button></th>
                        <th><button type="button" class="copiers-sort" data-copiers-movement-sort="attachment">Acta de entrega</button></th>
                    </tr>
                </thead>
                <tbody id="copiersMovementsBody">
                    <tr>
                        <td colspan="5" class="text-center copiers-muted">Abre Movimientos para cargar el historial de reasignaciones.</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="copiers-empty" id="copiersMovementsEmpty" hidden>No hay movimientos de equipos registrados.</div>
    </section>

    <section class="copiers-panel" data-copiers-panel="equipment" hidden>
        <div class="copiers-panel__header">
            <div>
                <div class="copiers-kicker">Equipos</div>
                <h2 class="copiers-section-title">Equipos por cliente y stock</h2>
            </div>
            <div class="copiers-panel__actions">
                <label class="copiers-search" for="copiersEquipmentSerialSearch">
                    <span>Serial</span>
                    <input class="form-control" id="copiersEquipmentSerialSearch" type="search" placeholder="Buscar serial..." autocomplete="off" />
                </label>
                <span class="copiers-counter" id="copiersEquipmentCount">0 equipos</span>
                <button type="button" class="btn btn-outline-secondary" id="copiersEquipmentRefreshBtn">Actualizar</button>
            </div>
        </div>
        <div class="copiers-kpis" id="copiersEquipmentKpis"></div>
        <div class="copiers-grid copiers-grid--single">
            <section class="copiers-subpanel">
                <div class="copiers-subpanel__header">
                    <h3>Clientes</h3>
                </div>
                <div class="copiers-table-wrap copiers-table-wrap--compact">
                    <table class="table align-middle copiers-table copiers-table--equipment-clients">
                        <thead>
                            <tr>
                                <th>Cliente</th>
                                <th>Persona a cargo</th>
                                <th>Correo</th>
                                <th>Telefono</th>
                                <th>Direccion</th>
                                <th class="text-end">Equipos</th>
                                <th>Categorias</th>
                            </tr>
                        </thead>
                        <tbody id="copiersEquipmentClientsBody"></tbody>
                    </table>
                </div>
            </section>
            <section class="copiers-subpanel">
                <div class="copiers-subpanel__header">
                    <h3>Stock</h3>
                </div>
                <div class="copiers-table-wrap copiers-table-wrap--compact">
                    <table class="table align-middle copiers-table copiers-table--equipment-stock">
                        <thead>
                            <tr>
                                <th>Serial</th>
                                <th>Categoria</th>
                                <th>Referencia</th>
                            </tr>
                        </thead>
                        <tbody id="copiersEquipmentStockBody"></tbody>
                    </table>
                </div>
            </section>
        </div>
        <section class="copiers-subpanel">
            <div class="copiers-subpanel__header">
                <h3>Inventario operativo</h3>
            </div>
            <div class="copiers-table-wrap">
                <table class="table align-middle copiers-table copiers-table--equipment">
                    <thead>
                        <tr>
                            <th>Serial</th>
                            <th>Cliente</th>
                            <th>Categoria</th>
                            <th>Area</th>
                            <th>Sede</th>
                            <th>Referencia</th>
                            <th>Observaciones</th>
                        </tr>
                    </thead>
                    <tbody id="copiersEquipmentBody"></tbody>
                </table>
            </div>
        </section>
    </section>

    <section class="copiers-panel" data-copiers-panel="equipmentInventory" hidden>
        <div class="copiers-panel__header">
            <div>
                <div class="copiers-kicker">Inventario equipos</div>
                <h2 class="copiers-section-title">Inventario por cliente</h2>
            </div>
            <div class="copiers-panel__actions">
                <label class="copiers-search" for="copiersInventoryClientName">
                    <span>Cliente</span>
                    <input class="form-control" id="copiersInventoryClientName" list="copiersInventoryClientOptions" autocomplete="off" placeholder="Buscar cliente..." />
                    <datalist id="copiersInventoryClientOptions"></datalist>
                </label>
                <input type="hidden" id="copiersInventoryClientId" />
                <span class="copiers-counter" id="copiersInventoryCount">0 equipos</span>
                <button type="button" class="btn btn-outline-secondary" id="copiersInventoryClearBtn">Limpiar</button>
                <button type="button" class="btn btn-primary" id="copiersInventoryLoadBtn">Consultar</button>
            </div>
        </div>
        <div class="copiers-status" id="copiersInventoryMissing" role="status" aria-live="polite"></div>
        <div class="copiers-kpis" id="copiersInventoryKpis"></div>
        <div class="copiers-contract-lines" id="copiersInventoryContractLines"></div>
        <div class="copiers-location-grid" id="copiersInventoryLocations"></div>
        <div class="copiers-table-wrap">
            <table class="table align-middle copiers-table copiers-table--equipment-inventory">
                <thead>
                    <tr>
                        <th>No.</th>
                        <th>Serial de maquina</th>
                        <th>Empresa</th>
                        <th>Clasificaci&oacute;n</th>
                        <th>Producto contratado</th>
                        <th class="text-end">Operaciones incl.</th>
                        <th>Area</th>
                        <th>Sede</th>
                        <th>Observaciones</th>
                        <th class="text-end">Backup</th>
                    </tr>
                </thead>
                <tbody id="copiersInventoryBody"></tbody>
            </table>
        </div>
        <div class="copiers-empty" id="copiersInventoryEmpty">Selecciona un cliente para consultar sus equipos.</div>
    </section>

    <section class="copiers-panel" data-copiers-panel="supplies" hidden>
        <div class="copiers-panel__header">
            <div>
                <div class="copiers-kicker">Inventario suministros</div>
                <h2 class="copiers-section-title">Suministros disponibles</h2>
            </div>
            <div class="copiers-panel__actions">
                <span class="copiers-counter" id="copiersSuppliesCount">0 suministros</span>
                <button type="button" class="btn btn-outline-secondary" id="copiersSuppliesRefreshBtn">Actualizar</button>
                <button type="button" class="btn btn-primary" id="copiersNewIngresoBtn">Nuevo ingreso</button>
            </div>
        </div>
        <div class="copiers-table-wrap">
            <table class="table align-middle copiers-table copiers-table--supplies">
                <thead>
                    <tr>
                        <th>Referencia</th>
                        <th class="text-end">Cantidad</th>
                        <th>Ultima compra</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody id="copiersSuppliesBody"></tbody>
            </table>
        </div>
        <div class="copiers-empty" id="copiersSuppliesEmpty" hidden>No hay suministros registrados.</div>
    </section>

    <section class="copiers-panel" data-copiers-panel="deliveries" hidden>
        <div class="copiers-panel__header">
            <div>
                <div class="copiers-kicker">Mis entregas</div>
                <h2 class="copiers-section-title">Entregas registradas</h2>
            </div>
            <div class="copiers-panel__actions">
                <span class="copiers-counter" id="copiersDeliveriesCount">0 entregas</span>
                <button type="button" class="btn btn-outline-secondary" id="copiersDeliveriesRefreshBtn">Actualizar</button>
                <button type="button" class="btn btn-primary" id="copiersNewDeliveryBtn">Nueva entrega</button>
            </div>
        </div>
        <div class="copiers-table-wrap">
            <table class="table align-middle copiers-table copiers-table--deliveries">
                <thead>
                    <tr>
                        <th>Cliente</th>
                        <th>Suministro</th>
                        <th>Fecha</th>
                        <th class="text-end">Cantidad</th>
                        <th>Estado</th>
                        <th>Comprobante</th>
                        <th>Owner</th>
                    </tr>
                </thead>
                <tbody id="copiersDeliveriesBody"></tbody>
            </table>
        </div>
        <div class="copiers-empty" id="copiersDeliveriesEmpty" hidden>No hay entregas propias para mostrar.</div>
    </section>
</div>

<div class="copiers-modal" id="copiersLineEquipmentModal" hidden>
    <div class="copiers-modal__backdrop" data-copiers-close="lineEquipment"></div>
    <div class="copiers-modal__dialog copiers-modal__dialog--wide" role="dialog" aria-modal="true" aria-labelledby="copiersLineEquipmentTitle">
        <div class="copiers-modal__header">
            <div>
                <div class="copiers-kicker">Asignaci&oacute;n de equipos</div>
                <h2 class="copiers-modal__title" id="copiersLineEquipmentTitle">Equipos de la l&iacute;nea</h2>
                <p class="copiers-modal__text" id="copiersLineEquipmentSubtitle">Asigna equipos del cliente a esta l&iacute;nea de producto Copiers.</p>
            </div>
            <button type="button" class="btn btn-outline-secondary" data-copiers-close="lineEquipment">Cerrar</button>
        </div>

        <div class="copiers-status" id="copiersLineEquipmentStatus" role="status" aria-live="polite"></div>
        <div class="copiers-assignment-summary" id="copiersLineEquipmentSummary"></div>

        <div class="copiers-assignment-grid">
            <section class="copiers-subpanel">
                <div class="copiers-subpanel__header">
                    <h3>Asignados a esta l&iacute;nea</h3>
                    <span class="copiers-counter" id="copiersLineEquipmentAssignedCount">0 equipos</span>
                </div>
                <div class="copiers-table-wrap copiers-table-wrap--compact">
                    <table class="table align-middle copiers-table copiers-table--assignment">
                        <thead>
                            <tr>
                                <th>Equipo</th>
                                <th>Detalle</th>
                                <th class="text-end">Acci&oacute;n</th>
                            </tr>
                        </thead>
                        <tbody id="copiersLineEquipmentAssignedBody">
                            <tr>
                                <td colspan="3" class="text-center copiers-muted">No hay equipos asignados a esta l&iacute;nea.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="copiers-subpanel">
                <div class="copiers-subpanel__header">
                    <h3>Disponibles del cliente</h3>
                    <span class="copiers-counter" id="copiersLineEquipmentAvailableCount">0 equipos</span>
                </div>
                <div class="copiers-table-wrap copiers-table-wrap--compact">
                    <table class="table align-middle copiers-table copiers-table--assignment">
                        <thead>
                            <tr>
                                <th>Equipo</th>
                                <th>Detalle</th>
                                <th class="text-end">Acci&oacute;n</th>
                            </tr>
                        </thead>
                        <tbody id="copiersLineEquipmentAvailableBody">
                            <tr>
                                <td colspan="3" class="text-center copiers-muted">No hay equipos disponibles para asignar.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>
        </div>

        <div class="copiers-modal__footer">
            <button type="button" class="btn btn-outline-secondary" data-copiers-close="lineEquipment">Cancelar</button>
            <button type="button" class="btn btn-primary" id="copiersLineEquipmentSaveBtn">Guardar asignaci&oacute;n</button>
        </div>
    </div>
</div>

<div class="copiers-modal" id="copiersEquipmentDetailModal" hidden>
    <div class="copiers-modal__backdrop" data-copiers-close="equipmentDetail"></div>
    <div class="copiers-modal__dialog copiers-modal__dialog--wide" role="dialog" aria-modal="true" aria-labelledby="copiersEquipmentDetailTitle">
        <div class="copiers-modal__header">
            <div>
                <div class="copiers-kicker">Equipos</div>
                <h2 class="copiers-modal__title" id="copiersEquipmentDetailTitle">Detalle del equipo</h2>
                <p class="copiers-modal__text" id="copiersEquipmentDetailSubtitle">Edita la informacion operativa del equipo seleccionado.</p>
            </div>
            <button type="button" class="btn btn-outline-secondary" data-copiers-close="equipmentDetail">Cerrar</button>
        </div>

        <div class="copiers-status" id="copiersEquipmentDetailStatus" role="status" aria-live="polite"></div>

        <form id="copiersEquipmentAssignmentForm" class="copiers-form">
            <input type="hidden" id="copiersEquipmentRecordId" />
            <input type="hidden" id="copiersEquipmentClientId" />

            <section class="copiers-detail-section">
                <div>
                    <div class="copiers-kicker">Formulario</div>
                    <h3>Datos del equipo</h3>
                </div>
                <div class="copiers-form__grid">
                    <label class="copiers-field">
                        <span>Serial</span>
                        <input class="form-control" id="copiersEquipmentSerial" autocomplete="off" required />
                    </label>
                    <div class="copiers-field copiers-field--span-2">
                        <span>Cliente asignado</span>
                        <div class="copiers-inline-control">
                            <input class="form-control" id="copiersEquipmentClientName" autocomplete="off" readonly />
                            <button type="button" class="btn btn-outline-primary" id="copiersRegisterMovementBtn">Registrar movimiento</button>
                        </div>
                        <datalist id="copiersEquipmentClientOptions"></datalist>
                    </div>
                    <label class="copiers-field">
                        <span>Tipo</span>
                        <select class="form-select" id="copiersEquipmentCategory"></select>
                    </label>
                    <label class="copiers-field">
                        <span>Area</span>
                        <input class="form-control" id="copiersEquipmentArea" autocomplete="off" />
                    </label>
                    <label class="copiers-field">
                        <span>Sede</span>
                        <input class="form-control" id="copiersEquipmentSite" autocomplete="off" />
                    </label>
                    <label class="copiers-field">
                        <span>Referencia</span>
                        <input class="form-control" id="copiersEquipmentReference" autocomplete="off" />
                    </label>
                    <label class="copiers-field">
                        <span>Mantenimientos</span>
                        <input class="form-control" id="copiersEquipmentMaintenanceCount" readonly />
                    </label>
                    <label class="copiers-field">
                        <span>Ultimo mantenimiento</span>
                        <input class="form-control" id="copiersEquipmentLastMaintenance" readonly />
                    </label>
                    <label class="copiers-field copiers-field--span-2">
