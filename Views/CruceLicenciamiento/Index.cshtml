@model CotizadorInterno.Web.Models.Licenciamiento.LicenciamientoCrucePageViewModel
@{
    ViewData["Title"] = "Cruce Licenciamiento";
}

@section Styles {
    <link rel="stylesheet" href="~/css/cruce-licenciamiento.css" asp-append-version="true" />
}

<div class="licx-shell"
     id="licCruceApp"
     data-load-url="@Url.Action("Data", "CruceLicenciamiento")"
     data-update-cost-contract-url="@Url.Action("UpdateCostContractType", "CruceLicenciamiento")"
     data-update-billing-contract-url="@Url.Action("UpdateBillingContractType", "CruceLicenciamiento")"
     data-update-billing-vertical-url="@Url.Action("UpdateBillingVertical", "CruceLicenciamiento")"
     data-update-cost-account-url="@Url.Action("UpdateCostAccount", "CruceLicenciamiento")"
     data-default-year="@Model.DefaultYear"
     data-default-month="@Model.DefaultMonth"
     data-default-period-mode="@Model.DefaultPeriodMode">
    <section class="licx-header">
        <div>
            <div class="licx-kicker">Gerencia</div>
            <h1 class="licx-title">Cruce Licenciamiento</h1>
        </div>
        <div class="licx-user">
            <span>Usuario</span>
            <strong>@Model.CurrentUser.Email</strong>
        </div>
    </section>

    <form class="licx-toolbar" id="licCruceFilters">
        <label class="licx-field">
            <span>Periodo</span>
            <select class="form-select" id="licCrucePeriodMode">
                <option value="month">Mes</option>
                <option value="quarter">Trimestre</option>
                <option value="ytd">Ano acumulado</option>
            </select>
        </label>
        <label class="licx-field">
            <span>Ano</span>
            <input class="form-control" id="licCruceYear" type="number" min="2000" max="2100" step="1" placeholder="Ultimo" />
        </label>
        <label class="licx-field">
            <span>Mes base</span>
            <select class="form-select" id="licCruceMonth">
                <option value="">Ultimo mes con data</option>
                <option value="1">Enero</option>
                <option value="2">Febrero</option>
                <option value="3">Marzo</option>
                <option value="4">Abril</option>
                <option value="5">Mayo</option>
                <option value="6">Junio</option>
                <option value="7">Julio</option>
                <option value="8">Agosto</option>
                <option value="9">Septiembre</option>
                <option value="10">Octubre</option>
                <option value="11">Noviembre</option>
                <option value="12">Diciembre</option>
            </select>
        </label>
        <label class="licx-field">
            <span>Tipo</span>
            <select class="form-select" id="licCruceSegmentSelect"></select>
        </label>
        <button type="submit" class="btn btn-primary">Actualizar</button>
    </form>

    <div id="licCruceStatus" class="licx-status" role="status" aria-live="polite"></div>

    <section class="licx-kpis" aria-label="Resumen consolidado">
        <article class="licx-kpi">
            <span>Total costos</span>
            <strong id="licCruceTotalCost">$0</strong>
        </article>
        <article class="licx-kpi">
            <span>Venta sin IVA</span>
            <strong id="licCruceTotalBilling">$0</strong>
        </article>
        <article class="licx-kpi">
            <span>Utilidad</span>
            <strong id="licCruceTotalMargin">$0</strong>
        </article>
        <article class="licx-kpi">
            <span>Utilidad %</span>
            <strong id="licCruceTotalMarginPct">N/A</strong>
        </article>
        <article class="licx-kpi">
            <span>Periodo cargado</span>
            <strong id="licCrucePeriodLabel">-</strong>
        </article>
        <article class="licx-kpi">
            <span>Margen negativo</span>
            <strong id="licCruceNegativeCount">0</strong>
        </article>
    </section>

    <section class="licx-panel licx-matrix-panel">
        <div class="licx-panel__header">
            <div>
                <div class="licx-kicker">Matriz por cliente</div>
                <h2 id="licCruceMatrixTitle">Monthly</h2>
            </div>
            <div class="licx-panel-actions">
                <span id="licCruceMatrixSummary"></span>
            </div>
        </div>
        <div id="licCruceMatrix" class="licx-matrix"></div>
    </section>
</div>

@section Scripts {
    <script src="~/js/cruce-licenciamiento.js" asp-append-version="true"></script>
}
