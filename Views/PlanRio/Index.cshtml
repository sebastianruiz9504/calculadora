@model CotizadorInterno.Web.Models.PlanRio.PlanRioPageViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Plan Rio";
    var jsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    var workoutsJson = JsonSerializer.Serialize(Model.Workouts, jsonOptions);
    var weeksJson = JsonSerializer.Serialize(Model.Weeks, jsonOptions);
}

@section Styles {
    <link rel="stylesheet" href="~/css/plan-rio.css" asp-append-version="true" />
}

<div class="plan-rio">
    <header class="plan-rio__header">
        <div>
            <p class="plan-rio__eyebrow">Triatlón 70.3</p>
            <h1>Entrenamientos semanales</h1>
            <p class="mb-1" id="weekLabel">@Model.WeekLabel</p>
            <small class="text-muted">
                Fuente: <strong>@Model.SourcePath</strong>
                @if (!string.IsNullOrWhiteSpace(Model.SourceSheet))
                {
                    <span> | Origen: <strong>@Model.SourceSheet</strong></span>
                }
                @if (!string.IsNullOrWhiteSpace(Model.DetailColumnName))
                {
                    <span> | Detalle: <strong>@Model.DetailColumnName</strong></span>
                }
            </small>
            @if (!string.IsNullOrWhiteSpace(Model.SourceStatus))
            {
                <div class="plan-rio__source-status">@Model.SourceStatus</div>
            }
        </div>
        <button id="resetWeek" class="btn btn-outline-secondary" type="button">Reiniciar semana</button>
    </header>

    <section class="plan-rio__week-panel">
        <div>
            <span class="plan-rio__label">Semana en pantalla</span>
            <strong id="selectedWeekTitle">@Model.WeekLabel</strong>
        </div>
        <select class="form-select" id="weekSelect" aria-label="Semana"></select>
    </section>

    <section class="plan-rio__grid" id="weekGrid"></section>

    <section class="plan-rio__charts">
        <article class="plan-rio__card">
            <h2>Progresión de cumplimiento</h2>
            <canvas id="completionChart" height="180"></canvas>
        </article>
        <article class="plan-rio__card">
            <h2>Volumen semanal (meta vs real)</h2>
            <canvas id="volumeChart" height="180"></canvas>
        </article>
    </section>
</div>

<div class="modal fade" id="workoutModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <form class="modal-content" id="workoutForm">
            <div class="modal-header">
                <h5 class="modal-title">Registrar entreno</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="workoutKey" />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" for="actualDuration">Duración (min)</label>
                        <input class="form-control" id="actualDuration" type="number" min="1" max="3000" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="actualDistance">Distancia</label>
                        <input class="form-control" id="actualDistance" type="number" min="0.01" max="1000" step="0.01" inputmode="decimal" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="averageHeartRate">FC promedio</label>
                        <input class="form-control" id="averageHeartRate" type="number" min="1" max="250" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="averagePower">Potencia promedio</label>
                        <input class="form-control" id="averagePower" type="number" min="0" max="2000" />
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="notes">Notas</label>
                        <textarea class="form-control" id="notes" rows="3"></textarea>
                    </div>
                </div>
                <div class="plan-rio__form-status" id="workoutFormStatus" aria-live="polite"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary" id="workoutSubmit">Guardar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        window.planRioWorkouts = @Html.Raw(workoutsJson);
        window.planRioWeeks = @Html.Raw(weeksJson);
        window.planRioWeekLabel = @Html.Raw(JsonSerializer.Serialize(Model.WeekLabel));
        window.planRioRegisterUrl = @Html.Raw(JsonSerializer.Serialize(Url.Action("Register", "PlanRio")));
    </script>
    <script src="~/js/plan-rio.js" asp-append-version="true"></script>
}
