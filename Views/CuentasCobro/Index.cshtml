@model CuentasCobroPageViewModel
@{
    ViewData["Title"] = "Cuentas de cobro";
}

@section Styles {
    <link rel="stylesheet" href="~/css/cuentas-cobro.css" asp-append-version="true" />
}

<div class="ccb-shell"
     id="cuentasCobroApp"
     data-load-url="@Url.Action("Data", "CuentasCobro")"
     data-save-url="@Url.Action("Save", "CuentasCobro")"
     data-upload-url="@Url.Action("UploadFile", "CuentasCobro")"
     data-download-url="@Url.Action("DownloadFile", "CuentasCobro")"
     data-mark-printed-url="@Url.Action("MarkPrinted", "CuentasCobro")"
     data-print-url="@Url.Action("Print", "CuentasCobro")"
     data-initial-year="@Model.InitialYear"
     data-initial-month="@Model.InitialMonth">
    <section class="ccb-hero">
        <div>
            <div class="ccb-kicker">Finanzas</div>
            <h1 class="ccb-title">Cuentas de cobro</h1>
            <p class="ccb-subtitle">
                Revisa el periodo, abre cualquier fila para editarla en detalle y guarda los soportes en un formulario mas limpio.
            </p>
        </div>
        <div class="ccb-user-pill">
            <span class="ccb-user-pill__label">Acceso</span>
            <span>@Model.CurrentUser.Email</span>
        </div>
    </section>

    <div id="ccbStatusBanner" class="ccb-status" role="status" aria-live="polite"></div>

    <section class="ccb-card">
        <div class="ccb-toolbar">
            <div class="ccb-toolbar__filters">
                <div class="ccb-field">
                    <label class="form-label" for="ccbYearSelect">Año</label>
                    <select class="form-select" id="ccbYearSelect"></select>
                </div>
                <div class="ccb-field">
                    <label class="form-label" for="ccbMonthSelect">Mes</label>
                    <select class="form-select" id="ccbMonthSelect"></select>
                </div>
            </div>
            <div class="ccb-toolbar__actions">
                <div class="ccb-toolbar__hint" id="ccbPeriodSource">
                    El periodo cargado se toma desde la cuenta de cobro.
                </div>
                <div class="ccb-toolbar__buttons">
                    <button type="button" class="btn btn-outline-secondary" id="ccbRefreshBtn">Recargar</button>
                    <button type="button" class="btn btn-primary" id="ccbAddRowBtn">Nuevo registro</button>
                </div>
            </div>
        </div>
    </section>

    <section class="ccb-summary" id="ccbSummary">
        <article class="ccb-summary__card">
            <span class="ccb-summary__label">Registros</span>
            <strong class="ccb-summary__value" id="ccbSummaryCount">0</strong>
        </article>
        <article class="ccb-summary__card">
            <span class="ccb-summary__label">Valor total</span>
            <strong class="ccb-summary__value" id="ccbSummaryValorTotal">$0</strong>
        </article>
        <article class="ccb-summary__card">
            <span class="ccb-summary__label">Valor pago</span>
            <strong class="ccb-summary__value" id="ccbSummaryValorPago">$0</strong>
        </article>
        <article class="ccb-summary__card">
            <span class="ccb-summary__label">Rete fuente valor</span>
            <strong class="ccb-summary__value" id="ccbSummaryReteValor">$0</strong>
        </article>
    </section>

    <section class="ccb-card">
        <div class="ccb-section-header">
            <div>
                <div class="ccb-kicker">Tabla</div>
                <h2 class="ccb-section-title" id="ccbTableTitle">Detalle por periodo</h2>
                <p class="ccb-section-subtitle">
                    La tabla queda como resumen. Haz clic sobre cualquier fila para abrir el formulario completo.
                </p>
            </div>
            <div class="ccb-counter" id="ccbRecordsCount">0 filas</div>
        </div>

        <div class="ccb-table-wrap">
            <table class="table align-middle ccb-table" id="ccbTable">
                <thead>
                    <tr>
                        <th>Receptor</th>
                        <th class="text-end">Valor total</th>
                        <th class="text-end">Valor pago</th>
                        <th>Valida</th>
                        <th>Impresion</th>
                    </tr>
                </thead>
                <tbody id="ccbRowsBody"></tbody>
            </table>
        </div>

        <div id="ccbEmptyState" class="ccb-empty" hidden>
            No hay cuentas de cobro para este periodo. Usa <strong>Nuevo registro</strong> para crear la primera.
        </div>
    </section>
</div>

<div class="ccb-modal" id="ccbEditorModal" hidden>
    <div class="ccb-modal__backdrop" data-ccb-close></div>
    <div class="ccb-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="ccbEditorTitle">
        <div class="ccb-modal__header">
            <div>
                <div class="ccb-kicker">Formulario</div>
                <h2 class="ccb-modal__title" id="ccbEditorTitle">Cuenta de cobro</h2>
                <p class="ccb-modal__subtitle" id="ccbEditorSubtitle">Completa los campos y guarda los cambios.</p>
            </div>
            <button type="button" class="btn btn-outline-secondary" id="ccbModalCloseBtn">Cerrar</button>
        </div>

        <div id="ccbModalStatus" class="ccb-status" role="status" aria-live="polite"></div>

        <form id="ccbEditorForm" class="ccb-form">
            <div class="ccb-form__grid">
                <label class="ccb-form__field ccb-form__field--span-2">
                    <span class="ccb-form__label">Receptor</span>
                    <input class="form-control" id="ccbReceptorInput" type="text" />
                </label>

                <label class="ccb-form__field">
                    <span class="ccb-form__label">NIT o Cedula</span>
                    <input class="form-control" id="ccbNitInput" type="text" />
                </label>

                <label class="ccb-form__field">
                    <span class="ccb-form__label">Rete fuente %</span>
                    <input class="form-control" id="ccbRetePorcentajeInput" type="number" min="0" max="100" step="0.01" />
                </label>

                <label class="ccb-form__field">
                    <span class="ccb-form__label">Valor total</span>
                    <input class="form-control" id="ccbValorTotalInput" type="number" min="0" step="0.01" />
                </label>

                <label class="ccb-form__field">
                    <span class="ccb-form__label">Valor pago</span>
                    <input class="form-control" id="ccbValorPagoInput" type="number" min="0" step="0.01" />
                </label>

                <label class="ccb-form__field">
                    <span class="ccb-form__label">Rete fuente valor</span>
                    <input class="form-control ccb-form__readonly" id="ccbReteValorInput" type="number" step="0.01" readonly />
                </label>

                <div class="ccb-form__field">
                    <span class="ccb-form__label">Validacion</span>
                    <div class="ccb-validation-card" id="ccbValidationCard">
                        <div class="ccb-validation-card__state" id="ccbValidationText">Cuadra</div>
                        <div class="ccb-validation-card__hint">
                            El valor total debe ser igual a valor pago + rete fuente valor.
                        </div>
                    </div>
                </div>

                <label class="ccb-form__field ccb-form__field--span-2">
                    <span class="ccb-form__label">Observaciones</span>
                    <textarea class="form-control ccb-form__textarea" id="ccbObservacionesInput" rows="4" placeholder="Escribe aqui cualquier observacion relacionada a la cuenta o factura."></textarea>
                </label>

                <div class="ccb-form__field ccb-form__field--span-2">
                    <span class="ccb-form__label">Adjunto</span>
                    <div class="ccb-file-card">
                        <div>
                            <div class="ccb-file-card__title" id="ccbAttachmentName">Sin adjunto cargado</div>
                            <div class="ccb-file-card__hint" id="ccbAttachmentHint">
                                Guarda el registro y adjunta el soporte en PDF, imagen o Word.
                            </div>
                        </div>
                        <div class="ccb-file-card__actions">
                            <a class="ccb-file-card__link is-disabled" id="ccbAttachmentDownloadLink" href="#" target="_blank" rel="noopener">Descargar</a>
                            <input class="form-control" id="ccbAttachmentInput" type="file" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="ccb-modal__footer">
                <div class="ccb-modal__meta" id="ccbEditorMeta">Nuevo registro</div>
                <div class="ccb-modal__actions">
                    <button type="button" class="btn btn-outline-secondary" id="ccbModalCancelBtn">Cancelar</button>
                    <button type="button" class="btn btn-outline-success" id="ccbModalPrintBtn" disabled>Imprimir</button>
                    <button type="submit" class="btn btn-primary" id="ccbModalSaveBtn">Guardar</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/cuentas-cobro.js" asp-append-version="true"></script>
}
