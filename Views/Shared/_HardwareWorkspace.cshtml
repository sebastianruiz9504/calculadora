@model CotizadorInterno.Web.Models.Hardware.HardwareWorkspaceViewModel

<div class="hardware-shell @(Model.ShowHero ? "" : "hardware-shell--embedded")"
     id="@Model.RootId"
     data-hw-root
     data-preview-url="@Model.PreviewUrl"
     data-provision-url="@Model.ProvisionUrl"
     data-board-url="@Model.BoardUrl"
     data-save-url="@Model.SaveUrl"
     data-edit-url="@Model.EditUrl"
     data-upload-url="@Model.UploadUrl"
     data-download-url="@Model.DownloadUrl"
     data-invoice-search-url="@Model.InvoiceSearchUrl"
     data-client-search-url="@Model.ClientSearchUrl"
     data-initial-start-date="@Model.InitialStartDate"
     data-initial-end-date="@Model.InitialEndDate">
    @if (Model.ShowHero)
    {
        <section class="hardware-hero">
            <div>
                <div class="hardware-kicker">@Model.HeroKicker</div>
                <h1 class="hardware-title">@Model.HeroTitle</h1>
                <p class="hardware-subtitle">@Model.HeroSubtitle</p>
            </div>
            <div class="hardware-user-pill">
                <span class="hardware-user-pill__label">@Model.AccessLabel</span>
                <span>@Model.CurrentUserLabel</span>
            </div>
        </section>
    }

    <div class="hardware-status" data-hw-status role="status" aria-live="polite"></div>

    <section class="hardware-card">
        <div class="hardware-toolbar">
            <div class="hardware-toolbar__filters">
                <label class="hardware-field">
                    <span class="hardware-field__label">Filtrar por estado</span>
                    <select class="form-select" data-hw-state-filter>
                        <option value="">Todos los estados</option>
                    </select>
                </label>
                <label class="hardware-field">
                    <span class="hardware-field__label">Desde ODC</span>
                    <input type="date" class="form-control" data-hw-start-date />
                </label>
                <label class="hardware-field">
                    <span class="hardware-field__label">Hasta ODC</span>
                    <input type="date" class="form-control" data-hw-end-date />
                </label>
            </div>
            <div class="hardware-toolbar__actions">
                <div class="hardware-toolbar__summary">
                    <span class="hardware-toolbar__summary-label">Vista activa</span>
                    <strong data-hw-filter-label>Todos los estados</strong>
                </div>
                <div class="hardware-actions">
                    <button type="button" class="btn btn-primary" data-hw-selected-action disabled>Gestionar selección</button>
                    <button type="button" class="btn btn-outline-primary" data-hw-edit-selected disabled>Editar selección</button>
                    <button type="button" class="btn btn-outline-secondary" data-hw-refresh>Actualizar</button>
                </div>
                <div class="hardware-selection-summary" data-hw-selection-summary>Selecciona una o varias filas.</div>
            </div>
        </div>

        <div class="hardware-inline-status" data-hw-board-status role="status" aria-live="polite"></div>
        <div class="hardware-warning-list" data-hw-warnings hidden></div>

        <div class="hardware-owner-tables" data-hw-rows>
            <div class="hardware-empty">Cargando tabla...</div>
        </div>
    </section>

    <div class="hardware-modal" data-hw-modal hidden>
        <div class="hardware-modal__backdrop" data-hw-close-modal></div>
        <div class="hardware-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="hardwareModalTitle-@Model.RootId">
            <div class="hardware-modal__header">
                <div>
                    <div class="hardware-kicker">Etapa</div>
                    <h2 class="hardware-modal__title" id="hardwareModalTitle-@Model.RootId" data-hw-modal-title>Gestión de hardware</h2>
                    <p class="hardware-modal__subtitle" data-hw-modal-subtitle>Completa la etapa seleccionada.</p>
                </div>
                <button type="button" class="btn btn-outline-secondary" data-hw-close-modal>Cerrar</button>
            </div>

            <div class="hardware-status hardware-status--modal" data-hw-modal-status role="status" aria-live="polite"></div>

            <form class="hardware-form" data-hw-form>
                <input type="hidden" data-hw-record-id />
                <input type="hidden" data-hw-action-key />

                <div class="hardware-form__summary">
                    <div>
                        <div class="hardware-form__summary-title" data-hw-record-name>Hardware</div>
                        <div class="hardware-form__summary-meta" data-hw-record-meta>Cliente</div>
                    </div>
                    <div class="hardware-pill" data-hw-record-state>Pendiente</div>
                </div>

                <div class="hardware-form__grid">
                    <section class="hardware-stage-panel" data-hw-stage-panel="register-documentation" hidden>
                        <div class="hardware-stage-panel__header">
                            <h3>Registrar documentación</h3>
                            <p>Completa la documentación base antes de autorizar el pago al proveedor.</p>
                        </div>
                        <div class="hardware-form__grid hardware-form__grid--nested">
                            <label class="hardware-field">
                                <span class="hardware-field__label">cr07a_noorden</span>
                                <input type="text" class="form-control" data-hw-field="purchaseOrderNumber" />
                            </label>
                            <label class="hardware-field">
                                <span class="hardware-field__label">cr07a_valorflete</span>
                                <input type="number" min="0" step="0.01" class="form-control" data-hw-field="freightValue" />
                            </label>
                        </div>
                        <div class="hardware-stage-table-wrap">
                            <table class="table align-middle hardware-stage-table">
                                <thead>
                                    <tr>
                                        <th>Hardware</th>
                                        <th class="text-end">Cant.</th>
                                        <th class="text-end">Venta unidad</th>
                                        <th>Fecha ODC</th>
                                        <th>Costo Unt Proveedor antes de IVA</th>
                                        <th>Proveedor</th>
                                        <th>Adjuntar ODC</th>
                                        <th>Adjuntar Proforma</th>
                                    </tr>
                                </thead>
                                <tbody data-hw-documentation-rows></tbody>
                            </table>
                        </div>
                        <div class="hardware-form__grid hardware-form__grid--nested hardware-legacy-documentation" hidden>
                            <label class="hardware-field">
                                <span class="hardware-field__label">Fecha ODC</span>
                                <input type="date" class="form-control" data-hw-field="odcDate" />
                            </label>
                            <label class="hardware-field">
                                <span class="hardware-field__label">Costo Unt Proveedor antes de IVA</span>
                                <input type="number" min="0" step="0.01" class="form-control" data-hw-field="supplierUnitCost" />
                            </label>
                            <label class="hardware-field hardware-field--span-2">
                                <span class="hardware-field__label">Proveedor</span>
                                <input type="text" class="form-control" data-hw-field="provider" />
                            </label>
                            <div class="hardware-file-card hardware-field--span-2" data-hw-file-card="cr07a_ordendecompra">
                                <div>
                                    <div class="hardware-file-card__title">Adjuntar ODC</div>
                                    <div class="hardware-file-card__hint" data-hw-file-hint="cr07a_ordendecompra">Carga la orden de compra correspondiente.</div>
                                </div>
                                <div class="hardware-file-card__actions">
                                    <a class="hardware-file-card__link is-disabled" href="#" target="_blank" rel="noopener" data-hw-download-link="cr07a_ordendecompra">Descargar</a>
                                    <div class="hardware-file-card__name" data-hw-file-name="cr07a_ordendecompra">Sin archivo</div>
                                    <input type="file" class="form-control" data-hw-file-input="cr07a_ordendecompra" />
                                </div>
                            </div>
                            <div class="hardware-file-card hardware-field--span-2" data-hw-file-card="cr07a_adjuntarproforma">
                                <div>
                                    <div class="hardware-file-card__title">Adjuntar Proforma</div>
                                    <div class="hardware-file-card__hint" data-hw-file-hint="cr07a_adjuntarproforma">Carga la proforma del proveedor.</div>
                                </div>
                                <div class="hardware-file-card__actions">
                                    <a class="hardware-file-card__link is-disabled" href="#" target="_blank" rel="noopener" data-hw-download-link="cr07a_adjuntarproforma">Descargar</a>
                                    <div class="hardware-file-card__name" data-hw-file-name="cr07a_adjuntarproforma">Sin archivo</div>
                                    <input type="file" class="form-control" data-hw-file-input="cr07a_adjuntarproforma" />
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="hardware-stage-panel" data-hw-stage-panel="register-supplier-payment" hidden>
                        <div class="hardware-stage-panel__header">
                            <h3>Registrar pago a proveedor</h3>
                            <p>Adjunta el soporte del pago realizado y registra su fecha.</p>
                        </div>
                        <div class="hardware-form__grid hardware-form__grid--nested">
                            <label class="hardware-field">
                                <span class="hardware-field__label">Fecha de pago a proveedor</span>
                                <input type="date" class="form-control" data-hw-field="supplierPaymentDate" />
                            </label>
                            <div class="hardware-file-card hardware-field--span-2" data-hw-file-card="cr07a_pagoaproveedor">
                                <div>
                                    <div class="hardware-file-card__title">Adjuntar pago a proveedor</div>
                                    <div class="hardware-file-card__hint" data-hw-file-hint="cr07a_pagoaproveedor">Carga el soporte del pago al proveedor.</div>
                                </div>
                                <div class="hardware-file-card__actions">
                                    <a class="hardware-file-card__link is-disabled" href="#" target="_blank" rel="noopener" data-hw-download-link="cr07a_pagoaproveedor">Descargar</a>
                                    <div class="hardware-file-card__name" data-hw-file-name="cr07a_pagoaproveedor">Sin archivo</div>
                                    <input type="file" class="form-control" data-hw-file-input="cr07a_pagoaproveedor" />
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="hardware-stage-panel" data-hw-stage-panel="register-received" hidden>
                        <div class="hardware-stage-panel__header">
                            <h3>Registrar recibido</h3>
                            <p>Esta acción confirma el recibido por comercial y mueve el hardware a tránsito.</p>
                        </div>
                        <div class="hardware-note-card">
                            <strong>Confirmación requerida</strong>
                            <p>Al guardar, se registrará la aprobación de recibido por comercial.</p>
                        </div>
                    </section>

                    <section class="hardware-stage-panel" data-hw-stage-panel="register-client-received" hidden>
                        <div class="hardware-stage-panel__header">
                            <h3>Registrar recibido cliente</h3>
                            <p>Adjunta el acta de entrega y registra su fecha para dejar el hardware listo para facturación.</p>
                        </div>
                        <div class="hardware-form__grid hardware-form__grid--nested">
                            <label class="hardware-field">
                                <span class="hardware-field__label">Fecha acta de entrega</span>
                                <input type="date" class="form-control" data-hw-field="deliveryRecordDate" />
                            </label>
                            <div class="hardware-file-card hardware-field--span-2" data-hw-file-card="cr07a_actadeentrega">
                                <div>
                                    <div class="hardware-file-card__title">Adjuntar acta de entrega</div>
                                    <div class="hardware-file-card__hint" data-hw-file-hint="cr07a_actadeentrega">Carga el acta firmada de entrega.</div>
                                </div>
                                <div class="hardware-file-card__actions">
                                    <a class="hardware-file-card__link is-disabled" href="#" target="_blank" rel="noopener" data-hw-download-link="cr07a_actadeentrega">Descargar</a>
                                    <div class="hardware-file-card__name" data-hw-file-name="cr07a_actadeentrega">Sin archivo</div>
                                    <input type="file" class="form-control" data-hw-file-input="cr07a_actadeentrega" />
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="hardware-stage-panel" data-hw-stage-panel="register-invoice" hidden>
                        <div class="hardware-stage-panel__header">
                            <h3>Registrar factura</h3>
                            <p>Busca una coincidencia exacta de la tabla Facturación y guarda el texto de la factura en Hardware.</p>
                        </div>
                        <div class="hardware-form__grid hardware-form__grid--nested">
                            <label class="hardware-field hardware-field--span-2">
                                <span class="hardware-field__label">Número de factura</span>
                                <input type="text" class="form-control" list="hardwareInvoiceOptions-@Model.RootId" autocomplete="off" data-hw-field="invoiceNumber" />
                                <datalist id="hardwareInvoiceOptions-@Model.RootId" data-hw-invoice-options></datalist>
                                <span class="hardware-field__hint">Escribe al menos 2 caracteres y selecciona una coincidencia exacta.</span>
                            </label>
                        </div>
                    </section>

                    <section class="hardware-stage-panel" data-hw-stage-panel="register-client-payment" hidden>
                        <div class="hardware-stage-panel__header">
                            <h3>Registrar pago cliente</h3>
                            <p>Esta acción consulta la factura en Facturación y cerrará el registro si <code>cr07a_valorpago</code> es mayor a 0.</p>
                        </div>
                        <div class="hardware-note-card">
                            <strong>Validación automática</strong>
                            <p>Si la factura aún no tiene valor pago, el hardware se mantendrá en espera de pago.</p>
                        </div>
                    </section>
                </div>

                <div class="hardware-modal__footer">
                    <div class="hardware-modal__meta" data-hw-modal-meta>Sin cambios</div>
                    <div class="hardware-actions">
                        <button type="button" class="btn btn-outline-secondary" data-hw-close-modal>Cancelar</button>
                        <button type="submit" class="btn btn-primary" data-hw-save-stage>Guardar etapa</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="hardware-modal" data-hw-edit-modal hidden>
        <div class="hardware-modal__backdrop" data-hw-close-edit-modal></div>
        <div class="hardware-modal__dialog hardware-modal__dialog--edit" role="dialog" aria-modal="true" aria-labelledby="hardwareEditModalTitle-@Model.RootId">
            <div class="hardware-modal__header">
                <div>
                    <div class="hardware-kicker">Edición</div>
                    <h2 class="hardware-modal__title" id="hardwareEditModalTitle-@Model.RootId" data-hw-edit-title>Editar Hardware</h2>
                    <p class="hardware-modal__subtitle" data-hw-edit-subtitle>Actualiza los campos de las filas seleccionadas.</p>
                </div>
                <button type="button" class="btn btn-outline-secondary" data-hw-close-edit-modal>Cerrar</button>
            </div>

            <div class="hardware-status hardware-status--modal" data-hw-edit-status role="status" aria-live="polite"></div>

            <form class="hardware-form" data-hw-edit-form>
                <div class="hardware-form__summary">
                    <div>
                        <div class="hardware-form__summary-title" data-hw-edit-count>0 filas seleccionadas</div>
                        <div class="hardware-form__summary-meta">Solo se guardan los campos que modifiques.</div>
                    </div>
                </div>

                <div class="hardware-form__grid">
                    <label class="hardware-field hardware-field--span-2">
                        <span class="hardware-field__label">Cliente</span>
                        <div class="hardware-lookup">
                            <input type="search" class="form-control" autocomplete="off" data-hw-edit-field="clientName" />
                            <div class="hardware-lookup__menu" data-hw-client-options></div>
                        </div>
                        <span class="hardware-field__hint" data-hw-client-hint>Busca y selecciona un cliente para cambiarlo.</span>
                    </label>
                    <label class="hardware-field">
                        <span class="hardware-field__label">Cantidad</span>
                        <input type="number" min="0" step="1" class="form-control" data-hw-edit-field="quantity" />
                    </label>
                    <label class="hardware-field">
                        <span class="hardware-field__label">Venta unidad</span>
                        <input type="number" min="0" step="0.01" class="form-control" data-hw-edit-field="saleUnit" />
                    </label>
                    <label class="hardware-field">
                        <span class="hardware-field__label">Total línea</span>
                        <input type="number" min="0" step="0.01" class="form-control" data-hw-edit-field="totalSale" />
                    </label>
                    <label class="hardware-field">
                        <span class="hardware-field__label">Estado</span>
                        <select class="form-select" data-hw-edit-field="stateValue"></select>
                    </label>
                    <label class="hardware-field">
                        <span class="hardware-field__label">No orden</span>
                        <input type="text" class="form-control" data-hw-edit-field="purchaseOrderNumber" />
                    </label>
                    <label class="hardware-field">
                        <span class="hardware-field__label">cr07a_fechaodc</span>
                        <input type="date" class="form-control" data-hw-edit-field="odcDateValue" />
                    </label>
                    <label class="hardware-field">
                        <span class="hardware-field__label">Costo unt proveedor</span>
                        <input type="number" min="0" step="0.01" class="form-control" data-hw-edit-field="supplierUnitCost" />
                    </label>
                    <label class="hardware-field">
                        <span class="hardware-field__label">Total proveedor</span>
                        <input type="number" min="0" step="0.01" class="form-control" data-hw-edit-field="supplierTotal" />
                    </label>
                    <label class="hardware-field">
                        <span class="hardware-field__label">Valor flete</span>
                        <input type="number" min="0" step="0.01" class="form-control" data-hw-edit-field="freightValue" />
                    </label>
                    <label class="hardware-field">
                        <span class="hardware-field__label">Utilidad</span>
                        <input type="number" step="0.01" class="form-control" data-hw-edit-field="utility" />
                    </label>
                    <label class="hardware-field">
                        <span class="hardware-field__label">Valor margen</span>
                        <input type="number" step="0.01" class="form-control" data-hw-edit-field="marginValue" />
                    </label>
                    <label class="hardware-field">
                        <span class="hardware-field__label">Proveedor</span>
                        <input type="text" class="form-control" data-hw-edit-field="provider" />
                    </label>
                    <label class="hardware-field">
                        <span class="hardware-field__label">Fecha pago proveedor</span>
                        <input type="date" class="form-control" data-hw-edit-field="supplierPaymentDateValue" />
                    </label>
                    <label class="hardware-field">
                        <span class="hardware-field__label">Fecha acta entrega</span>
                        <input type="date" class="form-control" data-hw-edit-field="deliveryRecordDateValue" />
                    </label>
                    <label class="hardware-field hardware-field--span-2">
                        <span class="hardware-field__label">Número de factura</span>
                        <input type="text" class="form-control" data-hw-edit-field="invoiceNumber" />
                    </label>
                </div>

                <div class="hardware-modal__footer">
                    <div class="hardware-modal__meta" data-hw-edit-meta>Sin cambios</div>
                    <div class="hardware-actions">
                        <button type="button" class="btn btn-outline-secondary" data-hw-close-edit-modal>Cancelar</button>
                        <button type="submit" class="btn btn-primary" data-hw-save-edit>Guardar cambios</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
