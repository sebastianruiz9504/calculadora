@using System.Globalization
@using System.Security.Claims
@using CotizadorInterno.Web.Models.Permissions
@using Microsoft.Identity.Web
@inject IDataverseService Dataverse
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    CurrentUserInfo? layoutCurrentUser = null;

    if (User?.Identity?.IsAuthenticated == true)
    {
        try
        {
            layoutCurrentUser = await Dataverse.GetCurrentUserAsync(Context.RequestAborted);
        }
        catch
        {
            layoutCurrentUser = null;
        }
    }

    bool CanAccessModule(AppModuleDefinition module)
    {
        return AppModuleAccessPolicy.CanAccess(module, layoutCurrentUser);
    }

    bool IsActiveModule(AppModuleDefinition module)
    {
        return currentController.Equals(module.Controller, StringComparison.OrdinalIgnoreCase);
    }

    string GetNavLinkClass(AppModuleDefinition module)
    {
        return IsActiveModule(module)
            ? "app-shell__nav-link is-active"
            : "app-shell__nav-link";
    }

    string GetNavGroupClass(bool isActive)
    {
        return isActive
            ? "app-shell__nav-link dropdown-toggle is-active"
            : "app-shell__nav-link dropdown-toggle";
    }

    string GetDropdownLinkClass(AppModuleDefinition module)
    {
        return IsActiveModule(module)
            ? "dropdown-item app-shell__dropdown-link is-active"
            : "dropdown-item app-shell__dropdown-link";
    }

    string NormalizeUserDisplayName(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "Usuario";
        }

        var trimmed = value.Trim();
        if (!trimmed.Contains('@'))
        {
            return trimmed;
        }

        var localPart = trimmed.Split('@', 2)[0]
            .Replace('.', ' ')
            .Replace('_', ' ')
            .Replace('-', ' ');

        return CultureInfo.CurrentCulture.TextInfo.ToTitleCase(localPart.ToLowerInvariant());
    }

    string ResolveUserDisplayName()
    {
        var principal = User;
        if (principal is null)
        {
            return "Usuario";
        }

        var givenName = principal.FindFirstValue(ClaimTypes.GivenName);
        var surname = principal.FindFirstValue(ClaimTypes.Surname);
        var fullName = string.Join(" ", new[] { givenName, surname }.Where(static part => !string.IsNullOrWhiteSpace(part)));

        return NormalizeUserDisplayName(
            principal.FindFirstValue("name")
            ?? principal.FindFirstValue(ClaimTypes.Name)
            ?? (string.IsNullOrWhiteSpace(fullName) ? null : fullName)
            ?? principal.GetDisplayName()
            ?? principal.Identity?.Name
            ?? principal.FindFirstValue("preferred_username")
            ?? principal.FindFirstValue(ClaimTypes.Upn)
            ?? principal.FindFirstValue(ClaimTypes.Email));
    }

    var navGroups = AppModuleCatalog.TopNavigationGroups
        .Select(group => new
        {
            group.Label,
            group.IsDropdown,
            Modules = group.Modules.Where(CanAccessModule).ToList()
        })
        .Where(group => group.Modules.Count > 0)
        .ToList();
    var userDisplayName = ResolveUserDisplayName();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Digital Tech</title>
    <script>
        (function () {
            try {
                if (localStorage.getItem("cotizador-interno-theme") === "dark") {
                    document.documentElement.setAttribute("data-bs-theme", "dark");
                    document.documentElement.classList.add("app-theme-dark");
                }
            } catch (error) {
                document.documentElement.setAttribute("data-bs-theme", "light");
            }
        })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CotizadorInterno.Web.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/css/dark-mode.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/font-weight-reset.css" asp-append-version="true" />
</head>
<body class="app-shell">
<header class="app-shell__header">
    <nav class="navbar navbar-expand-lg app-shell__navbar">
        <div class="container-xl">
            <div class="app-shell__nav-frame">
                <a class="app-shell__brand" href="~/">
                    <span class="app-shell__brand-title">Digital Tech</span>
                </a>

                <button class="navbar-toggler app-shell__toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation" aria-expanded="false" aria-label="Alternar navegacion">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse app-shell__collapse" id="mainNavigation">
                    <ul class="navbar-nav app-shell__nav-list">
                        @foreach (var group in navGroups)
                        {
                            var isActiveGroup = group.Modules.Any(IsActiveModule);
                            if (!group.IsDropdown && group.Modules.Count == 1)
                            {
                                var module = group.Modules[0];
                                <li class="nav-item app-shell__nav-item">
                                    <a class="@GetNavLinkClass(module)" asp-controller="@module.Controller" asp-action="@module.Action">@group.Label</a>
                                </li>
                                continue;
                            }

                            <li class="nav-item dropdown app-shell__nav-item">
                                <a class="@GetNavGroupClass(isActiveGroup)" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @group.Label
                                </a>
                                <ul class="dropdown-menu app-shell__dropdown-menu">
                                    @foreach (var module in group.Modules)
                                    {
                                        <li>
                                            <a class="@GetDropdownLinkClass(module)" asp-controller="@module.Controller" asp-action="@module.Action">@module.Label</a>
                                        </li>
                                    }
                                </ul>
                            </li>
                        }
                    </ul>

                    <div class="app-shell__actions">
                        <button type="button" class="app-shell__theme-toggle" data-theme-toggle aria-label="Activar modo oscuro" aria-pressed="false" title="Activar modo oscuro">
                            <span class="app-shell__theme-toggle-track" aria-hidden="true">
                                <span class="app-shell__theme-toggle-orb"></span>
                            </span>
                            <span class="visually-hidden" data-theme-toggle-label>Activar modo oscuro</span>
                        </button>
                        @if (User?.Identity?.IsAuthenticated == true)
                        {
                            <div class="app-shell__user-chip" title="@userDisplayName">
                                <span class="app-shell__user-name">@userDisplayName</span>
                            </div>
                            <a class="app-shell__session-link is-danger" asp-area="MicrosoftIdentity" asp-controller="Account" asp-action="SignOut">
                                Cerrar sesion
                            </a>
                        }
                        else
                        {
                            <a class="app-shell__session-link is-primary" asp-area="MicrosoftIdentity" asp-controller="Account" asp-action="SignIn">
                                Iniciar sesion
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </nav>
</header>

<div class="container-xl app-shell__content pb-4">
    <main role="main">
        @RenderBody()
    </main>
</div>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
