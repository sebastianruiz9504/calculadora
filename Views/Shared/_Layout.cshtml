@using System.Globalization
@using System.Security.Claims
@using CotizadorInterno.Web.Models.Permissions
@using Microsoft.Identity.Web
@inject IDataverseService Dataverse
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    CurrentUserInfo? layoutCurrentUser = null;

    if (User?.Identity?.IsAuthenticated == true)
    {
        try
        {
            layoutCurrentUser = await Dataverse.GetCurrentUserAsync(Context.RequestAborted);
        }
        catch
        {
            layoutCurrentUser = null;
        }
    }

    var canAccessRenovaciones = layoutCurrentUser?.HasModule(AppModuleCatalog.Renovaciones.OptionValue) == true;
    var canAccessPortalProveedores = layoutCurrentUser?.HasModule(AppModuleCatalog.PortalProveedores.OptionValue) == true;
    var canAccessPuntajes = layoutCurrentUser?.HasModule(AppModuleCatalog.Puntajes.OptionValue) == true;
    var canAccessMetricas = false;
    var canAccessNomina = layoutCurrentUser?.HasModule(AppModuleCatalog.Nomina.OptionValue) == true;
    var canAccessRh = layoutCurrentUser?.HasModule(AppModuleCatalog.Rh.OptionValue) == true;
    var canAccessGestionHumana = layoutCurrentUser?.HasModule(AppModuleCatalog.GestionHumana.OptionValue) == true;

    string GetNavLinkClass(string controller)
    {
        return currentController.Equals(controller, StringComparison.OrdinalIgnoreCase)
            ? "app-shell__nav-link is-active"
            : "app-shell__nav-link";
    }

    string NormalizeUserDisplayName(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "Usuario";
        }

        var trimmed = value.Trim();
        if (!trimmed.Contains('@'))
        {
            return trimmed;
        }

        var localPart = trimmed.Split('@', 2)[0]
            .Replace('.', ' ')
            .Replace('_', ' ')
            .Replace('-', ' ');

        return CultureInfo.CurrentCulture.TextInfo.ToTitleCase(localPart.ToLowerInvariant());
    }

    string ResolveUserDisplayName()
    {
        var principal = User;
        if (principal is null)
        {
            return "Usuario";
        }

        var givenName = principal.FindFirstValue(ClaimTypes.GivenName);
        var surname = principal.FindFirstValue(ClaimTypes.Surname);
        var fullName = string.Join(" ", new[] { givenName, surname }.Where(static part => !string.IsNullOrWhiteSpace(part)));

        return NormalizeUserDisplayName(
            principal.FindFirstValue("name")
            ?? principal.FindFirstValue(ClaimTypes.Name)
            ?? (string.IsNullOrWhiteSpace(fullName) ? null : fullName)
            ?? principal.GetDisplayName()
            ?? principal.Identity?.Name
            ?? principal.FindFirstValue("preferred_username")
            ?? principal.FindFirstValue(ClaimTypes.Upn)
            ?? principal.FindFirstValue(ClaimTypes.Email));
    }

    var navItems = new[]
    {
        new { Controller = "Calculator", Label = "Calculadora", Visible = true },
        new { Controller = "Renovaciones", Label = "Renovaciones", Visible = canAccessRenovaciones },
        new { Controller = "Puntajes", Label = "Puntajes", Visible = canAccessPuntajes },
        new { Controller = "Metricas", Label = "Metricas", Visible = canAccessMetricas },
        new { Controller = "LiquidacionNominas", Label = "Nomina", Visible = canAccessNomina },
        new { Controller = "Rh", Label = "RH", Visible = canAccessRh },
        new { Controller = "GestionHumana", Label = "Gestion humana", Visible = canAccessGestionHumana },
        new { Controller = "PortalProveedores", Label = "Proveedores", Visible = canAccessPortalProveedores }
    };
    var userDisplayName = ResolveUserDisplayName();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Digital Tech</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CotizadorInterno.Web.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="app-shell">
<header class="app-shell__header">
    <nav class="navbar navbar-expand-lg app-shell__navbar">
        <div class="container-xl">
            <div class="app-shell__nav-frame">
                <a class="app-shell__brand" href="~/">
                    <span class="app-shell__brand-title">Digital Tech</span>
                </a>

                <button class="navbar-toggler app-shell__toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation" aria-expanded="false" aria-label="Alternar navegacion">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse app-shell__collapse" id="mainNavigation">
                    <ul class="navbar-nav app-shell__nav-list">
                        @foreach (var item in navItems)
                        {
                            if (!item.Visible)
                            {
                                continue;
                            }

                            <li class="nav-item">
                                <a class="@GetNavLinkClass(item.Controller)" asp-controller="@item.Controller" asp-action="Index">@item.Label</a>
                            </li>
                        }
                    </ul>

                    <div class="app-shell__actions">
                        @if (User?.Identity?.IsAuthenticated == true)
                        {
                            <div class="app-shell__user-chip" title="@userDisplayName">
                                <span class="app-shell__user-name">@userDisplayName</span>
                            </div>
                            <a class="app-shell__session-link is-danger" asp-area="MicrosoftIdentity" asp-controller="Account" asp-action="SignOut">
                                Cerrar sesion
                            </a>
                        }
                        else
                        {
                            <a class="app-shell__session-link is-primary" asp-area="MicrosoftIdentity" asp-controller="Account" asp-action="SignIn">
                                Iniciar sesion
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </nav>
</header>

<div class="container-xl app-shell__content pb-4">
    <main role="main">
        @RenderBody()
    </main>
</div>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
