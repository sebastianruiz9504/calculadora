@using Microsoft.Identity.Web
@{
    var canAccessRenovaciones = RenovacionesAccessPolicy.HasAccess(User);
    var canAccessPortalProveedores = PortalProveedoresAccessPolicy.HasAccess(User);
    var canAccessPuntajes = PuntajesAccessPolicy.HasAccess(User);
    var canAccessMetricas = MetricasAccessPolicy.HasAccess(User);
    var canAccessNomina = NominaAccessPolicy.HasAccess(User);
    var canAccessRh = RhAccessPolicy.HasAccess(User);
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;

    string GetNavLinkClass(string controller)
    {
        return currentController.Equals(controller, StringComparison.OrdinalIgnoreCase)
            ? "app-shell__nav-link is-active"
            : "app-shell__nav-link";
    }

    var navItems = new[]
    {
        new { Controller = "Calculator", Label = "Calculadora", Visible = true },
        new { Controller = "Renovaciones", Label = "Renovaciones", Visible = canAccessRenovaciones },
        new { Controller = "Puntajes", Label = "Puntajes", Visible = canAccessPuntajes },
        new { Controller = "Metricas", Label = "Metricas", Visible = canAccessMetricas },
        new { Controller = "LiquidacionNominas", Label = "Nomina", Visible = canAccessNomina },
        new { Controller = "Rh", Label = "RH", Visible = canAccessRh },
        new { Controller = "PortalProveedores", Label = "Proveedores", Visible = canAccessPortalProveedores }
    };
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Digital Tech</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CotizadorInterno.Web.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="app-shell">
<header class="app-shell__header">
    <nav class="navbar navbar-expand-lg app-shell__navbar">
        <div class="container-xl">
            <div class="app-shell__nav-frame">
                <a class="app-shell__brand" asp-controller="Calculator" asp-action="Index">
                    <span class="app-shell__brand-mark" aria-hidden="true">DT</span>
                    <span class="app-shell__brand-text">
                        <span class="app-shell__brand-title">Digital Tech</span>
                        <span class="app-shell__brand-caption">Plataforma interna</span>
                    </span>
                </a>

                <button class="navbar-toggler app-shell__toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation" aria-expanded="false" aria-label="Alternar navegacion">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse app-shell__collapse" id="mainNavigation">
                    <ul class="navbar-nav app-shell__nav-list">
                        @foreach (var item in navItems)
                        {
                            if (!item.Visible)
                            {
                                continue;
                            }

                            <li class="nav-item">
                                <a class="@GetNavLinkClass(item.Controller)" asp-controller="@item.Controller" asp-action="Index">@item.Label</a>
                            </li>
                        }
                    </ul>

                    <div class="app-shell__actions">
                        @if (User?.Identity?.IsAuthenticated == true)
                        {
                            <div class="app-shell__user-chip" title="@User.Identity!.Name">
                                <span class="app-shell__user-eyebrow">Usuario</span>
                                <span class="app-shell__user-name">@User.Identity!.Name</span>
                            </div>
                            <a class="app-shell__session-link" asp-area="MicrosoftIdentity" asp-controller="Account" asp-action="SignOut">
                                Cerrar sesion
                            </a>
                        }
                        else
                        {
                            <a class="app-shell__session-link is-primary" asp-area="MicrosoftIdentity" asp-controller="Account" asp-action="SignIn">
                                Iniciar sesion
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </nav>
</header>

<div class="container-xl app-shell__content pb-4">
    <main role="main">
        @RenderBody()
    </main>
</div>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
