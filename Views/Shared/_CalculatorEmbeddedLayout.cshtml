<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Digital Tech</title>
    <link rel="icon" type="image/png" href="~/favicon.png" asp-append-version="true" />
    <script>
        (function () {
            try {
                if (localStorage.getItem("cotizador-interno-theme") === "dark") {
                    document.documentElement.setAttribute("data-bs-theme", "dark");
                    document.documentElement.classList.add("app-theme-dark");
                }
            } catch {
                document.documentElement.setAttribute("data-bs-theme", "light");
            }
        })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CotizadorInterno.Web.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/css/dark-mode.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/font-weight-reset.css" asp-append-version="true" />
</head>
<body class="calculator-embedded-body">
    <main class="calculator-embedded-main" role="main">
        @RenderBody()
    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
