@model HomePageViewModel
@{
    ViewData["Title"] = "Inicio";
    var availableModulesCount = Model.AvailableModules.Count;
    var pendingTasksCount = Model.PendingTasks.Count;
    var primaryModule = Model.AvailableModules.FirstOrDefault();
    var userEmail = string.IsNullOrWhiteSpace(Model.CurrentUser.Email)
        ? "Sin correo disponible"
        : Model.CurrentUser.Email;
    var availableModuleGroups = Model.AvailableModules
        .GroupBy(static module => module.Category)
        .Select(static group => new
        {
            Name = group.Key,
            Modules = group.ToList()
        })
        .ToList();
    var planRioModule = Model.AvailableModules.FirstOrDefault(static module => module.Key == AppModule.PlanRio);
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<div class="home-shell">
    <section class="home-hero">
        <div class="home-hero__content">
            <div>
                <div class="home-kicker">Digital Tech</div>
                <h1 class="home-title">Bienvenido, @Model.UserDisplayName</h1>
                <p class="home-subtitle">
                    Este es tu punto de entrada. Desde aqui puedes abrir los modulos habilitados para tu perfil y mantener la navegacion en una sola sintonia visual.
                </p>
            </div>
            <div class="home-user-pill">
                <span class="home-user-pill__label">Usuario activo</span>
                <span>@userEmail</span>
            </div>
        </div>

        <div class="home-insights">
            <article class="home-insight">
                <span class="home-insight__label">Modulos habilitados</span>
                <strong class="home-insight__value">@availableModulesCount</strong>
            </article>
            <article class="home-insight">
                <span class="home-insight__label">Modulo principal</span>
                <strong class="home-insight__value">@(primaryModule?.Label ?? "Pendiente")</strong>
            </article>
            <article class="home-insight">
                <span class="home-insight__label">Perfil</span>
                <strong class="home-insight__value">@(availableModulesCount > 0 ? "Con acceso" : "Sin acceso")</strong>
            </article>
        </div>
    </section>

    @if (Model.CurrentUser.HasPermissionLoadWarning)
    {
        <section class="home-card home-card--warning">
            <div class="home-kicker">Diagnostico</div>
            <h2 class="home-section-title">La sesion cargo, pero la lectura de permisos fallo</h2>
            <p class="home-section-subtitle">
                La aplicacion continuo en modo degradado para no enviarte a la pagina generica de error. Si tus modulos no aparecen, revisa el detalle tecnico.
            </p>
            <details class="home-warning__details">
                <summary>Ver error exacto</summary>
                <pre class="home-warning__pre">@Model.CurrentUser.PermissionLoadWarning</pre>
            </details>
        </section>
    }

    <section class="home-card home-tasks" data-home-tasks>
        <div class="home-card__header">
            <div>
                <div class="home-kicker">Tareas</div>
                <h2 class="home-section-title">Pendientes asignadas a ti</h2>
                <p class="home-section-subtitle">
                    @pendingTasksCount tarea(s) pendiente(s).
                </p>
            </div>
            <button type="button" class="btn btn-primary home-task-create-button" data-task-create-open>Nueva tarea</button>
        </div>

        @if (pendingTasksCount > 0)
        {
            <div class="home-task-list">
                @foreach (var task in Model.PendingTasks)
                {
                    <article class="home-task-row" data-task-id="@task.TaskId" data-task-title="@task.Title" data-task-manual="@task.IsManual.ToString().ToLowerInvariant()">
                        <div class="home-task-row__main">
                            <div class="home-task-row__meta">
                                <span>@task.Module</span>
                                @if (!string.IsNullOrWhiteSpace(task.DueDateDisplay))
                                {
                                    <span>Vence @task.DueDateDisplay</span>
                                }
                                @if (task.PendingCount > 1)
                                {
                                    <span>@task.PendingCount pendientes</span>
                                }
                            </div>
                            <h3>@task.Title</h3>
                            <p>@task.Description</p>
                        </div>
                        <div class="home-task-row__actions">
                            @if (task.CanExecute)
                            {
                                <a class="btn btn-secondary" href="@task.ActionUrl">Ejecutar</a>
                            }
                            @if (task.CanCloseManually)
                            {
                                <button type="button" class="btn btn-ghost" data-task-close-open>Cerrar</button>
                            }
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="home-task-empty">
                No tienes tareas pendientes.
            </div>
        }
    </section>

    @if (availableModulesCount > 0)
    {
        <section class="home-card">
            <div class="home-card__header">
                <div>
                    <div class="home-kicker">Accesos</div>
                    <h2 class="home-section-title">Tus modulos disponibles</h2>
                    <p class="home-section-subtitle">
                        Haz clic en cualquier tarjeta para entrar directo al flujo correspondiente.
                    </p>
                </div>
            </div>

            <div class="home-module-groups">
                @foreach (var group in availableModuleGroups)
                {
                    <div class="home-module-group">
                        <h3 class="home-module-group__title">@group.Name</h3>
                        <div class="home-module-grid">
                            @foreach (var module in group.Modules)
                            {
                                <a class="home-module-card" asp-controller="@module.Controller" asp-action="@module.Action" data-category="@module.Category">
                                    <span class="home-module-card__eyebrow">@module.Category</span>
                                    <strong class="home-module-card__title">@module.Label</strong>
                                    <span class="home-module-card__description">@module.Description</span>
                                    <span class="home-module-card__action">Abrir modulo</span>
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>
        </section>
    }
    else
    {
        <section class="home-card home-card--empty">
            <div class="home-empty">
                <div class="home-kicker">Acceso restringido</div>
                <h2 class="home-section-title">No tienes modulos asignados</h2>
                <p class="home-section-subtitle">
                    El acceso depende de la columna <code>cr07a_modulos</code> en <code>cr07a_empleado</code>. Cuando tu perfil tenga modulos activos, apareceran aqui en formato de tarjetas.
                </p>
                <div class="home-empty__meta">
                    Usuario autenticado: <strong>@userEmail</strong>
                </div>
                @if (Model.CurrentUser.HasPermissionLoadWarning)
                {
                    <div class="home-empty__meta">
                        La carga de permisos reporto un error tecnico. Revisa el bloque de diagnostico de esta pagina.
                    </div>
                }
            </div>
        </section>
    }

    @if (Model.CanManagePublicDataExport)
    {
        <section class="home-card">
            <div class="home-card__header">
                <div>
                    <div class="home-kicker">Portal publico</div>
                    <h2 class="home-section-title">Descargas aprobadas</h2>
                    <p class="home-section-subtitle">
                        Define la contrasena publica y las columnas disponibles para descargar Gastos Digital Tech y Facturacion Digital Tech.
                    </p>
                </div>
                <a class="btn btn-primary" asp-controller="DescargasPublicas" asp-action="Admin">Administrar portal</a>
            </div>
        </section>
    }

    @if (planRioModule is not null)
    {
        <section class="home-card">
            <div class="home-card__header">
                <div>
                    <div class="home-kicker">Nuevo</div>
                    <h2 class="home-section-title">Plan Rio 70.3</h2>
                    <p class="home-section-subtitle">Consulta tus entrenos de la semana, registra cada sesion y revisa tu progresion en graficas.</p>
                </div>
                <a class="btn btn-primary" asp-controller="@planRioModule.Controller" asp-action="@planRioModule.Action">Abrir modulo</a>
            </div>
        </section>
    }
</div>

<div class="home-modal" data-task-create-modal hidden>
    <div class="home-modal__backdrop" data-task-modal-close></div>
    <form class="home-modal__panel" data-task-create-form>
        <div class="home-modal__header">
            <h2>Nueva tarea</h2>
            <button type="button" class="home-modal__close" data-task-modal-close aria-label="Cerrar">x</button>
        </div>
        <label class="home-field">
            <span>Responsable</span>
            <input type="search" data-task-user-search autocomplete="off" placeholder="Buscar usuario" />
            <input type="hidden" data-task-user-id />
            <div class="home-lookup-menu" data-task-user-menu hidden></div>
        </label>
        <label class="home-field">
            <span>Correo</span>
            <input type="email" data-task-user-email required />
        </label>
        <label class="home-field">
            <span>Fecha limite</span>
            <input type="date" data-task-due-date required />
        </label>
        <label class="home-field">
            <span>Descripcion</span>
            <textarea data-task-description rows="5" required></textarea>
        </label>
        <div class="home-modal__status" data-task-create-status></div>
        <div class="home-modal__actions">
            <button type="button" class="btn btn-ghost" data-task-modal-close>Cancelar</button>
            <button type="submit" class="btn btn-primary">Crear</button>
        </div>
    </form>
</div>

<div class="home-modal" data-task-close-modal hidden>
    <div class="home-modal__backdrop" data-task-modal-close></div>
    <form class="home-modal__panel" data-task-close-form>
        <div class="home-modal__header">
            <h2>Cerrar tarea</h2>
            <button type="button" class="home-modal__close" data-task-modal-close aria-label="Cerrar">x</button>
        </div>
        <input type="hidden" data-task-close-id />
        <div class="home-task-close-title" data-task-close-title></div>
        <label class="home-field">
            <span>Comentarios</span>
            <textarea data-task-close-comments rows="4"></textarea>
        </label>
        <label class="home-field">
            <span>Adjunto</span>
            <input type="file" data-task-close-attachment />
        </label>
        <div class="home-modal__status" data-task-close-status></div>
        <div class="home-modal__actions">
            <button type="button" class="btn btn-ghost" data-task-modal-close>Cancelar</button>
            <button type="submit" class="btn btn-primary">Cerrar tarea</button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/home-tasks.js" asp-append-version="true"></script>
}
