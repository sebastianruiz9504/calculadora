@model HomePageViewModel
@{
    ViewData["Title"] = "Inicio";
    var availableModulesCount = Model.AvailableModules.Count;
    var primaryModule = Model.AvailableModules.FirstOrDefault();
    var userEmail = string.IsNullOrWhiteSpace(Model.CurrentUser.Email)
        ? "Sin correo disponible"
        : Model.CurrentUser.Email;
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<div class="home-shell">
    <section class="home-hero">
        <div class="home-hero__content">
            <div>
                <div class="home-kicker">Digital Tech</div>
                <h1 class="home-title">Bienvenido, @Model.UserDisplayName</h1>
                <p class="home-subtitle">
                    Este es tu punto de entrada. Desde aqui puedes abrir los modulos habilitados para tu perfil y mantener la navegacion en una sola sintonia visual.
                </p>
            </div>
            <div class="home-user-pill">
                <span class="home-user-pill__label">Usuario activo</span>
                <span>@userEmail</span>
            </div>
        </div>

        <div class="home-insights">
            <article class="home-insight">
                <span class="home-insight__label">Modulos habilitados</span>
                <strong class="home-insight__value">@availableModulesCount</strong>
            </article>
            <article class="home-insight">
                <span class="home-insight__label">Modulo principal</span>
                <strong class="home-insight__value">@(primaryModule?.Label ?? "Pendiente")</strong>
            </article>
            <article class="home-insight">
                <span class="home-insight__label">Perfil</span>
                <strong class="home-insight__value">@(availableModulesCount > 0 ? "Con acceso" : "Sin acceso")</strong>
            </article>
        </div>
    </section>

    @if (Model.CurrentUser.HasPermissionLoadWarning)
    {
        <section class="home-card home-card--warning">
            <div class="home-kicker">Diagnostico</div>
            <h2 class="home-section-title">La sesion cargo, pero la lectura de permisos fallo</h2>
            <p class="home-section-subtitle">
                La aplicacion continuo en modo degradado para no enviarte a la pagina generica de error. Si tus modulos no aparecen, revisa el detalle tecnico.
            </p>
            <details class="home-warning__details">
                <summary>Ver error exacto</summary>
                <pre class="home-warning__pre">@Model.CurrentUser.PermissionLoadWarning</pre>
            </details>
        </section>
    }

    @if (availableModulesCount > 0)
    {
        <section class="home-card">
            <div class="home-card__header">
                <div>
                    <div class="home-kicker">Accesos</div>
                    <h2 class="home-section-title">Tus modulos disponibles</h2>
                    <p class="home-section-subtitle">
                        Haz clic en cualquier tarjeta para entrar directo al flujo correspondiente.
                    </p>
                </div>
            </div>

            <div class="home-module-grid">
                @foreach (var module in Model.AvailableModules)
                {
                    <a class="home-module-card" asp-controller="@module.Controller" asp-action="@module.Action" data-category="@module.Category">
                        <span class="home-module-card__eyebrow">@module.Category</span>
                        <strong class="home-module-card__title">@module.Label</strong>
                        <span class="home-module-card__description">@module.Description</span>
                        <span class="home-module-card__action">Abrir modulo</span>
                    </a>
                }
            </div>
        </section>
    }
    else
    {
        <section class="home-card home-card--empty">
            <div class="home-empty">
                <div class="home-kicker">Acceso restringido</div>
                <h2 class="home-section-title">No tienes modulos asignados</h2>
                <p class="home-section-subtitle">
                    El acceso depende de la columna <code>cr07a_modulos</code> en <code>cr07a_empleado</code>. Cuando tu perfil tenga modulos activos, apareceran aqui en formato de tarjetas.
                </p>
                <div class="home-empty__meta">
                    Usuario autenticado: <strong>@userEmail</strong>
                </div>
                @if (Model.CurrentUser.HasPermissionLoadWarning)
                {
                    <div class="home-empty__meta">
                        La carga de permisos reporto un error tecnico. Revisa el bloque de diagnostico de esta pagina.
                    </div>
                }
            </div>
        </section>
    }
</div>
