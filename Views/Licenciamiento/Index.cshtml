@model CotizadorInterno.Web.Models.Licenciamiento.LicenciamientoPageViewModel
@{
    ViewData["Title"] = "Licenciamiento";
}

@section Styles {
    <link rel="stylesheet" href="~/css/licenciamiento.css" asp-append-version="true" />
}

<div class="lic-shell"
     id="licenciamientoApp"
     data-load-url="@Url.Action("Data", "Licenciamiento")"
     data-preview-url="@Url.Action("Preview", "Licenciamiento")"
     data-account-search-url="@Url.Action("AccountLookupSearch", "Licenciamiento")"
     data-client-search-url="@Url.Action("ClientLookupSearch", "Licenciamiento")"
     data-product-search-url="@Url.Action("ProductLookupSearch", "Licenciamiento")"
     data-register-account-url="@Url.Action("RegisterAccountId", "Licenciamiento")"
     data-register-product-url="@Url.Action("RegisterProduct", "Licenciamiento")"
     data-import-url="@Url.Action("Import", "Licenciamiento")"
     data-adjust-trm-url="@Url.Action("AdjustTrm", "Licenciamiento")"
     data-update-contract-url="@Url.Action("UpdateContractType", "Licenciamiento")"
     data-update-sales-price-url="@Url.Action("UpdateSalesPrice", "Licenciamiento")">
    <section class="lic-hero">
        <div>
            <div class="lic-kicker">Gerencia</div>
            <h1 class="lic-title">Licenciamiento</h1>
            <p class="lic-subtitle">Consumo Intcomex mensual en cr07a_consumointcomex.</p>
        </div>
        <div class="lic-user-pill">
            <span class="lic-user-pill__label">Usuario</span>
            <span>@Model.CurrentUser.Email</span>
        </div>
    </section>

    <div id="licStatus" class="lic-status" role="status" aria-live="polite"></div>

    <section class="lic-panel">
        <div class="lic-panel__header">
            <div>
                <div class="lic-kicker">Dataverse</div>
                <h2 class="lic-section-title">Consumos cargados</h2>
            </div>
            <div class="lic-panel__actions">
                <span class="lic-counter" id="licSelectedCount">0 seleccionados</span>
                <button type="button" class="btn btn-outline-secondary" id="licRefreshBtn">Actualizar</button>
                <button type="button" class="btn btn-outline-secondary" id="licClearFiltersBtn">Limpiar filtros</button>
                <button type="button" class="btn btn-outline-secondary" id="licContractBtn">Ajustar tipo de contrato</button>
                <button type="button" class="btn btn-outline-secondary" id="licTrmBtn">Ajustar TRM</button>
                <button type="button" class="btn btn-primary" id="licNewBtn">Nuevo ingreso</button>
            </div>
        </div>

        <div class="lic-kpis">
            <div class="lic-kpi">
                <span>Registros</span>
                <strong id="licTotalCount">0</strong>
            </div>
            <div class="lic-kpi">
                <span>Total USD</span>
                <strong id="licTotalUsd">USD 0</strong>
            </div>
            <div class="lic-kpi">
                <span>Total COP</span>
                <strong id="licTotalCop">$0</strong>
            </div>
        </div>

        <div class="lic-table-wrap">
            <table class="table align-middle lic-table">
                <thead>
                    <tr>
                        <th class="lic-check-cell">
                            <input class="form-check-input" type="checkbox" id="licSelectAll" aria-label="Seleccionar todos" />
                        </th>
                        <th>
                            <button type="button" class="lic-sort-btn" data-lic-sort="nombreCliente">Cliente<span data-lic-sort-icon="nombreCliente"></span></button>
                            <input class="form-control form-control-sm lic-column-filter" data-lic-filter="nombreCliente" type="search" placeholder="Filtrar" />
                        </th>
                        <th>
                            <button type="button" class="lic-sort-btn" data-lic-sort="companyAccountDisplay">Cuenta<span data-lic-sort-icon="companyAccountDisplay"></span></button>
                            <input class="form-control form-control-sm lic-column-filter" data-lic-filter="companyAccountDisplay" type="search" placeholder="Filtrar" />
                        </th>
                        <th>
                            <button type="button" class="lic-sort-btn" data-lic-sort="vendor">Vendor<span data-lic-sort-icon="vendor"></span></button>
                            <input class="form-control form-control-sm lic-column-filter" data-lic-filter="vendor" type="search" placeholder="Filtrar" />
                        </th>
                        <th>
                            <button type="button" class="lic-sort-btn" data-lic-sort="productDisplay">Producto<span data-lic-sort-icon="productDisplay"></span></button>
                            <input class="form-control form-control-sm lic-column-filter" data-lic-filter="productDisplay" type="search" placeholder="Filtrar" />
                        </th>
                        <th>
                            <button type="button" class="lic-sort-btn" data-lic-sort="facturaValue">Factura<span data-lic-sort-icon="facturaValue"></span></button>
                            <input class="form-control form-control-sm lic-column-filter" data-lic-filter="facturaValue" type="search" placeholder="Filtrar" />
                        </th>
                        <th class="text-end">
                            <button type="button" class="lic-sort-btn lic-sort-btn--end" data-lic-sort="valorTotalUsd">USD<span data-lic-sort-icon="valorTotalUsd"></span></button>
                            <input class="form-control form-control-sm lic-column-filter text-end" data-lic-filter="valorTotalUsd" type="search" placeholder="Filtrar" />
                        </th>
                        <th class="text-end">
                            <button type="button" class="lic-sort-btn lic-sort-btn--end" data-lic-sort="trm">TRM<span data-lic-sort-icon="trm"></span></button>
                            <input class="form-control form-control-sm lic-column-filter text-end" data-lic-filter="trm" type="search" placeholder="Filtrar" />
                        </th>
                        <th class="text-end">
                            <button type="button" class="lic-sort-btn lic-sort-btn--end" data-lic-sort="pesosTotal">COP<span data-lic-sort-icon="pesosTotal"></span></button>
                            <input class="form-control form-control-sm lic-column-filter text-end" data-lic-filter="pesosTotal" type="search" placeholder="Filtrar" />
                        </th>
                        <th>
                            <button type="button" class="lic-sort-btn" data-lic-sort="contractTypeLabel">Tipo<span data-lic-sort-icon="contractTypeLabel"></span></button>
                            <input class="form-control form-control-sm lic-column-filter" data-lic-filter="contractTypeLabel" type="search" placeholder="Filtrar" />
                        </th>
                    </tr>
                </thead>
                <tbody id="licRowsBody"></tbody>
            </table>
        </div>
        <div class="lic-empty" id="licEmpty" hidden>No hay consumos cargados.</div>
    </section>
</div>

<div class="lic-modal" id="licUploadModal" hidden>
    <div class="lic-modal__backdrop" data-lic-close></div>
    <div class="lic-modal__dialog lic-modal__dialog--wide" role="dialog" aria-modal="true" aria-labelledby="licUploadTitle">
        <div class="lic-modal__header">
            <div>
                <div class="lic-kicker">Nuevo ingreso</div>
                <h2 class="lic-modal__title" id="licUploadTitle">Excel de consumo</h2>
            </div>
            <button type="button" class="btn btn-outline-secondary" data-lic-close>Cerrar</button>
        </div>
        <div id="licUploadStatus" class="lic-status" role="status" aria-live="polite"></div>
        <form class="lic-form" id="licUploadForm">
            <label class="lic-field">
                <span>Archivo</span>
                <input class="form-control" id="licExcelFile" type="file" accept=".xlsx,.xlsm" />
            </label>

            <div class="lic-preview-summary" id="licPreviewSummary" hidden>
                <div>
                    <span>Filas</span>
                    <strong id="licPreviewRowsCount">0</strong>
                </div>
                <div>
                    <span>Validas</span>
                    <strong id="licPreviewValidCount">0</strong>
                </div>
                <div>
                    <span>Listas ocultas</span>
                    <strong id="licPreviewHiddenCount">0</strong>
                </div>
                <div>
                    <span>Total USD</span>
                    <strong id="licPreviewTotalUsd">USD 0</strong>
                </div>
            </div>

            <div class="lic-preview-workspace" id="licPreviewWrap" hidden>
                <section class="lic-preview-section" id="licPreviewAccountSection" hidden>
                    <div class="lic-preview-section__header">
                        <h3>Account ID sin lookup</h3>
                        <span class="lic-counter" id="licPreviewAccountCount">0 grupos</span>
                    </div>
                    <div class="lic-table-wrap lic-table-wrap--compact">
                        <table class="table align-middle lic-table lic-table--account-issues">
                            <thead>
                                <tr>
                                    <th>Account ID</th>
                                    <th>Filas</th>
                                    <th>Clientes</th>
                                    <th>Accion</th>
                                </tr>
                            </thead>
                            <tbody id="licPreviewAccountBody"></tbody>
                        </table>
                    </div>
                </section>

                <section class="lic-preview-section" id="licPreviewProductSection" hidden>
                    <div class="lic-preview-section__header">
                        <h3>Producto pendiente</h3>
                        <span class="lic-counter" id="licPreviewProductCount">0 filas</span>
                    </div>
                    <div class="lic-table-wrap lic-table-wrap--preview">
                        <table class="table align-middle lic-table lic-table--preview">
                            <thead>
                                <tr>
                                    <th>Fila</th>
                                    <th>Cliente</th>
                                    <th>Cuenta</th>
                                    <th>Vendor</th>
                                    <th>Producto</th>
                                    <th>Factura</th>
                                    <th class="text-end">USD</th>
                                    <th>Tipo</th>
                                    <th>Accion</th>
                                </tr>
                            </thead>
                            <tbody id="licPreviewBody"></tbody>
                        </table>
                    </div>
                </section>

                <section class="lic-preview-section" id="licPreviewAzureSection" hidden>
                    <div class="lic-preview-section__header">
                        <h3>Azure</h3>
                        <span class="lic-counter" id="licPreviewAzureCount">0 filas</span>
                    </div>
                    <div class="lic-table-wrap lic-table-wrap--preview">
                        <table class="table align-middle lic-table lic-table--azure">
                            <thead>
                                <tr>
                                    <th>Fila</th>
                                    <th>Cliente</th>
                                    <th>Cuenta</th>
                                    <th>Producto</th>
                                    <th class="text-end">Sales Price</th>
                                    <th class="text-end">Cantidad</th>
                                    <th>Estado</th>
                                    <th>Accion</th>
                                </tr>
                            </thead>
                            <tbody id="licPreviewAzureBody"></tbody>
                        </table>
                    </div>
                </section>

                <section class="lic-preview-section" id="licPreviewDataSection" hidden>
                    <div class="lic-preview-section__header">
                        <h3>Errores de datos</h3>
                        <span class="lic-counter" id="licPreviewDataCount">0 filas</span>
                    </div>
                    <div class="lic-table-wrap lic-table-wrap--compact">
                        <table class="table align-middle lic-table lic-table--data-issues">
                            <thead>
                                <tr>
                                    <th>Fila</th>
                                    <th>Cliente</th>
                                    <th>Cuenta</th>
                                    <th>Producto</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody id="licPreviewDataBody"></tbody>
                        </table>
                    </div>
                </section>

                <div class="lic-empty" id="licPreviewClean" hidden>Todos los lookup estan resueltos.</div>
            </div>

            <div class="lic-modal__footer">
                <button type="button" class="btn btn-outline-secondary" data-lic-close>Cancelar</button>
                <button type="submit" class="btn btn-outline-primary" id="licPreviewBtn">Vista previa</button>
                <button type="button" class="btn btn-primary" id="licImportBtn" disabled>Procesar</button>
            </div>
        </form>
    </div>
</div>

<div class="lic-modal" id="licAccountRegistrationModal" hidden>
    <div class="lic-modal__backdrop" data-lic-account-close></div>
    <div class="lic-modal__dialog lic-modal__dialog--small" role="dialog" aria-modal="true" aria-labelledby="licAccountRegistrationTitle">
        <div class="lic-modal__header">
            <div>
                <div class="lic-kicker">Account ID</div>
                <h2 class="lic-modal__title" id="licAccountRegistrationTitle">Registrar ID</h2>
            </div>
            <button type="button" class="btn btn-outline-secondary" data-lic-account-close>Cerrar</button>
        </div>
        <div id="licAccountRegistrationStatus" class="lic-status" role="status" aria-live="polite"></div>
        <form class="lic-form" id="licAccountRegistrationForm">
            <label class="lic-field">
                <span>Account ID</span>
                <input class="form-control" id="licAccountIdInput" type="text" readonly />
            </label>
            <label class="lic-field">
                <span>Cliente</span>
                <div class="lic-lookup">
                    <input class="form-control lic-lookup-input"
                           id="licAccountClientInput"
                           type="search"
                           autocomplete="off"
                           placeholder="Buscar cliente..." />
                    <div class="lic-lookup-menu" id="licAccountClientMenu"></div>
                </div>
                <small class="lic-lookup-note is-warning" id="licAccountClientHelper">Busca y selecciona un cliente.</small>
            </label>
            <div class="lic-modal__footer">
                <button type="button" class="btn btn-outline-secondary" data-lic-account-close>Cancelar</button>
                <button type="submit" class="btn btn-primary" id="licAccountRegistrationSaveBtn">Guardar</button>
            </div>
        </form>
    </div>
</div>

<div class="lic-modal" id="licProductRegistrationModal" hidden>
    <div class="lic-modal__backdrop" data-lic-product-close></div>
    <div class="lic-modal__dialog lic-modal__dialog--small" role="dialog" aria-modal="true" aria-labelledby="licProductRegistrationTitle">
        <div class="lic-modal__header">
            <div>
                <div class="lic-kicker">Precios Cloud</div>
                <h2 class="lic-modal__title" id="licProductRegistrationTitle">Registrar producto</h2>
            </div>
            <button type="button" class="btn btn-outline-secondary" data-lic-product-close>Cerrar</button>
        </div>
        <div id="licProductRegistrationStatus" class="lic-status" role="status" aria-live="polite"></div>
        <form class="lic-form" id="licProductRegistrationForm">
            <label class="lic-field">
                <span>Producto</span>
                <textarea class="form-control" id="licProductDescriptionInput" rows="3" readonly></textarea>
            </label>
            <label class="lic-field">
                <span>Costo</span>
                <input class="form-control" id="licProductPurchasePriceInput" type="number" min="0" step="0.01" inputmode="decimal" />
            </label>
            <label class="lic-field">
                <span>Acelerador</span>
                <input class="form-control" id="licProductAceleradorInput" type="number" min="0" step="0.01" inputmode="decimal" />
            </label>
            <label class="lic-field">
                <span>Service Identifier</span>
                <input class="form-control" id="licProductServiceIdentifierInput" type="text" />
            </label>
            <div class="lic-modal__footer">
                <button type="button" class="btn btn-outline-secondary" data-lic-product-close>Cancelar</button>
                <button type="submit" class="btn btn-primary" id="licProductRegistrationSaveBtn">Enviar</button>
            </div>
        </form>
    </div>
</div>

<div class="lic-modal" id="licSalesPriceModal" hidden>
    <div class="lic-modal__backdrop" data-lic-sales-price-close></div>
    <div class="lic-modal__dialog lic-modal__dialog--small" role="dialog" aria-modal="true" aria-labelledby="licSalesPriceTitle">
        <div class="lic-modal__header">
            <div>
                <div class="lic-kicker">Azure</div>
                <h2 class="lic-modal__title" id="licSalesPriceTitle">Actualizar precio de venta</h2>
            </div>
            <button type="button" class="btn btn-outline-secondary" data-lic-sales-price-close>Cerrar</button>
        </div>
        <div id="licSalesPriceStatus" class="lic-status" role="status" aria-live="polite"></div>
        <form class="lic-form" id="licSalesPriceForm">
            <div class="lic-breakdown-summary">
                <div>
                    <span>Fila Excel</span>
                    <strong id="licSalesPriceRow">-</strong>
                </div>
                <div>
                    <span>Sales Price</span>
                    <strong id="licSalesPriceExcel">USD 0</strong>
                </div>
                <div>
                    <span>Unitario calculado</span>
                    <strong id="licSalesPriceUnit">USD 0</strong>
                </div>
            </div>
            <label class="lic-field">
                <span>Cliente</span>
                <input class="form-control" id="licSalesPriceClient" type="text" readonly />
            </label>
            <label class="lic-field">
                <span>Cuenta</span>
                <input class="form-control" id="licSalesPriceAccount" type="text" readonly />
            </label>
            <label class="lic-field">
                <span>Producto</span>
                <textarea class="form-control" id="licSalesPriceProduct" rows="3" readonly></textarea>
            </label>
            <label class="lic-field">
                <span>Cantidad Excel</span>
                <input class="form-control" id="licSalesPriceQuantity" type="text" readonly />
            </label>
            <div class="lic-modal__footer">
                <button type="button" class="btn btn-outline-secondary" data-lic-sales-price-close>Cancelar</button>
                <button type="submit" class="btn btn-primary" id="licSalesPriceSaveBtn">Confirmar</button>
            </div>
        </form>
    </div>
</div>

<div class="lic-modal" id="licBreakdownModal" hidden>
    <div class="lic-modal__backdrop" data-lic-breakdown-close></div>
    <div class="lic-modal__dialog lic-modal__dialog--breakdown" role="dialog" aria-modal="true" aria-labelledby="licBreakdownTitle">
        <div class="lic-modal__header">
            <div>
                <div class="lic-kicker">Desglose</div>
                <h2 class="lic-modal__title" id="licBreakdownTitle">Distribuir cargo manual</h2>
            </div>
            <button type="button" class="btn btn-outline-secondary" data-lic-breakdown-close>Cerrar</button>
        </div>
        <div id="licBreakdownStatus" class="lic-status" role="status" aria-live="polite"></div>
        <div class="lic-breakdown-summary">
            <div>
                <span>Producto original</span>
                <strong id="licBreakdownProduct">-</strong>
            </div>
            <div>
                <span>Total original</span>
                <strong id="licBreakdownOriginalTotal">USD 0</strong>
            </div>
            <div>
                <span>Saldo pendiente</span>
                <strong id="licBreakdownRemaining" class="lic-breakdown-total">USD 0</strong>
            </div>
        </div>
        <div class="lic-breakdown-toolbar">
            <div class="lic-muted">Cada fila debe seleccionar cliente, producto y valor. El saldo debe quedar exactamente en 0.</div>
            <button type="button" class="btn btn-outline-primary" id="licBreakdownAddRowBtn">Agregar fila</button>
        </div>
        <div class="lic-table-wrap lic-table-wrap--preview">
            <table class="table align-middle lic-table lic-table--breakdown">
                <thead>
                    <tr>
                        <th>Cliente</th>
                        <th>Producto</th>
                        <th class="text-end">Valor USD</th>
                        <th>Accion</th>
                    </tr>
                </thead>
                <tbody id="licBreakdownBody"></tbody>
            </table>
        </div>
        <div class="lic-modal__footer">
            <button type="button" class="btn btn-outline-secondary" data-lic-breakdown-close>Cancelar</button>
            <button type="button" class="btn btn-primary" id="licBreakdownSaveBtn">Guardar desglose</button>
        </div>
    </div>
</div>

<div class="lic-modal" id="licTrmModal" hidden>
    <div class="lic-modal__backdrop" data-lic-trm-close></div>
    <div class="lic-modal__dialog lic-modal__dialog--small" role="dialog" aria-modal="true" aria-labelledby="licTrmTitle">
        <div class="lic-modal__header">
            <div>
                <div class="lic-kicker">TRM</div>
                <h2 class="lic-modal__title" id="licTrmTitle">Ajustar periodo</h2>
            </div>
            <button type="button" class="btn btn-outline-secondary" data-lic-trm-close>Cerrar</button>
        </div>
        <div id="licTrmStatus" class="lic-status" role="status" aria-live="polite"></div>
        <form class="lic-form" id="licTrmForm">
            <label class="lic-field">
                <span>Factura</span>
                <select class="form-select" id="licFacturaSelect"></select>
                <small class="lic-muted" id="licTrmScopeNote"></small>
            </label>
            <label class="lic-field">
                <span>TRM</span>
                <input class="form-control" id="licTrmInput" type="number" min="0.01" step="0.01" inputmode="decimal" />
            </label>
            <div class="lic-modal__footer">
                <button type="button" class="btn btn-outline-secondary" data-lic-trm-close>Cancelar</button>
                <button type="submit" class="btn btn-primary" id="licTrmSaveBtn">Calcular</button>
            </div>
        </form>
    </div>
</div>

<div class="lic-modal" id="licContractModal" hidden>
    <div class="lic-modal__backdrop" data-lic-contract-close></div>
    <div class="lic-modal__dialog lic-modal__dialog--small" role="dialog" aria-modal="true" aria-labelledby="licContractTitle">
        <div class="lic-modal__header">
            <div>
                <div class="lic-kicker">Tipo de contrato</div>
                <h2 class="lic-modal__title" id="licContractTitle">Actualizar seleccion</h2>
            </div>
            <button type="button" class="btn btn-outline-secondary" data-lic-contract-close>Cerrar</button>
        </div>
        <div id="licContractStatus" class="lic-status" role="status" aria-live="polite"></div>
        <form class="lic-form" id="licContractForm">
            <label class="lic-field">
                <span>Opcion</span>
                <select class="form-select" id="licContractSelect"></select>
            </label>
            <div class="lic-modal__footer">
                <button type="button" class="btn btn-outline-secondary" data-lic-contract-close>Cancelar</button>
                <button type="submit" class="btn btn-primary" id="licContractSaveBtn">Confirmar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/licenciamiento.js" asp-append-version="true"></script>
}
