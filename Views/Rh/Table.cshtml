@model RhTablePageViewModel
@{
    ViewData["Title"] = $"RH - {Model.Module.Title}";
}

@section Styles {
    <link rel="stylesheet" href="~/css/rh.css" asp-append-version="true" />
}

<div class="rh-shell rh-shell--table"
     id="rhApp"
     data-table-key="@Model.Module.Key"
     data-load-url="@Url.Action("Data", "Rh")"
     data-save-url="@Url.Action("Save", "Rh")"
     data-upload-url="@Url.Action("UploadFile", "Rh")"
     data-download-url="@Url.Action("DownloadFile", "Rh")">
    <section class="rh-hero">
        <div>
            <a class="rh-back-link" asp-action="Index">Volver al menu RH</a>
            <div class="rh-kicker">@Model.Module.Subtitle</div>
            <h1 class="rh-title">@Model.Module.Title</h1>
            <p class="rh-subtitle">@Model.Module.Description</p>
        </div>
        <div class="rh-user-pill">
            <span class="rh-user-pill__label">Acceso</span>
            <span>@Model.CurrentUser.Email</span>
        </div>
    </section>

    <div id="rhStatusBanner" class="rh-status" role="status" aria-live="polite"></div>

    <section class="rh-card">
        <div class="rh-toolbar">
            <div>
                <div class="rh-kicker">Edicion</div>
                <h2 class="rh-section-title">Listado y formulario</h2>
                <p class="rh-section-subtitle">Selecciona un registro para editarlo o crea uno nuevo.</p>
            </div>
            <div class="rh-toolbar__actions">
                <button type="button" class="btn btn-outline-secondary" id="rhRefreshBtn">Recargar</button>
                <button type="button" class="btn btn-outline-primary" id="rhNewBtn">Nuevo registro</button>
                <button type="button" class="btn btn-primary" id="rhSaveBtn">Guardar cambios</button>
            </div>
        </div>
    </section>

    <section class="rh-card">
        <div class="rh-section-header">
            <div>
                <div class="rh-kicker">Registros</div>
                <h2 class="rh-section-title">Tabla actual</h2>
                <p class="rh-section-subtitle" id="rhTableDescription">@Model.Module.Description</p>
            </div>
            <div class="rh-counter" id="rhRecordsCount">0 registros</div>
        </div>

        <div class="rh-table-wrap">
            <table class="table align-middle rh-list-table">
                <thead id="rhListHead"></thead>
                <tbody id="rhListBody"></tbody>
            </table>
        </div>

        <div id="rhEmptyState" class="rh-empty-state" hidden>
            No hay registros todavia.
        </div>
    </section>

    <section class="rh-card">
        <div class="rh-section-header">
            <div>
                <div class="rh-kicker">Formulario</div>
                <h2 class="rh-section-title" id="rhFormTitle">Nuevo registro</h2>
                <p class="rh-section-subtitle" id="rhFormSubtitle">Completa los campos y guarda.</p>
            </div>
            <div class="rh-record-pill" id="rhRecordPill">Sin guardar</div>
        </div>

        <div id="rhFormBody" class="rh-form-grid"></div>
    </section>
</div>

@section Scripts {
    <script src="~/js/rh.js" asp-append-version="true"></script>
}
