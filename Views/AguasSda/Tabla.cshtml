@model CotizadorInterno.Web.Models.AguasSda.AguasSdaGenericTableViewModel
@{
    ViewData["Title"] = Model.Title;
}

@section Styles {
    <link rel="stylesheet" href="~/css/aguas-sda.css" asp-append-version="true" />
}

<div class="ags-shell" data-aguas-sda-mode="tabla">
    <header class="ags-page-head">
        <div>
            <p class="ags-kicker">Aguas de Bogota SDA</p>
            <h1>@Model.Title</h1>
            @if (!string.IsNullOrWhiteSpace(Model.Subtitle))
            {
                <p>@Model.Subtitle</p>
            }
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.LoadWarning))
    {
        <div class="ags-status is-error">@Model.LoadWarning</div>
    }

    <section class="ags-panel">
        <div class="ags-panel-head">
            <div>
                <h2>Registros</h2>
                <p>@Model.Rows.Count fila(s)</p>
            </div>
            <input class="form-control ags-table-filter" type="search" placeholder="Filtrar" data-table-filter="#agsGenericTable" />
        </div>
        <div class="ags-table-wrap">
            <table class="ags-table" id="agsGenericTable">
                <thead>
                <tr>
                    @foreach (var column in Model.Columns)
                    {
                        <th data-sort="text">@column.Label</th>
                    }
                </tr>
                </thead>
                <tbody>
                @if (Model.Rows.Count == 0)
                {
                    <tr class="ags-empty-row"><td colspan="@Math.Max(Model.Columns.Count, 1)">Sin registros.</td></tr>
                }
                else
                {
                    foreach (var row in Model.Rows)
                    {
                        <tr>
                            @foreach (var column in Model.Columns)
                            {
                                <td>@(row.Values.TryGetValue(column.Key, out var value) ? value : "")</td>
                            }
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/js/aguas-sda.js" asp-append-version="true"></script>
}
