@model ConciliacionPageViewModel
@{ ViewData["Title"] = "Flujo de caja directo"; }
@section Styles {
    <link rel="stylesheet" href="~/css/direct-cash-flow.css" asp-append-version="true" />
}
<div class="dcf-shell" id="directCashFlowApp" data-year="@Model.Board.Year" data-month="@Model.Board.Month">
    @Html.AntiForgeryToken()
    <nav class="dcf-tabs" aria-label="Conciliación">
        <a href="@Url.Action("Index",new {year=Model.Board.Year,month=Model.Board.Month})#tab=deducciones-iva">Deducciones IVA</a>
        <a href="@Url.Action("Index",new {year=Model.Board.Year,month=Model.Board.Month})#tab=conciliacion-2">Conciliación 2</a>
        <a href="@Url.Action("Index",new {year=Model.Board.Year,month=Model.Board.Month})#tab=registro-dian">Registro DIAN</a>
        <a class="is-active" aria-current="page" href="@Url.Action("Index",new {year=Model.Board.Year,month=Model.Board.Month,tab="flujo-caja-directo"})">Flujo de caja directo</a>
    </nav>
    <header class="dcf-header">
        <div><div class="dcf-eyebrow">DIGITAL TECH · TESORERÍA</div><h1>Flujo de caja directo</h1><p>Ingresos, egresos y disponibilidad de efectivo en un solo lugar.</p></div>
        <div class="dcf-header-actions"><span class="dcf-live" data-dcf-live>Conectando…</span><button class="dcf-button dcf-button-light" type="button" data-dcf-refresh>Actualizar</button></div>
    </header>
    <section class="dcf-toolbar" aria-label="Período del reporte">
        <label>Año<input type="number" min="2020" max="2100" value="@Model.Board.Year" data-dcf-year /></label>
        <label>Desde<select data-dcf-first aria-label="Mes inicial"></select></label>
        <label>Hasta<select data-dcf-last aria-label="Mes final"></select></label>
        <button class="dcf-button" type="button" data-dcf-apply>Ver período</button>
        <div class="dcf-toolbar-end"><button class="dcf-button dcf-button-primary" type="button" data-dcf-manual>+ Registro manual</button><a class="dcf-button" data-dcf-export href="#">Descargar Excel ↓</a></div>
    </section>
    <p class="dcf-status" role="status" aria-live="polite" data-dcf-status></p>
    <section class="dcf-kpis" data-dcf-kpis aria-label="Resumen del período"><div class="dcf-skeleton">Cargando resumen del banco…</div></section>
    <section class="dcf-review" data-dcf-review aria-label="Estado de clasificación"></section>
    <section class="dcf-report">
        <div class="dcf-report-heading"><div><h2>Flujo de Caja Real</h2><p>Administración Digital Tech Copiers · Cifras en pesos colombianos</p></div><button class="dcf-button" type="button" data-dcf-all>Ver registros</button></div>
        <div class="dcf-table-scroll" tabindex="0" aria-label="Reporte de flujo de caja"><table class="dcf-table"><thead data-dcf-head></thead><tbody data-dcf-body></tbody></table></div>
        <footer class="dcf-report-footer"><span>Selecciona un valor para ver sus registros. Selecciona un saldo para completarlo.</span><span class="dcf-manual-key">Registro manual · sin envío a Siigo</span></footer>
    </section>
</div>
@section Scripts { <script src="~/js/direct-cash-flow.js" asp-append-version="true"></script> }
