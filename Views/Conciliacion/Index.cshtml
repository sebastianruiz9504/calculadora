                                                        <td class="text-end @(Math.Abs(row.DifferenceValue) > 5000 ? "cnc-money-warning" : "")">@Money(row.DifferenceValue)</td>
                                                        <td><span class="cnc-badge cnc-badge--@row.StatusTone">@row.StatusLabel</span><small>@row.Reason</small></td>
                                                        <td>
                                                            <div class="cnc-row-actions">
                                                                <button type="button" class="btn btn-sm btn-outline-primary" data-cnc-open-invoice-modal>Cambiar factura</button>
