                                    <header class="cnc-pipeline-stage__header">
                                        <h3>1. Detectadas en flujo de caja</h3>
                                        <span data-cnc-stage-count>@Number(detectedSupportRows.Count) filas</span>
                                    </header>
                                    <div class="cnc-table-wrap">
                                        <table class="table align-middle cnc-table cnc-table--pipeline">
