                                                        data-flow="@verticalFlow"
                                                        data-search="@DianSearchText(row)">
                                                        <td><strong>@row.EmissionDateDisplay</strong><small>@ExcelRowLabel(row.SourceRowNumber)</small><small>@row.DocumentType @row.DianGroup</small><small>@row.ReceptionDateDisplay</small></td>
                                                        <td><strong>@row.InvoiceNumber</strong><small>@row.SupplierName</small></td>
                                                        <td class="text-end">@Money(row.TotalValue)</td>
                                                        <td><strong>@row.SiigoDocumentName</strong><small>@row.SiigoDocumentId</small></td>
                                                        <td>@row.VerticalLabel</td>
                                                        <td><span class="cnc-badge cnc-badge--@row.SiigoStatusTone">@row.SiigoStatusLabel</span></td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </section>
                            </div>
                        </section>
                    }
                    else if (phase.Key == "salidas-fe")
                    {
                        string SupplierPaymentRowKey(ConciliacionCashFlowRowDto row) =>
                            FirstNonEmpty(row.RecordId, row.ExternalKey, row.SourceRowNumber.ToString(CultureInfo.InvariantCulture));
                        var supplierPaymentMatches = phaseRows
                            .Select(row => new
                            {
                                Key = SupplierPaymentRowKey(row),
                                Match = SupplierPaymentDocumentMatch(row)
                            })
                            .GroupBy(item => item.Key, StringComparer.OrdinalIgnoreCase)
                            .ToDictionary(group => group.Key, group => group.First().Match, StringComparer.OrdinalIgnoreCase);
                        ConciliacionDianSupplierInvoiceRowDto? SupplierPaymentMatchFor(ConciliacionCashFlowRowDto row) =>
                            supplierPaymentMatches.TryGetValue(SupplierPaymentRowKey(row), out var match) ? match : null;
                        string SupplierPaymentSearch(ConciliacionCashFlowRowDto row, ConciliacionDianSupplierInvoiceRowDto? match) =>
                            $"{SearchText(row)} {(match is null ? "" : DianSearchText(match))}".ToLowerInvariant();
                        var errorOutgoingRows = phaseRows
                            .Where(SupplierPaymentError)
                            .ToArray();
                        var sentOutgoingRows = phaseRows
                            .Where(row => SupplierPaymentSent(row) && !SupplierPaymentError(row))
                            .ToArray();
                        var actionableOutgoingRows = phaseRows
                            .Where(row => !SupplierPaymentSent(row) && !SupplierPaymentError(row))
                            .ToArray();
                        var crossedOutgoingRows = actionableOutgoingRows
                            .Where(row => SupplierPaymentMatchFor(row) is not null)
                            .ToArray();
                        var uncrossedOutgoingRows = actionableOutgoingRows
                            .Where(row => SupplierPaymentMatchFor(row) is null)
                            .ToArray();
                        <section class="cnc-payment-panel">
                            <div class="cnc-table-toolbar">
                                <input class="form-control cnc-table-search" type="search" placeholder="Buscar proveedor, banco, documento o descripcion" data-cnc-table-search="@phase.Key" />
                                <span class="cnc-counter" data-cnc-table-count="@phase.Key">@Number(phaseRows.Count) filas</span>
                            </div>

                            <div class="cnc-pipeline" data-cnc-table-body="@phase.Key">
                                <section class="cnc-pipeline-stage">
                                    <header class="cnc-pipeline-stage__header">
                                        <h3>1. Sin cruce</h3>
                                        <span data-cnc-stage-count>@Number(uncrossedOutgoingRows.Length) filas</span>
                                    </header>
                                    <div class="cnc-table-wrap">
                                        <table class="table align-middle cnc-table cnc-table--pipeline">
                                            <thead>
                                                <tr>
                                                    <th>Fecha</th>
                                                    <th>Banco</th>
                                                    <th>Descripcion / proveedor</th>
                                                    <th class="text-end">Salida</th>
                                                    <th>Documento Dataverse</th>
                                                    <th>Documento Siigo</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var row in uncrossedOutgoingRows)
                                                {
                                                    <tr class="cnc-click-row"
                                                        data-cnc-supplier-payment-row
                                                        data-record-id="@row.RecordId"
                                                        data-cashflow-record-id="@row.RecordId"
                                                        data-source-kind="@row.SourceKind"
                                                        data-movement-external-key="@row.ExternalKey"
                                                        data-flow="@row.SourceFlow"
                                                        data-search="@SearchText(row)"
                                                        data-direction="@row.Direction"
                                                        data-current-type="@row.DetectedTypeKey"
                                                        data-description="@row.Description"
                                                        data-supplier-query="@SupplierPaymentSuggestedQuery(row)"
                                                        data-exit-value="@row.ExitValue.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                        data-bank-account-code="@row.BankAccountCode"
                                                        data-bank-account-name="@row.BankAccountName">
                                                        <td><strong>@row.MovementDateDisplay</strong><small>@ExcelRowLabel(row.SourceRowNumber)</small><small>@row.SourceFlow</small></td>
                                                        <td><strong>@row.BankAccountCode</strong><small>@row.BankAccountName</small></td>
                                                        <td><strong>@(string.IsNullOrWhiteSpace(row.Description) ? row.Recipient : row.Description)</strong><small>@row.DocumentType @row.Observations</small></td>
                                                        <td class="text-end">@Money(row.ExitValue)</td>
                                                        <td><span class="cnc-badge cnc-badge--warning">Sin documento encontrado</span><small>Click en la fila para buscar factura Siigo</small></td>
                                                        <td>
                                                            <span hidden data-cnc-supplier-payment-search></span>
                                                            <span hidden data-cnc-supplier-payment-manual></span>
                                                            <span class="cnc-badge cnc-badge--@row.SiigoDocumentTone">@row.SiigoDocumentStatus</span>
                                                            <small>@row.SiigoPaymentStatus</small>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </section>

                                <section class="cnc-pipeline-stage">
                                    <header class="cnc-pipeline-stage__header">
                                        <h3>2. Cruce con factura listos para enviar</h3>
                                        <span data-cnc-stage-count>@Number(crossedOutgoingRows.Length) filas</span>
                                    </header>
                                    <div class="cnc-table-wrap">
                                        <table class="table align-middle cnc-table cnc-table--pipeline">
                                            <thead>
                                                <tr>
                                                    <th>Fecha</th>
                                                    <th>Banco</th>
                                                    <th>Descripcion / proveedor</th>
                                                    <th class="text-end">Salida</th>
                                                    <th>Documento encontrado</th>
                                                    <th>Documento Siigo</th>
                                                    <th>Accion</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var row in crossedOutgoingRows)
                                                {
                                                    var match = SupplierPaymentMatchFor(row);
                                                    var siigoLabel = FirstNonEmpty(match?.SiigoDocumentName, row.SiigoDocumentName, "Se buscara en Siigo");
                                                    var siigoTone = !string.IsNullOrWhiteSpace(match?.SiigoDocumentName) || !string.IsNullOrWhiteSpace(match?.SiigoDocumentId) ? "success" : "info";
                                                    var matchPaymentValue = match?.PaymentValue > 0m ? match.PaymentValue : match?.TotalValue ?? 0m;
                                                    <tr class="cnc-click-row"
                                                        data-cnc-reassign
                                                        data-cnc-supplier-payment-row
                                                        data-record-id="@row.RecordId"
                                                        data-cashflow-record-id="@row.RecordId"
                                                        data-source-kind="@row.SourceKind"
                                                        data-movement-external-key="@row.ExternalKey"
                                                        data-flow="@row.SourceFlow"
                                                        data-search="@SupplierPaymentSearch(row, match)"
                                                        data-direction="@row.Direction"
                                                        data-current-type="@row.DetectedTypeKey"
                                                        data-description="@row.Description"
                                                        data-supplier-query="@SupplierPaymentSuggestedQuery(row, match)"
                                                        data-exit-value="@row.ExitValue.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                        data-bank-account-code="@row.BankAccountCode"
                                                        data-bank-account-name="@row.BankAccountName"
                                                        data-dataverse-record-id="@match?.RecordId"
                                                        data-dataverse-invoice="@match?.InvoiceNumber"
                                                        data-dataverse-supplier="@match?.SupplierName"
                                                        data-dataverse-supplier-nit="@match?.SupplierNit"
                                                        data-dataverse-total="@((match?.TotalValue ?? 0m).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                                        data-dataverse-payment-value="@((match?.PaymentValue ?? 0m).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                                        data-rete-fuente-value="@((match?.ReteFuenteValue ?? 0m).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                                        data-rete-ica-value="@((match?.ReteIcaValue ?? 0m).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                                        data-siigo-document-id="@match?.SiigoDocumentId"
                                                        data-siigo-document-name="@match?.SiigoDocumentName">
                                                        <td><strong>@row.MovementDateDisplay</strong><small>@ExcelRowLabel(row.SourceRowNumber)</small><small>@row.SourceFlow</small></td>
                                                        <td><strong>@row.BankAccountCode</strong><small>@row.BankAccountName</small></td>
                                                        <td><strong>@(string.IsNullOrWhiteSpace(row.Description) ? row.Recipient : row.Description)</strong><small>@row.DocumentType @row.Observations</small></td>
                                                        <td class="text-end">@Money(row.ExitValue)</td>
                                                        <td><span class="cnc-badge cnc-badge--success">Documento encontrado</span><strong>@match?.InvoiceNumber</strong><small>@match?.SupplierName</small><small>Pago documento: @Money(matchPaymentValue)</small></td>
                                                        <td><span class="cnc-badge cnc-badge--@siigoTone">@siigoLabel</span><small>@match?.SiigoDocumentId</small></td>
                                                        <td>
                                                            <div class="cnc-row-actions">
                                                                <button type="button" class="btn btn-sm btn-primary" data-cnc-supplier-payment-send>Aplicar pago</button>
                                                                <button type="button" class="btn btn-sm btn-outline-primary" data-cnc-open-supplier-payment>Revisar</button>
                                                                <button type="button" class="btn btn-sm btn-outline-secondary" data-cnc-open-reassign>Categoria</button>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </section>

                                <section class="cnc-pipeline-stage">
                                    <header class="cnc-pipeline-stage__header">
                                        <h3>3. Enviados</h3>
                                        <span data-cnc-stage-count>@Number(sentOutgoingRows.Length) filas</span>
                                    </header>
                                    <div class="cnc-table-wrap">
                                        <table class="table align-middle cnc-table cnc-table--pipeline">
                                            <thead>
                                                <tr>
                                                    <th>Fecha</th>
                                                    <th>Banco</th>
                                                    <th>Descripcion</th>
                                                    <th class="text-end">Salida</th>
                                                    <th>Siigo</th>
                                                    <th>Saldo</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var row in sentOutgoingRows)
                                                {
                                                    var match = SupplierPaymentMatchFor(row);
                                                    <tr data-record-id="@row.RecordId"
                                                        data-flow="@row.SourceFlow"
                                                        data-search="@SupplierPaymentSearch(row, match)">
                                                        <td><strong>@row.MovementDateDisplay</strong><small>@ExcelRowLabel(row.SourceRowNumber)</small><small>@row.SourceFlow</small></td>
                                                        <td><strong>@row.BankAccountCode</strong><small>@row.BankAccountName</small></td>
                                                        <td><strong>@row.Description</strong><small>@row.Recipient</small></td>
                                                        <td class="text-end">@Money(row.ExitValue)</td>
                                                        <td><span class="cnc-badge cnc-badge--success">Enviado</span><small>@FirstNonEmpty(row.SiigoPaymentStatus, row.SiigoDocumentStatus, row.RegistrationStatus)</small><small>@row.SiigoDocumentName</small></td>
                                                        <td>@row.InvoiceBalanceStatus</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </section>

                                <section class="cnc-pipeline-stage">
                                    <header class="cnc-pipeline-stage__header">
                                        <h3>4. Errores</h3>
                                        <span data-cnc-stage-count>@Number(errorOutgoingRows.Length) filas</span>
                                    </header>
                                    <div class="cnc-table-wrap">
                                        <table class="table align-middle cnc-table cnc-table--pipeline">
                                            <thead>
                                                <tr>
                                                    <th>Fecha</th>
                                                    <th>Banco</th>
                                                    <th>Descripcion</th>
                                                    <th class="text-end">Salida</th>
                                                    <th>Error</th>
                                                    <th>Factura</th>
                                                    <th>Accion</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var row in errorOutgoingRows)
                                                {
                                                    var match = SupplierPaymentMatchFor(row);
                                                    <tr class="cnc-click-row"
                                                        data-cnc-reassign
                                                        data-cnc-supplier-payment-row
                                                        data-record-id="@row.RecordId"
                                                        data-cashflow-record-id="@row.RecordId"
                                                        data-source-kind="@row.SourceKind"
                                                        data-movement-external-key="@row.ExternalKey"
                                                        data-flow="@row.SourceFlow"
                                                        data-search="@SupplierPaymentSearch(row, match)"
                                                        data-direction="@row.Direction"
                                                        data-current-type="@row.DetectedTypeKey"
                                                        data-description="@row.Description"
                                                        data-supplier-query="@SupplierPaymentSuggestedQuery(row, match)"
                                                        data-exit-value="@row.ExitValue.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                        data-bank-account-code="@row.BankAccountCode"
                                                        data-bank-account-name="@row.BankAccountName"
                                                        data-dataverse-record-id="@match?.RecordId"
                                                        data-dataverse-invoice="@match?.InvoiceNumber"
                                                        data-dataverse-supplier="@match?.SupplierName"
                                                        data-dataverse-supplier-nit="@match?.SupplierNit"
                                                        data-dataverse-total="@((match?.TotalValue ?? 0m).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                                        data-dataverse-payment-value="@((match?.PaymentValue ?? 0m).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                                        data-rete-fuente-value="@((match?.ReteFuenteValue ?? 0m).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                                        data-rete-ica-value="@((match?.ReteIcaValue ?? 0m).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                                        data-siigo-document-id="@match?.SiigoDocumentId"
                                                        data-siigo-document-name="@match?.SiigoDocumentName">
                                                        <td><strong>@row.MovementDateDisplay</strong><small>@ExcelRowLabel(row.SourceRowNumber)</small><small>@row.SourceFlow</small></td>
                                                        <td><strong>@row.BankAccountCode</strong><small>@row.BankAccountName</small></td>
                                                        <td><strong>@row.Description</strong><small>@row.Recipient</small></td>
                                                        <td class="text-end">@Money(row.ExitValue)</td>
                                                        <td><span class="cnc-badge cnc-badge--danger">Error</span><small>@FirstNonEmpty(row.SiigoPaymentStatus, row.SiigoDocumentStatus, row.RegistrationStatus)</small></td>
                                                        <td><strong>@FirstNonEmpty(match?.InvoiceNumber, row.SiigoDocumentName, "Sin factura")</strong><small>@match?.SupplierName</small></td>
                                                        <td>
                                                            <div class="cnc-row-actions">
                                                                <button type="button" class="btn btn-sm btn-primary" data-cnc-supplier-payment-send>Reintentar</button>
                                                                <button type="button" class="btn btn-sm btn-outline-primary" data-cnc-open-supplier-payment>Revisar</button>
                                                                <button type="button" class="btn btn-sm btn-outline-secondary" data-cnc-open-reassign>Categoria</button>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </section>
                            </div>
                        </section>
                    }
                    else if (phase.Key == "entradas-fe")
                    {
                        var detectedRows = ClientPaymentRowsFor("detectadas");
                        var crossRows = ClientPaymentRowsFor("cruce");
                        var reviewRows = ClientPaymentRowsFor("revision");
                        var preflightRows = ClientPaymentRowsFor("prevalidacion");
                        var sentRows = ClientPaymentRowsFor("enviados");
                        <section class="cnc-payment-panel">
                            <div class="cnc-table-toolbar">
                                <div class="cnc-filter-grid">
                                    <input id="cncPaymentSearch" class="form-control" type="search" placeholder="Buscar cliente, factura o descripcion" />
                                    <select id="cncPaymentStatusFilter" class="form-select">
                                        <option value="">Todos los estados</option>
                                        <option value="Sugerido">Sugerido</option>
                                        <option value="Aprobado">Aprobado</option>
                                        <option value="ListoSiigo">Listo Siigo</option>
                                        <option value="BloqueadoSiigo">Bloqueado pre-Siigo</option>
                                        <option value="RevisionManual">Revision manual</option>
                                        <option value="DiferenciaFueraRango">Diferencia fuera de rango</option>
                                        <option value="SinFacturaDescripcion">Sin factura en descripcion</option>
                                        <option value="FacturaNoEncontrada">Factura no encontrada</option>
                                        <option value="FacturaAmbigua">Factura ambigua</option>
                                        <option value="Rechazado">Rechazado</option>
                                    </select>
