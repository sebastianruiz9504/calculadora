                                                <tr>
                                                    <th>Fecha</th>
                                                    <th>Proveedor</th>
                                                    <th>Banco</th>
                                                    <th class="text-end">Bruto</th>
                                                    <th class="text-end">Pago</th>
                                                    <th class="text-end">Retenciones</th>
                                                    <th>Cuenta</th>
                                                    <th>Siigo</th>
                                                </tr>
                                            </thead>
                                            <tbody>
