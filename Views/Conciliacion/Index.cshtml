                                        <table class="table align-middle cnc-table cnc-table--pipeline">
                                            <thead>
                                                <tr>
                                                    <th>Fecha</th>
                                                    <th>Factura / cliente</th>
                                                    <th class="text-end">Entrada</th>
                                                    <th>Estado Siigo</th>
                                                    <th>Detalle</th>
                                                    <th>Accion</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var row in sentRows)
                                                {
                                                    var search = $"{row.SourceRowNumber} {row.InvoiceNumbers} {row.ClientNames} {row.Description} {row.BankAccountName}".ToLowerInvariant();
