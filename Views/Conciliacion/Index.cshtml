@model ConciliacionPageViewModel
@using System.Globalization
@using System.Text.RegularExpressions
@{
    ViewData["Title"] = "Conciliacion";
    var culture = CultureInfo.GetCultureInfo("es-CO");
    var board = Model.Board;
    var cashFlow = board.CashFlow;
    var dianInvoices = board.DianSupplierInvoices;
    var activePhase = "flujo-caja";
    string Money(decimal value) => value.ToString("C0", culture);
    string Number(int value) => value.ToString("N0", culture);
    string SearchText(ConciliacionCashFlowRowDto row) =>
        $"{row.MovementDateDisplay} {row.SourceFlow} {row.BankAccountName} {row.Description} {row.Recipient} {row.DestinationBank} {row.DocumentType} {row.DetectedTypeLabel} {row.ValidationStatus} {row.RegistrationStatus}".ToLowerInvariant();
    IReadOnlyList<(string Text, string System)> PhaseTasks(string key) => key switch
    {
        "flujo-caja" => new[]
        {
            ("Asignar categorias", "dataverse"),
            ("Revisar punto de partida para conciliar", "app")
        },
        "salidas-fe" => new[]
        {
            ("Cruzar pago con documento", "siigo"),
            ("Aplicar egreso", "siigo")
        },
        "registro-dian" => new[]
        {
            ("Importar documentos proveedor", "dataverse"),
            ("Validar proveedor y Siigo", "siigo"),
            ("Clasificar gasto", "app")
        },
        "entradas-fe" => new[]
        {
            ("Aplicar pagos facturas de clientes", "dataverse"),
            ("Subir comprobantes contables", "siigo")
        },
        "cuentas-cobro" => new[]
        {
            ("Detectar retenciones en pagos", "dataverse"),
            ("Subir documentos soporte", "siigo")
        },
        "comprobantes" => new[]
        {
            ("Entradas y salidas sin FE", "siigo")
        },
        "huerfanos" => new[]
        {
            ("Asignar categoria", "app")
        },
        _ => Array.Empty<(string Text, string System)>()
    };
    IReadOnlyList<ConciliacionCashFlowRowDto> CashRowsFor(string key) => key switch
    {
        "salidas-fe" => cashFlow.Rows.Where(row => string.Equals(row.DetectedTypeKey, "salida-fe", StringComparison.OrdinalIgnoreCase)).ToArray(),
        "cuentas-cobro" => cashFlow.Rows.Where(row => string.Equals(row.DetectedTypeKey, "cuenta-cobro", StringComparison.OrdinalIgnoreCase)).ToArray(),
        "comprobantes" => cashFlow.Rows.Where(row =>
            string.Equals(row.DetectedTypeKey, "comprobante-contable", StringComparison.OrdinalIgnoreCase)
            || string.Equals(row.DetectedTypeKey, "entrada-comprobante", StringComparison.OrdinalIgnoreCase)).ToArray(),
        "huerfanos" => cashFlow.Rows.Where(row => string.Equals(row.DetectedTypeKey, "huerfano", StringComparison.OrdinalIgnoreCase)).ToArray(),
        _ => cashFlow.Rows
    };
    IReadOnlyList<ConciliacionDianSupplierInvoiceRowDto> DianRowsFor(string stage) => dianInvoices.Rows
        .Where(row => string.Equals(row.Stage, stage, StringComparison.OrdinalIgnoreCase))
        .ToArray();
    string DianSearchText(ConciliacionDianSupplierInvoiceRowDto row) =>
        $"{row.InvoiceNumber} {row.Cufe} {row.SupplierName} {row.SupplierNit} {row.RecipientName} {row.CategoryLabel} {row.AccountCode} {row.StageLabel} {row.DianStatus} {row.DianGroup}".ToLowerInvariant();
    bool HasPaymentStatus(ConciliacionClientPaymentRowDto row, params string[] statuses) =>
        statuses.Any(status => string.Equals(row.Status, status, StringComparison.OrdinalIgnoreCase));
    IReadOnlyList<ConciliacionClientPaymentRowDto> ClientPaymentRowsFor(string stage) => stage switch
    {
        "detectadas" => board.ClientPayments.Rows.Where(row => HasPaymentStatus(row, "SinFacturaDescripcion")).ToArray(),
        "cruce" => board.ClientPayments.Rows.Where(row => HasPaymentStatus(row, "Sugerido", "FacturaNoEncontrada", "FacturaAmbigua", "DiferenciaFueraRango")).ToArray(),
        "revision" => board.ClientPayments.Rows.Where(row => HasPaymentStatus(row, "RevisionManual", "Rechazado")).ToArray(),
        "prevalidacion" => board.ClientPayments.Rows.Where(row => HasPaymentStatus(row, "Aprobado", "BloqueadoSiigo", "ListoSiigo")).ToArray(),
        "enviados" => board.ClientPayments.Rows.Where(row => HasPaymentStatus(row, "EnviadoSiigo", "ErrorSiigo", "Conciliado")).ToArray(),
        _ => Array.Empty<ConciliacionClientPaymentRowDto>()
    };
    string InvoiceFromFlow(ConciliacionClientPaymentRowDto row)
    {
        var match = Regex.Match(
            row.Description ?? "",
            @"\b(?:FV|FVE|FEV|FEM|FE|FEDT|FEKT)[-\s]*\d+(?:[-\s]*\d+)?\b",
            RegexOptions.IgnoreCase | RegexOptions.CultureInvariant);
        return match.Success ? match.Value.Trim().ToUpperInvariant() : "";
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/conciliacion.css" asp-append-version="true" />
}

<div class="cnc-shell"
     id="conciliacionApp"
     data-update-payment-url="@Url.Action("UpdateClientPaymentStatus", "Conciliacion")"
     data-preflight-payment-url="@Url.Action("ValidateClientPaymentPreflight", "Conciliacion")"
     data-dry-run-payment-url="@Url.Action("SimulateClientPaymentSiigoSend", "Conciliacion")"
     data-send-payment-url="@Url.Action("SendClientPaymentToSiigo", "Conciliacion")"
     data-invoice-search-url="@Url.Action("SearchDataverseInvoices", "Conciliacion")"
     data-invoice-assign-url="@Url.Action("AssignClientPaymentInvoice", "Conciliacion")"
     data-sync-health-url="@Url.Action("SyncHealth", "Conciliacion", new { year = board.Year, month = board.Month })"
     data-active-vertical="Cloud">
    <section class="cnc-heading">
        <div class="cnc-heading__copy">
            <div class="cnc-kicker">Cierre mensual</div>
            <h1 class="cnc-title">Conciliacion</h1>
            <p class="cnc-subtitle">
                Flujo de caja por banco, registros FE, cuentas de cobro, comprobantes y huerfanos del periodo.
            </p>
        </div>
        <form class="cnc-period" method="get" asp-controller="Conciliacion" asp-action="Index">
            <label>
                <span>Periodo</span>
                <select name="month" class="form-select">
                    @for (var month = 1; month <= 12; month++)
                    {
                        <option value="@month" selected="@(board.Month == month ? "selected" : null)">
                            @culture.DateTimeFormat.GetMonthName(month)
                        </option>
                    }
                </select>
            </label>
            <label>
                <span>Ano</span>
                <input class="form-control" type="number" name="year" value="@board.Year" min="2020" max="2100" />
            </label>
            <button type="submit" class="btn btn-primary">Ver</button>
        </form>
    </section>

    <div id="cncStatus" class="cnc-status" role="status" aria-live="polite"></div>

    <section class="cnc-workspace">
        <div class="cnc-phase-nav" role="tablist" aria-label="Filtros de conciliacion">
            <button type="button"
                    class="cnc-phase-tab"
                    data-cnc-tab="sincronizacion"
                    role="tab"
                    aria-selected="false">
                <span>Sincronizacion</span>
                <span class="cnc-phase-tasks">
                    <small class="cnc-phase-task cnc-phase-task--dataverse">Dataverse</small>
                    <small class="cnc-phase-task cnc-phase-task--siigo">Siigo</small>
                </span>
                <small class="cnc-badge cnc-badge--info">Cruces</small>
            </button>
            @foreach (var phase in board.Phases)
            {
                var isActive = string.Equals(phase.Key, activePhase, StringComparison.OrdinalIgnoreCase);
                <button type="button"
                        class="cnc-phase-tab @(isActive ? "is-active" : "")"
                        data-cnc-tab="@phase.Key"
                        role="tab"
                        aria-selected="@(isActive ? "true" : "false")">
                    <span>@phase.Label</span>
                    <span class="cnc-phase-tasks">
                        @foreach (var task in PhaseTasks(phase.Key))
                        {
                            <small class="cnc-phase-task cnc-phase-task--@task.System">@task.Text</small>
                        }
                    </span>
                    <small class="cnc-badge cnc-badge--@phase.StatusTone">@phase.StatusLabel</small>
                </button>
            }
        </div>

        <div class="cnc-phase-panels">
            <div class="cnc-vertical-bar" aria-label="Seleccion de vertical">
                <div class="cnc-vertical-switch" role="group">
                    <button type="button"
                            class="cnc-vertical-button cnc-vertical-button--cloud is-active"
                            data-cnc-vertical="Cloud"
                            aria-pressed="true">
                        Cloud
                    </button>
                    <button type="button"
                            class="cnc-vertical-button cnc-vertical-button--copiers"
                            data-cnc-vertical="Copiers"
                            aria-pressed="false">
                        Copiers
                    </button>
                </div>
                <span class="cnc-counter" id="cncVerticalCount">Cloud</span>
            </div>

            <section class="cnc-phase-panel"
                     data-cnc-panel="sincronizacion"
                     role="tabpanel"
                     hidden>
                <div class="cnc-panel-header">
                    <div>
                        <div class="cnc-kicker">Dataverse vs Siigo</div>
                        <h2>Salud de sincronizacion</h2>
                    </div>
                    <button type="button" class="btn btn-outline-primary" data-cnc-sync-refresh>Actualizar</button>
                </div>
                <div class="cnc-sync-summary" data-cnc-sync-summary>
                    <span class="cnc-badge cnc-badge--neutral">Sin consultar</span>
                    <strong>Selecciona la pestana para cargar los cruces del periodo.</strong>
                </div>
                <div class="cnc-sync-grid" data-cnc-sync-grid>
                    <div class="cnc-sync-empty">Los resultados apareceran aqui.</div>
                </div>
            </section>

            @foreach (var phase in board.Phases)
            {
                var isActive = string.Equals(phase.Key, activePhase, StringComparison.OrdinalIgnoreCase);
                var phaseRows = CashRowsFor(phase.Key);
                <section class="cnc-phase-panel @(isActive ? "is-active" : "")"
                         data-cnc-panel="@phase.Key"
                         role="tabpanel"
                         @(isActive ? null : "hidden")>
                    <div class="cnc-panel-header">
                        <div>
                            <div class="cnc-kicker">@phase.CadenceLabel</div>
                            <h2>@phase.Label</h2>
                        </div>
                    </div>

                    @if (phase.Key == "registro-dian")
                    {
                        var providerRows = DianRowsFor("proveedor");
                        var classificationRows = DianRowsFor("clasificacion");
                        var readyRows = DianRowsFor("prevalidacion");
                        var sentRows = DianRowsFor("enviadas");
                        <section class="cnc-payment-panel">
                            <div class="cnc-table-toolbar">
                                <input class="form-control cnc-table-search" type="search" placeholder="Buscar proveedor, NIT, documento o categoria" data-cnc-table-search="@phase.Key" />
                                <span class="cnc-counter" data-cnc-table-count="@phase.Key">@Number(dianInvoices.Rows.Count) filas</span>
                            </div>

                            <div class="cnc-pipeline" data-cnc-table-body="@phase.Key">
                                <section class="cnc-pipeline-stage">
                                    <header class="cnc-pipeline-stage__header">
                                        <h3>1. Proveedor pendiente Siigo</h3>
                                        <span data-cnc-stage-count>@Number(providerRows.Count) filas</span>
                                    </header>
                                    <div class="cnc-table-wrap">
                                        <table class="table align-middle cnc-table cnc-table--pipeline">
                                            <thead>
                                                <tr>
                                                    <th>Fecha</th>
                                                    <th>Documento</th>
                                                    <th>Proveedor</th>
                                                    <th class="text-end">Total</th>
                                                    <th>Dataverse</th>
                                                    <th>Siigo</th>
                                                    <th>Detalle</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var row in providerRows)
                                                {
                                                    var verticalFlow = string.Equals(row.VerticalLabel, "Sin vertical", StringComparison.OrdinalIgnoreCase) ? "" : row.VerticalLabel;
                                                    <tr data-record-id="@row.RecordId"
                                                        data-flow="@verticalFlow"
                                                        data-search="@DianSearchText(row)">
                                                        <td><strong>@row.EmissionDateDisplay</strong><small>@row.DocumentType @row.DianGroup</small><small>@row.ReceptionDateDisplay</small></td>
                                                        <td><strong>@row.InvoiceNumber</strong><small>@row.Prefix @row.Folio</small><small>@row.DianStatus</small></td>
                                                        <td><strong>@row.SupplierName</strong><small>@row.SupplierNit</small></td>
                                                        <td class="text-end">@Money(row.TotalValue)</td>
                                                        <td><span class="cnc-badge cnc-badge--success">Importada</span><small>@row.SourceLabel</small></td>
                                                        <td><span class="cnc-badge cnc-badge--@row.ProviderStatusTone">@row.ProviderStatusLabel</span><small>@(string.IsNullOrWhiteSpace(row.SiigoSupplierName) ? "Crear o seleccionar proveedor en Siigo." : row.SiigoSupplierName)</small></td>
                                                        <td><small>@row.ReviewReason</small></td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </section>

                                <section class="cnc-pipeline-stage">
                                    <header class="cnc-pipeline-stage__header">
                                        <h3>2. Pendientes clasificacion</h3>
                                        <span data-cnc-stage-count>@Number(classificationRows.Count) filas</span>
                                    </header>
                                    <div class="cnc-table-wrap">
                                        <table class="table align-middle cnc-table cnc-table--pipeline">
                                            <thead>
                                                <tr>
                                                    <th>Fecha</th>
                                                    <th>Documento / proveedor</th>
                                                    <th class="text-end">Base</th>
                                                    <th class="text-end">IVA</th>
                                                    <th class="text-end">Total</th>
                                                    <th>Vertical</th>
                                                    <th>Clasificacion</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var row in classificationRows)
                                                {
                                                    var verticalFlow = string.Equals(row.VerticalLabel, "Sin vertical", StringComparison.OrdinalIgnoreCase) ? "" : row.VerticalLabel;
                                                    <tr data-record-id="@row.RecordId"
                                                        data-flow="@verticalFlow"
                                                        data-search="@DianSearchText(row)">
                                                        <td><strong>@row.EmissionDateDisplay</strong><small>@row.DocumentType @row.DianGroup</small><small>@row.ReceptionDateDisplay</small></td>
                                                        <td><strong>@row.InvoiceNumber</strong><small>@row.SupplierName</small></td>
                                                        <td class="text-end">@Money(row.BaseAmount)</td>
                                                        <td class="text-end">@Money(row.VatValue)</td>
                                                        <td class="text-end">@Money(row.TotalValue)</td>
                                                        <td><span class="cnc-badge cnc-badge--neutral">@row.VerticalLabel</span><small>Cloud @Money(row.CloudValue) / Copiers @Money(row.CopiersValue)</small></td>
                                                        <td><span class="cnc-badge cnc-badge--@row.ClassificationStatusTone">@row.ClassificationStatusLabel</span><small>@row.CategoryLabel @row.AccountCode</small></td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </section>

                                <section class="cnc-pipeline-stage">
                                    <header class="cnc-pipeline-stage__header">
                                        <h3>3. Prevalidacion documento Siigo</h3>
                                        <span data-cnc-stage-count>@Number(readyRows.Count) filas</span>
                                    </header>
                                    <div class="cnc-table-wrap">
                                        <table class="table align-middle cnc-table cnc-table--pipeline">
                                            <thead>
                                                <tr>
                                                    <th>Fecha</th>
                                                    <th>Documento / proveedor</th>
                                                    <th class="text-end">Total</th>
                                                    <th>Categoria</th>
                                                    <th>Cuenta gasto</th>
                                                    <th>Impuestos</th>
                                                    <th>Estado</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var row in readyRows)
                                                {
                                                    var verticalFlow = string.Equals(row.VerticalLabel, "Sin vertical", StringComparison.OrdinalIgnoreCase) ? "" : row.VerticalLabel;
                                                    <tr data-record-id="@row.RecordId"
                                                        data-flow="@verticalFlow"
                                                        data-search="@DianSearchText(row)">
                                                        <td><strong>@row.EmissionDateDisplay</strong><small>@row.VerticalLabel</small></td>
                                                        <td><strong>@row.InvoiceNumber</strong><small>@row.SupplierName</small></td>
                                                        <td class="text-end">@Money(row.TotalValue)</td>
                                                        <td>@row.CategoryLabel</td>
                                                        <td><strong>@row.AccountCode</strong><small>@row.AccountName</small></td>
                                                        <td><small>IVA @Money(row.VatValue) / RIVA @Money(row.ReteIvaValue) / RF @Money(row.ReteFuenteValue) / RICA @Money(row.ReteIcaValue)</small></td>
                                                        <td><span class="cnc-badge cnc-badge--@row.StageTone">@row.StageLabel</span><small>Crear FC o DS proveedor en Siigo.</small></td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </section>

                                <section class="cnc-pipeline-stage">
                                    <header class="cnc-pipeline-stage__header">
                                        <h3>4. Documentos enviados a Siigo</h3>
                                        <span data-cnc-stage-count>@Number(sentRows.Count) filas</span>
                                    </header>
                                    <div class="cnc-table-wrap">
                                        <table class="table align-middle cnc-table cnc-table--pipeline">
                                            <thead>
                                                <tr>
                                                    <th>Fecha</th>
                                                    <th>Documento / proveedor</th>
                                                    <th class="text-end">Total</th>
                                                    <th>Documento Siigo</th>
                                                    <th>Vertical</th>
                                                    <th>Estado</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var row in sentRows)
                                                {
                                                    var verticalFlow = string.Equals(row.VerticalLabel, "Sin vertical", StringComparison.OrdinalIgnoreCase) ? "" : row.VerticalLabel;
                                                    <tr data-record-id="@row.RecordId"
                                                        data-flow="@verticalFlow"
                                                        data-search="@DianSearchText(row)">
                                                        <td><strong>@row.EmissionDateDisplay</strong><small>@row.DocumentType @row.DianGroup</small><small>@row.ReceptionDateDisplay</small></td>
                                                        <td><strong>@row.InvoiceNumber</strong><small>@row.SupplierName</small></td>
                                                        <td class="text-end">@Money(row.TotalValue)</td>
                                                        <td><strong>@row.SiigoDocumentName</strong><small>@row.SiigoDocumentId</small></td>
                                                        <td>@row.VerticalLabel</td>
                                                        <td><span class="cnc-badge cnc-badge--@row.SiigoStatusTone">@row.SiigoStatusLabel</span></td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </section>
                            </div>
                        </section>
                    }
                    else if (phase.Key == "salidas-fe")
                    {
                        var supplierReadyRows = dianInvoices.Rows
                            .Where(row => string.Equals(row.Stage, "prevalidacion", StringComparison.OrdinalIgnoreCase)
                                || string.Equals(row.Stage, "enviadas", StringComparison.OrdinalIgnoreCase))
                            .ToArray();
                        var siigoOutgoingRows = phaseRows
                            .Where(row => row.RegistrationStatus.Contains("Siigo OK", StringComparison.OrdinalIgnoreCase)
                                || row.SiigoPaymentStatus.Contains("Enviado", StringComparison.OrdinalIgnoreCase)
                                || row.SiigoPaymentStatus.Contains("OK", StringComparison.OrdinalIgnoreCase))
                            .ToArray();
                        var pendingOutgoingRows = phaseRows
                            .Where(row => !siigoOutgoingRows.Any(sent => string.Equals(sent.RecordId, row.RecordId, StringComparison.OrdinalIgnoreCase)))
                            .ToArray();
                        <section class="cnc-payment-panel">
                            <div class="cnc-table-toolbar">
                                <input class="form-control cnc-table-search" type="search" placeholder="Buscar proveedor, banco, documento o descripcion" data-cnc-table-search="@phase.Key" />
                                <span class="cnc-counter" data-cnc-table-count="@phase.Key">@Number(phaseRows.Count + supplierReadyRows.Length) filas</span>
                            </div>

                            <div class="cnc-pipeline" data-cnc-table-body="@phase.Key">
                                <section class="cnc-pipeline-stage">
                                    <header class="cnc-pipeline-stage__header">
                                        <h3>1. Salidas FE del flujo de caja</h3>
                                        <span data-cnc-stage-count>@Number(pendingOutgoingRows.Length) filas</span>
                                    </header>
                                    <div class="cnc-table-wrap">
                                        <table class="table align-middle cnc-table cnc-table--pipeline">
                                            <thead>
                                                <tr>
                                                    <th>Fecha</th>
                                                    <th>Banco</th>
                                                    <th>Descripcion / proveedor</th>
                                                    <th class="text-end">Salida</th>
                                                    <th>Documento Dataverse</th>
                                                    <th>Documento Siigo</th>
                                                    <th>Accion</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var row in pendingOutgoingRows)
                                                {
                                                    <tr class="cnc-click-row"
                                                        data-cnc-reassign
                                                        data-record-id="@row.RecordId"
                                                        data-flow="@row.SourceFlow"
                                                        data-search="@SearchText(row)"
                                                        data-direction="@row.Direction"
                                                        data-current-type="@row.DetectedTypeKey"
                                                        data-description="@row.Description">
                                                        <td><strong>@row.MovementDateDisplay</strong><small>@row.SourceFlow</small></td>
                                                        <td><strong>@row.BankAccountCode</strong><small>@row.BankAccountName</small></td>
                                                        <td><strong>@(string.IsNullOrWhiteSpace(row.Description) ? row.Recipient : row.Description)</strong><small>@row.DocumentType @row.Observations</small></td>
                                                        <td class="text-end">@Money(row.ExitValue)</td>
                                                        <td><span class="cnc-badge cnc-badge--@row.InvoiceStatusTone">@row.InvoiceStatus</span><small>@row.DataversePaymentStatus</small></td>
                                                        <td><span class="cnc-badge cnc-badge--@row.SiigoDocumentTone">@row.SiigoDocumentStatus</span><small>@row.SiigoPaymentStatus</small></td>
                                                        <td><button type="button" class="btn btn-sm btn-outline-secondary" data-cnc-open-reassign>Categoria</button></td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </section>

                                <section class="cnc-pipeline-stage">
                                    <header class="cnc-pipeline-stage__header">
                                        <h3>2. Documentos proveedor disponibles</h3>
                                        <span data-cnc-stage-count>@Number(supplierReadyRows.Length) filas</span>
                                    </header>
                                    <div class="cnc-table-wrap">
                                        <table class="table align-middle cnc-table cnc-table--pipeline">
                                            <thead>
                                                <tr>
                                                    <th>Fecha</th>
                                                    <th>Documento / proveedor</th>
                                                    <th class="text-end">Total documento</th>
                                                    <th>Documento Siigo</th>
                                                    <th>Vertical</th>
                                                    <th>Estado</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var row in supplierReadyRows)
                                                {
                                                    var verticalFlow = string.Equals(row.VerticalLabel, "Sin vertical", StringComparison.OrdinalIgnoreCase) ? "" : row.VerticalLabel;
                                                    <tr data-record-id="@row.RecordId"
                                                        data-flow="@verticalFlow"
                                                        data-search="@DianSearchText(row)">
                                                        <td><strong>@row.EmissionDateDisplay</strong><small>@row.DocumentType @row.DianGroup</small><small>@row.ReceptionDateDisplay</small></td>
                                                        <td><strong>@row.InvoiceNumber</strong><small>@row.SupplierName</small></td>
                                                        <td class="text-end">@Money(row.TotalValue)</td>
                                                        <td><span class="cnc-badge cnc-badge--@row.SiigoStatusTone">@row.SiigoStatusLabel</span><small>@row.SiigoDocumentName</small></td>
                                                        <td>@row.VerticalLabel</td>
                                                        <td><span class="cnc-badge cnc-badge--@row.StageTone">@row.StageLabel</span></td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </section>

                                <section class="cnc-pipeline-stage">
                                    <header class="cnc-pipeline-stage__header">
                                        <h3>3. Pagos proveedor enviados / errores</h3>
                                        <span data-cnc-stage-count>@Number(siigoOutgoingRows.Length) filas</span>
                                    </header>
                                    <div class="cnc-table-wrap">
                                        <table class="table align-middle cnc-table cnc-table--pipeline">
                                            <thead>
                                                <tr>
                                                    <th>Fecha</th>
                                                    <th>Banco</th>
                                                    <th>Descripcion</th>
                                                    <th class="text-end">Salida</th>
                                                    <th>Siigo</th>
                                                    <th>Saldo</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var row in siigoOutgoingRows)
                                                {
                                                    <tr data-record-id="@row.RecordId"
                                                        data-flow="@row.SourceFlow"
                                                        data-search="@SearchText(row)">
                                                        <td><strong>@row.MovementDateDisplay</strong><small>@row.SourceFlow</small></td>
                                                        <td><strong>@row.BankAccountCode</strong><small>@row.BankAccountName</small></td>
                                                        <td><strong>@row.Description</strong><small>@row.Recipient</small></td>
                                                        <td class="text-end">@Money(row.ExitValue)</td>
                                                        <td><span class="cnc-badge cnc-badge--@row.SiigoPaymentTone">@row.SiigoPaymentStatus</span><small>@row.SiigoDocumentStatus</small></td>
                                                        <td>@row.InvoiceBalanceStatus</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </section>
                            </div>
                        </section>
                    }
                    else if (phase.Key == "entradas-fe")
                    {
                        var detectedRows = ClientPaymentRowsFor("detectadas");
                        var crossRows = ClientPaymentRowsFor("cruce");
                        var reviewRows = ClientPaymentRowsFor("revision");
                        var preflightRows = ClientPaymentRowsFor("prevalidacion");
                        var sentRows = ClientPaymentRowsFor("enviados");
                        <section class="cnc-payment-panel">
                            <div class="cnc-table-toolbar">
                                <div class="cnc-filter-grid">
                                    <input id="cncPaymentSearch" class="form-control" type="search" placeholder="Buscar cliente, factura o descripcion" />
                                    <select id="cncPaymentStatusFilter" class="form-select">
                                        <option value="">Todos los estados</option>
                                        <option value="Sugerido">Sugerido</option>
                                        <option value="Aprobado">Aprobado</option>
                                        <option value="ListoSiigo">Listo Siigo</option>
                                        <option value="BloqueadoSiigo">Bloqueado pre-Siigo</option>
                                        <option value="RevisionManual">Revision manual</option>
                                        <option value="DiferenciaFueraRango">Diferencia fuera de rango</option>
                                        <option value="SinFacturaDescripcion">Sin factura en descripcion</option>
                                        <option value="FacturaNoEncontrada">Factura no encontrada</option>
                                        <option value="FacturaAmbigua">Factura ambigua</option>
                                        <option value="Rechazado">Rechazado</option>
                                    </select>
                                </div>
                                <span class="cnc-counter" id="cncPaymentCount">@Number(board.ClientPayments.Rows.Count) filas</span>
                            </div>

                            <div class="cnc-pipeline" id="cncPaymentRows">
                                <section class="cnc-pipeline-stage">
                                    <header class="cnc-pipeline-stage__header">
                                        <h3>1. Entradas detectadas</h3>
                                        <span data-cnc-stage-count>@Number(detectedRows.Count) filas</span>
                                    </header>
                                    <div class="cnc-table-wrap">
                                        <table class="table align-middle cnc-table cnc-table--pipeline">
                                            <thead>
                                                <tr>
                                                    <th>Fecha</th>
                                                    <th>Banco</th>
                                                    <th>Descripcion flujo</th>
                                                    <th>Factura flujo</th>
                                                    <th class="text-end">Entrada</th>
                                                    <th>Estado</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var row in detectedRows)
                                                {
                                                    var search = $"{row.InvoiceNumbers} {row.ClientNames} {row.Description} {row.BankAccountName}".ToLowerInvariant();
                                                    var flowInvoice = InvoiceFromFlow(row);
                                                    <tr class="cnc-click-row"
                                                        data-cnc-reassign
                                                        data-record-id="@row.RecordId"
                                                        data-status="@row.Status"
                                                        data-flow="@row.SourceFlow"
                                                        data-search="@search"
                                                        data-direction="Entrada"
                                                        data-current-type="entrada-fe"
                                                        data-description="@row.Description">
                                                        <td><strong>@row.MovementDateDisplay</strong><small>@row.SourceFlow</small></td>
                                                        <td><strong>@row.BankAccountCode</strong><small>@row.BankAccountName</small></td>
                                                        <td><strong>@row.Description</strong></td>
                                                        <td>@(string.IsNullOrWhiteSpace(flowInvoice) ? "Sin factura" : flowInvoice)</td>
                                                        <td class="text-end">@Money(row.EntryValue)</td>
                                                        <td><span class="cnc-badge cnc-badge--@row.StatusTone">@row.StatusLabel</span></td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </section>

                                <section class="cnc-pipeline-stage">
                                    <header class="cnc-pipeline-stage__header">
                                        <h3>2. Cruce con factura</h3>
                                        <span data-cnc-stage-count>@Number(crossRows.Count) filas</span>
                                    </header>
                                    <div class="cnc-table-wrap">
                                        <table class="table align-middle cnc-table cnc-table--pipeline">
                                            <thead>
                                                <tr>
                                                    <th>Fecha</th>
                                                    <th>Factura / cliente flujo de caja</th>
                                                    <th>Factura / cliente Dataverse</th>
                                                    <th class="text-end">Entrada</th>
                                                    <th class="text-end">Valor Dataverse</th>
                                                    <th>Cliente</th>
                                                    <th class="text-end">Diferencia</th>
                                                    <th>Estado</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var row in crossRows)
                                                {
                                                    var search = $"{row.InvoiceNumbers} {row.ClientNames} {row.Description} {row.BankAccountName}".ToLowerInvariant();
                                                    var flowInvoice = InvoiceFromFlow(row);
                                                    <tr class="cnc-click-row"
                                                        data-cnc-invoice-assign
                                                        data-record-id="@row.RecordId"
                                                        data-status="@row.Status"
                                                        data-flow="@row.SourceFlow"
                                                        data-search="@search"
                                                        data-description="@row.Description"
                                                        data-flow-invoice="@flowInvoice"
                                                        data-dataverse-invoice="@row.InvoiceNumbers"
                                                        data-dataverse-client="@row.ClientNames"
                                                        data-entry-value="@row.EntryValue.ToString(CultureInfo.InvariantCulture)">
                                                        <td><strong>@row.MovementDateDisplay</strong><small>@row.SourceFlow</small></td>
                                                        <td><strong>@(string.IsNullOrWhiteSpace(flowInvoice) ? "Sin factura" : flowInvoice)</strong><small>@row.Description</small></td>
                                                        <td><strong>@(string.IsNullOrWhiteSpace(row.InvoiceNumbers) ? "Sin factura" : row.InvoiceNumbers)</strong><small>@(string.IsNullOrWhiteSpace(row.ClientNames) ? "Sin cliente" : row.ClientNames)</small></td>
                                                        <td class="text-end">@Money(row.EntryValue)</td>
                                                        <td class="text-end">@Money(row.InvoiceTotal)</td>
                                                        <td>@(string.IsNullOrWhiteSpace(row.ClientNames) ? "Sin cliente" : row.ClientNames)</td>
                                                        <td class="text-end @(Math.Abs(row.DifferenceValue) > 5000 ? "cnc-money-warning" : "")">@Money(row.DifferenceValue)</td>
                                                        <td>
                                                            @if (HasPaymentStatus(row, "Sugerido"))
                                                            {
                                                                <button type="button" class="btn btn-sm btn-outline-success" data-cnc-action="Aprobado">Aprobar sugerencia</button>
                                                                <small>Click en la fila para cambiar la factura.</small>
                                                            }
                                                            else
                                                            {
                                                                <span class="cnc-badge cnc-badge--@row.StatusTone" data-status-label>@row.StatusLabel</span>
                                                                <small>Click en la fila para buscar factura.</small>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </section>

                                <section class="cnc-pipeline-stage">
                                    <header class="cnc-pipeline-stage__header">
                                        <h3>3. Pendientes de revision</h3>
                                        <span data-cnc-stage-count>@Number(reviewRows.Count) filas</span>
                                    </header>
                                    <div class="cnc-table-wrap">
                                        <table class="table align-middle cnc-table cnc-table--pipeline">
                                            <thead>
                                                <tr>
                                                    <th>Fecha</th>
                                                    <th>Factura / cliente</th>
                                                    <th class="text-end">Entrada</th>
                                                    <th class="text-end">Retenciones</th>
                                                    <th class="text-end">Diferencia</th>
                                                    <th>Motivo</th>
                                                    <th>Accion</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var row in reviewRows)
                                                {
                                                    var search = $"{row.InvoiceNumbers} {row.ClientNames} {row.Description} {row.BankAccountName}".ToLowerInvariant();
                                                    <tr class="cnc-click-row"
                                                        data-record-id="@row.RecordId"
                                                        data-status="@row.Status"
                                                        data-flow="@row.SourceFlow"
                                                        data-search="@search">
                                                        <td><strong>@row.MovementDateDisplay</strong><small>@row.BankAccountName</small></td>
                                                        <td><strong>@(string.IsNullOrWhiteSpace(row.InvoiceNumbers) ? "Sin factura" : row.InvoiceNumbers)</strong><small>@(string.IsNullOrWhiteSpace(row.ClientNames) ? row.Description : row.ClientNames)</small></td>
                                                        <td class="text-end">@Money(row.EntryValue)</td>
                                                        <td class="text-end">@Money(row.RetentionsTotal)</td>
                                                        <td class="text-end @(Math.Abs(row.DifferenceValue) > 5000 ? "cnc-money-warning" : "")">@Money(row.DifferenceValue)</td>
                                                        <td><span class="cnc-badge cnc-badge--@row.StatusTone">@row.StatusLabel</span><small>@row.Reason</small></td>
                                                        <td>
                                                            <div class="cnc-row-actions">
                                                                <button type="button" class="btn btn-sm btn-outline-success" data-cnc-action="Aprobado">Aprobar</button>
                                                                <button type="button" class="btn btn-sm btn-outline-secondary" data-cnc-action="RevisionManual">Revisar</button>
                                                                <button type="button" class="btn btn-sm btn-outline-danger" data-cnc-action="Rechazado">Rechazar</button>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </section>

                                <section class="cnc-pipeline-stage">
                                    <header class="cnc-pipeline-stage__header">
                                        <h3>4. Prevalidacion y listos Siigo</h3>
                                        <span data-cnc-stage-count>@Number(preflightRows.Count) filas</span>
                                    </header>
                                    <div class="cnc-table-wrap">
                                        <table class="table align-middle cnc-table cnc-table--pipeline">
                                            <thead>
                                                <tr>
                                                    <th>Factura / cliente flujo de caja</th>
                                                    <th>Factura / cliente Dataverse</th>
                                                    <th>Banco</th>
                                                    <th class="text-end">Entrada</th>
                                                    <th class="text-end">Valor Dataverse</th>
                                                    <th>Pre-Siigo</th>
                                                    <th>Debito / credito</th>
                                                    <th>Accion</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var row in preflightRows)
                                                {
                                                    var search = $"{row.InvoiceNumbers} {row.ClientNames} {row.Description} {row.BankAccountName}".ToLowerInvariant();
                                                    var flowInvoice = InvoiceFromFlow(row);
                                                    <tr class="cnc-click-row"
                                                        data-record-id="@row.RecordId"
                                                        data-status="@row.Status"
                                                        data-flow="@row.SourceFlow"
                                                        data-search="@search">
                                                        <td><strong>@(string.IsNullOrWhiteSpace(flowInvoice) ? "Sin factura" : flowInvoice)</strong><small>@row.Description</small></td>
                                                        <td><strong>@(string.IsNullOrWhiteSpace(row.InvoiceNumbers) ? "Sin factura" : row.InvoiceNumbers)</strong><small>@(string.IsNullOrWhiteSpace(row.ClientNames) ? "Sin cliente" : row.ClientNames)</small></td>
                                                        <td><strong>@row.BankAccountCode</strong><small>@row.BankAccountName</small></td>
                                                        <td class="text-end">@Money(row.EntryValue)</td>
                                                        <td class="text-end">@Money(row.InvoiceTotal)</td>
                                                        <td>
                                                            <span class="cnc-badge cnc-badge--@row.PreflightStatusTone" data-preflight-label>@row.PreflightStatusLabel</span>
                                                            <small data-preflight-message>@(string.IsNullOrWhiteSpace(row.PreflightMessage) ? "Sin validacion pre-Siigo." : row.PreflightMessage)</small>
                                                            <ul class="cnc-issue-list" data-preflight-issues hidden></ul>
                                                            <small data-siigo-send-message>Sin envio real.</small>
                                                            <ul class="cnc-issue-list" data-siigo-send-issues hidden></ul>
                                                            <details class="cnc-json-preview" data-siigo-send-payload-preview hidden>
                                                                <summary>Payload real</summary>
                                                                <pre data-siigo-send-payload></pre>
                                                            </details>
                                                            <details class="cnc-json-preview" data-siigo-send-preview hidden>
                                                                <summary>Respuesta Siigo</summary>
                                                                <pre data-siigo-send-response></pre>
                                                            </details>
                                                        </td>
                                                        <td><small data-preflight-totals>Db @Money(row.PreflightDebitTotal) / Cr @Money(row.PreflightCreditTotal)</small></td>
                                                        <td>
                                                            <div class="cnc-row-actions">
                                                                <button type="button" class="btn btn-sm btn-outline-primary" data-cnc-preflight>Validar pre-Siigo</button>
                                                                <button type="button"
                                                                        class="btn btn-sm btn-danger"
                                                                        data-cnc-send-siigo
                                                                        @(HasPaymentStatus(row, "ListoSiigo") ? null : "disabled")>
                                                                    Enviar comprobante
                                                                </button>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </section>

                                <section class="cnc-pipeline-stage">
                                    <header class="cnc-pipeline-stage__header">
                                        <h3>5. Enviados / errores Siigo</h3>
                                        <span data-cnc-stage-count>@Number(sentRows.Count) filas</span>
                                    </header>
                                    <div class="cnc-table-wrap">
                                        <table class="table align-middle cnc-table cnc-table--pipeline">
                                            <thead>
                                                <tr>
                                                    <th>Fecha</th>
                                                    <th>Factura / cliente</th>
                                                    <th class="text-end">Entrada</th>
                                                    <th>Estado Siigo</th>
                                                    <th>Detalle</th>
                                                    <th>Accion</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var row in sentRows)
                                                {
                                                    var search = $"{row.InvoiceNumbers} {row.ClientNames} {row.Description} {row.BankAccountName}".ToLowerInvariant();
                                                    <tr class="cnc-click-row"
                                                        data-record-id="@row.RecordId"
                                                        data-status="@row.Status"
                                                        data-flow="@row.SourceFlow"
                                                        data-search="@search">
                                                        <td><strong>@row.MovementDateDisplay</strong><small>@row.SourceFlow</small></td>
                                                        <td><strong>@(string.IsNullOrWhiteSpace(row.InvoiceNumbers) ? "Sin factura" : row.InvoiceNumbers)</strong><small>@row.ClientNames</small></td>
                                                        <td class="text-end">@Money(row.EntryValue)</td>
                                                        <td><span class="cnc-badge cnc-badge--@row.StatusTone" data-status-label>@row.StatusLabel</span></td>
                                                        <td>
                                                            <small data-preflight-message>@(string.IsNullOrWhiteSpace(row.PreflightMessage) ? row.Reason : row.PreflightMessage)</small>
                                                            <small data-siigo-send-message>Listo para reintento si corriges el origen del error.</small>
                                                            <ul class="cnc-issue-list" data-siigo-send-issues hidden></ul>
                                                            <details class="cnc-json-preview" data-siigo-send-payload-preview hidden>
                                                                <summary>Payload real</summary>
                                                                <pre data-siigo-send-payload></pre>
                                                            </details>
                                                            <details class="cnc-json-preview" data-siigo-send-preview hidden>
                                                                <summary>Respuesta Siigo</summary>
                                                                <pre data-siigo-send-response></pre>
                                                            </details>
                                                        </td>
                                                        <td>
                                                            @if (HasPaymentStatus(row, "ErrorSiigo"))
                                                            {
                                                                <button type="button" class="btn btn-sm btn-danger" data-cnc-send-siigo>Reintentar comprobante</button>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </section>
                            </div>
                        </section>
                    }
                    else
                    {
                        <section class="cnc-payment-panel">
                            <div class="cnc-table-toolbar">
                                <input class="form-control cnc-table-search" type="search" placeholder="Buscar banco, descripcion o estado" data-cnc-table-search="@phase.Key" />
                                <span class="cnc-counter" data-cnc-table-count="@phase.Key">@Number(phaseRows.Count) filas</span>
                            </div>

                            <div class="cnc-table-wrap">
                                <table class="table align-middle cnc-table">
                                    <thead>
                                        @if (phase.Key == "flujo-caja")
                                        {
                                            <tr>
                                                <th>Fecha</th>
                                                <th>Banco</th>
                                                <th>Descripcion</th>
                                                <th>Tipo detectado</th>
                                                <th class="text-end">Valor</th>
                                                <th>Validacion</th>
                                                <th>Registro</th>
                                                <th>Accion</th>
                                            </tr>
                                        }
                                        else
                                        {
                                            <tr>
                                                <th>Fecha</th>
                                                <th>Banco</th>
                                                <th>Descripcion</th>
                                                <th class="text-end">Valor</th>
                                                <th>Dataverse</th>
                                                <th>Siigo</th>
                                                <th>Pago / saldo</th>
                                                <th>Accion</th>
                                            </tr>
                                        }
                                    </thead>
                                    <tbody data-cnc-table-body="@phase.Key">
                                        @foreach (var row in phaseRows)
                                        {
                                            <tr class="cnc-click-row"
                                                data-cnc-reassign
                                                data-record-id="@row.RecordId"
                                                data-flow="@row.SourceFlow"
                                                data-search="@SearchText(row)"
                                                data-direction="@row.Direction"
                                                data-current-type="@row.DetectedTypeKey"
                                                data-description="@row.Description">
                                                <td>
                                                    <strong>@row.MovementDateDisplay</strong>
                                                    <small>@row.SourceFlow</small>
                                                </td>
                                                <td>
                                                    <strong>@(string.IsNullOrWhiteSpace(row.BankAccountCode) ? row.SourceFlow : row.BankAccountCode)</strong>
                                                    <small>@row.BankAccountName</small>
                                                </td>
                                                <td>
                                                    <strong>@(string.IsNullOrWhiteSpace(row.Description) ? row.Recipient : row.Description)</strong>
                                                    <small>@row.DocumentType @row.Observations</small>
                                                </td>
                                                @if (phase.Key == "flujo-caja")
                                                {
                                                    <td>
                                                        <span class="cnc-badge cnc-badge--@row.DetectedTypeTone" data-cnc-type-label>@row.DetectedTypeLabel</span>
                                                        <small>@row.Direction</small>
                                                    </td>
                                                    <td class="text-end">@Money(row.Amount)</td>
                                                    <td>
                                                        <span class="cnc-badge cnc-badge--@row.ValidationTone">@row.ValidationStatus</span>
                                                        <small>@row.InvoiceStatus</small>
                                                    </td>
                                                    <td>
                                                        <span class="cnc-badge cnc-badge--@row.RegistrationTone">@row.RegistrationStatus</span>
                                                        <small>@row.SiigoStatus</small>
                                                    </td>
                                                }
                                                else
                                                {
                                                    <td class="text-end">@Money(row.Amount)</td>
                                                    <td>
                                                        <span class="cnc-badge cnc-badge--@row.InvoiceStatusTone">@row.InvoiceStatus</span>
                                                        <small>@row.DataversePaymentStatus</small>
                                                    </td>
                                                    <td>
                                                        <span class="cnc-badge cnc-badge--@row.SiigoDocumentTone">@row.SiigoDocumentStatus</span>
                                                        <small>@row.RegistrationStatus</small>
                                                    </td>
                                                    <td>
                                                        <span class="cnc-badge cnc-badge--@row.SiigoPaymentTone">@row.SiigoPaymentStatus</span>
                                                        <small>@row.InvoiceBalanceStatus</small>
                                                    </td>
                                                }
                                                <td>
                                                    <div class="cnc-row-actions">
                                                        @if (row.CanValidate && !string.IsNullOrWhiteSpace(row.ActionTargetKey))
                                                        {
                                                            <button type="button" class="btn btn-sm btn-outline-primary" data-cnc-tab-target="@row.ActionTargetKey">Validar</button>
                                                        }
                                                        <button type="button" class="btn btn-sm btn-outline-secondary" data-cnc-open-reassign>Categoria</button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </section>
                    }
                </section>
            }
        </div>
    </section>

    <div class="cnc-modal" id="cncReassignModal" role="dialog" aria-modal="true" aria-labelledby="cncReassignTitle" hidden>
        <div class="cnc-modal__panel">
            <div class="cnc-modal__header">
                <div>
                    <div class="cnc-kicker">Reasignacion</div>
                    <h2 id="cncReassignTitle">Categoria del registro</h2>
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-cnc-close-modal>Cerrar</button>
            </div>
            <p class="cnc-modal__description" id="cncReassignDescription"></p>
            <label class="cnc-modal__field">
                <span>Categoria</span>
                <select class="form-select" id="cncReassignCategory"></select>
            </label>
            <div class="cnc-modal__actions">
                <button type="button" class="btn btn-outline-secondary" data-cnc-close-modal>Cancelar</button>
                <button type="button" class="btn btn-primary" id="cncReassignApply">Aplicar</button>
            </div>
        </div>
    </div>

    <div class="cnc-modal" id="cncInvoiceModal" role="dialog" aria-modal="true" aria-labelledby="cncInvoiceTitle" hidden>
        <div class="cnc-modal__panel cnc-modal__panel--wide">
            <div class="cnc-modal__header">
                <div>
                    <div class="cnc-kicker">Factura Dataverse</div>
                    <h2 id="cncInvoiceTitle">Asignar factura al pago</h2>
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-cnc-close-invoice-modal>Cerrar</button>
            </div>
            <p class="cnc-modal__description" id="cncInvoiceDescription"></p>
            <div class="cnc-invoice-search">
                <label class="cnc-modal__field">
                    <span>Cliente o factura</span>
                    <input class="form-control" id="cncInvoiceQuery" type="search" placeholder="Cliente, numero de factura o NIT" />
                </label>
                <label class="cnc-modal__field">
                    <span>Valor factura</span>
                    <input class="form-control" id="cncInvoiceValue" type="number" min="0" step="1" />
                </label>
                <button type="button" class="btn btn-outline-primary" id="cncInvoiceSearchButton">Buscar</button>
            </div>
            <div class="cnc-invoice-selected" id="cncInvoiceSelected" hidden></div>
            <div class="cnc-invoice-results" id="cncInvoiceResults">
                <small>Busca por cliente, numero de factura o valor para seleccionar la factura correcta.</small>
            </div>
            <div class="cnc-modal__actions">
                <button type="button" class="btn btn-outline-secondary" data-cnc-close-invoice-modal>Cancelar</button>
                <button type="button" class="btn btn-primary" id="cncInvoiceSave" disabled>Guardar asignacion</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/conciliacion.js" asp-append-version="true"></script>
}
