            <div class="cnc-modal__actions">
                <button type="button" class="btn btn-outline-secondary" data-cnc-close-supplier-payment-modal>Cancelar</button>
                <button type="button" class="btn btn-outline-secondary" id="cncSupplierPaymentSkip" hidden>Omitir</button>
                <button type="button" class="btn btn-primary" id="cncSupplierPaymentSend" disabled>Enviar a Siigo</button>
            </div>
