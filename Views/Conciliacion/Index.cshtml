    <div class="cnc-modal" id="cncSupplierPaymentModal" role="dialog" aria-modal="true" aria-labelledby="cncSupplierPaymentTitle" hidden>
        <div class="cnc-modal__panel cnc-modal__panel--preview">
            <div class="cnc-modal__header">
                <div>
                    <div class="cnc-kicker">Pago proveedor</div>
                    <h2 id="cncSupplierPaymentTitle">Aplicar pago a factura Siigo</h2>
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-cnc-close-supplier-payment-modal>Cerrar</button>
            </div>
            <p class="cnc-modal__description" id="cncSupplierPaymentDescription"></p>
            <div class="cnc-supplier-payment-summary" id="cncSupplierPaymentSummary"></div>
            <div class="cnc-supplier-payment-search">
                <label class="cnc-modal__field">
                    <span>Proveedor Siigo</span>
                    <input class="form-control" id="cncSupplierPaymentSupplierQuery" type="search" placeholder="Nombre o NIT del proveedor" />
                </label>
                <button type="button" class="btn btn-outline-primary" id="cncSupplierPaymentSupplierSearch">Buscar proveedor</button>
            </div>
            <div class="cnc-supplier-payment-suppliers" id="cncSupplierPaymentSuppliers"></div>
            <div class="cnc-supplier-payment-table-wrap">
                <table class="table align-middle cnc-table cnc-supplier-payment-table">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Factura Siigo</th>
                            <th>Factura proveedor</th>
                            <th>Gastos Dataverse</th>
                            <th class="text-end">Saldo por pagar</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody id="cncSupplierPaymentPurchases">
                        <tr>
                            <td colspan="6"><small>Busca o confirma el proveedor para ver facturas abiertas.</small></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="cnc-modal__grid">
                <label class="cnc-modal__field">
                    <span>Retefuente</span>
                    <input class="form-control" id="cncSupplierPaymentReteFuenteValue" type="number" min="0" step="1" value="0" />
                </label>
                <label class="cnc-modal__field">
                    <span>Tarifa retefuente (%)</span>
                    <input class="form-control" id="cncSupplierPaymentReteFuenteRate" type="number" min="0" step="0.01" />
                </label>
                <label class="cnc-modal__field">
                    <span>ReteICA</span>
                    <input class="form-control" id="cncSupplierPaymentReteIcaValue" type="number" min="0" step="1" value="0" />
                </label>
                <label class="cnc-modal__field">
                    <span>Tarifa ReteICA (x1000)</span>
                    <input class="form-control" id="cncSupplierPaymentReteIcaRate" type="number" min="0" step="0.001" />
