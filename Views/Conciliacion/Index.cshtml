                                        <table class="table align-middle cnc-table cnc-table--pipeline">
                                            <thead>
                                                <tr>
                                                    <th>Fecha</th>
                                                    <th>Factura / cliente flujo de caja</th>
                                                    <th>Factura / cliente Dataverse</th>
                                                    <th>Banco</th>
                                                    <th class="text-end">Entrada</th>
                                                    <th class="text-end">Valor Dataverse</th>
                                                    <th>Pre-Siigo</th>
                                                    <th>Debito / credito</th>
                                                    <th>Accion</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var row in preflightRows)
                                                {
                                                    var search = $"{row.SourceRowNumber} {row.InvoiceNumbers} {row.ClientNames} {row.Description} {row.BankAccountName}".ToLowerInvariant();
                                                    var flowInvoice = InvoiceFromFlow(row);
                                                    <tr class="cnc-click-row"
                                                        data-cnc-invoice-assign
                                                        data-record-id="@row.RecordId"
                                                        data-status="@row.Status"
                                                        data-flow="@row.SourceFlow"
                                                        data-search="@search"
                                                        data-description="@row.Description"
                                                        data-flow-invoice="@flowInvoice"
                                                        data-dataverse-invoice="@row.InvoiceNumbers"
                                                        data-dataverse-client="@row.ClientNames"
                                                        data-entry-value="@row.EntryValue.ToString(CultureInfo.InvariantCulture)">
                                                        <td><strong>@row.MovementDateDisplay</strong><small>@ExcelRowLabel(row.SourceRowNumber)</small><small>@row.SourceFlow</small></td>
                                                        <td><strong>@(string.IsNullOrWhiteSpace(flowInvoice) ? "Sin factura" : flowInvoice)</strong><small>@ExcelRowLabel(row.SourceRowNumber)</small><small>@row.Description</small></td>
                                                        <td><strong>@(string.IsNullOrWhiteSpace(row.InvoiceNumbers) ? "Sin factura" : row.InvoiceNumbers)</strong><small>@(string.IsNullOrWhiteSpace(row.ClientNames) ? "Sin cliente" : row.ClientNames)</small></td>
                                                        <td><strong>@row.BankAccountCode</strong><small>@row.BankAccountName</small></td>
                                                        <td class="text-end">@Money(row.EntryValue)<small class="cnc-muted-detail">Retenciones DV @Money(row.RetentionsTotal)</small></td>
                                                        <td class="text-end">@Money(row.InvoiceTotal)</td>
                                                        <td>
                                                            <span class="cnc-badge cnc-badge--@row.PreflightStatusTone" data-preflight-label>@row.PreflightStatusLabel</span>
                                                            <small data-preflight-message>@(string.IsNullOrWhiteSpace(row.PreflightMessage) ? "Sin validacion pre-Siigo." : row.PreflightMessage)</small>
                                                            <ul class="cnc-issue-list" data-preflight-issues hidden></ul>
                                                            <small data-siigo-send-message>Sin envio real.</small>
                                                            <ul class="cnc-issue-list" data-siigo-send-issues hidden></ul>
                                                            <details class="cnc-json-preview" data-siigo-send-payload-preview hidden>
                                                                <summary>Payload real</summary>
                                                                <pre data-siigo-send-payload></pre>
                                                            </details>
                                                            <details class="cnc-json-preview" data-siigo-send-preview hidden>
                                                                <summary>Respuesta Siigo</summary>
                                                                <pre data-siigo-send-response></pre>
                                                            </details>
                                                        </td>
                                                        <td><small data-preflight-totals>Db @Money(row.PreflightDebitTotal) / Cr @Money(row.PreflightCreditTotal)</small></td>
                                                        <td>
                                                            <div class="cnc-row-actions">
                                                                <button type="button" class="btn btn-sm btn-outline-primary" data-cnc-preflight>Validar pre-Siigo</button>
                                                                <button type="button" class="btn btn-sm btn-outline-secondary" data-cnc-open-invoice-modal>Cambiar factura</button>
                                                                <button type="button"
                                                                        class="btn btn-sm btn-danger"
                                                                        data-cnc-send-siigo
                                                                        @(HasPaymentStatus(row, "ListoSiigo") ? null : "disabled")>
                                                                    Enviar comprobante
                                                                </button>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </section>

                                <section class="cnc-pipeline-stage">
                                    <header class="cnc-pipeline-stage__header">
                                        <h3>5. Enviados / errores Siigo</h3>
