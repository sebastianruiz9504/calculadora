                                                    <th>Fecha</th>
                                                    <th>Proveedor</th>
                                                    <th class="text-end">Bruto / pago</th>
                                                    <th>Documento soporte</th>
                                                    <th>Pago Siigo</th>
                                                    <th>Detalle</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var row in sentSupportRows)
                                                 {
                                                     var hasSupportDocument = !string.IsNullOrWhiteSpace(row.SiigoDocumentId) || !string.IsNullOrWhiteSpace(row.SiigoDocumentName);
                                                     var hasSupportPayment = !string.IsNullOrWhiteSpace(row.SiigoPaymentId) || !string.IsNullOrWhiteSpace(row.SiigoPaymentName);
                                                     var needsSupportDocumentVerification =
                                                         row.AutomationState.Equals("VerificacionDocumentoSoporteSiigoPendiente", StringComparison.OrdinalIgnoreCase)
                                                         || row.ReviewReason.Contains("[SIIGO_SUPPORT_DOCUMENT_WRITE_AMBIGUOUS]", StringComparison.OrdinalIgnoreCase);
                                                     var supportDocumentInProgress =
                                                         row.AutomationState.Equals("ProcesandoDocumentoSoporteSiigo", StringComparison.OrdinalIgnoreCase);
                                                     var hasSupportDocumentWriteHold = needsSupportDocumentVerification || supportDocumentInProgress;
                                                     var isLegacySupportRow = row.RecordSource.Equals("cuenta-cobro", StringComparison.OrdinalIgnoreCase);
                                                     <tr data-record-id="@row.RecordId"
                                                         data-record-source="@row.RecordSource"
                                                         data-concurrency-token="@row.ConcurrencyToken"
                                                         data-cashflow-record-id="@row.CashFlowRecordId"
                                                         data-movement-external-key="@row.CashFlowExternalKey"
                                                        data-flow="@row.SourceFlow"
                                                        data-search="@CuentaCobroSearchText(row)">
                                                        <td><strong>@(string.IsNullOrWhiteSpace(row.FechaPagoDisplay) ? row.MovementDateDisplay : row.FechaPagoDisplay)</strong><small>@row.SourceFlow</small></td>
                                                        <td><strong>@row.Receptor</strong><small>@ExcelRowLabel(row.SourceRowNumber)</small><small>@row.NitOCedula</small></td>
                                                        <td class="text-end">
                                                            <strong>@Money(row.ValorTotal)</strong>
                                                            <small>Pago @Money(row.ValorPago)</small>
                                                            <small>Retenciones @Money(row.Retentions.Sum(retention => retention.Value))</small>
                                                            @foreach (var retention in row.Retentions.Where(retention => retention.Value > 0m))
                                                            {
                                                                <small>@(string.IsNullOrWhiteSpace(retention.Label) ? retention.Kind : retention.Label) @Money(retention.Value)</small>
                                                            }
                                                         </td>
                                                         <td>
                                                             @if (!hasSupportDocument && !hasSupportDocumentWriteHold && !isLegacySupportRow)
                                                             {
                                                                 <span hidden data-cnc-cuenta-cobro-send></span>
                                                             }
                                                            <span class="cnc-badge cnc-badge--@row.SiigoStatusTone">@row.SiigoStatusLabel</span>
                                                            <strong>@(string.IsNullOrWhiteSpace(row.SiigoDocumentName) ? "Sin DS" : row.SiigoDocumentName)</strong>
                                                            <small>@row.SiigoDocumentId</small>
                                                         </td>
                                                         <td>
                                                             @if (hasSupportDocument && !hasSupportPayment && !needsSupportDocumentVerification)
                                                             {
                                                                 <span hidden data-cnc-cuenta-cobro-send-payment></span>
                                                             }
                                                            <span class="cnc-badge cnc-badge--@row.SiigoPaymentStatusTone">@row.SiigoPaymentStatusLabel</span>
                                                            <strong>@(string.IsNullOrWhiteSpace(row.SiigoPaymentName) ? "Sin pago" : row.SiigoPaymentName)</strong>
                                                            <small>@row.SiigoPaymentId</small>
                                                        </td>
                                                        <td>
                                                            <small data-cnc-cuenta-cobro-message>@(string.IsNullOrWhiteSpace(row.ReviewReason) ? row.StageLabel : row.ReviewReason)</small>
                                                            <ul class="cnc-issue-list" data-cnc-cuenta-cobro-issues hidden></ul>
                                                            <details class="cnc-json-preview" hidden data-cnc-cuenta-cobro-preview>
                                                                <summary>Payload / respuesta</summary>
                                                                <pre data-cnc-cuenta-cobro-payload></pre>
                                                                <pre data-cnc-cuenta-cobro-response></pre>
                                                            </details>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </section>
                            </div>
                        </section>
                    }
                    else if (phase.Key == "comprobantes")
                    {
                        var voucherGroups = board.CashFlow.AccountingVoucherGroups;
                        var accountValidationGroups = voucherGroups
                            .Where(group => !AccountingVoucherGroupInLog(group) && group.HasMissingAccounts)
                            .ToArray();
                        var readyVoucherGroups = voucherGroups
                            .Where(group => !AccountingVoucherGroupInLog(group) && !group.HasMissingAccounts)
                            .ToArray();
                        var logVoucherGroups = voucherGroups.Where(AccountingVoucherGroupInLog).ToArray();
                        var voucherSections = new[]
                        {
                            new { Title = "1. Validar cuentas contables", Groups = accountValidationGroups },
                            new { Title = "2. Listos para enviar a Siigo", Groups = readyVoucherGroups },
                            new { Title = "3. Enviados / errores a Siigo", Groups = logVoucherGroups }
                        };
                        <section class="cnc-payment-panel">
                            <div class="cnc-table-toolbar">
                                <input class="form-control cnc-table-search" type="search" placeholder="Buscar banco, descripcion, cuenta o estado" data-cnc-table-search="@phase.Key" />
                                <span class="cnc-counter" data-cnc-table-count="@phase.Key">@Number(voucherGroups.Count) grupos</span>
                            </div>

                            <div class="cnc-pipeline" data-cnc-table-body="@phase.Key">
                                @foreach (var voucherSection in voucherSections)
                                {
                                    <section class="cnc-pipeline-stage">
                                        <header class="cnc-pipeline-stage__header">
                                            <h3>@voucherSection.Title</h3>
                                            <span data-cnc-stage-count>@Number(voucherSection.Groups.Length) grupos</span>
                                        </header>
                                        <div class="cnc-table-wrap">
                                            <table class="table align-middle cnc-table cnc-table--pipeline">
                                                <thead>
                                                    <tr>
                                                        <th>Cierre</th>
                                                        <th>Banco</th>
                                                        <th>Acumulado / desglose</th>
                                                        <th class="text-end">Valor</th>
                                                        <th>Pago / saldo</th>
                                                        <th>Lineas contables</th>
                                                        <th>Estado</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var group in voucherSection.Groups)
                                                    {
                                                        var firstRow = group.Rows.FirstOrDefault();
                                                        var hasAccount = !group.HasMissingAccounts;
                                                        var isError = group.Rows.Any(row => string.Equals(row.SiigoStatus, "ErrorSiigo", StringComparison.OrdinalIgnoreCase));
                                                        var inLog = AccountingVoucherGroupInLog(group);
                                                        var primaryDocument = group.Rows
                                                            .Select(row => string.IsNullOrWhiteSpace(row.SiigoDocumentName) ? row.SiigoDocumentId : row.SiigoDocumentName)
                                                            .FirstOrDefault(value => !string.IsNullOrWhiteSpace(value)) ?? "";
                                                        var persistedThirdParty = firstRow is not null
                                                            && !string.IsNullOrWhiteSpace(firstRow.ThirdPartyId)
                                                            && !string.IsNullOrWhiteSpace(firstRow.ThirdPartyIdentification)
                                                            && group.Rows.All(row =>
                                                                string.Equals(row.ThirdPartyId, firstRow.ThirdPartyId, StringComparison.OrdinalIgnoreCase)
                                                                && string.Equals(row.ThirdPartyIdentification, firstRow.ThirdPartyIdentification, StringComparison.OrdinalIgnoreCase)
                                                                && string.Equals(row.ThirdPartyName, firstRow.ThirdPartyName, StringComparison.Ordinal)
                                                                && row.ThirdPartyBranchOffice == firstRow.ThirdPartyBranchOffice)
                                                                ? firstRow
                                                                : null;
                                                        <tr class="cnc-click-row"
                                                            data-cnc-accounting-voucher-edit
                                                            data-record-id="@group.GroupKey"
                                                            data-cashflow-record-id="@(firstRow?.RecordId ?? "")"
                                                            data-cashflow-record-ids="@DataList(group.RecordIds)"
                                                            data-source-kind="@(firstRow?.SourceKind ?? "Movimiento")"
                                                            data-movement-external-key="@(firstRow?.ExternalKey ?? "")"
                                                            data-movement-external-keys="@DataList(group.MovementExternalKeys)"
                                                            data-accounting-voucher-group-key="@group.GroupKey"
                                                            data-accounting-voucher-group-label="@group.GroupLabel"
                                                            data-flow="@group.SourceFlow"
                                                            data-search="@AccountingVoucherGroupSearchText(group)"
                                                            data-direction="@group.Direction"
                                                            data-current-type="@(firstRow?.DetectedTypeKey ?? (string.Equals(group.Direction, "Entrada", StringComparison.OrdinalIgnoreCase) ? "entrada-comprobante" : "comprobante-contable"))"
                                                            data-description="@group.GroupLabel"
                                                            data-account-code="@(group.AccountLines.Count == 1 ? group.AccountLines[0].AccountCode : "")"
                                                            data-account-name="@(group.AccountLines.Count == 1 ? group.AccountLines[0].AccountName : "")"
                                                            data-third-party-id="@(persistedThirdParty?.ThirdPartyId ?? "")"
                                                            data-third-party-identification="@(persistedThirdParty?.ThirdPartyIdentification ?? "")"
                                                            data-third-party-name="@(persistedThirdParty?.ThirdPartyName ?? "")"
                                                            data-third-party-branch-office="@(persistedThirdParty?.ThirdPartyBranchOffice ?? 0)">
                                                            <td>
                                                                <strong>@group.MovementDateDisplay</strong>
                                                                <small>@(group.IsMonthlyCloseGroup ? "Cierre mensual" : "Movimiento individual")</small>
                                                                <small>@group.SourceFlow</small>
                                                            </td>
                                                            <td><strong>@(string.IsNullOrWhiteSpace(group.BankAccountCode) ? group.SourceFlow : group.BankAccountCode)</strong><small>@group.BankAccountName</small></td>
                                                            <td>
                                                                <strong>@group.GroupLabel</strong>
                                                                <small>@group.GroupDetail</small>
                                                                <details class="cnc-voucher-breakdown">
                                                                    <summary>Desglose: @Number(group.RowCount) movimiento(s)</summary>
                                                                    <div class="cnc-voucher-breakdown__grid">
                                                                        @foreach (var line in group.Rows)
                                                                        {
                                                                            <div class="cnc-voucher-breakdown__line">
                                                                                <strong>@line.MovementDateDisplay - @Money(line.Amount)</strong>
                                                                                <small>@ExcelRowLabel(line.SourceRowNumber) - @(string.IsNullOrWhiteSpace(line.Description) ? line.Recipient : line.Description)</small>
                                                                                <small>@(string.IsNullOrWhiteSpace(line.AccountCode) ? "Sin cuenta contable" : $"{line.AccountCode} - {line.AccountName}")</small>
                                                                                <button type="button"
                                                                                        class="btn btn-sm btn-outline-secondary"
                                                                                        data-cnc-accounting-voucher-line-edit
                                                                                        data-record-id="@line.RecordId"
                                                                                        data-cashflow-record-id="@line.RecordId"
                                                                                        data-source-kind="@line.SourceKind"
                                                                                        data-movement-external-key="@line.ExternalKey"
                                                                                        data-description="@line.Description"
                                                                                        data-account-code="@line.AccountCode"
                                                                                        data-account-name="@line.AccountName">
                                                                                    Cuenta
                                                                                </button>
                                                                            </div>
                                                                        }
                                                                    </div>
                                                                </details>
                                                            </td>
                                                            <td class="text-end">@Money(group.Amount)<small>@group.Direction</small></td>
                                                            <td><strong>Pago @Money(AccountingVoucherGroupPaid(group))</strong><small>Saldo @Money(AccountingVoucherGroupBalance(group))</small></td>
                                                            <td>
                                                                @foreach (var line in group.AccountLines)
                                                                {
                                                                    <strong>@line.ConceptLabel</strong>
                                                                    <small>@(line.HasAccount ? $"{line.AccountCode} - {line.AccountName}" : "Sin cuenta contable") - @Money(line.Amount) - @Number(line.RowCount) mov.</small>
                                                                }
                                                            </td>
                                                            <td>
                                                                @if (hasAccount && (!inLog || isError))
                                                                {
                                                                    <span hidden data-cnc-accounting-voucher-send></span>
                                                                }
                                                                @if (!hasAccount)
                                                                {
                                                                    <span class="cnc-badge cnc-badge--danger">Pendiente cuenta contable</span>
                                                                    <small>Asigna la cuenta en el desglose antes de enviar.</small>
                                                                }
                                                                else if (isError)
                                                                {
                                                                    <span class="cnc-badge cnc-badge--danger">Error Siigo</span>
                                                                    <small>Listo para reintento con accion masiva.</small>
                                                                    <button type="button" class="btn btn-sm btn-danger cnc-inline-action" data-cnc-accounting-voucher-send>Reintentar envio</button>
                                                                }
                                                                else if (inLog)
                                                                {
                                                                    <span class="cnc-badge cnc-badge--success">Enviado Siigo</span>
                                                                    <strong>@primaryDocument</strong>
                                                                }
                                                                else
                                                                {
                                                                    <span class="cnc-badge cnc-badge--success">OK para Siigo</span>
                                                                    <small>Enviar desde la tabla de listos.</small>
                                                                    <button type="button" class="btn btn-sm btn-danger cnc-inline-action" data-cnc-accounting-voucher-send>Enviar a Siigo</button>
                                                                }
                                                                <ul class="cnc-issue-list" data-cnc-accounting-voucher-issues hidden></ul>
                                                                <details class="cnc-json-preview" hidden data-cnc-accounting-voucher-preview>
                                                                    <summary>Payload / respuesta</summary>
                                                                    <pre data-cnc-accounting-voucher-payload></pre>
                                                                    <pre data-cnc-accounting-voucher-response></pre>
                                                                </details>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </section>
                                }
                            </div>
                        </section>
                    }
                    else
                    {
                        <section class="cnc-payment-panel">
                            @if (phase.Key == "flujo-caja" && board.CashFlow.BankSummaries.Count > 0)
                            {
                                <div class="cnc-bank-summary" aria-label="Resumen por banco">
                                    <table class="table align-middle cnc-table cnc-table--summary">
                                        <thead>
                                            <tr>
                                                <th>Banco</th>
                                                <th class="text-end">Registros encontrados</th>
                                                <th class="text-end">Reportados a Siigo</th>
                                                <th class="text-end">Pendientes conciliar</th>
                                                <th class="text-end">Ingresos</th>
                                                <th class="text-end">Egresos</th>
                                                <th>Cierre</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var summary in board.CashFlow.BankSummaries)
                                            {
                                                <tr>
                                                    <td><strong>@summary.BankLabel</strong></td>
                                                    <td class="text-end">@Number(summary.RowsFound)</td>
                                                    <td class="text-end">@Number(summary.ReportedToSiigo)</td>
                                                    <td class="text-end">@Number(summary.PendingConciliation)</td>
                                                    <td class="text-end">@Money(summary.TotalEntries)</td>
                                                    <td class="text-end">@Money(summary.TotalExits)</td>
                                                    <td>
                                                        <button type="button"
                                                                class="btn btn-sm btn-outline-primary"
                                                                data-cnc-open-month-close
                                                                data-bank-key="@summary.BankKey"
                                                                data-bank-label="@summary.BankLabel">
                                                            Cargar extracto
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }

                            @if (phase.Key == "flujo-caja")
                            {
                                var pendingCashRows = phaseRows.Where(CashFlowPendingForClose).ToArray();
                                var conciliatedCashRows = phaseRows.Where(row => !CashFlowPendingForClose(row)).ToArray();
                                var cashFlowGroups = new[]
                                {
                                    new { Title = "Registros pendientes por conciliar", Rows = pendingCashRows, IsPending = true },
                                    new { Title = "Registros conciliados", Rows = conciliatedCashRows, IsPending = false }
                                };

                                <div class="cnc-table-toolbar cnc-table-toolbar--cashflow">
                                    <button type="button" class="btn btn-primary cnc-start-button" data-cnc-start-cashflow>
                                        INICIAR
                                    </button>
                                    <input class="form-control cnc-table-search" type="search" placeholder="Buscar banco, descripcion o estado" data-cnc-table-search="@phase.Key" />
                                    <span class="cnc-counter" data-cnc-table-count="@phase.Key">@Number(phaseRows.Count) filas</span>
                                </div>

                                <div class="cnc-pipeline" data-cnc-table-body="@phase.Key">
                                    @foreach (var group in cashFlowGroups)
                                    {
                                        <section class="cnc-pipeline-stage">
                                            <header class="cnc-pipeline-stage__header">
                                                <h3>@group.Title</h3>
                                                <span data-cnc-stage-count>@Number(group.Rows.Length) filas</span>
                                            </header>
                                            <div class="cnc-table-wrap">
                                                <table class="table align-middle cnc-table cnc-table--pipeline">
                                                    <thead>
                                                        <tr>
                                                            <th>Fecha</th>
                                                            <th>Banco</th>
                                                            <th>Descripcion</th>
                                                            <th>Tipo detectado</th>
                                                            <th class="text-end">Valor</th>
                                                            <th>Validacion</th>
                                                            <th>Registro</th>
                                                            <th>Accion</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var row in group.Rows)
                                                        {
                                                            var accumulatedGroup = AccumulatedVoucherGroupFor(row);
                                                            <tr class="cnc-click-row"
                                                                data-cnc-reassign
                                                                data-record-id="@row.RecordId"
                                                                data-cashflow-record-id="@row.RecordId"
                                                                data-source-kind="@row.SourceKind"
                                                                data-movement-external-key="@row.ExternalKey"
                                                                data-flow="@row.SourceFlow"
                                                                data-cnc-cashflow-pending="@(group.IsPending ? "true" : "false")"
                                                                data-search="@SearchText(row)"
                                                                data-direction="@row.Direction"
                                                                data-current-type="@row.DetectedTypeKey"
                                                                data-type-label="@row.DetectedTypeLabel"
                                                                data-type-tone="@row.DetectedTypeTone"
                                                                data-action-target="@row.ActionTargetKey"
                                                                data-date-display="@row.MovementDateDisplay"
                                                                data-bank-label="@FirstNonEmpty(row.BankAccountCode, row.BankAccountName, row.SourceFlow)"
                                                                data-amount-label="@Money(row.Amount)"
                                                                data-entry-value="@row.EntryValue.ToString(CultureInfo.InvariantCulture)"
                                                                data-exit-value="@row.ExitValue.ToString(CultureInfo.InvariantCulture)"
                                                                data-supplier-query="@FirstNonEmpty(row.Recipient, row.Description, row.Observations)"
                                                                data-dataverse-supplier="@row.Recipient"
                                                                data-siigo-document-id="@row.SiigoDocumentId"
                                                                data-siigo-document-name="@row.SiigoDocumentName"
                                                                data-cnc-accumulated-group-key="@(accumulatedGroup?.GroupKey ?? "")"
                                                                data-cnc-accumulated-group-label="@(accumulatedGroup?.GroupLabel ?? "")"
                                                                data-cnc-accumulated-group-detail="@(accumulatedGroup?.GroupDetail ?? "")"
                                                                data-cnc-accumulated-group-amount="@((accumulatedGroup?.Amount ?? 0m).ToString(CultureInfo.InvariantCulture))"
                                                                data-cnc-accumulated-group-amount-label="@(accumulatedGroup is null ? "" : Money(accumulatedGroup.Amount))"
                                                                data-cnc-accumulated-group-count="@(accumulatedGroup?.RowCount ?? 0)"
                                                                data-cnc-accumulated-group-missing-accounts="@((accumulatedGroup?.HasMissingAccounts ?? false) ? "true" : "false")"
                                                                data-validation-status="@row.ValidationStatus"
                                                                data-registration-status="@row.RegistrationStatus"
                                                                data-match-record-id="@row.MatchRecordId"
                                                                data-description="@row.Description">
                                                                <td><strong>@row.MovementDateDisplay</strong><small>@ExcelRowLabel(row.SourceRowNumber)</small><small>@row.SourceFlow</small></td>
                                                                <td><strong>@(string.IsNullOrWhiteSpace(row.BankAccountCode) ? row.SourceFlow : row.BankAccountCode)</strong><small>@row.BankAccountName</small></td>
                                                                <td><strong>@(string.IsNullOrWhiteSpace(row.Description) ? row.Recipient : row.Description)</strong><small>@row.DocumentType @row.Observations</small></td>
                                                                <td><span class="cnc-badge cnc-badge--@row.DetectedTypeTone" data-cnc-type-label>@row.DetectedTypeLabel</span><small>@row.Direction</small></td>
                                                                <td class="text-end">@Money(row.Amount)</td>
                                                                <td><span class="cnc-badge cnc-badge--@row.ValidationTone" data-cnc-validation-label>@row.ValidationStatus</span><small>@row.InvoiceStatus</small></td>
                                                                <td><span class="cnc-badge cnc-badge--@row.RegistrationTone" data-cnc-registration-label>@row.RegistrationStatus</span><small>@row.SiigoStatus</small></td>
                                                                <td>
                                                                    <div class="cnc-row-actions">
                                                                        <span hidden data-cnc-bulk-category></span>
                                                                        @if (row.CanValidate && !string.IsNullOrWhiteSpace(row.ActionTargetKey))
                                                                        {
                                                                            <button type="button" class="btn btn-sm btn-outline-primary" data-cnc-tab-target="@row.ActionTargetKey">Validar</button>
                                                                        }
                                                                        <button type="button" class="btn btn-sm btn-outline-secondary" data-cnc-open-reassign>Categoria</button>
                                                                        @if (group.IsPending)
                                                                        {
                                                                            <button type="button" class="btn btn-sm btn-outline-success" data-cnc-cashflow-manual>Subido manualmente</button>
                                                                        }
                                                                    </div>
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </section>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="cnc-table-toolbar">
                                    <input class="form-control cnc-table-search" type="search" placeholder="Buscar banco, descripcion o estado" data-cnc-table-search="@phase.Key" />
                                    <span class="cnc-counter" data-cnc-table-count="@phase.Key">@Number(phaseRows.Count) filas</span>
                                </div>

                                <div class="cnc-table-wrap">
                                    <table class="table align-middle cnc-table">
                                        <thead>
                                            <tr>
                                                <th>Fecha</th>
                                                <th>Banco</th>
                                                <th>Descripcion</th>
                                                <th class="text-end">Valor</th>
                                                <th>Dataverse</th>
                                                <th>Siigo</th>
                                                <th>Pago / saldo</th>
                                                <th>Accion</th>
                                            </tr>
                                        </thead>
                                        <tbody data-cnc-table-body="@phase.Key">
                                            @foreach (var row in phaseRows)
                                            {
                                                <tr class="cnc-click-row"
                                                    data-cnc-reassign
                                                    data-record-id="@row.RecordId"
                                                    data-cashflow-record-id="@row.RecordId"
                                                    data-source-kind="@row.SourceKind"
                                                    data-movement-external-key="@row.ExternalKey"
                                                    data-flow="@row.SourceFlow"
                                                    data-search="@SearchText(row)"
                                                    data-direction="@row.Direction"
                                                    data-current-type="@row.DetectedTypeKey"
                                                    data-description="@row.Description">
                                                    <td><strong>@row.MovementDateDisplay</strong><small>@ExcelRowLabel(row.SourceRowNumber)</small><small>@row.SourceFlow</small></td>
                                                    <td><strong>@(string.IsNullOrWhiteSpace(row.BankAccountCode) ? row.SourceFlow : row.BankAccountCode)</strong><small>@row.BankAccountName</small></td>
                                                    <td><strong>@(string.IsNullOrWhiteSpace(row.Description) ? row.Recipient : row.Description)</strong><small>@row.DocumentType @row.Observations</small></td>
                                                    <td class="text-end">@Money(row.Amount)</td>
                                                    <td><span class="cnc-badge cnc-badge--@row.InvoiceStatusTone">@row.InvoiceStatus</span><small>@row.DataversePaymentStatus</small></td>
                                                    <td><span class="cnc-badge cnc-badge--@row.SiigoDocumentTone">@row.SiigoDocumentStatus</span><small>@row.RegistrationStatus</small></td>
                                                    <td><span class="cnc-badge cnc-badge--@row.SiigoPaymentTone">@row.SiigoPaymentStatus</span><small>@row.InvoiceBalanceStatus</small></td>
                                                    <td>
                                                        <div class="cnc-row-actions">
                                                            @if (row.CanValidate && !string.IsNullOrWhiteSpace(row.ActionTargetKey))
                                                            {
                                                                <button type="button" class="btn btn-sm btn-outline-primary" data-cnc-tab-target="@row.ActionTargetKey">Validar</button>
                                                            }
                                                            <button type="button" class="btn btn-sm btn-outline-secondary" data-cnc-open-reassign>Categoria</button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </section>
                    }
                </section>
            }
        </div>
    </section>

    <div class="cnc-modal" id="cncMonthCloseModal" role="dialog" aria-modal="true" aria-labelledby="cncMonthCloseTitle" hidden>
        <div class="cnc-modal__panel cnc-modal__panel--wide">
            <div class="cnc-modal__header">
                <div>
                    <div class="cnc-kicker">Cierre de mes</div>
                    <h2 id="cncMonthCloseTitle">Extractos bancarios de @board.PeriodLabel</h2>
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-cnc-close-month-modal>Cerrar</button>
            </div>
            <p class="cnc-modal__description" id="cncMonthCloseDescription">
                Carga el extracto por banco para comparar contra el flujo de caja manual del mes.
            </p>
            <div class="cnc-table-wrap">
                <table class="table align-middle cnc-table cnc-table--summary">
                    <thead>
                        <tr>
                            <th>Banco</th>
                            <th class="text-end">Ingresos flujo</th>
                            <th class="text-end">Egresos flujo</th>
                            <th>Extracto</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var summary in board.CashFlow.BankSummaries)
                        {
                            <tr data-bank-key="@summary.BankKey">
                                <td><strong>@summary.BankLabel</strong></td>
                                <td class="text-end">@Money(summary.TotalEntries)</td>
                                <td class="text-end">@Money(summary.TotalExits)</td>
                                <td><input class="form-control" type="file" data-cnc-bank-statement accept=".xlsx,.xls,.csv,.pdf" /></td>
                                <td><span class="cnc-badge cnc-badge--neutral" data-cnc-bank-statement-status>Pendiente</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="cnc-modal__actions">
                <button type="button" class="btn btn-outline-secondary" data-cnc-close-month-modal>Cancelar</button>
                <button type="button" class="btn btn-primary" data-cnc-close-month-ack>Guardar seleccion</button>
            </div>
        </div>
    </div>

    <div class="cnc-modal" id="cncReassignModal" role="dialog" aria-modal="true" aria-labelledby="cncReassignTitle" hidden>
