                                                        data-flow="@row.SourceFlow"
                                                        data-search="@search"
                                                        data-description="@row.Description"
                                                        data-flow-invoice=""
                                                        data-dataverse-invoice="@row.InvoiceNumbers"
                                                        data-dataverse-client="@row.ClientNames"
                                                        data-entry-value="@row.EntryValue.ToString(CultureInfo.InvariantCulture)">
                                                        <td><strong>@row.MovementDateDisplay</strong><small>@ExcelRowLabel(row.SourceRowNumber)</small><small>@row.BankAccountName</small></td>
                                                        <td><strong>@(string.IsNullOrWhiteSpace(row.InvoiceNumbers) ? "Sin factura" : row.InvoiceNumbers)</strong><small>@(string.IsNullOrWhiteSpace(row.ClientNames) ? row.Description : row.ClientNames)</small></td>
