@model ConciliacionPageViewModel
@using System.Globalization
@using System.Text.Json
@using System.Text.RegularExpressions
@{
    ViewData["Title"] = "Conciliacion";
    var culture = CultureInfo.GetCultureInfo("es-CO");
    var board = Model.Board;
    var cashFlow = board.CashFlow;
    var dianInvoices = board.DianSupplierInvoices;
    var cuentasCobro = board.CuentasCobro;
    var dianExpenseAccountOptions = board.DianExpenseAccountOptions;
    var accountingAccountOptions = board.AccountingAccountOptions;
    var deduccionesHistoryJson = JsonSerializer.Serialize(
        board.DeduccionesIvaImports,
        new JsonSerializerOptions(JsonSerializerDefaults.Web));
    var activePhase = "conciliacion-2";
    string Money(decimal value) => value.ToString("C0", culture);
    string Number(int value) => value.ToString("N0", culture);
    string FirstNonEmpty(params string?[] values) =>
        values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value))?.Trim() ?? "";
    string ExcelRowLabel(int rowNumber) => rowNumber > 0 ? $"Fila Excel {Number(rowNumber)}" : "Fila Excel s/d";
    string SearchText(ConciliacionCashFlowRowDto row) =>
        $"{row.SourceRowNumber} {row.MovementDateDisplay} {row.SourceFlow} {row.BankAccountName} {row.Description} {row.Recipient} {row.DestinationBank} {row.DocumentType} {row.DetectedTypeLabel} {row.ValidationStatus} {row.RegistrationStatus} {row.AccountCode} {row.AccountName}".ToLowerInvariant();
    bool CashFlowReportedForClose(ConciliacionCashFlowRowDto row) =>
        row.RegistrationStatus.Contains("Siigo OK", StringComparison.OrdinalIgnoreCase)
        || row.RegistrationStatus.Contains("no aplica Siigo", StringComparison.OrdinalIgnoreCase)
        || row.SiigoDocumentStatus.Contains("Siigo OK", StringComparison.OrdinalIgnoreCase)
        || row.SiigoPaymentStatus.Contains("Enviado", StringComparison.OrdinalIgnoreCase)
        || row.SiigoPaymentStatus.Contains("detectado", StringComparison.OrdinalIgnoreCase)
        || string.Equals(row.SiigoStatus, "EnviadoSiigo", StringComparison.OrdinalIgnoreCase)
        || string.Equals(row.SiigoStatus, "Conciliado", StringComparison.OrdinalIgnoreCase);
    bool CashFlowPendingForClose(ConciliacionCashFlowRowDto row) =>
        !string.Equals(row.DetectedTypeKey, "no-incluida-conciliacion", StringComparison.OrdinalIgnoreCase)
        && !string.Equals(row.DataverseStatus, "Omitido", StringComparison.OrdinalIgnoreCase)
        && !string.Equals(row.SourceKind, "Traslado", StringComparison.OrdinalIgnoreCase)
        && !string.Equals(row.DetectedTypeKey, "traslado-interno", StringComparison.OrdinalIgnoreCase)
        && (!CashFlowReportedForClose(row)
            || row.ValidationStatus.Contains("Pendiente", StringComparison.OrdinalIgnoreCase)
            || row.ValidationStatus.Contains("Revisar", StringComparison.OrdinalIgnoreCase)
            || row.RegistrationStatus.Contains("pendiente", StringComparison.OrdinalIgnoreCase)
            || row.SiigoPaymentStatus.Contains("Pendiente", StringComparison.OrdinalIgnoreCase)
            || row.RegistrationStatus.Contains("Cambio", StringComparison.OrdinalIgnoreCase));
    bool AccountingVoucherInLog(ConciliacionCashFlowRowDto row) =>
        CashFlowReportedForClose(row)
        || string.Equals(row.SiigoStatus, "ErrorSiigo", StringComparison.OrdinalIgnoreCase)
        || row.RegistrationStatus.Contains("Error", StringComparison.OrdinalIgnoreCase);
    decimal AccountingVoucherPaid(ConciliacionCashFlowRowDto row) => CashFlowReportedForClose(row) ? row.Amount : 0m;
    bool AccountingVoucherGroupInLog(ConciliacionAccountingVoucherGroupDto group) =>
        group.Rows.Count > 0 && group.Rows.All(AccountingVoucherInLog);
    decimal AccountingVoucherGroupPaid(ConciliacionAccountingVoucherGroupDto group) =>
        group.Rows.Sum(AccountingVoucherPaid);
    decimal AccountingVoucherGroupBalance(ConciliacionAccountingVoucherGroupDto group) =>
        Math.Max(0m, group.Amount - AccountingVoucherGroupPaid(group));
    string AccountingVoucherGroupSearchText(ConciliacionAccountingVoucherGroupDto group) =>
        $"{group.GroupLabel} {group.GroupDetail} {group.MovementDateDisplay} {group.SourceFlow} {group.BankAccountName} {group.BankAccountCode} {group.Direction} {string.Join(" ", group.AccountLines.Select(line => $"{line.ConceptLabel} {line.AccountCode} {line.AccountName}"))} {string.Join(" ", group.Rows.Select(SearchText))}".ToLowerInvariant();
    ConciliacionAccountingVoucherGroupDto? AccumulatedVoucherGroupFor(ConciliacionCashFlowRowDto row) =>
        board.CashFlow.AccountingVoucherGroups
            .Where(group => group.IsGrouped)
            .FirstOrDefault(group =>
                group.RecordIds.Any(id => string.Equals(id, row.RecordId, StringComparison.OrdinalIgnoreCase))
                || group.MovementExternalKeys.Any(key => string.Equals(key, row.ExternalKey, StringComparison.OrdinalIgnoreCase)));
    string DataList(IEnumerable<string> values) =>
        string.Join("|", values.Where(value => !string.IsNullOrWhiteSpace(value)));
    var supplierPaymentStopWords = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
    {
        "PAGO",
        "FACTURA",
        "DOCUMENTO",
        "COMPRA",
        "PROVEEDOR",
        "TRANSFERENCIA",
        "BANCO",
        "CUENTA",
        "RETENCION",
        "RETEFUENTE",
        "RETEICA"
    };
    string NormalizeSupplierPaymentText(string? value)
    {
        var text = (value ?? "").Trim().ToUpperInvariant();
        text = text
            .Replace("Á", "A", StringComparison.Ordinal)
            .Replace("É", "E", StringComparison.Ordinal)
            .Replace("Í", "I", StringComparison.Ordinal)
            .Replace("Ó", "O", StringComparison.Ordinal)
            .Replace("Ú", "U", StringComparison.Ordinal)
            .Replace("Ü", "U", StringComparison.Ordinal)
            .Replace("Ñ", "N", StringComparison.Ordinal);
        return Regex.Replace(text, @"\s+", " ", RegexOptions.CultureInvariant).Trim();
    }
    string SupplierPaymentInvoiceKey(string? value) =>
        Regex.Replace(NormalizeSupplierPaymentText(value), @"[^A-Z0-9]+", "", RegexOptions.CultureInvariant);
    IReadOnlySet<string> SupplierPaymentInvoiceKeys(params string?[] values)
    {
        var keys = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var value in values)
        {
            var key = SupplierPaymentInvoiceKey(value);
            if (key.Length >= 3)
                keys.Add(key);
            var digits = Regex.Replace(value ?? "", @"\D+", "", RegexOptions.CultureInvariant);
            if (digits.Length >= 4)
                keys.Add(digits);
        }

        return keys;
    }
    bool SupplierPaymentKeysMatch(IReadOnlySet<string> left, IReadOnlySet<string> right) =>
        left.Count > 0 && right.Count > 0 && left.Any(key => right.Contains(key));
    bool SupplierPaymentAmountClose(decimal left, decimal right)
    {
        if (left <= 0m || right <= 0m)
            return false;
        var delta = Math.Abs(left - right);
        var tolerance = Math.Max(1000m, Math.Min(left, right) * 0.015m);
        return delta <= tolerance;
    }
    bool SupplierPaymentTextContainsTokens(string haystack, string needles)
    {
        var normalizedHaystack = NormalizeSupplierPaymentText(haystack);
        var tokens = NormalizeSupplierPaymentText(needles)
            .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(token => token.Length >= 4 && !supplierPaymentStopWords.Contains(token))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Take(6)
            .ToArray();
        return tokens.Length > 0
            && tokens.Count(token => normalizedHaystack.Contains(token, StringComparison.OrdinalIgnoreCase)) >= Math.Min(2, tokens.Length);
    }
    string SupplierPaymentSuggestedQuery(ConciliacionCashFlowRowDto row, ConciliacionDianSupplierInvoiceRowDto? match = null) =>
        FirstNonEmpty(match?.SupplierNit, match?.SupplierName, row.Recipient, row.Description, row.Observations);
    bool SupplierPaymentSent(ConciliacionCashFlowRowDto row) =>
        row.RegistrationStatus.Contains("Siigo OK", StringComparison.OrdinalIgnoreCase)
        || row.SiigoPaymentStatus.Contains("Enviado", StringComparison.OrdinalIgnoreCase)
        || row.SiigoPaymentStatus.Contains("OK", StringComparison.OrdinalIgnoreCase)
        || string.Equals(row.SiigoStatus, "EnviadoSiigo", StringComparison.OrdinalIgnoreCase)
        || string.Equals(row.SiigoStatus, "Conciliado", StringComparison.OrdinalIgnoreCase);
    bool SupplierPaymentError(ConciliacionCashFlowRowDto row) =>
        row.RegistrationStatus.Contains("Error", StringComparison.OrdinalIgnoreCase)
        || row.SiigoPaymentStatus.Contains("Error", StringComparison.OrdinalIgnoreCase)
        || row.SiigoDocumentStatus.Contains("Error", StringComparison.OrdinalIgnoreCase)
        || string.Equals(row.SiigoStatus, "ErrorSiigo", StringComparison.OrdinalIgnoreCase);
    int SupplierPaymentDocumentMatchScore(ConciliacionCashFlowRowDto row, ConciliacionDianSupplierInvoiceRowDto document)
    {
        var score = 0;
        var rowText = string.Join(" ", new[] { row.Description, row.Recipient, row.Observations, row.DocumentType });
        var rowKeys = SupplierPaymentInvoiceKeys(row.Description, row.Recipient, row.Observations, row.DocumentType);
        var documentKeys = SupplierPaymentInvoiceKeys(document.InvoiceNumber, document.Prefix + document.Folio, document.Folio, document.SiigoDocumentName);
        if (SupplierPaymentKeysMatch(rowKeys, documentKeys))
            score += 75;
        var rowDigits = Regex.Replace(rowText, @"\D+", "", RegexOptions.CultureInvariant);
        var supplierDigits = Regex.Replace(document.SupplierNit ?? "", @"\D+", "", RegexOptions.CultureInvariant);
        if (supplierDigits.Length >= 5 && rowDigits.Contains(supplierDigits, StringComparison.OrdinalIgnoreCase))
            score += 35;
        if (SupplierPaymentTextContainsTokens(rowText, document.SupplierName))
            score += 30;
        if (SupplierPaymentAmountClose(row.ExitValue, document.PaymentValue > 0m ? document.PaymentValue : document.TotalValue))
            score += 40;
        if (!string.IsNullOrWhiteSpace(document.SiigoDocumentId) || !string.IsNullOrWhiteSpace(document.SiigoDocumentName))
            score += 5;
        return score;
    }
    ConciliacionDianSupplierInvoiceRowDto? SupplierPaymentDocumentMatch(ConciliacionCashFlowRowDto row) =>
        dianInvoices.Rows
            .Select(document => new
            {
                Document = document,
                Score = SupplierPaymentDocumentMatchScore(row, document)
            })
            .Where(item => item.Score >= 70)
            .OrderByDescending(item => item.Score)
            .ThenBy(item => item.Document.InvoiceNumber, StringComparer.OrdinalIgnoreCase)
            .FirstOrDefault()?.Document;
    IReadOnlyList<ConciliacionCashFlowRowDto> CashRowsFor(string key) => key switch
    {
        "salidas-fe" => cashFlow.Rows.Where(row => string.Equals(row.DetectedTypeKey, "salida-fe", StringComparison.OrdinalIgnoreCase)).ToArray(),
        "cuentas-cobro" => cashFlow.Rows.Where(row => string.Equals(row.DetectedTypeKey, "cuenta-cobro", StringComparison.OrdinalIgnoreCase)).ToArray(),
        "comprobantes" => cashFlow.Rows.Where(row =>
            string.Equals(row.DetectedTypeKey, "comprobante-contable", StringComparison.OrdinalIgnoreCase)
            || string.Equals(row.DetectedTypeKey, "entrada-comprobante", StringComparison.OrdinalIgnoreCase)).ToArray(),
        "huerfanos" => cashFlow.Rows.Where(row => string.Equals(row.DetectedTypeKey, "no-incluida-conciliacion", StringComparison.OrdinalIgnoreCase)).ToArray(),
        _ => cashFlow.Rows
    };
    IReadOnlyList<ConciliacionDianSupplierInvoiceRowDto> DianRowsFor(string stage) => dianInvoices.Rows
        .Where(row => string.Equals(row.Stage, stage, StringComparison.OrdinalIgnoreCase))
        .ToArray();
    IReadOnlyList<ConciliacionCuentaCobroRowDto> CuentaCobroRowsFor(string stage) => cuentasCobro.Rows
        .Where(row => string.Equals(row.Stage, stage, StringComparison.OrdinalIgnoreCase))
        .ToArray();
    string DianSearchText(ConciliacionDianSupplierInvoiceRowDto row) =>
        $"{row.SourceRowNumber} {row.InvoiceNumber} {row.Cufe} {row.SupplierName} {row.SupplierNit} {row.RecipientName} {row.AccountCode} {row.StageLabel} {row.DianStatus} {row.DianGroup}".ToLowerInvariant();
    string CuentaCobroSearchText(ConciliacionCuentaCobroRowDto row) =>
        $"{row.SourceRowNumber} {row.MovementDateDisplay} {row.SourceFlow} {row.BankAccountName} {row.CashFlowDescription} {row.CashFlowRecipient} {row.CashFlowDocumentType} {row.CashFlowObservations} {row.Receptor} {row.NitOCedula} {row.AccountCode} {row.StageLabel} {row.ReviewReason}".ToLowerInvariant();
    string CuentaCobroFlowDetail(ConciliacionCuentaCobroRowDto row) =>
        string.Join(" | ", new[] { row.CashFlowRecipient, row.CashFlowDocumentType, row.CashFlowObservations }
            .Where(value => !string.IsNullOrWhiteSpace(value)));
    bool HasPaymentStatus(ConciliacionClientPaymentRowDto row, params string[] statuses) =>
        statuses.Any(status => string.Equals(row.Status, status, StringComparison.OrdinalIgnoreCase));
    IReadOnlyList<ConciliacionClientPaymentRowDto> ClientPaymentRowsFor(string stage) => stage switch
    {
        "detectadas" => board.ClientPayments.Rows.Where(row => HasPaymentStatus(row, "SinFacturaDescripcion")).ToArray(),
        "cruce" => board.ClientPayments.Rows.Where(row => HasPaymentStatus(row, "Sugerido", "FacturaNoEncontrada", "FacturaAmbigua", "DiferenciaFueraRango")).ToArray(),
        "revision" => board.ClientPayments.Rows.Where(row => HasPaymentStatus(row, "RevisionManual", "Rechazado")).ToArray(),
        "prevalidacion" => board.ClientPayments.Rows.Where(row => HasPaymentStatus(row, "Aprobado", "BloqueadoSiigo", "ListoSiigo")).ToArray(),
        "enviados" => board.ClientPayments.Rows.Where(row => HasPaymentStatus(row, "EnviadoSiigo", "ErrorSiigo", "Conciliado")).ToArray(),
        _ => Array.Empty<ConciliacionClientPaymentRowDto>()
    };
    string InvoiceFromFlow(ConciliacionClientPaymentRowDto row)
    {
        var match = Regex.Match(
            row.Description ?? "",
            @"\b(?:FV|FVE|FEV|FEM|FE|FEDT|FEKT)[-\s]*\d+(?:[-\s]*\d+)?\b",
            RegexOptions.IgnoreCase | RegexOptions.CultureInvariant);
        return match.Success ? match.Value.Trim().ToUpperInvariant() : "";
    }
    bool LooksLikeSupplierCompany(string name)
    {
        var value = (name ?? "").ToUpperInvariant();
        return value.Contains("S.A", StringComparison.OrdinalIgnoreCase)
            || value.Contains("SAS", StringComparison.OrdinalIgnoreCase)
            || value.Contains("S A", StringComparison.OrdinalIgnoreCase)
            || value.Contains("LTDA", StringComparison.OrdinalIgnoreCase)
            || value.Contains("LIMITADA", StringComparison.OrdinalIgnoreCase)
            || value.Contains("SOCIEDAD", StringComparison.OrdinalIgnoreCase);
    }
    string SupplierPersonType(ConciliacionDianSupplierInvoiceRowDto row) =>
        LooksLikeSupplierCompany(row.SupplierName) ? "Company" : "Person";
    string SupplierIdType(ConciliacionDianSupplierInvoiceRowDto row) =>
        SupplierPersonType(row) == "Company" ? "31" : "13";
    string SupplierNitDigits(string? value) =>
        Regex.Replace(value ?? "", @"\D+", "", RegexOptions.CultureInvariant);
    string SupplierCheckDigit(ConciliacionDianSupplierInvoiceRowDto row)
    {
        var digits = SupplierNitDigits(row.SupplierNit);
        return digits.Length >= 10 ? digits[^1].ToString() : "";
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/conciliacion.css" asp-append-version="true" />
}

<div class="cnc-shell"
     id="conciliacionApp"
     data-update-payment-url="@Url.Action("UpdateClientPaymentStatus", "Conciliacion")"
     data-manual-payment-url="@Url.Action("MarkClientPaymentManualSiigo", "Conciliacion")"
     data-cashflow-category-url="@Url.Action("UpdateCashFlowCategory", "Conciliacion")"
     data-cashflow-statement-import-url="@Url.Action("ImportBancolombiaCashFlowStatement", "Conciliacion")"
     data-bank-balances-url="@Url.Action("BankBalances", "Conciliacion")"
     data-bank-opening-balance-url="@Url.Action("SetBankOpeningBalance", "Conciliacion")"
     data-cashflow-description-url="@Url.Action("UpdateCashFlowDescription", "Conciliacion")"
     data-cashflow-pending-url="@Url.Action("MarkCashFlowPending", "Conciliacion")"
     data-cashflow-omitted-url="@Url.Action("MarkCashFlowOmitted", "Conciliacion")"
     data-cashflow-manual-url="@Url.Action("MarkCashFlowManualSiigo", "Conciliacion")"
     data-preflight-payment-url="@Url.Action("ValidateClientPaymentPreflight", "Conciliacion")"
     data-dry-run-payment-url="@Url.Action("SimulateClientPaymentSiigoSend", "Conciliacion")"
     data-send-payment-url="@Url.Action("SendClientPaymentToSiigo", "Conciliacion")"
     data-invoice-search-url="@Url.Action("SearchDataverseInvoices", "Conciliacion")"
     data-invoice-assign-url="@Url.Action("AssignClientPaymentInvoice", "Conciliacion")"
     data-siigo-customer-search-url="@Url.Action("SearchSiigoCustomersForPayment", "Conciliacion")"
     data-client-payment-invoices-url="@Url.Action("SearchClientOpenInvoicesForPayment", "Conciliacion")"
     data-client-payment-dataverse-apply-url="@Url.Action("ApplyClientInvoicePaymentToDataverse", "Conciliacion")"
     data-client-payment-direct-send-url="@Url.Action("SendClientInvoicePaymentToSiigo", "Conciliacion")"
     data-siigo-supplier-search-url="@Url.Action("SearchSiigoSuppliersForPayment", "Conciliacion")"
     data-supplier-payment-purchases-url="@Url.Action("SearchSupplierOpenPurchasesForPayment", "Conciliacion")"
     data-supplier-payment-send-url="@Url.Action("SendSupplierPaymentToSiigo", "Conciliacion")"
     data-supplier-payment-manual-url="@Url.Action("MarkSupplierPaymentManualSiigo", "Conciliacion")"
     data-dian-classification-url="@Url.Action("UpdateDianSupplierDocumentClassification", "Conciliacion")"
     data-dian-create-supplier-url="@Url.Action("CreateDianSupplierInSiigo", "Conciliacion")"
     data-dian-analyze-rut-url="@Url.Action("AnalyzeDianSupplierRut", "Conciliacion")"
     data-dian-retry-purchases-url="@Url.Action("RetryDianSupplierPurchases", "Conciliacion")"
     data-dian-supplier-lookup-url="@Url.Action("ResolveDianSupplierDocumentsSuppliers", "Conciliacion", new { year = board.Year, month = board.Month })"
     data-deducciones-iva-import-url="@Url.Action("ImportDeduccionesIva", "Conciliacion")"
     data-dian-dry-run-url="@Url.Action("SimulateDianSupplierPurchaseSiigoSend", "Conciliacion")"
     data-dian-send-url="@Url.Action("SendDianSupplierPurchaseToSiigo", "Conciliacion")"
     data-cuenta-cobro-editor-url="@Url.Action("OpenCuentaCobroExpenseEditor", "Conciliacion")"
     data-cuenta-cobro-expense-save-url="@Url.Action("SaveCuentaCobroExpense", "Conciliacion")"
     data-cuenta-cobro-classification-url="@Url.Action("UpdateCuentaCobroClassification", "Conciliacion")"
     data-cuenta-cobro-preflight-url="@Url.Action("ValidateCuentaCobroSupportDocumentPreflight", "Conciliacion")"
     data-cuenta-cobro-send-url="@Url.Action("SendCuentaCobroSupportDocumentToSiigo", "Conciliacion")"
     data-cuenta-cobro-payment-url="@Url.Action("SendCuentaCobroSupportPaymentToSiigo", "Conciliacion")"
     data-cuenta-cobro-manual-url="@Url.Action("MarkCuentaCobroManualSiigo", "Conciliacion")"
     data-cashflow-account-url="@Url.Action("UpdateCashFlowAccountingAccount", "Conciliacion")"
     data-accounting-voucher-send-url="@Url.Action("SendAccountingVoucherToSiigo", "Conciliacion")"
     data-sync-health-url="@Url.Action("SyncHealth", "Conciliacion", new { year = board.Year, month = board.Month })"
     data-sync-billing-differences-url="@Url.Action("BillingDifferences", "Conciliacion", new { year = board.Year, month = board.Month })"
     data-sync-billing-create-url="@Url.Action("CreateMissingBillingInvoices", "Conciliacion")"
     data-sync-billing-delete-url="@Url.Action("DeleteDataverseBillingInvoices", "Conciliacion")"
     data-cashflow-month-validate-url="@Url.Action("ValidateCashFlowMonth", "Conciliacion")"
     data-period-year="@board.Year"
     data-period-month="@board.Month"
     data-active-vertical="Cloud">
    @Html.AntiForgeryToken()
    <section class="cnc-heading">
        <div class="cnc-heading__copy">
            <div class="cnc-kicker">Cierre mensual</div>
            <h1 class="cnc-title">Conciliacion</h1>
            <p class="cnc-subtitle">
                Flujo de caja por banco, registros FE, cuentas de cobro, comprobantes y no incluidas en conciliacion del periodo.
            </p>
        </div>
        <form class="cnc-period" method="get" asp-controller="Conciliacion" asp-action="Index">
            <label>
                <span>Periodo</span>
                <select name="month" class="form-select">
                    @for (var month = 1; month <= 12; month++)
                    {
                        <option value="@month" selected="@(board.Month == month ? "selected" : null)">
                            @culture.DateTimeFormat.GetMonthName(month)
                        </option>
                    }
                </select>
            </label>
            <label>
                <span>Ano</span>
                <input class="form-control" type="number" name="year" value="@board.Year" min="2020" max="2100" />
            </label>
            <button type="submit" class="btn btn-primary">Ver</button>
        </form>
    </section>

    <div id="cncStatus" class="cnc-status" role="status" aria-live="polite"></div>

    <section class="cnc-workspace">
        <div class="cnc-phase-nav" role="tablist" aria-label="Filtros de conciliacion">
            <button type="button"
                    class="cnc-phase-tab"
                    data-cnc-tab="sincronizacion"
                    role="tab"
                    aria-selected="false"
                    aria-hidden="true"
                    tabindex="-1"
                    hidden>
                <span>Sincronizacion</span>
            </button>
            <button type="button"
                    class="cnc-phase-tab"
                    data-cnc-tab="deducciones-iva"
                    role="tab"
                    aria-selected="false">
                <span>Deducciones IVA</span>
            </button>
            <button type="button"
                    class="cnc-phase-tab is-active"
                    data-cnc-tab="conciliacion-2"
                    role="tab"
                    aria-selected="true">
                <span>Conciliacion 2</span>
            </button>
            @foreach (var phase in board.Phases)
            {
                var isActive = string.Equals(phase.Key, activePhase, StringComparison.OrdinalIgnoreCase);
                var isVisiblePhase = string.Equals(phase.Key, "registro-dian", StringComparison.OrdinalIgnoreCase);
                <button type="button"
                        class="cnc-phase-tab @(isActive ? "is-active" : "")"
                        data-cnc-tab="@phase.Key"
                        role="tab"
                        aria-selected="@(isActive ? "true" : "false")"
                        aria-hidden="@(isVisiblePhase ? "false" : "true")"
                        tabindex="@(isVisiblePhase ? "0" : "-1")"
                        @(isVisiblePhase ? null : "hidden")>
                    <span>@phase.Label</span>
                </button>
            }
        </div>

        <div class="cnc-phase-panels">
            <div class="cnc-vertical-bar" aria-label="Seleccion de vertical" hidden>
                <div class="cnc-vertical-switch" role="group">
                    <button type="button"
                            class="cnc-vertical-button cnc-vertical-button--cloud is-active"
                            data-cnc-vertical="Cloud"
                            aria-pressed="true">
                        Cloud
                    </button>
                    <button type="button"
                            class="cnc-vertical-button cnc-vertical-button--copiers"
                            data-cnc-vertical="Copiers"
                            aria-pressed="false">
                        Copiers
                    </button>
                </div>
                <span class="cnc-counter" id="cncVerticalCount">Cloud</span>
            </div>

            @await Html.PartialAsync("_Conciliacion2", Model)

            <section class="cnc-phase-panel"
                     data-cnc-panel="sincronizacion"
                     role="tabpanel"
                     hidden>
                @{
                    var dataverseSiigoComparisons = board.CashFlow.MonthCloseComparisons
                        .Where(row => row.ShowSiigo && row.ShowDataverse && !row.ShowCashFlow)
                        .ToArray();
                    var cashFlowSiigoComparisons = board.CashFlow.MonthCloseComparisons
                        .Where(row => row.ShowSiigo && row.ShowCashFlow && !row.ShowDataverse)
                        .ToArray();
                    var closeNoticeComparisons = board.CashFlow.MonthCloseComparisons
                        .Where(row => !row.ShowSiigo && !row.ShowDataverse && !row.ShowCashFlow)
                        .ToArray();
                }
                <div class="cnc-panel-header">
                    <div>
                        <div class="cnc-kicker">Dataverse, Siigo y flujo de caja</div>
                        <h2>Sincronizacion y cierre</h2>
                    </div>
                </div>

                <section class="cnc-sync-section">
                    <header class="cnc-sync-section-header">
                        <div>
                            <div class="cnc-kicker">Cierre mensual</div>
                            <h3>Cierre de @board.PeriodLabel</h3>
                            <p>Validacion final del periodo contra las fuentes que alimentan la conciliacion.</p>
                        </div>
                        <div class="cnc-sync-header-actions">
                            <button type="button" class="btn btn-outline-primary" data-cnc-open-month-close>Cargar extractos</button>
                            <button type="button"
                                    class="btn btn-success"
                                    data-cnc-validate-month
                                    data-year="@board.Year"
                                    data-month="@board.Month"
                                    @(board.CashFlow.CanValidateMonth && !board.CashFlow.MonthValidated ? null : "disabled")>
                                Mes validado
                            </button>
                        </div>
                    </header>

                    <div class="cnc-month-close-bar">
                        <div>
                            <span class="cnc-badge cnc-badge--@board.CashFlow.MonthValidationTone">@board.CashFlow.MonthValidationLabel</span>
                            <strong>Estado del cierre</strong>
                            <small>@board.CashFlow.MonthValidationDetail</small>
                        </div>
                        <div class="cnc-close-stats" aria-label="Resumen de cierre">
                            <span>@Number(board.CashFlow.MonthCloseComparisons.Count) cruces</span>
                            <span>@Number(board.CashFlow.MonthCloseIssues.Count) alertas</span>
                        </div>
                    </div>

                    @if (board.CashFlow.MonthCloseIssues.Count > 0)
                    {
                        <ul class="cnc-close-issues">
                            @foreach (var issue in board.CashFlow.MonthCloseIssues)
                            {
                                <li>@issue</li>
                            }
                        </ul>
                    }

                    @if (closeNoticeComparisons.Length > 0)
                    {
                        <div class="cnc-sync-empty">
                            @foreach (var notice in closeNoticeComparisons)
                            {
                                <strong>@notice.Concept</strong>
                                <small>@notice.Detail</small>
                            }
                        </div>
                    }

                    <div class="cnc-sync-comparison-grid">
                        @if (dataverseSiigoComparisons.Length > 0)
                        {
                            <section class="cnc-sync-comparison-card">
                                <header>
                                    <div>
                                        <h4>Dataverse vs Siigo</h4>
                                        <p>Totales contables del periodo usados para habilitar el cierre.</p>
                                    </div>
                                    <span class="cnc-badge cnc-badge--neutral">@Number(dataverseSiigoComparisons.Length) cruces</span>
                                </header>
                                <div class="cnc-sync-table-wrap">
                                    <table class="cnc-sync-table cnc-sync-table--compact">
                                        <thead>
                                            <tr>
                                                <th>Comparativo</th>
                                                <th class="is-money">Siigo</th>
                                                <th class="is-money">Dataverse</th>
                                                <th class="is-money">Diferencia</th>
                                                <th>Estado</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var comparison in dataverseSiigoComparisons)
                                            {
                                                <tr>
                                                    <td><strong>@comparison.Concept</strong><small>@comparison.Detail</small></td>
                                                    <td class="is-money">@Money(comparison.SiigoValue)</td>
                                                    <td class="is-money">@Money(comparison.DataverseValue)</td>
                                                    <td class="is-money @(Math.Abs(comparison.DifferenceValue) > 1 ? "cnc-money-warning" : "")">
                                                        @Money(comparison.DifferenceValue)
                                                        <small>@comparison.DifferenceLabel</small>
                                                    </td>
                                                    <td><span class="cnc-badge cnc-badge--@comparison.StatusTone">@comparison.StatusLabel</span></td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </section>
                        }

                        @if (cashFlowSiigoComparisons.Length > 0)
                        {
                            <section class="cnc-sync-comparison-card">
                                <header>
                                    <div>
                                        <h4>Flujo de caja vs Siigo</h4>
                                        <p>Entradas y salidas conciliadas contra pagos o comprobantes reportados.</p>
                                    </div>
                                    <span class="cnc-badge cnc-badge--neutral">@Number(cashFlowSiigoComparisons.Length) cruces</span>
                                </header>
                                <div class="cnc-sync-table-wrap">
                                    <table class="cnc-sync-table cnc-sync-table--compact">
                                        <thead>
                                            <tr>
                                                <th>Comparativo</th>
                                                <th class="is-money">Siigo</th>
                                                <th class="is-money">Flujo de caja</th>
                                                <th class="is-money">Diferencia</th>
                                                <th>Estado</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var comparison in cashFlowSiigoComparisons)
                                            {
                                                <tr>
                                                    <td><strong>@comparison.Concept</strong><small>@comparison.Detail</small></td>
                                                    <td class="is-money">@Money(comparison.SiigoValue)</td>
                                                    <td class="is-money">@Money(comparison.CashFlowValue)</td>
                                                    <td class="is-money @(Math.Abs(comparison.DifferenceValue) > 1 ? "cnc-money-warning" : "")">
                                                        @Money(comparison.DifferenceValue)
                                                        <small>@comparison.DifferenceLabel</small>
                                                    </td>
                                                    <td><span class="cnc-badge cnc-badge--@comparison.StatusTone">@comparison.StatusLabel</span></td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </section>
                        }
                    </div>
                </section>

                <section class="cnc-sync-section">
                    <header class="cnc-sync-section-header">
                        <div>
                            <div class="cnc-kicker">Resumen automatico</div>
                            <h3>Salud Dataverse vs Siigo</h3>
                            <p>Totales agregados del periodo para detectar diferencias generales por fuente.</p>
                        </div>
                        <div class="cnc-sync-header-actions">
                            <button type="button" class="btn btn-outline-primary" data-cnc-sync-refresh>Actualizar totales</button>
                        </div>
                    </header>
                    <div class="cnc-sync-summary" data-cnc-sync-summary>
                        <span class="cnc-badge cnc-badge--neutral">Sin consultar</span>
                        <strong>Selecciona la pestana para cargar los cruces del periodo.</strong>
                    </div>
                    <div class="cnc-sync-grid" data-cnc-sync-grid>
                        <div class="cnc-sync-empty">Los resultados apareceran aqui.</div>
                    </div>
                </section>

                <section class="cnc-sync-section">
                    <header class="cnc-sync-section-header">
                        <div>
                            <div class="cnc-kicker">Facturacion</div>
                            <h3>Diferencias accionables</h3>
                            <p>Facturas faltantes, sobrantes o con valores distintos entre Siigo y Dataverse.</p>
                        </div>
                        <div class="cnc-sync-header-actions">
                            <button type="button" class="btn btn-primary" data-cnc-billing-diff-refresh>Consultar diferencias ahora</button>
                        </div>
                    </header>
                    <div class="cnc-sync-actions">
                        <button type="button" class="btn btn-outline-primary" data-cnc-billing-create-selected disabled>Crear seleccionadas en Dataverse</button>
                        <button type="button" class="btn btn-outline-danger" data-cnc-billing-delete-selected disabled>Eliminar seleccionadas de Dataverse</button>
                    </div>
                    <div class="cnc-sync-differences" data-cnc-billing-diff>
                        <div class="cnc-sync-empty">Consulta manualmente para ver las facturas que faltan o sobran por lado.</div>
                    </div>
                </section>
            </section>

            <section class="cnc-phase-panel"
                     data-cnc-panel="deducciones-iva"
                     role="tabpanel"
                     hidden>
                <div class="cnc-panel-header">
                    <div>
                        <div class="cnc-kicker">ZIP / Excel DIAN</div>
                        <h2>Deducciones IVA</h2>
                    </div>
                </div>

                <section class="cnc-sync-section cnc-deducciones-section">
                    <header class="cnc-sync-section-header">
                        <div>
                            <div class="cnc-kicker">Admin / deducciones iva</div>
                            <h3>Importar exportable</h3>
                            <p>Importa todos los periodos encontrados en el archivo. Facturas y notas siguen el flujo Siigo; las nóminas se guardan únicamente en Dataverse.</p>
                        </div>
                    </header>
                    <form class="cnc-deducciones-upload" data-cnc-deducciones-form>
                        <label class="cnc-deducciones-file">
                            <span>ZIP o Excel DIAN</span>
                            <input class="form-control" type="file" name="file" accept=".zip,.xlsx,.xlsm" data-cnc-deducciones-file />
                        </label>
                        <button type="submit" class="btn btn-primary" data-cnc-deducciones-submit>Importar</button>
                    </form>
                    <div class="cnc-sync-grid cnc-deducciones-result" data-cnc-deducciones-result>
                        <div class="cnc-sync-empty">
                            <strong>Sin archivo cargado en esta sesion.</strong>
                            <small>Destino: Admin / deducciones iva.</small>
                        </div>
                    </div>
                </section>

                <section class="cnc-sync-section cnc-deducciones-history">
                    <header class="cnc-sync-section-header">
                        <div>
                            <div class="cnc-kicker">Trazabilidad</div>
                            <h3>Histórico de importaciones</h3>
                            <p>Abre una importación para revisar periodos detectados, facturas, notas crédito, documentos soporte y nóminas en Dataverse, filas omitidas y RUT pendientes.</p>
                        </div>
                        <span class="cnc-badge cnc-badge--neutral">@Number(board.DeduccionesIvaImports.Count) importaciones</span>
                    </header>

                    @if (!string.IsNullOrWhiteSpace(board.DeduccionesIvaHistoryError))
                    {
                        <div class="cnc-sync-empty">
                            <strong>No fue posible consultar el histórico.</strong>
                            <small>La importación continúa disponible; intenta recargar la página.</small>
                        </div>
                    }
                    else if (board.DeduccionesIvaImports.Count == 0)
                    {
                        <div class="cnc-sync-empty">
                            <strong>Aún no hay importaciones con trazabilidad.</strong>
                            <small>Las siguientes importaciones quedarán registradas automáticamente.</small>
                        </div>
                    }
                    else
                    {
                        <div class="cnc-sync-table-wrap">
                            <table class="cnc-sync-table cnc-sync-table--compact cnc-deducciones-history-table">
                                <thead>
                                    <tr>
                                        <th>Importación</th>
                                        <th>Periodo</th>
                                        <th>Registros</th>
                                        <th>Siigo</th>
                                        <th>RUT pendientes</th>
                                        <th>Estado</th>
                                        <th>Acción</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var history in board.DeduccionesIvaImports)
                                    {
                                        var otherPending = history.PendingClassification + history.PendingSiigo + history.WithErrors;
                                        <tr class="cnc-click-row"
                                            role="button"
                                            tabindex="0"
                                            data-cnc-deducciones-history-open
                                            data-history-id="@history.ImportId">
                                            <td>
                                                <strong>@FirstNonEmpty(history.OriginalFileName, history.StoredFileName, "Archivo DIAN")</strong>
                                                <small>@history.ImportedAtDisplay · @FirstNonEmpty(history.ImportedBy, "Usuario autenticado")</small>
                                            </td>
                                            <td><strong>@history.PeriodLabel</strong></td>
                                            <td>
                                                <strong>@Number(history.ImportableRows) importables</strong>
                                                <small>@Number(history.Created) creadas · @Number(history.Updated) actualizadas · @Number(history.Unchanged) sin cambios</small>
                                            </td>
                                            <td>
                                                <strong>@Number(history.SentToSiigo) de @Number(history.SiigoRows)</strong>
                                                <small>
                                                    @Number(history.SupplierCreditNotesApplied) de @Number(history.SupplierCreditNotes) notas aplicadas
                                                    · @Number(history.SupportDocumentRows) documentos soporte solo Dataverse
                                                    · @Number(history.PayrollRows) nóminas solo Dataverse
                                                    · @(otherPending > 0 ? $"{Number(otherPending)} pendientes adicionales" : "sin otros pendientes")
                                                </small>
                                            </td>
                                            <td>
                                                <strong>@Number(history.PendingRutSuppliers) proveedores</strong>
                                                <small>@Number(history.PendingRut) facturas</small>
                                            </td>
                                            <td><span class="cnc-badge cnc-badge--@history.StatusTone">@history.StatusLabel</span></td>
                                            <td><button type="button" class="btn btn-sm btn-primary">Ver detalle</button></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    <script type="application/json" data-cnc-deducciones-history-json>@Html.Raw(deduccionesHistoryJson)</script>
                </section>
            </section>

            @foreach (var phase in board.Phases)
            {
                var isActive = string.Equals(phase.Key, activePhase, StringComparison.OrdinalIgnoreCase);
                var phaseRows = CashRowsFor(phase.Key);
                <section class="cnc-phase-panel @(isActive ? "is-active" : "")"
                         data-cnc-panel="@phase.Key"
                         role="tabpanel"
                         @(isActive ? null : "hidden")>
                    <div class="cnc-panel-header">
                        <div>
                            <div class="cnc-kicker">@phase.CadenceLabel</div>
                            @if (phase.Key == "entradas-fe")
                            {
                                <h2 class="cnc-title-inline">
                                    <span>@phase.Label</span>
                                    <span>Flujo de caja actualizado a: @board.CashFlow.LastRunLabel</span>
                                </h2>
                            }
                            else
                            {
                                <h2>@phase.Label</h2>
                            }
                        </div>
                    </div>

                    @if (phase.Key == "registro-dian")
                    {
                        var providerRows = DianRowsFor("proveedor");
                        var providerGroups = providerRows
                            .GroupBy(
                                row =>
                                {
                                    var nitDigits = SupplierNitDigits(row.SupplierNit);
                                    return string.IsNullOrWhiteSpace(nitDigits)
                                        ? $"record:{row.RecordId}"
                                        : $"nit:{nitDigits}";
                                },
                                StringComparer.OrdinalIgnoreCase)
                            .Select(group => group
                                .OrderByDescending(row => row.EmissionDateValue, StringComparer.OrdinalIgnoreCase)
                                .ThenBy(row => row.InvoiceNumber, StringComparer.OrdinalIgnoreCase)
                                .ToArray())
                            .OrderBy(group => group[0].SupplierName, StringComparer.OrdinalIgnoreCase)
                            .ThenBy(group => SupplierNitDigits(group[0].SupplierNit), StringComparer.OrdinalIgnoreCase)
                            .ToArray();
                        var classificationRows = DianRowsFor("clasificacion");
                        var readyRows = DianRowsFor("prevalidacion");
                        var sentRows = DianRowsFor("enviadas");
                        var dianJobCompleted = providerRows.Count == 0
                            && classificationRows.Count == 0
                            && readyRows.Count == 0;
                        <article class="cnc-sync-card cnc-sync-card--@(dianJobCompleted ? "success" : "warning")">
                            <header>
                                <div>
                                    <h3>Estado del job DIAN / Siigo</h3>
                                    <p>
                                        @if (dianInvoices.TotalRows == 0)
                                        {
                                            <text>No hay facturas electronicas recibidas importadas para este periodo; el job no tiene pendientes.</text>
                                        }
                                        else if (dianJobCompleted)
                                        {
                                            <text>Todas las facturas electronicas recibidas del periodo quedaron asociadas a Siigo.</text>
                                        }
                                        else
                                        {
                                            <text>Quedan @Number(providerRows.Count) sin proveedor, @Number(classificationRows.Count) sin clasificar y @Number(readyRows.Count) pendientes de crear/recuperar en Siigo.</text>
                                        }
                                    </p>
                                </div>
                                <span class="cnc-badge cnc-badge--@(dianJobCompleted ? "success" : "warning")">
                                    @(dianJobCompleted ? "Job completado" : "Job pendiente")
                                </span>
                            </header>
                        </article>
                        <section class="cnc-payment-panel">
                            <div class="cnc-table-toolbar">
                                <input class="form-control cnc-table-search" type="search" placeholder="Buscar proveedor, NIT, documento o categoria" data-cnc-table-search="@phase.Key" />
                                <div class="cnc-toolbar-actions">
                                    <button type="button" class="btn btn-sm btn-outline-primary" data-cnc-dian-supplier-lookup>
                                        Validar proveedores Siigo
                                    </button>
                                    <span class="cnc-counter" data-cnc-table-count="@phase.Key">@Number(dianInvoices.Rows.Count) filas</span>
                                </div>
                            </div>

                            <div class="cnc-pipeline" data-cnc-table-body="@phase.Key">
                                <section class="cnc-pipeline-stage">
                                    <header class="cnc-pipeline-stage__header">
                                        <h3>1. Proveedor pendiente Siigo</h3>
                                        <span data-cnc-stage-count>@Number(providerGroups.Length) proveedores / @Number(providerRows.Count) facturas</span>
                                    </header>
                                    <div class="cnc-table-wrap">
                                        <table class="table align-middle cnc-table cnc-table--pipeline">
                                            <thead>
                                                <tr>
                                                    <th>Proveedor</th>
                                                    <th>NIT</th>
                                                    <th>Facturas</th>
                                                    <th>Numeros</th>
                                                    <th class="text-end">Total</th>
                                                    <th>Siigo</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var groupRows in providerGroups)
                                                {
                                                    var row = groupRows[0];
                                                    var verticalFlow = string.Equals(row.VerticalLabel, "Sin vertical", StringComparison.OrdinalIgnoreCase) ? "" : row.VerticalLabel;
                                                    var invoiceNumbers = groupRows
                                                        .Select(item => item.InvoiceNumber)
                                                        .Where(number => !string.IsNullOrWhiteSpace(number))
                                                        .Distinct(StringComparer.OrdinalIgnoreCase)
                                                        .ToArray();
                                                    var visibleInvoiceNumbers = string.Join(", ", invoiceNumbers.Take(6));
                                                    var hiddenInvoiceNumbers = Math.Max(0, invoiceNumbers.Length - 6);
                                                    var providerTotal = groupRows.Sum(item => item.TotalValue);
                                                    <tr class="cnc-click-row"
                                                        data-record-id="@row.RecordId"
                                                        data-cnc-dian-supplier-row
                                                        data-supplier-name="@row.SupplierName"
                                                        data-supplier-nit="@row.SupplierNit"
                                                        data-supplier-person-type="@SupplierPersonType(row)"
                                                        data-supplier-id-type="@SupplierIdType(row)"
                                                        data-supplier-check-digit="@SupplierCheckDigit(row)"
                                                        data-flow="@verticalFlow"
                                                        data-search="@string.Join(" ", groupRows.Select(DianSearchText))">
                                                        <td><strong>@row.SupplierName</strong><small>@row.SupplierNit</small></td>
                                                        <td><strong>@row.SupplierNit</strong><small>@SupplierNitDigits(row.SupplierNit)</small></td>
                                                        <td><strong>@Number(groupRows.Length)</strong><small>pendientes de crear en Siigo</small></td>
                                                        <td>
                                                            <strong>@FirstNonEmpty(visibleInvoiceNumbers, "Sin numero")</strong>
                                                            @if (hiddenInvoiceNumbers > 0)
                                                            {
                                                                <small>y @Number(hiddenInvoiceNumbers) mas</small>
                                                            }
                                                        </td>
                                                        <td class="text-end">@Money(providerTotal)</td>
                                                        <td>
                                                            <span class="cnc-badge cnc-badge--@row.ProviderStatusTone">@row.ProviderStatusLabel</span>
                                                            <small data-cnc-dian-message>@(string.IsNullOrWhiteSpace(row.SiigoSupplierName) ? $"Crear o seleccionar proveedor para {groupRows.Length:N0} factura(s)." : row.SiigoSupplierName)</small>
                                                            <div class="cnc-row-actions">
                                                                <button type="button" class="btn btn-sm btn-primary" data-cnc-dian-create-supplier>Subir RUT</button>
                                                                <button type="button" class="btn btn-sm btn-outline-primary" data-cnc-dian-create-supplier-manual>Subir manualmente</button>
                                                            </div>
                                                            <ul class="cnc-issue-list" data-cnc-dian-issues hidden></ul>
                                                            <details class="cnc-json-preview" hidden data-cnc-dian-preview>
                                                                <summary>Payload / respuesta</summary>
                                                                <pre data-cnc-dian-payload></pre>
                                                                <pre data-cnc-dian-response></pre>
                                                            </details>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </section>

                                <section class="cnc-pipeline-stage">
                                    <header class="cnc-pipeline-stage__header">
                                        <h3>2. Pendientes clasificacion</h3>
                                        <span data-cnc-stage-count>@Number(classificationRows.Count) filas</span>
                                    </header>
                                    <div class="cnc-table-wrap">
                                        <table class="table align-middle cnc-table cnc-table--pipeline">
                                            <thead>
                                                <tr>
                                                    <th>Fecha</th>
                                                    <th>Documento / proveedor</th>
                                                    <th class="text-end">Base</th>
                                                    <th class="text-end">IVA</th>
                                                    <th class="text-end">Total</th>
                                                    <th>Vertical</th>
                                                    <th>Cuenta gasto</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var row in classificationRows)
                                                {
                                                    var verticalFlow = string.Equals(row.VerticalLabel, "Sin vertical", StringComparison.OrdinalIgnoreCase) ? "" : row.VerticalLabel;
                                                    <tr class="cnc-click-row"
                                                        data-record-id="@row.RecordId"
                                                        data-cnc-dian-edit
                                                        data-description="@($"{row.InvoiceNumber} - {row.SupplierName}")"
                                                        data-account-code="@row.AccountCode"
                                                        data-flow="@verticalFlow"
                                                        data-search="@DianSearchText(row)">
                                                        <td><strong>@row.EmissionDateDisplay</strong><small>@ExcelRowLabel(row.SourceRowNumber)</small><small>@row.DocumentType @row.DianGroup</small><small>@row.ReceptionDateDisplay</small></td>
                                                        <td><strong>@row.InvoiceNumber</strong><small>@row.SupplierName</small></td>
                                                        <td class="text-end">@Money(row.BaseAmount)</td>
                                                        <td class="text-end">@Money(row.VatValue)</td>
                                                        <td class="text-end">@Money(row.TotalValue)</td>
                                                        <td><span class="cnc-badge cnc-badge--neutral">@row.VerticalLabel</span><small>Cloud @Money(row.CloudValue) / Copiers @Money(row.CopiersValue)</small></td>
                                                        <td>
                                                            <span hidden data-cnc-dian-adjust-account></span>
                                                            <span class="cnc-badge cnc-badge--@row.ClassificationStatusTone">@row.ClassificationStatusLabel</span>
                                                            <small>@FirstNonEmpty(row.AccountCode, "Sin cuenta gasto")</small>
                                                            <small>@row.AccountName</small>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </section>

                                <section class="cnc-pipeline-stage">
                                    <header class="cnc-pipeline-stage__header">
                                        <h3>3. Prevalidacion documento Siigo</h3>
                                        <span data-cnc-stage-count>@Number(readyRows.Count) filas</span>
                                    </header>
                                    <div class="cnc-table-wrap">
                                        <table class="table align-middle cnc-table cnc-table--pipeline">
                                            <thead>
                                                <tr>
                                                    <th>Fecha</th>
                                                    <th>Documento / proveedor</th>
                                                    <th class="text-end">Total</th>
                                                    <th>Cuenta gasto</th>
                                                    <th>Impuestos</th>
                                                    <th>Estado / accion</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var row in readyRows)
                                                {
                                                    var verticalFlow = string.Equals(row.VerticalLabel, "Sin vertical", StringComparison.OrdinalIgnoreCase) ? "" : row.VerticalLabel;
                                                    var ambiguousSiigoWrite = row.AutomationState.Equals("VerificacionSiigoPendiente", StringComparison.OrdinalIgnoreCase)
                                                        || row.ReviewReason.Contains("[SIIGO_WRITE_AMBIGUOUS]", StringComparison.OrdinalIgnoreCase);
                                                    <tr class="cnc-click-row"
                                                        data-record-id="@row.RecordId"
                                                        data-cnc-dian-edit
                                                        data-description="@($"{row.InvoiceNumber} - {row.SupplierName}")"
                                                        data-account-code="@row.AccountCode"
                                                        data-flow="@verticalFlow"
                                                        data-search="@DianSearchText(row)">
                                                        <td><strong>@row.EmissionDateDisplay</strong><small>@ExcelRowLabel(row.SourceRowNumber)</small><small>@row.VerticalLabel</small></td>
                                                        <td><strong>@row.InvoiceNumber</strong><small>@row.SupplierName</small></td>
                                                        <td class="text-end">@Money(row.TotalValue)</td>
                                                        <td><strong>@row.AccountCode</strong><small>@row.AccountName</small></td>
                                                        <td><small>IVA @Money(row.VatValue) / RIVA @Money(row.ReteIvaValue) / RF @Money(row.ReteFuenteValue) / RICA @Money(row.ReteIcaValue)</small></td>
                                                        <td>
                                                            <span hidden data-cnc-dian-dry-run></span>
                                                            <span hidden data-cnc-dian-send></span>
                                                            <span class="cnc-badge cnc-badge--@row.StageTone">@row.StageLabel</span>
