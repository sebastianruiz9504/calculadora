                                                <tr>
                                                    <th>Fecha</th>
                                                    <th>Factura / cliente flujo de caja</th>
                                                    <th>Factura / cliente Dataverse</th>
                                                    <th class="text-end">Entrada</th>
                                                    <th class="text-end">Valor Dataverse</th>
                                                    <th>Cliente</th>
                                                    <th class="text-end">Diferencia</th>
                                                    <th>Estado</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var row in crossRows)
                                                {
                                                    var search = $"{row.SourceRowNumber} {row.InvoiceNumbers} {row.ClientNames} {row.Description} {row.BankAccountName}".ToLowerInvariant();
                                                    var flowInvoice = InvoiceFromFlow(row);
                                                    <tr class="cnc-click-row"
                                                        data-cnc-invoice-assign
                                                        data-record-id="@row.RecordId"
                                                        data-status="@row.Status"
