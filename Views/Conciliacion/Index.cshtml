                                                <tr>
                                                    <th>Fecha</th>
                                                    <th>Documento / proveedor</th>
                                                    <th class="text-end">Total</th>
                                                    <th>Documento Siigo</th>
                                                    <th>Vertical</th>
                                                    <th>Estado</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var row in sentRows)
