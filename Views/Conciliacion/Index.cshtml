                                                        <td class="text-end">@Money(row.EntryValue)</td>
                                                        <td><span class="cnc-badge cnc-badge--@row.StatusTone" data-status-label>@row.StatusLabel</span></td>
                                                        <td>
                                                            <small data-preflight-message>@(string.IsNullOrWhiteSpace(row.PreflightMessage) ? row.Reason : row.PreflightMessage)</small>
