                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </section>
                            </div>
                        </section>
                    }
                    else if (phase.Key == "cuentas-cobro")
                    {
                        var detectedSupportRows = CuentaCobroRowsFor("detectadas");
                        var pendingSupportRows = CuentaCobroRowsFor("pendientes");
                        var readySupportRows = CuentaCobroRowsFor("prevalidacion");
                        var sentSupportRows = CuentaCobroRowsFor("enviadas");
                        <section class="cnc-payment-panel">
                            <div class="cnc-table-toolbar">
                                <input class="form-control cnc-table-search" type="search" placeholder="Buscar proveedor, NIT, banco, cuenta o descripcion" data-cnc-table-search="@phase.Key" />
                                <span class="cnc-counter" data-cnc-table-count="@phase.Key">@Number(cuentasCobro.Rows.Count) filas</span>
                            </div>

                            <div class="cnc-pipeline" data-cnc-table-body="@phase.Key">
