    <div class="cnc-modal" id="cncDianSupplierModal" role="dialog" aria-modal="true" aria-labelledby="cncDianSupplierTitle" hidden>
        <div class="cnc-modal__panel cnc-modal__panel--wide">
            <div class="cnc-modal__header">
                <div>
                    <div class="cnc-kicker">Proveedor Siigo</div>
                    <h2 id="cncDianSupplierTitle">Datos para crear proveedor</h2>
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-cnc-close-dian-supplier-modal>Cerrar</button>
            </div>
            <p class="cnc-modal__description" id="cncDianSupplierDescription"></p>
            <div class="cnc-modal__feedback"
                 id="cncDianSupplierFeedback"
                 role="alert"
                 aria-live="assertive"
                 hidden></div>
            <div class="cnc-rut-upload" id="cncDianSupplierRutSection">
                <label class="cnc-modal__field" for="cncDianSupplierRutFile">
                    <span>RUT del proveedor</span>
                    <input class="form-control" id="cncDianSupplierRutFile" type="file" accept=".pdf,.png,.jpg,.jpeg,.webp,application/pdf,image/*" />
                </label>
                <button type="button" class="btn btn-outline-primary" id="cncDianSupplierRutAnalyze">Extraer datos con IA</button>
                <small id="cncDianSupplierRutStatus">Adjunta el RUT para completar automáticamente los datos fiscales.</small>
            </div>
            <div class="cnc-modal__grid">
                <label class="cnc-modal__field">
                    <span>Nombre proveedor</span>
                    <input class="form-control" id="cncDianSupplierName" type="text" maxlength="100" required />
                </label>
                <label class="cnc-modal__field">
                    <span>NIT / identificacion</span>
                    <input class="form-control" id="cncDianSupplierNit" type="text" required />
                </label>
                <label class="cnc-modal__field">
                    <span>Tipo persona</span>
                    <select class="form-select" id="cncDianSupplierPersonType" required>
                        <option value="Company">Empresa</option>
                        <option value="Person">Persona natural</option>
                    </select>
                </label>
                <label class="cnc-modal__field">
                    <span>Tipo identificacion</span>
                    <select class="form-select" id="cncDianSupplierIdType" required>
                        <option value="31">NIT</option>
                        <option value="13">Cedula ciudadania</option>
                        <option value="22">Cedula extranjeria</option>
                        <option value="41">Pasaporte</option>
                    </select>
                </label>
                <label class="cnc-modal__field">
                    <span>Digito verificacion</span>
                    <input class="form-control" id="cncDianSupplierCheckDigit" type="text" maxlength="1" />
                </label>
                <label class="cnc-modal__field">
                    <span>Responsable IVA</span>
                    <select class="form-select" id="cncDianSupplierVatResponsible" required>
                        <option value="false">No</option>
                        <option value="true">Si</option>
                    </select>
                </label>
                <label class="cnc-modal__field">
                    <span>Responsabilidad fiscal</span>
                    <select class="form-select" id="cncDianSupplierFiscalResponsibility" required>
                        <option value="R-99-PN">No aplica / No responsable</option>
                        <option value="O-13">Gran contribuyente</option>
                        <option value="O-15">Autorretenedor</option>
                        <option value="O-23">Agente retencion IVA</option>
                        <option value="O-47">Regimen simple</option>
                    </select>
                </label>
                <label class="cnc-modal__field">
                    <span>Direccion</span>
                    <input class="form-control" id="cncDianSupplierAddress" type="text" maxlength="100" required />
                </label>
                <label class="cnc-modal__field">
                    <span>Ciudad Siigo</span>
                    <select class="form-select" id="cncDianSupplierCity" required>
                        <option value="">Selecciona ciudad</option>
                        <option value="CO|11|11001">Bogota D.C.</option>
                        <option value="CO|05|05001">Medellin</option>
                        <option value="CO|76|76001">Cali</option>
                        <option value="CO|08|08001">Barranquilla</option>
                        <option value="CO|68|68001">Bucaramanga</option>
                        <option value="CO|47|47001">Santa Marta</option>
                        <option value="CO|13|13001">Cartagena</option>
                        <option value="CO|54|54001">Cucuta</option>
                        <option value="CO|66|66001">Pereira</option>
                        <option value="CO|17|17001">Manizales</option>
                        <option value="CO|63|63001">Armenia</option>
                        <option value="CO|73|73001">Ibague</option>
                    </select>
                </label>
            </div>
            <div class="cnc-modal__actions">
                <button type="button" class="btn btn-outline-secondary" data-cnc-close-dian-supplier-modal>Cancelar</button>
                <button type="button" class="btn btn-primary" id="cncDianSupplierSave">Crear/asociar proveedor</button>
            </div>
        </div>
    </div>

