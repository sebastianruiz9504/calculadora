                                                                    data-cnc-dian-preview-send
                                                                    data-ambiguous-siigo-write="@(ambiguousSiigoWrite ? "true" : "false")">
                                                                @(ambiguousSiigoWrite ? "Verificar en Siigo" : "Enviar factura")
                                                            </button>
