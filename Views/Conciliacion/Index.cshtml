                                                        data-status="@row.Status"
                                                        data-flow="@row.SourceFlow"
                                                        data-search="@search"
                                                        data-direction="Entrada"
                                                        data-current-type="entrada-fe"
                                                        data-description="@row.Description">
                                                        <td><strong>@row.MovementDateDisplay</strong><small>@ExcelRowLabel(row.SourceRowNumber)</small><small>@row.SourceFlow</small></td>
                                                        <td><strong>@row.BankAccountCode</strong><small>@row.BankAccountName</small></td>
                                                        <td><strong>@row.Description</strong></td>
                                                        <td>@(string.IsNullOrWhiteSpace(flowInvoice) ? "Sin factura" : flowInvoice)</td>
                                                        <td class="text-end">@Money(row.EntryValue)</td>
                                                        <td>
                                                            <span hidden data-cnc-bulk-category></span>
                                                            <span class="cnc-badge cnc-badge--@row.StatusTone">@row.StatusLabel</span>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </section>

                                <section class="cnc-pipeline-stage">
                                    <header class="cnc-pipeline-stage__header">
                                        <h3>2. Cruce con factura</h3>
                                        <span data-cnc-stage-count>@Number(crossRows.Count) filas</span>
                                    </header>
