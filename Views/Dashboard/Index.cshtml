                    <span class="dashboard-copiers-form__label">cr07a_operacionadicional</span>
                    <input type="number" min="0" step="0.01" class="form-control" id="copiersAdditionalOperationInput" data-copiers-input-field="additionalOperation" />
                </label>

                <label class="dashboard-copiers-form__field">
                    <span class="dashboard-copiers-form__label">Valor unit. antes IVA</span>
                    <input type="number" min="0" step="0.01" class="form-control" id="copiersUnitValueBeforeVatInput" data-copiers-input-field="unitValueBeforeVat" />
                </label>

                <label class="dashboard-copiers-form__field">
                    <span class="dashboard-copiers-form__label">Valor unit. con IVA</span>
                    <input type="number" min="0" step="0.01" class="form-control" id="copiersUnitValueWithVatInput" data-copiers-input-field="unitValueWithVat" />
                </label>

                <label class="dashboard-copiers-form__field">
                    <span class="dashboard-copiers-form__label">Total con IVA</span>
                    <input type="number" min="0" step="0.01" class="form-control" id="copiersTotalWithVatInput" data-copiers-input-field="totalWithVat" />
                </label>
            </div>

            <div class="dashboard-copiers-form__actions">
                <button type="button" class="btn btn-outline-secondary" id="copiersEditorCancelBtn">Cancelar</button>
                <button type="submit" class="btn btn-primary" id="copiersEditorSaveBtn">Guardar</button>
            </div>
        </form>
    </div>
</div>

<div class="dashboard-modal" id="copiersClientInvoicesModal" hidden>
    <div class="dashboard-modal__backdrop" data-copiers-client-invoices-close></div>
    <div class="dashboard-modal__dialog dashboard-modal__dialog--medium" role="dialog" aria-modal="true" aria-labelledby="copiersClientInvoicesTitle">
        <div class="dashboard-modal__header">
            <div>
                <div class="dashboard-panel__kicker">Facturas emitidas</div>
                <h2 class="dashboard-modal__title" id="copiersClientInvoicesTitle">Facturas del cliente</h2>
                <p class="dashboard-modal__subtitle" id="copiersClientInvoicesSubtitle">Consulta las facturas emitidas con vertical Copiers en <span class="dashboard-highlight">cr07a_facturacion</span> para el cliente seleccionado.</p>
            </div>
            <button type="button" class="btn btn-outline-secondary" id="copiersClientInvoicesCloseBtn">Cerrar</button>
        </div>

        <div id="copiersClientInvoicesStatus" class="dashboard-status" role="status" aria-live="polite"></div>

        <div class="dashboard-table-meta" id="copiersClientInvoicesResultsCount">Mostrando 0 facturas</div>

        <div class="dashboard-table-wrap">
            <table class="table dashboard-table dashboard-client-invoices-table">
                <thead>
                    <tr>
                        <th>Factura</th>
                        <th class="text-end">Valor total</th>
                        <th>Fecha emisi&oacute;n</th>
                        <th>Fecha pago</th>
                        <th class="text-end">Valor pago</th>
                    </tr>
                </thead>
                <tbody id="copiersClientInvoicesBody">
                    <tr>
                        <td colspan="5" class="dashboard-table__empty">Selecciona un cliente para ver sus facturas emitidas.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="dashboard-modal" id="copiersEquipmentDetailModal" hidden>
    <div class="dashboard-modal__backdrop" data-copiers-equipment-close></div>
    <div class="dashboard-modal__dialog dashboard-modal__dialog--wide" role="dialog" aria-modal="true" aria-labelledby="copiersEquipmentDetailTitle">
        <div class="dashboard-modal__header">
            <div>
                <div class="dashboard-panel__kicker">Equipos Copiers</div>
                <h2 class="dashboard-modal__title" id="copiersEquipmentDetailTitle">Detalle del equipo</h2>
                <p class="dashboard-modal__subtitle" id="copiersEquipmentDetailSubtitle">Consulta la informaci&oacute;n del equipo, reasigna su cliente o env&iacute;alo a stock y revisa sus mantenimientos.</p>
            </div>
            <button type="button" class="btn btn-outline-secondary" id="copiersEquipmentDetailCloseBtn">Cerrar</button>
        </div>

        <div id="copiersEquipmentDetailStatus" class="dashboard-status" role="status" aria-live="polite"></div>

        <form id="copiersEquipmentAssignmentForm" class="dashboard-equipment-detail">
            <input type="hidden" id="copiersEquipmentRecordIdInput" />
            <input type="hidden" id="copiersEquipmentClientIdInput" />

            <section class="dashboard-equipment-detail__summary">
                <div class="dashboard-equipment-detail__card">
                    <span class="dashboard-equipment-detail__label">Serial</span>
                    <strong id="copiersEquipmentDetailSerial">-</strong>
                </div>
                <div class="dashboard-equipment-detail__card">
                    <span class="dashboard-equipment-detail__label">Cliente actual</span>
                    <strong id="copiersEquipmentDetailCurrentClient">-</strong>
                </div>
                <div class="dashboard-equipment-detail__card">
                    <span class="dashboard-equipment-detail__label">Categor&iacute;a</span>
                    <strong id="copiersEquipmentDetailCategory">-</strong>
                </div>
                <div class="dashboard-equipment-detail__card">
                    <span class="dashboard-equipment-detail__label">Referencia</span>
                    <strong id="copiersEquipmentDetailReference">-</strong>
                </div>
                <div class="dashboard-equipment-detail__card dashboard-equipment-detail__card--wide">
                    <span class="dashboard-equipment-detail__label">Observaciones</span>
                    <strong id="copiersEquipmentDetailObservations">-</strong>
                </div>
            </section>

            <section class="dashboard-equipment-detail__assignment">
                <div>
                    <div class="dashboard-panel__kicker">Asignaci&oacute;n</div>
                    <h3 class="dashboard-equipment-detail__section-title">Reasignar cliente</h3>
                    <p class="dashboard-panel__description">Busca el cliente actual del equipo o m&aacute;rcalo como stock si debe quedar disponible.</p>
                </div>

                <div class="dashboard-equipment-detail__assignment-grid">
                    <label class="dashboard-copiers-form__field">
                        <span class="dashboard-copiers-form__label">Cliente</span>
                        <input type="text"
                               class="form-control"
                               id="copiersEquipmentClientNameInput"
                               list="copiersEquipmentClientOptions"
                               autocomplete="off"
                               placeholder="Buscar cliente..." />
                        <datalist id="copiersEquipmentClientOptions"></datalist>
                        <span class="dashboard-copiers-form__hint">Escribe al menos 2 caracteres y elige una coincidencia para dejarlo asignado.</span>
                    </label>

                    <label class="dashboard-equipment-detail__stock-toggle" for="copiersEquipmentMoveToStockInput">
                        <input type="checkbox" id="copiersEquipmentMoveToStockInput" />
                        <span>Dejar este equipo en stock</span>
                    </label>
                </div>

                <div class="dashboard-copiers-form__actions">
                    <button type="button" class="btn btn-outline-secondary" id="copiersEquipmentDetailCancelBtn">Cancelar</button>
                    <button type="submit" class="btn btn-primary" id="copiersEquipmentSaveBtn">Guardar reasignaci&oacute;n</button>
                </div>
            </section>
        </form>

        <section class="dashboard-equipment-detail__maintenance">
            <div class="dashboard-panel__header">
                <div>
                    <div class="dashboard-panel__kicker">Mantenimientos</div>
                    <h3 class="dashboard-equipment-detail__section-title">Historial del equipo</h3>
                    <p class="dashboard-panel__description">Cada soporte muestra su fecha, cliente asociado, t&eacute;cnico, tipo y enlace al acta si existe.</p>
                </div>
            </div>
            <div class="dashboard-table-wrap dashboard-table-wrap--tall">
                <table class="table dashboard-table dashboard-equipment-maintenance-table">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>T&iacute;tulo</th>
                            <th>Tipo</th>
                            <th>Estado</th>
                            <th>Cliente</th>
                            <th>T&eacute;cnico</th>
                            <th>Descripci&oacute;n</th>
                            <th>ID</th>
                            <th>Acta</th>
                        </tr>
                    </thead>
                    <tbody id="copiersEquipmentMaintenanceBody"></tbody>
                </table>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
    <script src="~/js/support-cloud.js" asp-append-version="true"></script>
}
