@model DashboardPageViewModel
@{
    ViewData["Title"] = "Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/hardware.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/support-cloud.css" asp-append-version="true" />
}

<div class="dashboard-shell"
     id="billingDashboardApp"
     data-agent-url="@Url.Action("Agent", "Dashboard")"
     data-agent-export-url="@Url.Action("AgentExport", "Dashboard")"
     data-agent-feedback-url="@Url.Action("AgentFeedback", "Dashboard")"
     data-agent-learning-url="@Url.Action("AgentLearning", "Dashboard")"
     data-agent-learning-status-url="@Url.Action("AgentLearningStatus", "Dashboard")"
     data-today-url="@Url.Action("Today", "Dashboard")"
     data-billing-url="@Url.Action("Billing", "Dashboard")"
     data-billing-invoices-url="@Url.Action("BillingInvoices", "Dashboard")"
     data-billing-credit-notes-url="@Url.Action("BillingCreditNotes", "Dashboard")"
     data-billing-current-month-url="@Url.Action("BillingCurrentMonth", "Dashboard")"
     data-billing-invoice-save-url="@Url.Action("BillingInvoice", "Dashboard")"
     data-billing-invoices-delete-url="@Url.Action("BillingInvoicesDelete", "Dashboard")"
     data-billing-invoices-contract-url="@Url.Action("BillingInvoicesContractType", "Dashboard")"
     data-billing-client-report-url="@Url.Action("BillingClientReport", "Dashboard")"
     data-billing-client-report-export-url="@Url.Action("BillingClientReportExport", "Dashboard")"
     data-business-url="@Url.Action("Business", "Dashboard")"
     data-siigo-customers-url="@Url.Action("SiigoCustomers", "Dashboard")"
     data-siigo-customer-search-url="@Url.Action("SiigoCustomerSearch", "Dashboard")"
     data-siigo-invoices-url="@Url.Action("SiigoInvoices", "Dashboard")"
     data-siigo-invoices-download-url="@Url.Action("SiigoInvoicesDownload", "Dashboard")"
     data-copiers-url="@Url.Action("Copiers", "Dashboard")"
     data-copiers-client-invoices-url="@Url.Action("CopiersClientInvoices", "Dashboard")"
     data-copiers-save-url="@Url.Action("CopiersRecord", "Dashboard")"
     data-copiers-equipment-url="@Url.Action("CopiersEquipment", "Dashboard")"
     data-copiers-inventory-url="@Url.Action("CopiersInventory", "Dashboard")"
     data-copiers-inventory-export-url="@Url.Action("CopiersInventoryExport", "Dashboard")"
     data-copiers-equipment-movements-url="@Url.Action("CopiersEquipmentMovements", "Dashboard")"
     data-copiers-counters-url="@Url.Action("CopiersCounters", "Dashboard")"
      data-copiers-counters-pdf-url="@Url.Action("CopiersCountersPdf", "Dashboard")"
     data-copiers-equipment-detail-url="@Url.Action("CopiersEquipmentDetail", "Dashboard")"
     data-copiers-equipment-assignment-url="@Url.Action("CopiersEquipmentAssignment", "Dashboard")"
     data-copiers-line-equipment-assignment-url="@Url.Action("CopiersLineEquipmentAssignment", "Dashboard")"
     data-copiers-line-equipment-assignment-save-url="@Url.Action("CopiersLineEquipmentAssignment", "Dashboard")"
     data-copiers-maintenance-file-url="@Url.Action("CopiersMaintenanceAttachment", "Dashboard")"
     data-copiers-equipment-movement-file-url="@Url.Action("CopiersEquipmentMovementAttachment", "Dashboard")"
     data-copiers-client-search-url="@Url.Action("CopiersClientSearch", "Dashboard")"
     data-copiers-product-search-url="@Url.Action("CopiersProductSearch", "Dashboard")"
      data-taxes-url="@Url.Action("Taxes", "Dashboard")"
      data-taxes-retefuente-export-url="@Url.Action("TaxesReteFuenteExport", "Dashboard")"
      data-taxes-reteica-export-url="@Url.Action("TaxesReteIcaExport", "Dashboard")"
      data-taxes-vat-export-url="@Url.Action("TaxesVatExport", "Dashboard")"
      data-portfolio-url="@Url.Action("Portfolio", "Dashboard")"
      data-account-statement-client-search-url="@Url.Action("AccountStatementClientSearch", "Dashboard")"
      data-account-statement-url="@Url.Action("AccountStatement", "Dashboard")"
      data-account-statement-pdf-url="@Url.Action("AccountStatementPdf", "Dashboard")"
     data-licenciamiento-url="@Url.Action("Licenciamiento", "Dashboard")"
     data-utility-url="@Url.Action("Utility", "Dashboard")"
     data-utility-assignment-url="@Url.Action("UtilityAssignment", "Dashboard")"
     data-pnl-url="@Url.Action("Pnl", "Dashboard")"
     data-pnl-detail-url="@Url.Action("PnlDetail", "Dashboard")"
     data-pnl-detail-update-url="@Url.Action("PnlDetailRecord", "Dashboard")"
     data-ytd-url="@Url.Action("Ytd", "Dashboard")"
     data-ytd-billing-update-url="@Url.Action("YtdBillingRecord", "Dashboard")"
     data-ytd-records-update-url="@Url.Action("YtdRecords", "Dashboard")"
     data-ytd-cost-contract-update-url="@Url.Action("UpdateCostContractType", "CruceLicenciamiento")"
     data-business-billing-url="@Url.Action("BusinessBilling", "Dashboard")"
     data-initial-year="@Model.InitialYear"
     data-initial-period="@Model.InitialPeriodKind.ToKey()"
     data-initial-value="@Model.InitialPeriodValue">
    <section class="dashboard-hero">
        <div class="dashboard-hero__content">
            <h1 class="dashboard-title">Dashboard Financiero</h1>
        </div>
    </section>

    <section class="dashboard-tabs" aria-label="Secciones del dashboard">
        <button type="button" class="dashboard-tab is-active dashboard-tab--today" data-dashboard-tab="today">. HOY</button>
        <button type="button" class="dashboard-tab" data-dashboard-tab="agent">Agente</button>
        <button type="button" class="dashboard-tab" data-dashboard-tab="billing">Facturaci&oacute;n</button>
        <button type="button" class="dashboard-tab" data-dashboard-tab="business" data-dashboard-group-tabs="business business-billing licenciamiento utility">Negocio</button>
        <button type="button" class="dashboard-tab" data-dashboard-tab="copiers" data-dashboard-group-tabs="copiers support-cloud">Soporte</button>
        <button type="button" class="dashboard-tab" data-dashboard-tab="hardware">Hardware</button>
        <button type="button" class="dashboard-tab" data-dashboard-tab="taxes" data-dashboard-group-tabs="taxes pnl">Contabilidad</button>
        <button type="button" class="dashboard-tab" data-dashboard-tab="portfolio">Cartera</button>
        <button type="button" class="dashboard-tab" data-dashboard-tab="ytd">YTD</button>
    </section>

    <section class="dashboard-group-tabs" data-dashboard-group-panel="support" data-dashboard-group-tabs="copiers support-cloud" aria-label="Subsecciones de soporte" hidden>
        <button type="button" class="dashboard-subtab is-active" data-dashboard-group-target="copiers">Copiers</button>
        <button type="button" class="dashboard-subtab" data-dashboard-group-target="support-cloud">Soporte cloud</button>
    </section>

    <section class="dashboard-group-tabs" data-dashboard-group-panel="business" data-dashboard-group-tabs="business business-billing licenciamiento utility" aria-label="Subsecciones de negocio" hidden>
        <button type="button" class="dashboard-subtab is-active" data-dashboard-group-target="business">Negocios</button>
        <button type="button" class="dashboard-subtab" data-dashboard-group-target="business-billing">Facturaci&oacute;n</button>
        <button type="button" class="dashboard-subtab" data-dashboard-group-target="licenciamiento">Licenciamiento</button>
        <button type="button" class="dashboard-subtab" data-dashboard-group-target="utility">Utilidad</button>
    </section>

    <section class="dashboard-group-tabs" data-dashboard-group-panel="accounting" data-dashboard-group-tabs="taxes pnl" aria-label="Subsecciones de contabilidad" hidden>
        <button type="button" class="dashboard-subtab is-active" data-dashboard-group-target="taxes">Impuestos</button>
        <button type="button" class="dashboard-subtab" data-dashboard-group-target="pnl">P&amp;L</button>
    </section>

    <section class="dashboard-toolbar" id="dashboardPeriodScope" hidden>
        <div class="dashboard-filters">
            <div class="dashboard-filter">
                <label class="dashboard-filter__label" for="dashboardYearFilter">A&ntilde;o</label>
                <select id="dashboardYearFilter" class="form-select dashboard-select"></select>
            </div>
            <div class="dashboard-filter">
                <label class="dashboard-filter__label" for="dashboardPeriodFilter">Periodo</label>
                <select id="dashboardPeriodFilter" class="form-select dashboard-select">
                    <option value="month">Mes</option>
                    <option value="bimonthly">Bimensual</option>
                    <option value="quarter">Trimestre</option>
                    <option value="semester">Semestre</option>
                    <option value="year">Anual</option>
                </select>
            </div>
            <div class="dashboard-filter">
                <label class="dashboard-filter__label" for="dashboardValueFilter">Detalle</label>
                <select id="dashboardValueFilter" class="form-select dashboard-select"></select>
            </div>
        </div>
        <div class="dashboard-toolbar__actions">
            <div class="dashboard-toolbar__summary">
                <span class="dashboard-toolbar__summary-label">Periodo activo</span>
                <strong id="dashboardPeriodLabel">Cargando...</strong>
                <span id="dashboardDateRangeLabel">-</span>
            </div>
            <button type="button" class="btn btn-primary dashboard-refresh-btn" id="dashboardRefreshBtn">Actualizar</button>
        </div>
    </section>

    <div class="dashboard-tab-panel is-active" data-dashboard-panel="today">
        <section class="dashboard-today" aria-labelledby="dashboardTodayTitle">
            <header class="dashboard-today__header">
                <div>
                    <div class="dashboard-panel__kicker">Resumen ejecutivo</div>
                    <h2 class="dashboard-today__title" id="dashboardTodayTitle">Lo esencial de hoy</h2>
                    <p class="dashboard-today__subtitle">
                        Corte <strong id="dashboardTodayAsOf">de hoy</strong>. Las variaciones comparan
                        <span id="dashboardTodayCurrentPeriod">el mes a la fecha</span> contra
                        <span id="dashboardTodayComparisonPeriod">los mismos d&iacute;as del mes anterior</span>.
                    </p>
                </div>
                <button type="button" class="btn btn-outline-primary dashboard-today__refresh" id="dashboardTodayRefreshBtn">Actualizar</button>
            </header>

            <div class="dashboard-status" id="dashboardTodayStatus" role="status" aria-live="polite"></div>
            <div class="dashboard-today-grid" id="dashboardTodayCards" aria-live="polite" aria-busy="true">
                @for (var index = 0; index < 7; index++)
                {
                    <article class="dashboard-today-card dashboard-today-card--skeleton" aria-hidden="true">
                        <span></span><strong></strong><small></small>
                    </article>
                }
            </div>
        </section>
    </div>

    <div class="dashboard-tab-panel" data-dashboard-panel="agent" hidden>
        <section class="dashboard-agent" aria-labelledby="dashboardAgentTitle">
            <div class="dashboard-agent__header">
                <div>
                    <div class="dashboard-panel__kicker">Agente</div>
                    <h2 class="dashboard-agent__title" id="dashboardAgentTitle">Chat financiero</h2>
                </div>
                <div class="dashboard-agent__status" id="dashboardAgentStatus" role="status" aria-live="polite"></div>
            </div>

            <div class="dashboard-agent__messages" id="dashboardAgentMessages" aria-live="polite">
                <div class="dashboard-agent-message dashboard-agent-message--assistant">
                    <div class="dashboard-agent-message__bubble">Listo. Preguntame por facturas, nomina, utilidad, P&amp;L o contratos.</div>
                </div>
            </div>

            <div class="dashboard-agent__sources" id="dashboardAgentSources" hidden></div>

            <form class="dashboard-agent__composer" id="dashboardAgentForm">
                <label class="visually-hidden" for="dashboardAgentInput">Pregunta para el agente financiero</label>
                <textarea id="dashboardAgentInput"
                          class="form-control dashboard-agent__input"
                          rows="2"
                          maxlength="1800"
                          autocomplete="off"
                          placeholder="Ej. que facturas tiene este cliente pendientes por pagar"></textarea>
                <button type="submit" class="btn btn-primary dashboard-agent__send" id="dashboardAgentSendBtn">Enviar</button>
            </form>

            <div class="dashboard-agent__prompts" aria-label="Preguntas rapidas">
                <button type="button" class="dashboard-agent__prompt" data-agent-prompt="Que facturas tiene un cliente pendientes por pagar?">Facturas pendientes</button>
                <button type="button" class="dashboard-agent__prompt" data-agent-prompt="Cuanto se le pago a un empleado en total en 2025?">Pagos 2025</button>
                <button type="button" class="dashboard-agent__prompt" data-agent-prompt="Cual es la utilidad para contratos Monthly y vertical Cloud en junio 2026?">Utilidad Monthly</button>
            </div>

            <details class="dashboard-agent-learning" id="dashboardAgentLearningPanel">
                <summary>
                    <span>Aprendizaje del agente</span>
                    <small id="dashboardAgentLearningSummary">Solicitudes enviadas para revisar</small>
                </summary>
                <div class="dashboard-agent-learning__body">
                    <div class="dashboard-agent-learning__toolbar">
                        <div class="dashboard-agent-learning__status" id="dashboardAgentLearningStatus" role="status" aria-live="polite"></div>
                        <button type="button" class="btn btn-outline-secondary dashboard-agent-learning__refresh" id="dashboardAgentLearningRefreshBtn">Actualizar</button>
                    </div>
                    <div class="dashboard-agent-learning__list" id="dashboardAgentLearningList">
                        <div class="dashboard-agent-learning__empty">Abre la bandeja para cargar solicitudes.</div>
                    </div>
                </div>
            </details>
        </section>
    </div>

    <div class="dashboard-modal dashboard-agent-feedback-modal" id="dashboardAgentFeedbackModal" hidden>
        <div class="dashboard-modal__backdrop" data-agent-feedback-close></div>
        <div class="dashboard-modal__dialog dashboard-modal__dialog--medium" role="dialog" aria-modal="true" aria-labelledby="dashboardAgentFeedbackTitle">
            <div class="dashboard-modal__header">
                <div>
                    <h2 class="dashboard-modal__title" id="dashboardAgentFeedbackTitle">Enviar a aprendizaje</h2>
                    <p class="dashboard-modal__subtitle">Guarda la pregunta, respuesta y contexto usado para mejorar reglas del agente.</p>
                </div>
                <button type="button" class="btn-close" aria-label="Cerrar" data-agent-feedback-close></button>
            </div>
            <form class="dashboard-agent-feedback-form" id="dashboardAgentFeedbackForm">
                <input type="hidden" id="dashboardAgentFeedbackMessageId" />
                <label class="dashboard-agent-feedback-form__field">
                    <span>Motivo</span>
                    <select class="form-select" id="dashboardAgentFeedbackCategory">
                        <option value="incorrect">Respuesta incorrecta</option>
                        <option value="missing-data">Faltan datos</option>
                        <option value="learning">Debe aprender esta consulta</option>
                        <option value="other">Otro</option>
                    </select>
                </label>
                <label class="dashboard-agent-feedback-form__field">
                    <span>Respuesta esperada</span>
                    <textarea class="form-control" id="dashboardAgentFeedbackExpected" rows="4" maxlength="3900" placeholder="Escribe como deberia responder o que tablas deberia usar."></textarea>
                </label>
                <label class="dashboard-agent-feedback-form__field">
                    <span>Notas</span>
                    <textarea class="form-control" id="dashboardAgentFeedbackNotes" rows="3" maxlength="3900" placeholder="Detalle adicional para revisar despues."></textarea>
                </label>
                <div class="dashboard-agent-feedback-form__status" id="dashboardAgentFeedbackStatus" role="status" aria-live="polite"></div>
                <div class="dashboard-agent-feedback-form__actions">
                    <button type="button" class="btn btn-outline-secondary" data-agent-feedback-close>Cancelar</button>
                    <button type="submit" class="btn btn-primary" id="dashboardAgentFeedbackSubmitBtn">Guardar</button>
                </div>
            </form>
        </div>
    </div>

    <div class="dashboard-tab-panel" data-dashboard-panel="billing" hidden>
        <section class="dashboard-subtabs" aria-label="Vistas de facturaci&oacute;n">
            <button type="button" class="dashboard-subtab is-active" data-billing-subtab="overview">Resumen</button>
            <button type="button" class="dashboard-subtab" data-billing-subtab="current-month">MES ACTUAL</button>
            <button type="button" class="dashboard-subtab" data-billing-subtab="credit-notes">Notas Cr&eacute;dito</button>
        </section>

        <div class="dashboard-subpanel is-active" data-billing-subpanel="overview">
        <div id="dashboardStatusBanner" class="dashboard-status" role="status" aria-live="polite"></div>

        <section class="dashboard-kpis dashboard-kpis--billing" id="billingKpisContainer"></section>

        <section class="dashboard-billing-actions" aria-label="Acciones de facturaci&oacute;n">
            <button type="button" class="btn btn-outline-secondary" id="billingReportToggleBtn" aria-expanded="false" aria-controls="billingReportSection">Mostrar reportes</button>
            <button type="button" class="btn btn-outline-secondary" id="siigoToggleBtn" aria-expanded="false" aria-controls="siigoApiSection">Mostrar Siigo API</button>
            <button type="button"
                    class="btn btn-outline-primary"
                    id="billingDataverseRepairBtn"
                    data-repair-url="@Url.Action("Repair", "FinancialReconciliation")">Sincronizar Siigo &rarr; Dataverse</button>
        </section>

        <section class="dashboard-grid">
            <article class="dashboard-panel dashboard-panel--full">
                <div class="dashboard-panel__header">
                    <div>
                        <div class="dashboard-panel__kicker">Tendencias</div>
                        <h2 class="dashboard-panel__title">Facturacion neta y recaudo YTD</h2>
                    </div>
                </div>
                <div class="dashboard-trends" id="billingTrendsContainer"></div>
            </article>

            <article class="dashboard-panel dashboard-panel--full">
                <div class="dashboard-panel__header">
                    <div>
                        <div class="dashboard-panel__kicker">Facturaci&oacute;n</div>
                        <h2 class="dashboard-panel__title">Tabla de facturaci&oacute;n</h2>
                    </div>
                    <div class="dashboard-panel__actions dashboard-panel__actions--table">
                        <label class="dashboard-filter dashboard-filter--compact" for="billingInvoicesMonth">
                            <span class="dashboard-filter__label">Mes</span>
                            <input type="month"
                                   id="billingInvoicesMonth"
                                   class="form-control dashboard-select dashboard-select--compact"
                                   value="@($"{Model.InitialYear:D4}-{Model.InitialPeriodValue:D2}")" />
                        </label>
                        <label class="dashboard-filter dashboard-filter--compact" for="billingInvoicesPageSize">
                            <span class="dashboard-filter__label">Filas</span>
                            <select id="billingInvoicesPageSize" class="form-select dashboard-select dashboard-select--compact">
                                <option value="25">25</option>
                                <option value="50" selected>50</option>
                                <option value="100">100</option>
                            </select>
                        </label>
                        <label class="dashboard-search dashboard-search--customer" for="billingInvoicesSearch">
                            <span class="dashboard-search__label">Buscar</span>
                            <input type="search"
                                   id="billingInvoicesSearch"
                                   class="form-control dashboard-search__input"
                                   autocomplete="off"
                                   placeholder="Consultar facturas..." />
                        </label>
                        <button type="button" class="btn btn-outline-secondary" id="billingInvoicesRefreshBtn">Actualizar facturas</button>
                        <button type="button" class="btn btn-outline-secondary" id="billingInvoicesDuplicatesBtn">Buscar duplicados</button>
                        <button type="button" class="btn btn-outline-secondary" id="billingInvoicesClearFiltersBtn">Limpiar filtros</button>
                        <button type="button" class="btn btn-outline-primary" id="billingInvoicesContractBtn" disabled>Cambiar tipo de contrato</button>
                        <button type="button" class="btn btn-outline-danger" id="billingInvoicesDeleteBtn" disabled>Eliminar</button>
                    </div>
                </div>

                <div id="billingInvoicesStatus" class="dashboard-status" role="status" aria-live="polite"></div>

                <div class="dashboard-table-toolbar">
                    <div class="dashboard-table-meta" id="billingInvoicesResultsCount">Mostrando 0 facturas</div>
                    <div class="dashboard-table-meta">Seleccionadas: <strong id="billingInvoicesSelectedCount">0</strong></div>
                    <div class="dashboard-table-meta d-flex align-items-center gap-2" aria-label="Paginación de facturas">
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="billingInvoicesPreviousPageBtn" disabled>Anterior</button>
                        <span id="billingInvoicesPageLabel">Página 1 de 1</span>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="billingInvoicesNextPageBtn" disabled>Siguiente</button>
                    </div>
                </div>

                <div class="dashboard-table-wrap dashboard-table-wrap--billing-fit">
                    <table class="table dashboard-table dashboard-billing-invoices-table">
                        <thead id="billingInvoicesHead">
                            <tr>
                                <th>Sel.</th>
                                <th>Factura</th>
                                <th>Cliente</th>
                                <th>Vertical</th>
                                <th>Contrato</th>
                                <th>Emisi&oacute;n</th>
                                <th class="text-end">Total factura</th>
                                <th class="text-end">Notas cr&eacute;dito</th>
                                <th class="text-end">Total neto</th>
                                <th>Estado</th>
                                <th>Link</th>
                            </tr>
                        </thead>
                        <tbody id="billingInvoicesBody">
                            <tr>
                                <td colspan="11" class="dashboard-table__empty">Cargando facturas...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </article>

            <article class="dashboard-panel dashboard-panel--full" id="billingReportSection" hidden>
                <div class="dashboard-panel__header">
                    <div>
                        <div class="dashboard-panel__kicker">Reportes</div>
                        <h2 class="dashboard-panel__title">Exportar facturas por cliente</h2>
                    </div>
                    <div class="dashboard-panel__actions dashboard-panel__actions--table">
                        <input type="hidden" id="billingReportClientIdInput" />
                        <label class="dashboard-search" for="billingReportClientSearch">
                            <span class="dashboard-search__label">Cliente</span>
                            <input type="search"
                                   id="billingReportClientSearch"
                                   class="form-control dashboard-search__input"
                                   list="billingReportClientOptions"
                                   autocomplete="off"
                                   placeholder="Buscar cliente..." />
                            <datalist id="billingReportClientOptions"></datalist>
                        </label>
                        <button type="button" class="btn btn-outline-secondary" id="billingReportLoadBtn">Consultar</button>
                        <button type="button" class="btn btn-primary" id="billingReportExportBtn" disabled>Exportar Excel</button>
                    </div>
                </div>

                <div id="billingReportStatus" class="dashboard-status" role="status" aria-live="polite"></div>

                <div class="dashboard-report-summary">
                    <div class="dashboard-report-summary__item">
                        <span>Cliente</span>
                        <strong id="billingReportClientReference">-</strong>
                    </div>
                    <div class="dashboard-report-summary__item">
                        <span>NIT empresa</span>
                        <strong id="billingReportNitReference">-</strong>
                    </div>
                    <div class="dashboard-report-summary__item">
                        <span>Facturas</span>
                        <strong id="billingReportResultsCount">0</strong>
                    </div>
                    <div class="dashboard-report-summary__item">
                        <span>Seleccionadas</span>
                        <strong id="billingReportSelectedCount">0</strong>
                    </div>
                    <div class="dashboard-report-summary__item">
                        <span>Total neto reporte</span>
                        <strong id="billingReportSelectedTotal">$0</strong>
                    </div>
                </div>

                <div class="dashboard-table-wrap dashboard-table-wrap--tall">
                    <table class="table dashboard-table dashboard-billing-report-table">
                        <thead>
                            <tr>
                                <th>Sel.</th>
                                <th>Factura</th>
                                <th>Fecha</th>
                                <th class="text-end">% IVA</th>
                                <th class="text-end">IVA neto</th>
                                <th class="text-end">Total neto</th>
                                <th class="text-end">Valor reporte</th>
                                <th>URL</th>
                            </tr>
                        </thead>
                        <tbody id="billingReportBody">
                            <tr>
                                <td colspan="8" class="dashboard-table__empty">Busca un cliente para ver sus facturas.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="dashboard-invoice-preview" id="billingReportPreview" hidden>
                    <div class="dashboard-invoice-preview__header">
                        <div>
                            <div class="dashboard-panel__kicker">Vista previa</div>
                            <strong id="billingReportPreviewTitle">Factura</strong>
