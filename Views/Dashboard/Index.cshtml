@model DashboardPageViewModel
@{
    ViewData["Title"] = "Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div class="dashboard-shell"
     id="billingDashboardApp"
     data-billing-url="@Url.Action("Billing", "Dashboard")"
     data-copiers-url="@Url.Action("Copiers", "Dashboard")"
     data-taxes-url="@Url.Action("Taxes", "Dashboard")"
     data-portfolio-url="@Url.Action("Portfolio", "Dashboard")"
     data-pnl-url="@Url.Action("Pnl", "Dashboard")"
     data-pnl-detail-url="@Url.Action("PnlDetail", "Dashboard")"
     data-pnl-detail-update-url="@Url.Action("PnlDetailRecord", "Dashboard")"
     data-initial-year="@Model.InitialYear"
     data-initial-period="@Model.InitialPeriodKind.ToKey()"
     data-initial-value="@Model.InitialPeriodValue">
    <section class="dashboard-hero">
        <div class="dashboard-hero__content">
            <h1 class="dashboard-title">Dashboard financiero</h1>
            <p class="dashboard-subtitle">
                Un tablero estilo control ejecutivo para seguir facturacion, recaudo, impuestos, cartera, P&amp;L
                y la facturacion de productos copiers sobre <span class="dashboard-highlight">cr07a_facturacion</span>
                y <span class="dashboard-highlight">cr07a_productoscopiers</span>.
            </p>
            <div class="dashboard-hero__facts">
                <div class="dashboard-fact">
                    <span class="dashboard-fact__label">Referencia</span>
                    <strong id="dashboardCompareLabel">Mismo periodo del a&ntilde;o anterior</strong>
                </div>
                <div class="dashboard-fact">
                    <span class="dashboard-fact__label">Enfoque</span>
                    <strong id="dashboardGranularityLabel">Mensual</strong>
                </div>
                <div class="dashboard-fact">
                    <span class="dashboard-fact__label">Registros</span>
                    <strong id="dashboardRecordCount">0</strong>
                </div>
            </div>
        </div>
        <aside class="dashboard-user-card">
            <span class="dashboard-user-card__label">Acceso actual</span>
            <strong class="dashboard-user-card__value">@Model.CurrentUser.Email</strong>
            <span class="dashboard-user-card__caption">Facturaci&oacute;n e Impuestos comparan contra el mismo periodo del a&ntilde;o anterior, Cartera muestra el corte actual de facturas vencidas sin pago, P&amp;L consolida ingresos y costos hasta el &uacute;ltimo mes con datos y Facturaci&oacute;n Copiers ordena la tabla operativa de productos.</span>
        </aside>
    </section>

    <section class="dashboard-tabs" aria-label="Secciones del dashboard">
        <button type="button" class="dashboard-tab is-active" data-dashboard-tab="billing">Facturaci&oacute;n</button>
        <button type="button" class="dashboard-tab" data-dashboard-tab="copiers">Facturaci&oacute;n Copiers</button>
        <button type="button" class="dashboard-tab" data-dashboard-tab="taxes">Impuestos</button>
        <button type="button" class="dashboard-tab" data-dashboard-tab="portfolio">Cartera</button>
        <button type="button" class="dashboard-tab" data-dashboard-tab="pnl">P&amp;L</button>
    </section>

    <section class="dashboard-toolbar" id="dashboardPeriodScope">
        <div class="dashboard-filters">
            <div class="dashboard-filter">
                <label class="dashboard-filter__label" for="dashboardYearFilter">A&ntilde;o</label>
                <select id="dashboardYearFilter" class="form-select dashboard-select"></select>
            </div>
            <div class="dashboard-filter">
                <label class="dashboard-filter__label" for="dashboardPeriodFilter">Periodo</label>
                <select id="dashboardPeriodFilter" class="form-select dashboard-select">
                    <option value="month">Mes</option>
                    <option value="quarter">Trimestre</option>
                    <option value="semester">Semestre</option>
                    <option value="year">Anual</option>
                </select>
            </div>
            <div class="dashboard-filter">
                <label class="dashboard-filter__label" for="dashboardValueFilter">Detalle</label>
                <select id="dashboardValueFilter" class="form-select dashboard-select"></select>
            </div>
        </div>
        <div class="dashboard-toolbar__actions">
            <div class="dashboard-toolbar__summary">
                <span class="dashboard-toolbar__summary-label">Periodo activo</span>
                <strong id="dashboardPeriodLabel">Cargando...</strong>
                <span id="dashboardDateRangeLabel">-</span>
            </div>
            <button type="button" class="btn btn-primary dashboard-refresh-btn" id="dashboardRefreshBtn">Actualizar</button>
        </div>
    </section>

    <div class="dashboard-tab-panel is-active" data-dashboard-panel="billing">
        <div id="dashboardStatusBanner" class="dashboard-status" role="status" aria-live="polite"></div>

        <section class="dashboard-kpis dashboard-kpis--billing" id="billingKpisContainer"></section>

        <section class="dashboard-grid">
            <article class="dashboard-panel dashboard-panel--full">
                <div class="dashboard-panel__header">
                    <div>
                        <div class="dashboard-panel__kicker">Tendencias</div>
                        <h2 class="dashboard-panel__title">Facturacion y recaudo</h2>
                    </div>
                </div>
                <div class="dashboard-trends" id="billingTrendsContainer"></div>
            </article>
        </section>
    </div>

    <div class="dashboard-tab-panel" data-dashboard-panel="taxes" hidden>
        <div id="taxesStatusBanner" class="dashboard-status" role="status" aria-live="polite"></div>

        <section class="dashboard-grid">
            <article class="dashboard-panel dashboard-panel--full">
                <div class="dashboard-panel__header">
                    <div>
                        <div class="dashboard-panel__kicker">Impuestos</div>
                        <h2 class="dashboard-panel__title">Retefuente</h2>
                        <p class="dashboard-panel__description" id="taxesReteFuenteDescription"></p>
                    </div>
                </div>
                <div class="dashboard-metric-grid" id="taxesReteFuenteContainer"></div>
                <div class="dashboard-table-meta">
                    <span id="taxesExpenseResultsCount">Mostrando 0 registros</span>
                </div>
                <div class="dashboard-table-wrap dashboard-table-wrap--tall">
                    <table class="table dashboard-table">
                        <thead>
                            <tr>
                                <th>Fecha pago</th>
                                <th class="text-end">Valor pago</th>
                                <th class="text-end">Retefuente</th>
                                <th>Receptor</th>
                                <th>NIT receptor</th>
                                <th class="text-end">Cloud</th>
                                <th class="text-end">Copiers</th>
                            </tr>
                        </thead>
                        <tbody id="taxesExpenseBody"></tbody>
                    </table>
                </div>
            </article>

            <article class="dashboard-panel dashboard-panel--full">
                <div class="dashboard-panel__header">
                    <div>
                        <div class="dashboard-panel__kicker">Impuestos</div>
                        <h2 class="dashboard-panel__title">Rete IVA</h2>
                        <p class="dashboard-panel__description" id="taxesReteIvaDescription"></p>
                    </div>
                </div>
                <div class="dashboard-metric-grid" id="taxesReteIvaContainer"></div>
            </article>

            <article class="dashboard-panel dashboard-panel--full">
                <div class="dashboard-panel__header">
                    <div>
                        <div class="dashboard-panel__kicker">Impuestos</div>
                        <h2 class="dashboard-panel__title">Rete ICA</h2>
                        <p class="dashboard-panel__description" id="taxesReteIcaDescription"></p>
                    </div>
                </div>
                <div class="dashboard-metric-grid" id="taxesReteIcaContainer"></div>
            </article>
        </section>
    </div>

    <div class="dashboard-tab-panel" data-dashboard-panel="copiers" hidden>
        <section class="dashboard-toolbar dashboard-toolbar--static">
            <div class="dashboard-toolbar__summary">
                <span class="dashboard-toolbar__summary-label">Corte actual</span>
                <strong id="copiersAsOfLabel">Cargando...</strong>
                <span id="copiersFocusLabel">Ordenado por dia de facturacion</span>
            </div>
            <div class="dashboard-toolbar__actions">
                <button type="button" class="btn btn-primary dashboard-refresh-btn" id="copiersRefreshBtn">Actualizar</button>
            </div>
        </section>

        <div id="copiersStatusBanner" class="dashboard-status" role="status" aria-live="polite"></div>

        <section class="dashboard-kpis dashboard-kpis--portfolio" id="copiersKpisContainer"></section>

        <section class="dashboard-grid">
            <article class="dashboard-panel dashboard-panel--full">
                <div class="dashboard-panel__header">
                    <div>
                        <div class="dashboard-panel__kicker">Copiers</div>
                        <h2 class="dashboard-panel__title">Facturaci&oacute;n Copiers</h2>
                        <p class="dashboard-panel__description">Vista operativa de la tabla <span class="dashboard-highlight">cr07a_productoscopiers</span>.</p>
                    </div>
                </div>
                <div class="dashboard-table-meta">
                    <span id="copiersResultsCount">Mostrando 0 registros</span>
                </div>
                <div class="dashboard-table-wrap dashboard-table-wrap--tall">
                    <table class="table dashboard-table">
                        <thead>
                            <tr>
                                <th>Dia fact.</th>
                                <th>Cliente</th>
                                <th>Producto</th>
                                <th class="text-end">Cantidad</th>
                                <th class="text-end">Oper. incluidas</th>
                                <th class="text-end">Valor unit. antes IVA</th>
                                <th class="text-end">Valor unit. con IVA</th>
                                <th class="text-end">Total con IVA</th>
                            </tr>
                        </thead>
                        <tbody id="copiersBillingBody"></tbody>
                    </table>
                </div>
            </article>
        </section>
    </div>

    <div class="dashboard-tab-panel" data-dashboard-panel="portfolio" hidden>
        <section class="dashboard-toolbar dashboard-toolbar--static">
            <div class="dashboard-toolbar__summary">
                <span class="dashboard-toolbar__summary-label">Corte actual</span>
                <strong id="portfolioAsOfLabel">Cargando...</strong>
                <span id="portfolioFocusLabel">Facturas vencidas sin pago</span>
            </div>
            <div class="dashboard-toolbar__actions">
                <button type="button" class="btn btn-primary dashboard-refresh-btn" id="portfolioRefreshBtn">Actualizar</button>
            </div>
        </section>

        <div id="portfolioStatusBanner" class="dashboard-status" role="status" aria-live="polite"></div>

        <section class="dashboard-kpis dashboard-kpis--portfolio" id="portfolioKpisContainer"></section>

        <section class="dashboard-grid">
            <article class="dashboard-panel dashboard-panel--full">
                <div class="dashboard-panel__header">
                    <div>
                        <div class="dashboard-panel__kicker">Pendientes</div>
                        <h2 class="dashboard-panel__title">Facturas vencidas sin pago</h2>
                    </div>
                    <div class="dashboard-panel__actions dashboard-panel__actions--table">
                        <label class="dashboard-search" for="portfolioClientSearch">
                            <span class="dashboard-search__label">Cliente</span>
                            <input type="search"
                                   id="portfolioClientSearch"
                                   class="form-control dashboard-search__input"
                                   placeholder="Buscar cliente..." />
                        </label>
                        <label class="dashboard-filter dashboard-filter--compact" for="portfolioSortFilter">
                            <span class="dashboard-filter__label">Ordenar por</span>
                            <select id="portfolioSortFilter" class="form-select dashboard-select dashboard-select--compact">
                                <option value="age">Mayor antiguedad</option>
                                <option value="value">Mayor valor</option>
                            </select>
                        </label>
                    </div>
                </div>
                <div class="dashboard-table-meta">
                    <span id="portfolioResultsCount">Mostrando 0 registros</span>
                </div>
                <div class="dashboard-table-wrap dashboard-table-wrap--tall">
                    <table class="table dashboard-table">
                        <thead>
                            <tr>
                                <th>Factura</th>
                                <th>Cliente</th>
                                <th>Vertical</th>
                                <th>Contrato</th>
                                <th>Vencimiento</th>
                                <th>Dias vencida</th>
                                <th class="text-end">Valor</th>
                            </tr>
                        </thead>
                        <tbody id="portfolioUnpaidBody"></tbody>
                    </table>
                </div>
            </article>
        </section>
    </div>

    <div class="dashboard-tab-panel" data-dashboard-panel="pnl" hidden>
        <section class="dashboard-toolbar dashboard-toolbar--static">
            <div class="dashboard-filters">
                <div class="dashboard-filter">
                    <label class="dashboard-filter__label" for="pnlYearFilter">A&ntilde;o</label>
                    <select id="pnlYearFilter" class="form-select dashboard-select"></select>
                </div>
                <div class="dashboard-filter">
                    <label class="dashboard-filter__label" for="pnlMonthFilter">Corte por mes</label>
                    <select id="pnlMonthFilter" class="form-select dashboard-select"></select>
                </div>
                <div class="dashboard-filter">
                    <label class="dashboard-filter__label" for="pnlVerticalFilter">Vertical</label>
                    <select id="pnlVerticalFilter" class="form-select dashboard-select">
                        <option value="all">Consolidado</option>
                        <option value="cloud">Cloud</option>
                        <option value="copiers">Copiers</option>
                    </select>
                </div>
            </div>
            <div class="dashboard-toolbar__actions">
                <div class="dashboard-toolbar__summary">
                    <span class="dashboard-toolbar__summary-label">Corte activo</span>
                    <strong id="pnlPeriodLabel">Cargando...</strong>
                    <span id="pnlDateRangeLabel">-</span>
                </div>
                <button type="button" class="btn btn-primary dashboard-refresh-btn" id="pnlRefreshBtn">Actualizar</button>
            </div>
        </section>

        <div id="pnlStatusBanner" class="dashboard-status" role="status" aria-live="polite"></div>

        <section class="dashboard-kpis dashboard-kpis--pnl" id="pnlKpisContainer"></section>

        <section class="dashboard-grid">
            <article class="dashboard-panel dashboard-panel--full">
                <div class="dashboard-panel__header">
                    <div>
                        <div class="dashboard-panel__kicker">P&amp;L</div>
                        <h2 class="dashboard-panel__title">Profit &amp; Loss mensual</h2>
                        <p class="dashboard-panel__description" id="pnlDescription"></p>
                    </div>
                </div>
                <div class="dashboard-table-wrap">
                    <div id="pnlTableContainer"></div>
                </div>
            </article>
            <article class="dashboard-panel dashboard-panel--full">
                <div class="dashboard-panel__header">
                    <div>
                        <div class="dashboard-panel__kicker">Calidad de datos</div>
                        <h2 class="dashboard-panel__title">Registros huerfanos por mes</h2>
                        <p class="dashboard-panel__description" id="pnlOrphanDescription"></p>
                    </div>
                </div>
                <div class="dashboard-table-wrap">
                    <div id="pnlOrphanTableContainer"></div>
                </div>
            </article>
        </section>
    </div>
</div>

<div class="dashboard-modal" id="pnlDetailModal" hidden>
    <div class="dashboard-modal__backdrop" data-pnl-detail-close></div>
    <div class="dashboard-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="pnlDetailTitle">
        <div class="dashboard-modal__header">
            <div>
                <div class="dashboard-panel__kicker">Detalle P&amp;L</div>
                <h2 class="dashboard-modal__title" id="pnlDetailTitle">Detalle de la celda</h2>
                <p class="dashboard-modal__subtitle" id="pnlDetailSubtitle">Selecciona una celda del P&amp;L para ver su composici&oacute;n.</p>
            </div>
            <button type="button" class="btn btn-outline-secondary" id="pnlDetailCloseBtn">Cerrar</button>
        </div>

        <div id="pnlDetailStatus" class="dashboard-status" role="status" aria-live="polite"></div>

        <div class="dashboard-table-wrap dashboard-table-wrap--tall">
            <table class="table dashboard-table dashboard-pnl-detail-table">
                <thead>
                    <tr>
                        <th>Origen</th>
                        <th>Documento</th>
                        <th>Fecha</th>
                        <th>Detalle</th>
                        <th>Vertical</th>
                        <th>Categoria</th>
                        <th class="text-end">Total factura</th>
                        <th class="text-end">IVA</th>
                        <th class="text-end">Base</th>
                        <th class="text-end">Valor pago</th>
                        <th class="text-end">Cloud</th>
                        <th class="text-end">Copiers</th>
                        <th class="text-end">Valor celda</th>
                        <th>Acci&oacute;n</th>
                    </tr>
                </thead>
                <tbody id="pnlDetailBody">
                    <tr>
                        <td colspan="14" class="dashboard-table__empty">Selecciona una celda del P&amp;L para ver el detalle.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
