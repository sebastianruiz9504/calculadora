@model DashboardPageViewModel
@{
    ViewData["Title"] = "Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/support-cloud.css" asp-append-version="true" />
}

<div class="dashboard-shell"
     id="billingDashboardApp"
     data-billing-url="@Url.Action("Billing", "Dashboard")"
     data-billing-client-report-url="@Url.Action("BillingClientReport", "Dashboard")"
     data-billing-client-report-export-url="@Url.Action("BillingClientReportExport", "Dashboard")"
     data-siigo-customers-url="@Url.Action("SiigoCustomers", "Dashboard")"
     data-siigo-customer-search-url="@Url.Action("SiigoCustomerSearch", "Dashboard")"
     data-siigo-invoices-url="@Url.Action("SiigoInvoices", "Dashboard")"
     data-siigo-invoices-download-url="@Url.Action("SiigoInvoicesDownload", "Dashboard")"
     data-copiers-url="@Url.Action("Copiers", "Dashboard")"
     data-copiers-client-invoices-url="@Url.Action("CopiersClientInvoices", "Dashboard")"
     data-copiers-save-url="@Url.Action("CopiersRecord", "Dashboard")"
     data-copiers-equipment-url="@Url.Action("CopiersEquipment", "Dashboard")"
     data-copiers-equipment-detail-url="@Url.Action("CopiersEquipmentDetail", "Dashboard")"
     data-copiers-equipment-assignment-url="@Url.Action("CopiersEquipmentAssignment", "Dashboard")"
     data-copiers-maintenance-file-url="@Url.Action("CopiersMaintenanceAttachment", "Dashboard")"
     data-copiers-client-search-url="@Url.Action("CopiersClientSearch", "Dashboard")"
     data-copiers-product-search-url="@Url.Action("CopiersProductSearch", "Dashboard")"
     data-taxes-url="@Url.Action("Taxes", "Dashboard")"
     data-taxes-retentions-export-url="@Url.Action("TaxesRetentionsExport", "Dashboard")"
     data-portfolio-url="@Url.Action("Portfolio", "Dashboard")"
     data-pnl-url="@Url.Action("Pnl", "Dashboard")"
     data-pnl-detail-url="@Url.Action("PnlDetail", "Dashboard")"
     data-pnl-detail-update-url="@Url.Action("PnlDetailRecord", "Dashboard")"
     data-initial-year="@Model.InitialYear"
     data-initial-period="@Model.InitialPeriodKind.ToKey()"
     data-initial-value="@Model.InitialPeriodValue">
    <section class="dashboard-hero">
        <div class="dashboard-hero__content">
            <h1 class="dashboard-title">Dashboard Financiero</h1>
        </div>
    </section>

    <section class="dashboard-tabs" aria-label="Secciones del dashboard">
        <button type="button" class="dashboard-tab is-active" data-dashboard-tab="billing">Facturaci&oacute;n</button>
        <button type="button" class="dashboard-tab" data-dashboard-tab="copiers">Copiers</button>
        <button type="button" class="dashboard-tab" data-dashboard-tab="support-cloud">Soporte cloud</button>
        <button type="button" class="dashboard-tab" data-dashboard-tab="taxes">Impuestos</button>
        <button type="button" class="dashboard-tab" data-dashboard-tab="portfolio">Cartera</button>
        <button type="button" class="dashboard-tab" data-dashboard-tab="pnl">P&amp;L</button>
    </section>

    <section class="dashboard-toolbar" id="dashboardPeriodScope">
        <div class="dashboard-filters">
            <div class="dashboard-filter">
                <label class="dashboard-filter__label" for="dashboardYearFilter">A&ntilde;o</label>
                <select id="dashboardYearFilter" class="form-select dashboard-select"></select>
            </div>
            <div class="dashboard-filter">
                <label class="dashboard-filter__label" for="dashboardPeriodFilter">Periodo</label>
                <select id="dashboardPeriodFilter" class="form-select dashboard-select">
                    <option value="month">Mes</option>
                    <option value="bimonthly">Bimensual</option>
                    <option value="quarter">Trimestre</option>
                    <option value="semester">Semestre</option>
                    <option value="year">Anual</option>
                </select>
            </div>
            <div class="dashboard-filter">
                <label class="dashboard-filter__label" for="dashboardValueFilter">Detalle</label>
                <select id="dashboardValueFilter" class="form-select dashboard-select"></select>
            </div>
        </div>
        <div class="dashboard-toolbar__actions">
            <div class="dashboard-toolbar__summary">
                <span class="dashboard-toolbar__summary-label">Periodo activo</span>
                <strong id="dashboardPeriodLabel">Cargando...</strong>
                <span id="dashboardDateRangeLabel">-</span>
            </div>
            <button type="button" class="btn btn-primary dashboard-refresh-btn" id="dashboardRefreshBtn">Actualizar</button>
        </div>
    </section>

    <div class="dashboard-tab-panel is-active" data-dashboard-panel="billing">
        <div id="dashboardStatusBanner" class="dashboard-status" role="status" aria-live="polite"></div>

        <section class="dashboard-kpis dashboard-kpis--billing" id="billingKpisContainer"></section>

        <section class="dashboard-grid">
            <article class="dashboard-panel dashboard-panel--full">
                <div class="dashboard-panel__header">
                    <div>
                        <div class="dashboard-panel__kicker">Tendencias</div>
                        <h2 class="dashboard-panel__title">Facturacion y recaudo</h2>
                    </div>
                </div>
                <div class="dashboard-trends" id="billingTrendsContainer"></div>
            </article>

            <article class="dashboard-panel dashboard-panel--full">
                <div class="dashboard-panel__header">
                    <div>
                        <div class="dashboard-panel__kicker">Reportes</div>
                        <h2 class="dashboard-panel__title">Exportar facturas por cliente</h2>
                    </div>
                    <div class="dashboard-panel__actions dashboard-panel__actions--table">
                        <input type="hidden" id="billingReportClientIdInput" />
                        <label class="dashboard-search" for="billingReportClientSearch">
                            <span class="dashboard-search__label">Cliente</span>
                            <input type="search"
                                   id="billingReportClientSearch"
                                   class="form-control dashboard-search__input"
                                   list="billingReportClientOptions"
                                   autocomplete="off"
                                   placeholder="Buscar cliente..." />
                            <datalist id="billingReportClientOptions"></datalist>
                        </label>
                        <button type="button" class="btn btn-outline-secondary" id="billingReportLoadBtn">Consultar</button>
                        <button type="button" class="btn btn-primary" id="billingReportExportBtn" disabled>Exportar Excel</button>
                    </div>
                </div>

                <div id="billingReportStatus" class="dashboard-status" role="status" aria-live="polite"></div>

                <div class="dashboard-report-summary">
                    <div class="dashboard-report-summary__item">
                        <span>Cliente</span>
                        <strong id="billingReportClientReference">-</strong>
                    </div>
                    <div class="dashboard-report-summary__item">
                        <span>NIT empresa</span>
                        <strong id="billingReportNitReference">-</strong>
                    </div>
                    <div class="dashboard-report-summary__item">
                        <span>Facturas</span>
                        <strong id="billingReportResultsCount">0</strong>
                    </div>
                    <div class="dashboard-report-summary__item">
                        <span>Seleccionadas</span>
                        <strong id="billingReportSelectedCount">0</strong>
                    </div>
                    <div class="dashboard-report-summary__item">
                        <span>Total reporte</span>
                        <strong id="billingReportSelectedTotal">$0</strong>
                    </div>
                </div>

                <div class="dashboard-table-wrap dashboard-table-wrap--tall">
                    <table class="table dashboard-table dashboard-billing-report-table">
                        <thead>
                            <tr>
                                <th>Sel.</th>
                                <th>Factura</th>
                                <th>Fecha</th>
                                <th class="text-end">% IVA</th>
                                <th class="text-end">IVA valor</th>
                                <th class="text-end">Total factura</th>
                                <th class="text-end">Valor reporte</th>
                                <th>URL</th>
                            </tr>
                        </thead>
                        <tbody id="billingReportBody">
                            <tr>
                                <td colspan="8" class="dashboard-table__empty">Busca un cliente para ver sus facturas.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="dashboard-invoice-preview" id="billingReportPreview" hidden>
                    <div class="dashboard-invoice-preview__header">
                        <div>
                            <div class="dashboard-panel__kicker">Vista previa</div>
                            <strong id="billingReportPreviewTitle">Factura</strong>
                        </div>
                        <a href="#" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary" id="billingReportPreviewLink">Abrir factura</a>
                    </div>
                    <iframe id="billingReportPreviewFrame" title="Vista previa factura"></iframe>
                </div>
            </article>

            <article class="dashboard-panel dashboard-panel--full">
                <div class="dashboard-panel__header">
                    <div>
                        <div class="dashboard-panel__kicker">Siigo API</div>
                        <h2 class="dashboard-panel__title">Descargar facturas desde Siigo</h2>
                    </div>
                    <div class="dashboard-panel__actions dashboard-panel__actions--table">
                        <input type="hidden" id="siigoCustomerIdInput" />
                        <label class="dashboard-search dashboard-search--customer" for="siigoCustomerSelect">
                            <span class="dashboard-search__label">Cliente Siigo</span>
                            <select id="siigoCustomerSelect" class="form-select dashboard-search__input" disabled>
                                <option value="">Consulta clientes en Siigo...</option>
                            </select>
                        </label>
                        <button type="button" class="btn btn-outline-secondary" id="siigoCustomersLoadBtn">Consultar clientes</button>
                        <label class="dashboard-search dashboard-search--nit" for="siigoCustomerNitSearch">
                            <span class="dashboard-search__label">Buscar NIT</span>
                            <input type="search"
                                   id="siigoCustomerNitSearch"
                                   class="form-control dashboard-search__input"
                                   autocomplete="off"
                                   inputmode="numeric"
                                   pattern="[0-9.\-\s]*"
                                   placeholder="Ej. 900300358" />
                        </label>
                        <button type="button" class="btn btn-outline-secondary" id="siigoCustomerNitSearchBtn">Buscar NIT</button>
                        <label class="dashboard-search dashboard-search--date" for="siigoStartDateInput">
                            <span class="dashboard-search__label">Desde</span>
                            <input type="date" id="siigoStartDateInput" class="form-control dashboard-search__input" />
                        </label>
                        <label class="dashboard-search dashboard-search--date" for="siigoEndDateInput">
                            <span class="dashboard-search__label">Hasta</span>
                            <input type="date" id="siigoEndDateInput" class="form-control dashboard-search__input" />
                        </label>
                        <button type="button" class="btn btn-outline-secondary" id="siigoUseActivePeriodBtn">Periodo activo</button>
                        <button type="button" class="btn btn-outline-secondary" id="siigoInvoicesLoadBtn">Consultar</button>
                        <button type="button" class="btn btn-primary" id="siigoInvoicesDownloadBtn" disabled>Descargar PDFs</button>
                    </div>
                </div>

                <div id="siigoInvoicesStatus" class="dashboard-status" role="status" aria-live="polite"></div>

                <div class="dashboard-report-summary">
                    <div class="dashboard-report-summary__item">
                        <span>Cliente</span>
                        <strong id="siigoCustomerReference">-</strong>
                    </div>
                    <div class="dashboard-report-summary__item">
                        <span>NIT</span>
                        <strong id="siigoNitReference">-</strong>
                    </div>
                    <div class="dashboard-report-summary__item">
                        <span>Periodo</span>
                        <strong id="siigoPeriodReference">-</strong>
                    </div>
                    <div class="dashboard-report-summary__item">
                        <span>Facturas</span>
                        <strong id="siigoInvoicesResultsCount">0</strong>
                    </div>
                    <div class="dashboard-report-summary__item">
                        <span>Seleccionadas</span>
                        <strong id="siigoInvoicesSelectedCount">0</strong>
                    </div>
                    <div class="dashboard-report-summary__item">
                        <span>Total</span>
                        <strong id="siigoInvoicesTotalAmount">$0</strong>
                    </div>
                </div>

                <div class="dashboard-table-wrap dashboard-table-wrap--tall">
                    <table class="table dashboard-table dashboard-siigo-table">
                        <thead>
                            <tr>
                                <th>
                                    <input type="checkbox" class="form-check-input" id="siigoInvoicesSelectAll" aria-label="Seleccionar facturas Siigo" />
                                </th>
                                <th>Factura</th>
                                <th>Fecha</th>
                                <th>NIT</th>
                                <th>Estado</th>
                                <th class="text-end">Total</th>
                                <th class="text-end">Saldo</th>
                            </tr>
                        </thead>
                        <tbody id="siigoInvoicesBody">
                            <tr>
                                <td colspan="7" class="dashboard-table__empty">Busca un cliente y consulta sus facturas de Siigo.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </article>
        </section>
    </div>

    <div class="dashboard-tab-panel" data-dashboard-panel="support-cloud" hidden>
        <div class="support-cloud-dashboard"
             id="dashboardSupportCloudApp"
             data-load-url="@Url.Action("SupportCloud", "Dashboard")"
             data-client-search-url="@Url.Action("SupportCloudClientSearch", "Dashboard")"
             data-save-url="@Url.Action("SupportCloudTicket", "Dashboard")"
             data-upload-url="@Url.Action("SupportCloudUploadFile", "Dashboard")"
             data-download-url="@Url.Action("SupportCloudDownloadFile", "Dashboard")"
             data-initial-start-date="@Model.InitialSupportStartDate"
             data-initial-end-date="@Model.InitialSupportEndDate"
             data-current-user-name="@(!string.IsNullOrWhiteSpace(Model.CurrentUser.DisplayName) ? Model.CurrentUser.DisplayName : Model.CurrentUser.Email)"
             data-show-charts="true">
            <section class="support-cloud-card">
                <div class="support-cloud-toolbar">
                    <div class="support-cloud-toolbar__filters">
                        <label class="support-cloud-field">
                            <span class="support-cloud-field__label">Desde</span>
                            <input type="date" class="form-control" data-sc-start-date />
                        </label>
                        <label class="support-cloud-field">
                            <span class="support-cloud-field__label">Hasta</span>
                            <input type="date" class="form-control" data-sc-end-date />
                        </label>
                    </div>
                    <div class="support-cloud-toolbar__actions">
                        <div class="support-cloud-toolbar__summary">
                            <span class="support-cloud-toolbar__summary-label">Rango activo</span>
                            <strong data-sc-range-label>@Model.InitialSupportStartDate - @Model.InitialSupportEndDate</strong>
                        </div>
                        <div class="support-cloud-toolbar__buttons">
                            <button type="button" class="btn btn-outline-secondary" data-sc-refresh>Actualizar</button>
                            <button type="button" class="btn btn-primary" data-sc-new-ticket>Nuevo ticket</button>
                        </div>
                    </div>
                </div>
            </section>

            <div class="support-cloud-status" data-sc-status role="status" aria-live="polite"></div>

            <section class="support-cloud-summary">
                <article class="support-cloud-summary__card">
                    <span class="support-cloud-summary__label">Total tickets</span>
                    <strong class="support-cloud-summary__value" data-sc-total-tickets>0</strong>
                </article>
                <article class="support-cloud-summary__card">
                    <span class="support-cloud-summary__label">Horas tomadas</span>
                    <strong class="support-cloud-summary__value" data-sc-total-hours>0</strong>
                </article>
                <article class="support-cloud-summary__card">
                    <span class="support-cloud-summary__label">Creadores activos</span>
                    <strong class="support-cloud-summary__value" data-sc-total-creators>0</strong>
                </article>
                <article class="support-cloud-summary__card">
                    <span class="support-cloud-summary__label">Clientes impactados</span>
                    <strong class="support-cloud-summary__value" data-sc-total-clients>0</strong>
                </article>
            </section>

            <section class="support-cloud-card">
                <div class="support-cloud-section-header">
                    <div>
                        <div class="support-cloud-kicker">Gerencial</div>
                        <h2 class="support-cloud-section-title">Total por creador</h2>
                        <p class="support-cloud-section-subtitle">
                            Distribuci&oacute;n de tickets y horas por usuario creador.
                        </p>
                    </div>
                </div>
                <div class="support-cloud-creators" data-sc-creators></div>
            </section>

            <section class="support-cloud-chart-grid" data-sc-charts-section>
                <article class="support-cloud-card">
                    <div class="support-cloud-section-header">
                        <div>
                            <div class="support-cloud-kicker">Distribuci&oacute;n</div>
                            <h2 class="support-cloud-section-title">Tickets por tipo</h2>
                        </div>
                    </div>
                    <div class="support-cloud-breakdown" data-sc-chart="type"></div>
                </article>

                <article class="support-cloud-card">
                    <div class="support-cloud-section-header">
                        <div>
                            <div class="support-cloud-kicker">Distribuci&oacute;n</div>
                            <h2 class="support-cloud-section-title">Tickets por m&eacute;todo</h2>
                        </div>
                    </div>
                    <div class="support-cloud-breakdown" data-sc-chart="method"></div>
                </article>

                <article class="support-cloud-card">
                    <div class="support-cloud-section-header">
                        <div>
                            <div class="support-cloud-kicker">Distribuci&oacute;n</div>
                            <h2 class="support-cloud-section-title">Tickets por categor&iacute;a</h2>
                        </div>
                    </div>
                    <div class="support-cloud-breakdown" data-sc-chart="category"></div>
                </article>
            </section>

            <section class="support-cloud-card">
                <div class="support-cloud-section-header">
                    <div>
                        <div class="support-cloud-kicker">Tabla</div>
                        <h2 class="support-cloud-section-title">Tickets registrados</h2>
                        <p class="support-cloud-section-subtitle">
                            Vista resumida para seguimiento gerencial. Abre un ticket para consultar todos los campos y su adjunto.
                        </p>
                    </div>
                    <div class="support-cloud-counter" data-sc-records-count>0 tickets</div>
                </div>

                <div class="support-cloud-table-wrap">
                    <table class="table align-middle support-cloud-table">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Ticket</th>
                                <th>Cliente</th>
                                <th>Estado</th>
                                <th>Tipo</th>
                                <th>Creador</th>
                                <th class="text-end">Horas</th>
                                <th>Adjunto</th>
                            </tr>
                        </thead>
                        <tbody data-sc-rows></tbody>
                    </table>
                </div>

                <div class="support-cloud-empty" data-sc-empty hidden>
                    No hay tickets de soporte cloud en el rango seleccionado.
                </div>
            </section>

            <div class="support-cloud-modal" data-sc-modal hidden>
                <div class="support-cloud-modal__backdrop" data-sc-close-modal></div>
                <div class="support-cloud-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="dashboardSupportCloudModalTitle">
                    <div class="support-cloud-modal__header">
                        <div>
                            <div class="support-cloud-kicker">Formulario</div>
                            <h2 class="support-cloud-modal__title" id="dashboardSupportCloudModalTitle" data-sc-modal-title>Ticket de soporte cloud</h2>
                            <p class="support-cloud-modal__subtitle" data-sc-modal-subtitle>Completa todos los campos del ticket.</p>
                        </div>
                        <button type="button" class="btn btn-outline-secondary" data-sc-close-modal>Cerrar</button>
                    </div>

                    <div class="support-cloud-status" data-sc-modal-status role="status" aria-live="polite"></div>

                    <form class="support-cloud-form" data-sc-form>
                        <input type="hidden" data-sc-record-id />
                        <input type="hidden" data-sc-client-id />

                        <div class="support-cloud-form__grid">
                            <label class="support-cloud-form__field support-cloud-form__field--span-2">
                                <span class="support-cloud-form__label">Titulo del ticket</span>
                                <input type="text" class="form-control" data-sc-field="title" />
                            </label>

                            <label class="support-cloud-form__field support-cloud-form__field--span-2">
                                <span class="support-cloud-form__label">Descripcion</span>
                                <textarea class="form-control support-cloud-form__textarea" rows="4" data-sc-field="description"></textarea>
                            </label>

                            <label class="support-cloud-form__field">
                                <span class="support-cloud-form__label">Fecha de creacion</span>
                                <input type="date" class="form-control" data-sc-field="creationDate" />
                            </label>

                            <label class="support-cloud-form__field">
                                <span class="support-cloud-form__label">Estado</span>
                                <select class="form-select" data-sc-field="state"></select>
                            </label>

                            <label class="support-cloud-form__field">
                                <span class="support-cloud-form__label">Tipo</span>
                                <select class="form-select" data-sc-field="type"></select>
                            </label>

                            <label class="support-cloud-form__field">
                                <span class="support-cloud-form__label">Categoria</span>
                                <select class="form-select" data-sc-field="category"></select>
                            </label>

                            <label class="support-cloud-form__field support-cloud-form__field--span-2">
                                <span class="support-cloud-form__label">Cliente</span>
                                <input type="text" class="form-control" list="supportCloudClientOptionsDashboard" autocomplete="off" data-sc-field="clientName" />
                                <datalist id="supportCloudClientOptionsDashboard" data-sc-client-options></datalist>
                                <span class="support-cloud-form__hint">Escribe al menos 2 caracteres y selecciona una coincidencia.</span>
                            </label>

                            <label class="support-cloud-form__field">
                                <span class="support-cloud-form__label">Creador</span>
                                <input type="text" class="form-control support-cloud-form__readonly" data-sc-field="creatorName" readonly />
                            </label>

                            <label class="support-cloud-form__field">
                                <span class="support-cloud-form__label">Horas tomadas</span>
                                <input type="number" min="0" step="0.01" class="form-control" data-sc-field="hoursTaken" />
                            </label>

                            <label class="support-cloud-form__field">
                                <span class="support-cloud-form__label">Metodo</span>
                                <select class="form-select" data-sc-field="method"></select>
                            </label>

                            <label class="support-cloud-form__field support-cloud-form__field--span-2">
                                <span class="support-cloud-form__label">Solucion</span>
                                <textarea class="form-control support-cloud-form__textarea" rows="4" data-sc-field="solution"></textarea>
                            </label>

                            <div class="support-cloud-form__field support-cloud-form__field--span-2">
                                <span class="support-cloud-form__label">Adjunto</span>
                                <div class="support-cloud-file-card">
                                    <div>
                                        <div class="support-cloud-file-card__title" data-sc-attachment-name>Sin adjunto cargado</div>
                                        <div class="support-cloud-file-card__hint" data-sc-attachment-hint>
                                            Guarda el ticket y adjunta el soporte en PDF, imagen o Word.
                                        </div>
                                    </div>
                                    <div class="support-cloud-file-card__actions">
                                        <a class="support-cloud-file-card__link is-disabled" href="#" target="_blank" rel="noopener" data-sc-download-link>Descargar</a>
                                        <input type="file" class="form-control" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx" data-sc-attachment-input />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="support-cloud-modal__footer">
                            <div class="support-cloud-modal__meta" data-sc-modal-meta>Nuevo ticket</div>
                            <div class="support-cloud-modal__actions">
                                <button type="button" class="btn btn-outline-secondary" data-sc-close-modal>Cancelar</button>
                                <button type="submit" class="btn btn-primary" data-sc-save-ticket>Guardar</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="dashboard-tab-panel" data-dashboard-panel="taxes" hidden>
        <div id="taxesStatusBanner" class="dashboard-status" role="status" aria-live="polite"></div>

        <section class="dashboard-grid">
            <article class="dashboard-panel dashboard-panel--full">
                <div class="dashboard-panel__header">
                    <div>
                        <div class="dashboard-panel__kicker">Impuestos</div>
                        <h2 class="dashboard-panel__title">Impuesto de Retefuente mensual</h2>
                        <p class="dashboard-panel__description" id="taxesReteFuenteDescription"></p>
                    </div>
                    <div class="dashboard-panel__actions">
