@model EmployeeModulePermissionsPageViewModel
@{
    ViewData["Title"] = "Permisos";
}

@section Styles {
    <link rel="stylesheet" href="~/css/permissions.css" asp-append-version="true" />
}

<div class="permissions-shell"
     id="permissionsApp"
     data-save-url="@Url.Action("Save", "Permissions")">
    <section class="permissions-hero">
        <div>
            <div class="permissions-kicker">Control de acceso</div>
            <h1 class="permissions-title">Permisos</h1>
            <p class="permissions-subtitle">
                Selecciona un empleado para editar sus modulos habilitados.
            </p>
        </div>
        <div class="permissions-user-pill">
            <span class="permissions-user-pill__label">Administrador</span>
            <span>@Model.CurrentUser.Email</span>
        </div>
    </section>

    <section class="permissions-panel">
        <div class="permissions-toolbar">
            <div>
                <div class="permissions-kicker">Empleados</div>
                <h2 class="permissions-section-title">Lista de permisos</h2>
                <p class="permissions-section-subtitle">
                    La lista muestra solo nombre y correo. Abre cualquier empleado para asignar uno o varios modulos.
                </p>
            </div>
            <button type="button"
                    class="btn btn-primary permissions-save-btn permissions-save-action"
                    id="savePermissionsBtn"
                    @(Model.Employees.Count == 0 ? "disabled" : null)>
                Guardar cambios
            </button>
        </div>

        <div id="permissionsStatus" class="permissions-status" role="status" aria-live="polite"></div>

        @if (Model.Employees.Count == 0)
        {
            <div class="permissions-empty">No hay empleados disponibles para editar permisos.</div>
        }
        else
        {
            <div class="permissions-employee-list" role="list">
                @for (var employeeIndex = 0; employeeIndex < Model.Employees.Count; employeeIndex++)
                {
                    var employee = Model.Employees[employeeIndex];
                    var panelId = $"permissionsEmployeePanel_{employeeIndex}";
                    var employeeName = string.IsNullOrWhiteSpace(employee.EmployeeName)
                        ? "Empleado sin nombre"
                        : employee.EmployeeName;
                    var email = string.IsNullOrWhiteSpace(employee.UserEmail)
                        ? "Sin correo asociado"
                        : employee.UserEmail;

                    <article class="permissions-employee-item"
                             data-employee-id="@employee.EmployeeId"
                             role="listitem">
                        <button type="button"
                                class="permissions-employee-trigger"
                                aria-expanded="false"
                                aria-controls="@panelId">
                            <span class="permissions-employee-copy">
                                <span class="permissions-employee-name">@employeeName</span>
                                <span class="permissions-employee-email">@email</span>
                            </span>
                            <span class="permissions-employee-chevron" aria-hidden="true"></span>
                        </button>

                        <div class="permissions-module-menu"
                             id="@panelId"
                             hidden>
                            <div class="permissions-module-menu__header">
                                <span>Modulos disponibles</span>
                                <small>Seleccion multiple</small>
                            </div>

                            <div class="permissions-module-grid">
                                @for (var moduleIndex = 0; moduleIndex < Model.Modules.Count; moduleIndex++)
                                {
                                    var module = Model.Modules[moduleIndex];
                                    var checkboxId = $"perm_{employeeIndex}_{moduleIndex}_{module.OptionValue}";

                                    <label class="permissions-module-option" for="@checkboxId">
                                        <input id="@checkboxId"
                                               class="permissions-module-checkbox"
                                               type="checkbox"
                                               value="@module.OptionValue"
                                               @(employee.ModuleOptionValues.Contains(module.OptionValue) ? "checked" : null) />
                                        <span class="permissions-module-box"></span>
                                        <span class="permissions-module-copy">
                                            <span class="permissions-module-name">@module.Label</span>
                                            <span class="permissions-module-category">@module.Category</span>
                                        </span>
                                    </label>
                                }
                            </div>

                            <div class="permissions-module-actions">
                                <button type="button" class="btn btn-primary permissions-save-btn permissions-save-action">
                                    Guardar cambios
                                </button>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </section>
</div>

@section Scripts {
    <script>
        (() => {
            const app = document.getElementById("permissionsApp");
            if (!app) {
                return;
            }

            const saveUrl = app.dataset.saveUrl || "";
            const saveButtons = Array.from(app.querySelectorAll(".permissions-save-action"));
            const status = document.getElementById("permissionsStatus");
            const employeeItems = Array.from(app.querySelectorAll(".permissions-employee-item"));

            const setStatus = (message, tone) => {
                if (!status) {
                    return;
                }

                status.textContent = message || "";
                status.className = "permissions-status";
                if (tone) {
                    status.classList.add(`is-${tone}`);
                }
                status.classList.toggle("show", Boolean(message));
            };

            const buildPayload = () => {
                const employees = employeeItems.map((item) => {
                    const employeeId = item.dataset.employeeId || "";
                    const moduleOptionValues = Array.from(item.querySelectorAll(".permissions-module-checkbox:checked"))
                        .map((checkbox) => Number.parseInt(checkbox.value, 10))
                        .filter((value) => Number.isInteger(value));

                    return {
                        employeeId,
                        moduleOptionValues
                    };
                });

                return { employees };
            };

            const setBusy = (isBusy) => {
                saveButtons.forEach((button) => {
                    button.disabled = isBusy;
                    button.textContent = isBusy ? "Guardando..." : "Guardar cambios";
                });
            };

            const closeEmployee = (item) => {
                const trigger = item.querySelector(".permissions-employee-trigger");
                const menu = item.querySelector(".permissions-module-menu");
                item.classList.remove("is-open");
                trigger?.setAttribute("aria-expanded", "false");
                if (menu) {
                    menu.hidden = true;
                }
            };

            const openEmployee = (item) => {
                employeeItems.forEach((candidate) => {
                    if (candidate !== item) {
                        closeEmployee(candidate);
                    }
                });

                const trigger = item.querySelector(".permissions-employee-trigger");
                const menu = item.querySelector(".permissions-module-menu");
                item.classList.add("is-open");
                trigger?.setAttribute("aria-expanded", "true");
                if (menu) {
                    menu.hidden = false;
                }
            };

            employeeItems.forEach((item) => {
                const trigger = item.querySelector(".permissions-employee-trigger");
                trigger?.addEventListener("click", () => {
                    if (item.classList.contains("is-open")) {
                        closeEmployee(item);
                        return;
                    }

                    openEmployee(item);
                });
            });

            const saveChanges = async () => {
                if (saveButtons.length === 0) {
                    return;
                }

                if (!saveUrl) {
                    setStatus("No se encontro la ruta para guardar permisos.", "error");
                    return;
                }

                setBusy(true);
                setStatus("Guardando cambios en Dataverse...", "info");

                try {
                    const response = await fetch(saveUrl, {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        body: JSON.stringify(buildPayload())
                    });

                    const payload = await response.json().catch(() => ({}));
                    if (!response.ok) {
                        throw new Error(payload.detail || payload.message || "No fue posible guardar los permisos.");
                    }

                    setStatus(payload.message || "Permisos guardados correctamente.", "success");
                } catch (error) {
                    setStatus(error instanceof Error ? error.message : "Ocurrio un error inesperado guardando permisos.", "error");
                } finally {
                    setBusy(false);
                }
            };

            saveButtons.forEach((button) => button.addEventListener("click", saveChanges));
        })();
    </script>
}
