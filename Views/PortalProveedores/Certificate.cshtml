@model SupplierCertificateDocumentViewModel
@{
    Layout = null;
    var culture = new System.Globalization.CultureInfo("es-CO");
    var includeReteFuente = Model.Certificate.CertificateTypes.Contains(SupplierCertificateType.ReteFuente);
    var includeReteIca = Model.Certificate.CertificateTypes.Contains(SupplierCertificateType.ReteIca);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Certificado proveedores - @Model.Certificate.SupplierName</title>
    <link rel="stylesheet" href="~/css/portal-proveedores-certificate.css" asp-append-version="true" />
</head>
<body>
    <div class="print-toolbar">
        <div class="print-toolbar__text">Vista A4 lista para imprimir o guardar como PDF.</div>
        <div class="print-toolbar__actions">
            <button type="button" onclick="window.print()">Guardar en PDF / Imprimir</button>
        </div>
    </div>

    <div class="certificate-wrap">
        <article class="certificate-sheet">
            <header class="certificate-header">
                <span class="certificate-kicker">Portal proveedores</span>
                <h1 class="certificate-title">Certificado de retenciones a proveedores</h1>
                <p class="certificate-subtitle">
                    Documento emitido por @Model.CompanyName para certificar las retenciones practicadas al proveedor
                    @Model.Certificate.SupplierName durante el periodo @Model.Certificate.PeriodLabel.
                </p>
            </header>

            <section class="certificate-body">
                <div class="certificate-grid">
                    <section class="certificate-panel">
                        <span class="certificate-panel__label">Agente retenedor</span>
                        <div class="certificate-panel__title">@Model.CompanyName</div>
                        <div class="certificate-panel__meta">
                            <div><strong>NIT:</strong> @Model.CompanyNit</div>
                            @if (!string.IsNullOrWhiteSpace(Model.CompanyAddress))
                            {
                                <div><strong>Dirección:</strong> @Model.CompanyAddress</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.CompanyCity))
                            {
                                <div><strong>Ciudad:</strong> @Model.CompanyCity</div>
                            }
                            <div><strong>Fecha de emisión:</strong> @Model.IssueDateDisplay</div>
                        </div>
                    </section>

                    <section class="certificate-panel">
                        <span class="certificate-panel__label">Proveedor certificado</span>
                        <div class="certificate-panel__title">@Model.Certificate.SupplierName</div>
                        <div class="certificate-panel__meta">
                            <div><strong>NIT:</strong> @Model.Certificate.SupplierNit</div>
                            <div><strong>Periodo consultado:</strong> @Model.Certificate.PeriodLabel</div>
                            <div><strong>Tipo de certificado:</strong> @Model.Certificate.CertificateTypesLabel</div>
                            <div><strong>Registros incluidos:</strong> @Model.Certificate.RecordsCount</div>
                        </div>
                    </section>
                </div>

                <section class="certificate-stats">
                    <article class="certificate-stat">
                        <span class="certificate-stat__label">Total facturas</span>
                        <div class="certificate-stat__value">@Model.Certificate.TotalInvoices.ToString("C2", culture)</div>
                        <div class="certificate-stat__meta">Suma de todas las filas en <code>cr07a_total</code>.</div>
                    </article>
                    <article class="certificate-stat">
                        <span class="certificate-stat__label">Total base</span>
                        <div class="certificate-stat__value">@Model.Certificate.TotalBase.ToString("C2", culture)</div>
                        <div class="certificate-stat__meta">Suma de todas las filas en <code>cr07a_totalantesdeiva</code>.</div>
                    </article>
                    @if (includeReteFuente)
                    {
                        <article class="certificate-stat">
                            <span class="certificate-stat__label">Total rete fuente</span>
                            <div class="certificate-stat__value">@Model.Certificate.TotalReteFuente.ToString("C2", culture)</div>
                            <div class="certificate-stat__meta">Valor total retenido por concepto de rete fuente.</div>
                        </article>
                    }
                    @if (includeReteIca)
                    {
                        <article class="certificate-stat">
                            <span class="certificate-stat__label">Total rete ICA</span>
                            <div class="certificate-stat__value">@Model.Certificate.TotalReteIca.ToString("C2", culture)</div>
                            <div class="certificate-stat__meta">Valor total retenido por concepto de rete ICA.</div>
                        </article>
                    }
                </section>

                <div class="certificate-note">
                    Este certificado consolida los pagos y retenciones identificados en Dataverse dentro del rango solicitado.
                    Su estructura fue diseñada siguiendo el enfoque formal que suelen usar los portales de proveedores en Colombia
                    y los datos mínimos exigidos para certificados de retención a terceros.
                </div>

                <div class="certificate-table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Proveedor</th>
                                <th>NIT</th>
                                <th class="text-end">Total facturas</th>
                                <th class="text-end">Total base</th>
                                @if (includeReteFuente)
                                {
                                    <th class="text-end">Rete fuente</th>
                                }
                                @if (includeReteIca)
                                {
                                    <th class="text-end">Rete ICA</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.Certificate.Records)
                            {
                                <tr>
                                    <td>@row.ExpenseDateDisplay</td>
                                    <td>@row.SupplierName</td>
                                    <td>@row.SupplierNit</td>
                                    <td class="text-end">@row.TotalInvoices.ToString("C2", culture)</td>
                                    <td class="text-end">@row.TotalBase.ToString("C2", culture)</td>
                                    @if (includeReteFuente)
                                    {
                                        <td class="text-end">@row.TotalReteFuente.ToString("C2", culture)</td>
                                    }
                                    @if (includeReteIca)
                                    {
                                        <td class="text-end">@row.TotalReteIca.ToString("C2", culture)</td>
                                    }
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="3" class="text-end">Totales</th>
                                <td class="text-end">@Model.Certificate.TotalInvoices.ToString("C2", culture)</td>
                                <td class="text-end">@Model.Certificate.TotalBase.ToString("C2", culture)</td>
                                @if (includeReteFuente)
                                {
                                    <td class="text-end">@Model.Certificate.TotalReteFuente.ToString("C2", culture)</td>
                                }
                                @if (includeReteIca)
                                {
                                    <td class="text-end">@Model.Certificate.TotalReteIca.ToString("C2", culture)</td>
                                }
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <div class="certificate-footer">
                    <div class="certificate-signature">
                        <div class="certificate-signature__line"></div>
                        <div class="certificate-signature__meta">
                            <div><strong>@Model.CompanyName</strong></div>
                            <div>NIT @Model.CompanyNit</div>
                            <div>Documento generado desde Portal proveedores</div>
                        </div>
                    </div>
                    <div class="certificate-small">
                        Emitido por <strong>@Model.CurrentUser.DisplayName</strong> (@Model.CurrentUser.Email).<br />
                        Certificado generado electrónicamente con la información disponible en Dataverse para el rango y proveedor seleccionados.
                    </div>
                </div>
            </section>
        </article>
    </div>

    @if (Model.AutoPrint)
    {
        <script>
            window.addEventListener("load", () => {
                window.setTimeout(() => window.print(), 350);
            });
        </script>
    }
</body>
</html>
