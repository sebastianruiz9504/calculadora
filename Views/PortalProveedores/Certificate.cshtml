@model SupplierCertificateDocumentViewModel
@{
    Layout = null;
    var culture = new System.Globalization.CultureInfo("es-CO");
    var includeReteFuente = Model.Certificate.CertificateTypes.Contains(SupplierCertificateType.ReteFuente);
    var includeReteIca = Model.Certificate.CertificateTypes.Contains(SupplierCertificateType.ReteIca);
    var titleSuffix = Model.Certificate.CertificateTypesLabel.ToUpperInvariant();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Certificado proveedores - @Model.Certificate.SupplierName</title>
    <link rel="stylesheet" href="~/css/portal-proveedores-certificate.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/font-weight-reset.css" asp-append-version="true" />
</head>
<body>
    <div class="print-toolbar">
        <div class="print-toolbar__text">Documento listo para imprimir o guardar como PDF.</div>
        <div class="print-toolbar__actions">
            <button type="button" onclick="window.print()">Guardar en PDF / Imprimir</button>
        </div>
    </div>

    <div class="certificate-wrap">
        <article class="certificate-sheet">
            <header class="certificate-letterhead">
                <div class="certificate-brand">
                    <div class="certificate-brand__mark">DT</div>
                    <div>
                        <div class="certificate-brand__name">@Model.CompanyName</div>
                        <div class="certificate-brand__meta">NIT @Model.CompanyNit</div>
                        @if (!string.IsNullOrWhiteSpace(Model.CompanyAddress) || !string.IsNullOrWhiteSpace(Model.CompanyCity))
                        {
                            <div class="certificate-brand__meta">
                                @if (!string.IsNullOrWhiteSpace(Model.CompanyAddress))
                                {
                                    <span>@Model.CompanyAddress</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.CompanyAddress) && !string.IsNullOrWhiteSpace(Model.CompanyCity))
                                {
                                    <span> · </span>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.CompanyCity))
                                {
                                    <span>@Model.CompanyCity</span>
                                }
                            </div>
                        }
                    </div>
                </div>
                <div class="certificate-letterhead__meta">
                    <div><strong>Fecha de emisión:</strong> @Model.IssueDateDisplay</div>
                    <div><strong>Periodo certificado:</strong> @Model.Certificate.PeriodLabel</div>
                </div>
            </header>

            <header class="certificate-header">
                <div class="certificate-kicker">Certificado tributario</div>
                <h1 class="certificate-title">Certificado de retenciones practicadas</h1>
                <div class="certificate-title__suffix">@titleSuffix</div>
                <p class="certificate-subtitle">
                    @Model.CompanyName, identificado con NIT @Model.CompanyNit, certifica que durante el periodo
                    comprendido entre @Model.Certificate.PeriodLabel practicó
                    retenciones al proveedor aquí identificado, de acuerdo con la información consolidada para el periodo seleccionado.
                </p>
            </header>

            <section class="certificate-body">
                <section class="certificate-parties">
                    <div class="certificate-parties__block">
                        <div class="certificate-parties__label">Agente retenedor</div>
                        <div class="certificate-parties__value">@Model.CompanyName</div>
                        <div class="certificate-parties__detail">NIT @Model.CompanyNit</div>
                    </div>
                    <div class="certificate-parties__block">
                        <div class="certificate-parties__label">Proveedor</div>
                        <div class="certificate-parties__value">@Model.Certificate.SupplierName</div>
                        <div class="certificate-parties__detail">NIT @Model.Certificate.SupplierNit</div>
                    </div>
                    <div class="certificate-parties__block">
                        <div class="certificate-parties__label">Tipos certificados</div>
                        <div class="certificate-parties__value">@Model.Certificate.CertificateTypesLabel</div>
                        <div class="certificate-parties__detail">@Model.Certificate.RecordsCount registros incluidos</div>
                    </div>
                </section>

                <section class="certificate-summary-table">
                    <table>
                        <tbody>
                            <tr>
                                <th>Concepto</th>
                                <th class="text-end">Valor</th>
                            </tr>
                            <tr>
                                <td>Total facturas</td>
                                <td class="text-end">@Model.Certificate.TotalInvoices.ToString("C2", culture)</td>
                            </tr>
                            <tr>
                                <td>Total base gravable</td>
                                <td class="text-end">@Model.Certificate.TotalBase.ToString("C2", culture)</td>
                            </tr>
                            @if (includeReteFuente)
                            {
                                <tr>
                                    <td>Total retención en la fuente</td>
                                    <td class="text-end">@Model.Certificate.TotalReteFuente.ToString("C2", culture)</td>
                                </tr>
                            }
                            @if (includeReteIca)
                            {
                                <tr>
                                    <td>Total retención ICA</td>
                                    <td class="text-end">@Model.Certificate.TotalReteIca.ToString("C2", culture)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </section>

                <div class="certificate-note">
                    La presente certificación se expide a solicitud de la parte interesada y deja constancia de los valores
                    acumulados en el periodo indicado, con base en los movimientos asociados al proveedor y consolidados para
                    el rango seleccionado.
                </div>

                <div class="certificate-table-wrap">
                    <div class="certificate-table-title">Relación de movimientos incluidos</div>
                    <table class="certificate-detail-table">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th class="text-end">Total facturas</th>
                                <th class="text-end">Total base</th>
                                @if (includeReteFuente)
                                {
                                    <th class="text-end">Rete fuente</th>
                                }
                                @if (includeReteIca)
                                {
                                    <th class="text-end">Rete ICA</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.Certificate.Records)
                            {
                                <tr>
                                    <td>@row.ExpenseDateDisplay</td>
                                    <td class="text-end">@row.TotalInvoices.ToString("C2", culture)</td>
                                    <td class="text-end">@row.TotalBase.ToString("C2", culture)</td>
                                    @if (includeReteFuente)
                                    {
                                        <td class="text-end">@row.TotalReteFuente.ToString("C2", culture)</td>
                                    }
                                    @if (includeReteIca)
                                    {
                                        <td class="text-end">@row.TotalReteIca.ToString("C2", culture)</td>
                                    }
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th class="text-end">Totales</th>
                                <td class="text-end">@Model.Certificate.TotalInvoices.ToString("C2", culture)</td>
                                <td class="text-end">@Model.Certificate.TotalBase.ToString("C2", culture)</td>
                                @if (includeReteFuente)
                                {
                                    <td class="text-end">@Model.Certificate.TotalReteFuente.ToString("C2", culture)</td>
                                }
                                @if (includeReteIca)
                                {
                                    <td class="text-end">@Model.Certificate.TotalReteIca.ToString("C2", culture)</td>
                                }
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <div class="certificate-closing">
                    Se firma electrónicamente para constancia, en la fecha indicada de emisión.
                </div>

                <div class="certificate-footer">
                    <div class="certificate-signature">
                        <div class="certificate-signature__line"></div>
                        <div class="certificate-signature__meta">
                            <div><strong>@Model.CompanyName</strong></div>
                            <div>NIT @Model.CompanyNit</div>
                            <div>Área administrativa y contable</div>
                        </div>
                    </div>
                    <div class="certificate-small">
                        Documento generado por <strong>@Model.CurrentUser.DisplayName</strong> (@Model.CurrentUser.Email).<br />
                        Certificado emitido electrónicamente desde Portal proveedores con información consolidada para el rango y proveedor seleccionados.
                    </div>
                </div>
            </section>
        </article>
    </div>

    @if (Model.AutoPrint)
    {
        <script>
            window.addEventListener("load", () => {
                window.setTimeout(() => window.print(), 350);
            });
        </script>
    }
</body>
</html>
