@using System.Text.Json
@model SoporteCloudPublicSurveyViewModel
@{
    Layout = null;
    var title = string.IsNullOrWhiteSpace(Model.SessionName) ? "Encuesta de capacitacion" : Model.SessionName;
    var payload = new
    {
        code = Model.Code,
        sessionId = Model.SessionId,
        sessionName = title,
        topicName = Model.TopicName,
        isClosed = Model.IsClosed,
        message = Model.Message,
        submitUrl = Url.Action("SubmitSurvey", "SoporteCloud", new { code = Model.Code }),
        resultsUrl = Url.Action("PublicSurveyResults", "SoporteCloud", new { code = Model.Code }),
        liveStateUrl = Url.Action("PublicLiveSurveyState", "SoporteCloud", new { code = Model.Code }),
        liveRegisterUrl = Url.Action("PublicLiveSurveyRegister", "SoporteCloud", new { code = Model.Code }),
        liveAnswerUrl = Url.Action("PublicLiveSurveyAnswer", "SoporteCloud", new { code = Model.Code }),
        liveCompleteUrl = Url.Action("PublicLiveSurveyComplete", "SoporteCloud", new { code = Model.Code }),
        liveWheelUrl = Url.Action("PublicLiveWheelSpin", "SoporteCloud", new { code = Model.Code }),
        knowledgeQuestions = Model.KnowledgeQuestions.Select(question => new
        {
            questionId = question.QuestionId,
            text = question.Text,
            inputTypeValue = question.InputTypeValue,
            inputTypeLabel = question.InputTypeLabel,
            maxPoints = 10,
            sortOrder = question.SortOrder,
            options = question.Options
                .Where(option => option.IsActive)
                .OrderBy(option => option.SortOrder)
                .Select(option => new
                {
                    optionId = option.OptionId,
                    text = option.Text,
                    isCorrect = option.IsCorrect,
                    points = option.Points,
                    sortOrder = option.SortOrder
                })
        }),
        satisfactionQuestions = Model.SatisfactionQuestions.Select(question => new
        {
            questionId = question.QuestionId,
            text = question.Text,
            inputTypeValue = question.InputTypeValue,
            inputTypeLabel = question.InputTypeLabel,
            sortOrder = question.SortOrder,
            options = question.Options
                .Where(option => option.IsActive)
                .OrderBy(option => option.SortOrder)
                .Select(option => new
                {
                    optionId = option.OptionId,
                    text = option.Text,
                    isCorrect = option.IsCorrect,
                    points = option.Points,
                    sortOrder = option.SortOrder
                })
        }),
        leaderboard = Model.Leaderboard.Select(item => new
        {
            fullName = item.FullName,
            company = item.Company,
            score = item.Score,
            scorePercent = item.ScorePercent
        })
    };
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, user-scalable=no" />
    <title>Asistente de aprendizaje Digital Tech</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Open+Sans:wght@400;600;700&family=Inter:wght@400;500&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/support-cloud.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/font-weight-reset.css" asp-append-version="true" />
</head>
<body class="support-cloud-live-public-body">
    <main class="support-cloud-live-public"
          id="soporteCloudLivePublicSurvey"
          data-code="@Model.Code">
        <header class="support-cloud-live-chat-header">
            <div class="support-cloud-live-avatar">
                <img src="~/img/digital-tech-white-logo.png" asp-append-version="true" alt="Digital Tech" />
            </div>
            <div class="support-cloud-live-chat-title">
                <strong>Asistente de aprendizaje Digital Tech</strong>
                <small>@title</small>
            </div>
            <div class="support-cloud-live-score" data-sclp-score hidden>
                <i class="fa-solid fa-star" aria-hidden="true"></i>
                <span data-sclp-score-value>0</span>
            </div>
        </header>

        <section class="support-cloud-live-topbar" data-sclp-topbar hidden>
            <span data-sclp-progress>Esperando al presentador</span>
            <span data-sclp-phase>Registro</span>
        </section>

        <section class="support-cloud-live-messages" data-sclp-messages aria-live="polite"></section>

        <section class="support-cloud-live-bottom" data-sclp-bottom hidden>
            <div class="support-cloud-live-input-context" data-sclp-input-context hidden></div>
            <div class="support-cloud-live-input" data-sclp-input-panel hidden>
                <textarea data-sclp-input rows="1" placeholder="Escribe aqui..."></textarea>
                <button type="button" data-sclp-send aria-label="Enviar">
                    <i class="fa-solid fa-paper-plane" aria-hidden="true"></i>
                </button>
            </div>

            <div class="support-cloud-live-wheel" data-sclp-wheel-panel hidden>
                <h3>Ruleta de la suerte</h3>
                <div class="support-cloud-live-wheel-wrap">
                    <div class="support-cloud-live-wheel-arrow">▼</div>
                    <div class="support-cloud-live-wheel-disk" data-sclp-wheel></div>
                </div>
                <button type="button" class="support-cloud-live-spin" data-sclp-spin>Girar</button>
                <div class="support-cloud-live-result" data-sclp-result></div>
                <div class="support-cloud-live-wheel-ranking" data-sclp-wheel-ranking></div>
            </div>
        </section>
    </main>

    <script type="application/json" id="supportCloudLiveSurveyPayload">
        @Html.Raw(JsonSerializer.Serialize(payload))
    </script>
    <script src="~/js/support-cloud-surveys.js" asp-append-version="true"></script>
</body>
</html>
