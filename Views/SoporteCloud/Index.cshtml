            </div>
            <div class="support-cloud-report-history-controls">
                <label class="support-cloud-form__field">
                    <span class="support-cloud-form__label">Mes</span>
                    <select class="form-select" data-scr-history-month></select>
                </label>
                <label class="support-cloud-form__field">
                    <span class="support-cloud-form__label">Ano</span>
                    <select class="form-select" data-scr-history-year></select>
                </label>
            </div>
            <div class="support-cloud-table-wrap">
                <table class="table align-middle support-cloud-table support-cloud-report-history-table">
                    <thead>
                        <tr>
                            <th>Cliente</th>
                            <th>Periodo</th>
                            <th>Estado</th>
                            <th>Generado</th>
                            <th class="text-end">Accion</th>
                        </tr>
                    </thead>
                    <tbody data-scr-history-rows></tbody>
                </table>
            </div>
            <div class="support-cloud-empty" data-scr-history-empty hidden>
                No hay informes generados para el periodo seleccionado.
            </div>
        </article>
    </section>

    <div class="support-cloud-modal support-cloud-loading-modal" data-scr-loading-modal hidden>
        <div class="support-cloud-modal__backdrop"></div>
        <div class="support-cloud-modal__dialog support-cloud-loading-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="supportCloudReportLoadingTitle" aria-describedby="supportCloudReportLoadingMessage">
            <div class="support-cloud-loading-modal__spinner" aria-hidden="true"></div>
            <div>
                <div class="support-cloud-kicker">Procesando</div>
                <h2 class="support-cloud-modal__title" id="supportCloudReportLoadingTitle">Generando informe</h2>
                <p class="support-cloud-modal__subtitle" id="supportCloudReportLoadingMessage" data-scr-loading-message>
                    Recolectando datos y preparando el reporte. Este proceso puede tardar unos minutos.
                </p>
            </div>
        </div>
    </div>

    <div class="support-cloud-modal" data-scr-recommendation-modal hidden>
        <div class="support-cloud-modal__backdrop" data-scr-close-recommendation></div>
        <form class="support-cloud-modal__dialog support-cloud-recommendation-dialog" role="dialog" aria-modal="true" aria-labelledby="supportCloudRecommendationTitle" data-scr-recommendation-form>
            <div class="support-cloud-modal__header">
                <div>
                    <div class="support-cloud-kicker">Recomendacion mensual</div>
                    <h2 class="support-cloud-modal__title" id="supportCloudRecommendationTitle">Antes de generar</h2>
                    <p class="support-cloud-modal__subtitle">
                        Escribe la recomendacion principal del periodo para incluirla en el informe final.
                    </p>
                </div>
                <button type="button" class="btn btn-outline-secondary" data-scr-close-recommendation>Cerrar</button>
            </div>

            <div class="support-cloud-status" data-scr-recommendation-status role="status" aria-live="polite"></div>

            <label class="support-cloud-form__field">
                <span class="support-cloud-form__label">Recomendacion del mes</span>
                <textarea class="form-control support-cloud-recommendation-textarea"
                          rows="7"
                          maxlength="2000"
                          data-scr-recommendation
                          placeholder="Ejemplo: priorizar la revision de alertas altas y cerrar incidentes activos con responsable y fecha objetivo."></textarea>
                <span class="support-cloud-form__hint" data-scr-recommendation-counter>0/2000</span>
            </label>

            <label class="support-cloud-form__field">
                <span class="support-cloud-form__label">Documentos anexos</span>
                <input type="file"
                       class="form-control"
                       multiple
                       accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.png,.jpg,.jpeg,.txt"
                       data-scr-attachments />
                <span class="support-cloud-form__hint support-cloud-attachment-list" data-scr-attachment-list>Sin documentos adjuntos</span>
            </label>

            <div class="support-cloud-modal__footer">
                <div class="support-cloud-modal__meta" data-scr-recommendation-context>Informe mensual</div>
                <div class="support-cloud-modal__actions">
                    <button type="button" class="btn btn-outline-secondary" data-scr-close-recommendation>Cancelar</button>
                    <button type="submit" class="btn btn-primary" data-scr-save-recommendation>Guardar y generar informe</button>
                </div>
            </div>
        </form>
    </div>

    <div class="support-cloud-modal" data-scr-email-template-modal hidden>
        <div class="support-cloud-modal__backdrop" data-scr-close-email-template></div>
        <form class="support-cloud-modal__dialog support-cloud-email-template-dialog" role="dialog" aria-modal="true" aria-labelledby="supportCloudEmailTemplateTitle" data-scr-email-template-form>
            <div class="support-cloud-modal__header">
                <div>
                    <div class="support-cloud-kicker">Correo</div>
                    <h2 class="support-cloud-modal__title" id="supportCloudEmailTemplateTitle">Plantilla de envio</h2>
                    <p class="support-cloud-modal__subtitle" data-scr-email-template-context>Personaliza el mensaje antes de enviarlo.</p>
                </div>
                <button type="button" class="btn btn-outline-secondary" data-scr-close-email-template>Cerrar</button>
            </div>

            <div class="support-cloud-status" data-scr-email-status role="status" aria-live="polite"></div>

            <label class="support-cloud-form__field">
                <span class="support-cloud-form__label">Asunto</span>
                <input type="text" class="form-control" data-scr-email-subject />
            </label>

            <label class="support-cloud-form__field">
                <span class="support-cloud-form__label">Cuerpo del correo</span>
                <textarea class="form-control support-cloud-email-template-body" rows="9" data-scr-email-body></textarea>
                <span class="support-cloud-form__hint">{ClienteNombre}, {ContactoNombre}, {Periodo}, {FechaGeneracion}, {ReporteNombre}</span>
            </label>

            <label class="support-cloud-form__field">
                <span class="support-cloud-form__label">Correo de prueba</span>
                <input type="email" class="form-control" placeholder="correo@empresa.com" data-scr-test-email />
            </label>

            <div class="support-cloud-modal__footer">
                <div class="support-cloud-modal__meta" data-scr-email-recipient>Selecciona un reporte para enviar o probar.</div>
                <div class="support-cloud-modal__actions">
                    <button type="button" class="btn btn-outline-secondary" data-scr-close-email-template>Cancelar</button>
                    <button type="submit" class="btn btn-outline-primary" data-scr-save-email-template>Guardar plantilla</button>
                    <button type="button" class="btn btn-outline-primary" data-scr-send-test-email>Enviar prueba</button>
                    <button type="button" class="btn btn-primary" data-scr-send-email>Enviar al cliente</button>
                </div>
            </div>
        </form>
    </div>

    <div class="support-cloud-modal" data-scr-consent-modal hidden>
        <div class="support-cloud-modal__backdrop" data-scr-close-consent></div>
        <div class="support-cloud-modal__dialog support-cloud-consent-dialog" role="dialog" aria-modal="true" aria-labelledby="supportCloudConsentTitle">
            <div class="support-cloud-modal__header">
                <div>
                    <div class="support-cloud-kicker">Nuevo consentimiento</div>
                    <h2 class="support-cloud-modal__title" id="supportCloudConsentTitle">Conectar Microsoft 365</h2>
                    <p class="support-cloud-modal__subtitle">
                        Selecciona el cliente, genera la URL de admin consent y abre Microsoft para completar el permiso.
                    </p>
                </div>
                <button type="button" class="btn btn-outline-secondary" data-scr-close-consent>Cerrar</button>
            </div>

            <div class="support-cloud-status" data-scr-consent-status role="status" aria-live="polite"></div>

            <div class="support-cloud-consent-steps">
                <article class="support-cloud-consent-step">
                    <span class="support-cloud-consent-step__number">1</span>
                    <div>
                        <h3>Datos del cliente</h3>
                        <p>El tenant puede ser un dominio como contoso.com o un tenantId.</p>
                    </div>
                    <div class="support-cloud-form__grid support-cloud-form__field--span-2">
                        <label class="support-cloud-form__field">
                            <span class="support-cloud-form__label">Cliente</span>
                            <select class="form-select" data-scr-consent-client>
                                <option value="">Cargando clientes...</option>
                            </select>
                        </label>
                        <label class="support-cloud-form__field">
                            <span class="support-cloud-form__label">Tenant ID o dominio</span>
                            <input type="text" class="form-control" placeholder="contoso.com" data-scr-tenant />
                        </label>
                    </div>
                    <div class="support-cloud-modal__actions">
                        <button type="button" class="btn btn-primary" data-scr-connect>Generar URL de consentimiento</button>
                    </div>
                </article>

                <article class="support-cloud-consent-step" data-scr-consent-card hidden>
                    <span class="support-cloud-consent-step__number">2</span>
                    <div>
                        <h3>Admin consent</h3>
                        <p>Abre la URL, acepta los permisos como administrador y vuelve a este modulo para actualizar la tabla.</p>
                    </div>
                    <div class="support-cloud-consent-url-row">
                        <input type="text" class="form-control support-cloud-report-url" readonly data-scr-consent-url />
                        <a class="btn btn-outline-primary" href="#" target="_blank" rel="noopener" data-scr-consent-link>Abrir Microsoft</a>
                    </div>
                    <div class="support-cloud-breakdown" data-scr-permissions></div>
                </article>
            </div>
        </div>
    </div>
</div>
    </div>
</div>

@section Scripts {
    <script src="~/js/support-cloud.js" asp-append-version="true"></script>
    <script src="~/js/support-cloud-surveys.js" asp-append-version="true"></script>
    <script src="~/js/support-cloud-reports.js" asp-append-version="true"></script>
}
