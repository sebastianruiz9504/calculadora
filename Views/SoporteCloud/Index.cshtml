@model SoporteCloudPageViewModel
@{
    ViewData["Title"] = "Soporte cloud";
    var currentUserLabel = !string.IsNullOrWhiteSpace(Model.CurrentUser.DisplayName)
        ? Model.CurrentUser.DisplayName
        : Model.CurrentUser.Email;
}

@section Styles {
    <link rel="stylesheet" href="~/css/support-cloud.css" asp-append-version="true" />
}

<div class="support-cloud-module-shell" id="soporteCloudModuleShell">
    <section class="support-cloud-module-nav" aria-label="Submodulos de soporte cloud">
        <button type="button" class="support-cloud-module-tab is-active" data-scs-module-tab="soporte" aria-selected="true">
            Soporte Cloud
        </button>
        <button type="button" class="support-cloud-module-tab" data-scs-module-tab="capacitaciones" aria-selected="false">
            Capacitaciones
        </button>
        <button type="button" class="support-cloud-module-tab" data-scs-module-tab="reportes" aria-selected="false">
            Reportes
        </button>
    </section>

    <div class="support-cloud-module-panel is-active" data-scs-module-panel="soporte">
<div class="support-cloud-shell"
     id="soporteCloudApp"
     data-load-url="@Url.Action("Data", "SoporteCloud")"
     data-client-search-url="@Url.Action("ClientSearch", "SoporteCloud")"
     data-save-url="@Url.Action("Save", "SoporteCloud")"
     data-upload-url="@Url.Action("UploadFile", "SoporteCloud")"
     data-download-url="@Url.Action("DownloadFile", "SoporteCloud")"
     data-initial-start-date="@Model.InitialStartDate"
     data-initial-end-date="@Model.InitialEndDate"
     data-current-user-name="@currentUserLabel"
     data-show-charts="false">
    <section class="support-cloud-hero">
        <div>
            <div class="support-cloud-kicker">Cloud</div>
            <h1 class="support-cloud-title">Soporte cloud</h1>
            <p class="support-cloud-subtitle">
                Administra tickets de soporte, abre cualquier fila para editarla y mantén el historial con su adjunto correcto.
            </p>
        </div>
        <div class="support-cloud-user-pill">
            <span class="support-cloud-user-pill__label">Acceso</span>
            <span>@currentUserLabel</span>
        </div>
    </section>

    <div class="support-cloud-status" data-sc-status role="status" aria-live="polite"></div>

    <section class="support-cloud-card">
        <div class="support-cloud-toolbar">
            <div class="support-cloud-toolbar__filters">
                <label class="support-cloud-field">
                    <span class="support-cloud-field__label">Desde</span>
                    <input type="date" class="form-control" data-sc-start-date />
                </label>
                <label class="support-cloud-field">
                    <span class="support-cloud-field__label">Hasta</span>
                    <input type="date" class="form-control" data-sc-end-date />
                </label>
            </div>
            <div class="support-cloud-toolbar__actions">
                <div class="support-cloud-toolbar__summary">
                    <span class="support-cloud-toolbar__summary-label">Rango activo</span>
                    <strong data-sc-range-label>@Model.InitialStartDate - @Model.InitialEndDate</strong>
                </div>
                <div class="support-cloud-toolbar__buttons">
                    <button type="button" class="btn btn-outline-secondary" data-sc-refresh>Actualizar</button>
                    <button type="button" class="btn btn-primary" data-sc-new-ticket>Nuevo ticket</button>
                </div>
            </div>
        </div>
    </section>

    <section class="support-cloud-summary">
        <article class="support-cloud-summary__card">
            <span class="support-cloud-summary__label">Total tickets</span>
            <strong class="support-cloud-summary__value" data-sc-total-tickets>0</strong>
        </article>
        <article class="support-cloud-summary__card">
            <span class="support-cloud-summary__label">Horas tomadas</span>
            <strong class="support-cloud-summary__value" data-sc-total-hours>0</strong>
        </article>
        <article class="support-cloud-summary__card">
            <span class="support-cloud-summary__label">Creadores activos</span>
            <strong class="support-cloud-summary__value" data-sc-total-creators>0</strong>
        </article>
        <article class="support-cloud-summary__card">
            <span class="support-cloud-summary__label">Clientes impactados</span>
            <strong class="support-cloud-summary__value" data-sc-total-clients>0</strong>
        </article>
    </section>

    <section class="support-cloud-card">
        <div class="support-cloud-section-header">
            <div>
                <div class="support-cloud-kicker">Resumen</div>
                <h2 class="support-cloud-section-title">Total por creador</h2>
                <p class="support-cloud-section-subtitle">
                    Los tickets se agrupan por usuario creador dentro del rango filtrado.
                </p>
            </div>
        </div>
        <div class="support-cloud-creators" data-sc-creators></div>
    </section>

    <section class="support-cloud-card">
        <div class="support-cloud-section-header">
            <div>
                <div class="support-cloud-kicker">Tabla</div>
                <h2 class="support-cloud-section-title">Tickets registrados</h2>
                <p class="support-cloud-section-subtitle">
                    La tabla muestra un resumen para que todo ajuste mejor en pantalla. Haz clic en cualquier fila para ver y editar toda la informaci&oacute;n del ticket.
                </p>
            </div>
            <div class="support-cloud-counter" data-sc-records-count>0 tickets</div>
        </div>

        <div class="support-cloud-table-wrap">
            <table class="table align-middle support-cloud-table">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Ticket</th>
                        <th>Cliente</th>
                        <th>Estado</th>
                        <th>Tipo</th>
                        <th>Creador</th>
                        <th class="text-end">Horas</th>
                        <th>Adjunto</th>
                    </tr>
                </thead>
                <tbody data-sc-rows></tbody>
            </table>
        </div>

        <div class="support-cloud-empty" data-sc-empty hidden>
            No hay tickets para este rango. Usa <strong>Nuevo ticket</strong> para crear el primero.
        </div>
    </section>

    <div class="support-cloud-modal" data-sc-modal hidden>
        <div class="support-cloud-modal__backdrop" data-sc-close-modal></div>
        <div class="support-cloud-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="supportCloudModalTitle">
            <div class="support-cloud-modal__header">
                <div>
                    <div class="support-cloud-kicker">Formulario</div>
                    <h2 class="support-cloud-modal__title" id="supportCloudModalTitle" data-sc-modal-title>Ticket de soporte cloud</h2>
                    <p class="support-cloud-modal__subtitle" data-sc-modal-subtitle>Completa todos los campos del ticket.</p>
                </div>
                <button type="button" class="btn btn-outline-secondary" data-sc-close-modal>Cerrar</button>
            </div>

            <div class="support-cloud-status" data-sc-modal-status role="status" aria-live="polite"></div>

            <form class="support-cloud-form" data-sc-form>
                <input type="hidden" data-sc-record-id />
                <input type="hidden" data-sc-client-id />

                <div class="support-cloud-form__grid">
                    <label class="support-cloud-form__field support-cloud-form__field--span-2">
                        <span class="support-cloud-form__label">Titulo del ticket</span>
                        <input type="text" class="form-control" data-sc-field="title" />
                    </label>

                    <label class="support-cloud-form__field support-cloud-form__field--span-2">
                        <span class="support-cloud-form__label">Descripcion</span>
                        <textarea class="form-control support-cloud-form__textarea" rows="4" data-sc-field="description"></textarea>
                    </label>

                    <label class="support-cloud-form__field">
                        <span class="support-cloud-form__label">Fecha de creacion</span>
                        <input type="date" class="form-control" data-sc-field="creationDate" />
                    </label>

                    <label class="support-cloud-form__field">
                        <span class="support-cloud-form__label">Estado</span>
                        <select class="form-select" data-sc-field="state"></select>
                    </label>

                    <label class="support-cloud-form__field">
                        <span class="support-cloud-form__label">Tipo</span>
                        <select class="form-select" data-sc-field="type"></select>
                    </label>

                    <label class="support-cloud-form__field">
                        <span class="support-cloud-form__label">Categoria</span>
                        <select class="form-select" data-sc-field="category"></select>
                    </label>

                    <label class="support-cloud-form__field support-cloud-form__field--span-2">
                        <span class="support-cloud-form__label">Cliente</span>
                        <input type="text" class="form-control" list="supportCloudClientOptionsStandalone" autocomplete="off" data-sc-field="clientName" />
                        <datalist id="supportCloudClientOptionsStandalone" data-sc-client-options></datalist>
                        <span class="support-cloud-form__hint">Escribe al menos 2 caracteres y selecciona una coincidencia.</span>
                    </label>

                    <label class="support-cloud-form__field">
                        <span class="support-cloud-form__label">Creador</span>
                        <input type="text" class="form-control support-cloud-form__readonly" data-sc-field="creatorName" readonly />
                    </label>

                    <label class="support-cloud-form__field">
                        <span class="support-cloud-form__label">Horas tomadas</span>
                        <input type="number" min="0" step="0.01" class="form-control" data-sc-field="hoursTaken" />
                    </label>

                    <label class="support-cloud-form__field">
                        <span class="support-cloud-form__label">Metodo</span>
                        <select class="form-select" data-sc-field="method"></select>
                    </label>

                    <label class="support-cloud-form__field support-cloud-form__field--span-2">
                        <span class="support-cloud-form__label">Solucion</span>
                        <textarea class="form-control support-cloud-form__textarea" rows="4" data-sc-field="solution"></textarea>
                    </label>

                    <div class="support-cloud-form__field support-cloud-form__field--span-2">
                        <span class="support-cloud-form__label">Adjunto</span>
                        <div class="support-cloud-file-card">
                            <div>
                                <div class="support-cloud-file-card__title" data-sc-attachment-name>Sin adjunto cargado</div>
                                <div class="support-cloud-file-card__hint" data-sc-attachment-hint>
                                    Guarda el ticket y adjunta el soporte en PDF, imagen o Word.
                                </div>
                            </div>
                            <div class="support-cloud-file-card__actions">
                                <a class="support-cloud-file-card__link is-disabled" href="#" target="_blank" rel="noopener" data-sc-download-link>Descargar</a>
                                <input type="file" class="form-control" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx" data-sc-attachment-input />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="support-cloud-modal__footer">
                    <div class="support-cloud-modal__meta" data-sc-modal-meta>Nuevo ticket</div>
                    <div class="support-cloud-modal__actions">
                        <button type="button" class="btn btn-outline-secondary" data-sc-close-modal>Cancelar</button>
                        <button type="submit" class="btn btn-primary" data-sc-save-ticket>Guardar</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
    </div>

    <div class="support-cloud-module-panel" data-scs-module-panel="capacitaciones" hidden>
<div class="support-cloud-shell support-cloud-survey-admin"
     id="soporteCloudSurveyAdmin"
     data-board-url="@Url.Action("SurveyBoard", "SoporteCloud")"
     data-save-topic-url="@Url.Action("SaveSurveyTopic", "SoporteCloud")"
     data-save-question-url="@Url.Action("SaveSurveyQuestion", "SoporteCloud")"
     data-save-session-url="@Url.Action("SaveSurveySession", "SoporteCloud")"
     data-close-session-url="@Url.Action("CloseSurveySession", "SoporteCloud")"
     data-session-detail-url="@Url.Action("SurveySessionDetail", "SoporteCloud")"
     data-export-url="@Url.Action("SurveyExport", "SoporteCloud")"
     data-client-search-url="@Url.Action("ClientSearch", "SoporteCloud")">
    <section class="support-cloud-hero">
        <div>
            <div class="support-cloud-kicker">Capacitaciones</div>
            <h1 class="support-cloud-title">Encuestas y resultados</h1>
            <p class="support-cloud-subtitle">
                Gestiona temas, preguntas, sesiones por QR y resultados de conocimiento por cada capacitaci&oacute;n.
            </p>
        </div>
        <div class="support-cloud-user-pill">
            <span class="support-cloud-user-pill__label">Responsable</span>
            <span>@currentUserLabel</span>
        </div>
    </section>

    <div class="support-cloud-status" data-scs-status role="status" aria-live="polite"></div>

    <section class="support-cloud-summary">
        <article class="support-cloud-summary__card">
            <span class="support-cloud-summary__label">Sesiones</span>
            <strong class="support-cloud-summary__value" data-scs-total-sessions>0</strong>
        </article>
        <article class="support-cloud-summary__card">
            <span class="support-cloud-summary__label">Abiertas</span>
            <strong class="support-cloud-summary__value" data-scs-open-sessions>0</strong>
        </article>
        <article class="support-cloud-summary__card">
            <span class="support-cloud-summary__label">Respuestas</span>
            <strong class="support-cloud-summary__value" data-scs-total-responses>0</strong>
        </article>
        <article class="support-cloud-summary__card">
            <span class="support-cloud-summary__label">Promedio</span>
            <strong class="support-cloud-summary__value" data-scs-average-score>0%</strong>
        </article>
    </section>

    <section class="support-cloud-survey-actions">
        <article class="support-cloud-card support-cloud-survey-action">
            <div>
                <div class="support-cloud-kicker">QR</div>
                <h2 class="support-cloud-section-title">Sesion de encuesta</h2>
                <p class="support-cloud-section-subtitle">
                    Crea una encuesta con el bloque fijo de Satisfaccion y el tema de conocimiento de la capacitacion.
                </p>
            </div>
            <div class="support-cloud-modal__actions">
                <button type="button" class="btn btn-outline-secondary" data-scs-refresh>Actualizar</button>
                <button type="button" class="btn btn-primary" data-scs-open-session>Generar nueva encuesta</button>
            </div>
        </article>

        <article class="support-cloud-card support-cloud-survey-action">
            <div>
                <div class="support-cloud-kicker">Banco</div>
                <h2 class="support-cloud-section-title">Temas y preguntas</h2>
                <p class="support-cloud-section-subtitle">
                    Administra los temas editables y sus preguntas de conocimiento.
                </p>
            </div>
            <div class="support-cloud-modal__actions">
                <button type="button" class="btn btn-primary" data-scs-open-topics>Encuestas</button>
            </div>
        </article>
    </section>

    <div class="support-cloud-modal" data-scs-session-modal hidden>
        <div class="support-cloud-modal__backdrop" data-scs-close-session-modal></div>
        <div class="support-cloud-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="supportCloudSurveySessionTitle">
            <div class="support-cloud-modal__header">
                <div>
                    <div class="support-cloud-kicker">Nueva encuesta</div>
                    <h2 class="support-cloud-modal__title" id="supportCloudSurveySessionTitle">Generar nueva encuesta</h2>
                    <p class="support-cloud-modal__subtitle">
                        La sesion incluye Satisfaccion y el tema de conocimiento seleccionado.
                    </p>
                </div>
                <button type="button" class="btn btn-outline-secondary" data-scs-close-session-modal>Cerrar</button>
            </div>

            <form class="support-cloud-form" data-scs-session-form>
                <input type="hidden" data-scs-session-id />
                <input type="hidden" data-scs-client-id />
                <div class="support-cloud-form__grid">
                    <label class="support-cloud-form__field">
                        <span class="support-cloud-form__label">Nombre</span>
                        <input type="text" class="form-control" data-scs-session-name />
                    </label>
                    <label class="support-cloud-form__field">
                        <span class="support-cloud-form__label">Fecha</span>
                        <input type="date" class="form-control" data-scs-session-date />
                    </label>
                    <label class="support-cloud-form__field">
                        <span class="support-cloud-form__label">Tema</span>
                        <select class="form-select" data-scs-session-topic></select>
                    </label>
                    <label class="support-cloud-form__field">
                        <span class="support-cloud-form__label">Cliente</span>
                        <input type="text" class="form-control" list="supportCloudSurveyClientOptions" autocomplete="off" data-scs-client-name />
                        <datalist id="supportCloudSurveyClientOptions" data-scs-client-options></datalist>
                    </label>
                </div>

                <div class="support-cloud-survey-compose">
                    <article>
                        <div class="support-cloud-kicker">Tema fijo</div>
                        <h3>Satisfaccion</h3>
                        <div class="support-cloud-survey-mini-list" data-scs-satisfaction-preview></div>
                    </article>
                    <article>
                        <div class="support-cloud-kicker">Tema seleccionado</div>
                        <h3 data-scs-selected-topic-title>Conocimiento</h3>
                        <div class="support-cloud-survey-mini-list" data-scs-selected-topic-preview></div>
                    </article>
                </div>

                <div class="support-cloud-modal__footer">
                    <div class="support-cloud-modal__meta" data-scs-session-meta>Nueva sesion</div>
                    <div class="support-cloud-modal__actions">
                        <button type="button" class="btn btn-outline-secondary" data-scs-reset-session>Limpiar</button>
                        <button type="submit" class="btn btn-primary">Guardar sesion</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="support-cloud-modal" data-scs-qr-modal hidden>
        <div class="support-cloud-modal__backdrop" data-scs-close-qr-modal></div>
        <div class="support-cloud-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="supportCloudSurveyQrTitle">
            <div class="support-cloud-modal__header">
                <div>
                    <div class="support-cloud-kicker">QR activo</div>
                    <h2 class="support-cloud-modal__title" id="supportCloudSurveyQrTitle" data-scs-qr-session-title>Encuesta</h2>
                    <p class="support-cloud-modal__subtitle">Comparte este codigo durante la capacitacion.</p>
                </div>
                <button type="button" class="btn btn-outline-secondary" data-scs-close-qr-modal>Cerrar</button>
            </div>

            <div class="support-cloud-qr-panel" data-scs-qr-panel hidden>
                <img alt="Codigo QR de encuesta" data-scs-qr-image />
                <div class="support-cloud-qr-panel__content">
                    <span class="support-cloud-summary__label">Enlace publico</span>
                    <a href="#" target="_blank" rel="noopener" data-scs-public-link></a>
                    <div class="support-cloud-qr-counters">
                        <article>
                            <span class="support-cloud-summary__label">Escaneos</span>
                            <strong data-scs-scan-count>0</strong>
                        </article>
                        <article>
                            <span class="support-cloud-summary__label">Respondieron todo</span>
                            <strong data-scs-completed-count>0</strong>
                        </article>
                    </div>
                    <div class="support-cloud-qr-panel__actions">
                        <button type="button" class="btn btn-outline-danger" data-scs-close-session>Cerrar encuesta</button>
                        <a class="btn btn-outline-primary" href="#" data-scs-export>Exportar reporte</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="support-cloud-modal" data-scs-winners-modal hidden>
        <div class="support-cloud-modal__backdrop" data-scs-close-winners></div>
        <div class="support-cloud-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="supportCloudSurveyWinnersTitle">
            <div class="support-cloud-modal__header">
                <div>
                    <div class="support-cloud-kicker">Encuesta cerrada</div>
                    <h2 class="support-cloud-modal__title" id="supportCloudSurveyWinnersTitle">Ganadores</h2>
                    <p class="support-cloud-modal__subtitle">Ranking de participantes para la sesion cerrada.</p>
                </div>
                <button type="button" class="btn btn-outline-secondary" data-scs-close-winners>Cerrar</button>
            </div>

            <div class="support-cloud-table-wrap">
                <table class="table align-middle support-cloud-table">
                    <thead>
                        <tr>
                            <th>Posicion</th>
                            <th>Participante</th>
                            <th>Empresa</th>
                            <th class="text-end">Puntaje</th>
                            <th class="text-end">Porcentaje</th>
                        </tr>
                    </thead>
                    <tbody data-scs-winners-rows></tbody>
                </table>
            </div>

            <div class="support-cloud-modal__footer">
                <div class="support-cloud-modal__meta">Resultados finales</div>
                <div class="support-cloud-modal__actions">
                    <button type="button" class="btn btn-primary" data-scs-close-winners>Cerrar la sesion</button>
                </div>
            </div>
        </div>
    </div>

    <div class="support-cloud-modal" data-scs-topics-modal hidden>
        <div class="support-cloud-modal__backdrop" data-scs-close-topics-modal></div>
        <div class="support-cloud-modal__dialog support-cloud-survey-topics-dialog" role="dialog" aria-modal="true" aria-labelledby="supportCloudSurveyTopicsTitle">
            <div class="support-cloud-modal__header">
                <div>
                    <div class="support-cloud-kicker">Encuestas</div>
                    <h2 class="support-cloud-modal__title" id="supportCloudSurveyTopicsTitle">Temas y preguntas</h2>
                    <p class="support-cloud-modal__subtitle">Selecciona un tema para editarlo o crea uno nuevo.</p>
                </div>
                <button type="button" class="btn btn-outline-secondary" data-scs-close-topics-modal>Cerrar</button>
            </div>

            <div class="support-cloud-survey-topic-layout">
                <aside>
                    <button type="button" class="btn btn-primary w-100" data-scs-new-topic>Nuevo tema</button>
                    <div class="support-cloud-survey-pick-list" data-scs-topics-list></div>
                </aside>

                <div class="support-cloud-survey-topic-editor">
                    <form class="support-cloud-form" data-scs-topic-form>
                        <input type="hidden" data-scs-topic-id />
                        <div class="support-cloud-form__grid">
                            <label class="support-cloud-form__field">
                                <span class="support-cloud-form__label">Tema</span>
                                <input type="text" class="form-control" data-scs-topic-name />
                            </label>
                            <label class="support-cloud-form__field">
                                <span class="support-cloud-form__label">Activo</span>
                                <select class="form-select" data-scs-topic-active>
                                    <option value="true">Si</option>
                                    <option value="false">No</option>
                                </select>
                            </label>
                            <label class="support-cloud-form__field support-cloud-form__field--span-2">
                                <span class="support-cloud-form__label">Descripcion</span>
                                <textarea class="form-control" rows="2" data-scs-topic-description></textarea>
                            </label>
                        </div>
                        <div class="support-cloud-placeholder support-cloud-placeholder--compact" data-scs-topic-lock-notice hidden>
                            Satisfaccion es un tema fijo y no se puede editar.
                        </div>
                        <div class="support-cloud-modal__footer">
                            <div class="support-cloud-modal__meta" data-scs-topic-meta>Nuevo tema</div>
                            <div class="support-cloud-modal__actions">
                                <button type="button" class="btn btn-outline-secondary" data-scs-reset-topic>Limpiar</button>
                                <button type="submit" class="btn btn-primary" data-scs-save-topic>Guardar tema</button>
                            </div>
                        </div>
                    </form>

                    <form class="support-cloud-form support-cloud-survey-question-form" data-scs-question-form hidden>
                        <input type="hidden" data-scs-question-id />
                        <input type="hidden" data-scs-question-component value="645250000" />
                        <div class="support-cloud-form__grid">
                            <label class="support-cloud-form__field">
                                <span class="support-cloud-form__label">Tema</span>
                                <select class="form-select" data-scs-question-topic></select>
                            </label>
                            <label class="support-cloud-form__field">
                                <span class="support-cloud-form__label">Tipo</span>
                                <select class="form-select" data-scs-question-type>
                                    <option value="645250000">Seleccion unica</option>
                                    <option value="645250001">Escala 1 a 5</option>
                                    <option value="645250002">Texto abierto</option>
                                </select>
                            </label>
                            <label class="support-cloud-form__field">
                                <span class="support-cloud-form__label">Puntos</span>
                                <input type="number" min="0" step="0.01" class="form-control" data-scs-question-points />
                            </label>
                            <label class="support-cloud-form__field">
                                <span class="support-cloud-form__label">Orden</span>
                                <input type="number" min="0" step="1" class="form-control" data-scs-question-order />
                            </label>
                            <label class="support-cloud-form__field">
                                <span class="support-cloud-form__label">Activa</span>
                                <select class="form-select" data-scs-question-active>
                                    <option value="true">Si</option>
                                    <option value="false">No</option>
                                </select>
                            </label>
                            <label class="support-cloud-form__field support-cloud-form__field--span-2">
                                <span class="support-cloud-form__label">Pregunta</span>
                                <textarea class="form-control" rows="2" data-scs-question-text></textarea>
                            </label>
                        </div>

                        <div class="support-cloud-survey-options" data-scs-options></div>
                        <button type="button" class="btn btn-outline-secondary" data-scs-add-option>Agregar opcion</button>

                        <div class="support-cloud-modal__footer">
                            <div class="support-cloud-modal__meta" data-scs-question-meta>Nueva pregunta</div>
                            <div class="support-cloud-modal__actions">
                                <button type="button" class="btn btn-outline-secondary" data-scs-reset-question>Limpiar</button>
                                <button type="submit" class="btn btn-primary">Guardar pregunta</button>
                            </div>
                        </div>
                    </form>

                    <div class="support-cloud-survey-pick-list" data-scs-questions-list></div>
                </div>
            </div>
        </div>
    </div>

    <section class="support-cloud-card">
        <div class="support-cloud-section-header">
            <div>
                <div class="support-cloud-kicker">Detalle</div>
                <h2 class="support-cloud-section-title">Sesiones y estadistica</h2>
            </div>
        </div>
        <div class="support-cloud-survey-detail">
            <div class="support-cloud-table-wrap">
                <table class="table align-middle support-cloud-table support-cloud-survey-session-table">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Sesion</th>
                            <th>Cliente</th>
                            <th>Tema</th>
                            <th>Estado</th>
                            <th class="text-end">Respuestas</th>
                            <th class="text-end">Promedio</th>
                        </tr>
                    </thead>
                    <tbody data-scs-session-rows></tbody>
                </table>
            </div>
            <div class="support-cloud-survey-stats" data-scs-session-detail></div>
        </div>
    </section>

    <section class="support-cloud-training-grid">
        <article class="support-cloud-card">
            <div class="support-cloud-section-header">
                <div>
                    <div class="support-cloud-kicker">Mejor puntaje</div>
                    <h2 class="support-cloud-section-title">Preguntas fuertes</h2>
                </div>
            </div>
            <div class="support-cloud-breakdown" data-scs-best-questions></div>
        </article>
        <article class="support-cloud-card">
            <div class="support-cloud-section-header">
                <div>
                    <div class="support-cloud-kicker">Fallas</div>
                    <h2 class="support-cloud-section-title">Preguntas con mas errores</h2>
                </div>
            </div>
            <div class="support-cloud-breakdown" data-scs-weak-questions></div>
        </article>
    </section>
</div>
    </div>

    <div class="support-cloud-module-panel" data-scs-module-panel="reportes" hidden>
<div class="support-cloud-shell support-cloud-reports"
     id="soporteCloudReports"
     data-clients-url="@Url.Action("ReportClients", "SoporteCloud")"
     data-connected-url="@Url.Content("~/api/m365/connected-clients")"
     data-connect-url="@Url.Content("~/api/m365/connect-url")"
     data-snapshot-url="@Url.Content("~/api/m365/security-snapshot")"
     data-generate-url="@Url.Content("~/api/reportes/generar")"
     data-generated-reports-url="@Url.Content("~/api/reportes/generados")"
     data-report-detail-url="@Url.Content("~/api/reportes/generados")">
    <section class="support-cloud-hero">
        <div>
            <div class="support-cloud-kicker">Reportes</div>
            <h1 class="support-cloud-title">Reportes automatizados</h1>
            <p class="support-cloud-subtitle">
                Conecta Microsoft 365, recolecta el snapshot mensual y genera el informe HTML ejecutivo.
            </p>
        </div>
        <div class="support-cloud-user-pill">
            <span class="support-cloud-user-pill__label">Responsable</span>
            <span>@currentUserLabel</span>
        </div>
    </section>

    <div class="support-cloud-status" data-scr-status role="status" aria-live="polite"></div>

    <section class="support-cloud-card">
        <div class="support-cloud-section-header">
            <div>
                <div class="support-cloud-kicker">Tenants conectados</div>
                <h2 class="support-cloud-section-title">Clientes con consentimiento activo</h2>
                <p class="support-cloud-section-subtitle">
                    Selecciona un cliente conectado, elige el periodo y genera el informe. La recoleccion mensual se ejecuta automaticamente antes de generar el HTML.
                </p>
            </div>
            <div class="support-cloud-modal__actions">
                <button type="button" class="btn btn-outline-secondary" data-scr-refresh-connected>Actualizar</button>
                <button type="button" class="btn btn-primary" data-scr-open-consent>Crear nuevo consentimiento</button>
            </div>
        </div>

        <div class="support-cloud-report-actionbar">
            <div>
                <span class="support-cloud-summary__label">Cliente seleccionado</span>
                <strong data-scr-selection-meta>Selecciona un cliente conectado</strong>
            </div>
            <label class="support-cloud-form__field">
                <span class="support-cloud-form__label">Mes de reporte</span>
                <select class="form-select" data-scr-month></select>
            </label>
            <button type="button" class="btn btn-primary" data-scr-generate disabled>Generar informe</button>
        </div>

        <div class="support-cloud-table-wrap">
            <table class="table align-middle support-cloud-table support-cloud-connected-table">
                <thead>
                    <tr>
                        <th>Cliente</th>
                        <th>Tenant</th>
                        <th>Estado</th>
                        <th>Consentimiento</th>
                        <th>Permisos</th>
                        <th class="text-end">Accion</th>
                    </tr>
                </thead>
                <tbody data-scr-connected-rows></tbody>
            </table>
        </div>
        <div class="support-cloud-empty" data-scr-connected-empty hidden>
            No hay clientes con consentimiento activo. Usa <strong>Crear nuevo consentimiento</strong> para iniciar una conexion.
        </div>
    </section>

    <section class="support-cloud-summary support-cloud-report-summary">
        <article class="support-cloud-summary__card">
            <span class="support-cloud-summary__label">Conectados</span>
            <strong class="support-cloud-summary__value" data-scr-total-connected>0</strong>
        </article>
        <article class="support-cloud-summary__card">
            <span class="support-cloud-summary__label">Mes</span>
            <strong class="support-cloud-summary__value support-cloud-summary__value--compact" data-scr-selected-month>-</strong>
        </article>
        <article class="support-cloud-summary__card">
            <span class="support-cloud-summary__label">Conexion</span>
            <strong class="support-cloud-summary__value support-cloud-summary__value--compact" data-scr-connection-state>Sin seleccion</strong>
        </article>
        <article class="support-cloud-summary__card">
            <span class="support-cloud-summary__label">Informe</span>
            <strong class="support-cloud-summary__value support-cloud-summary__value--compact" data-scr-report-state>Sin generar</strong>
        </article>
        <article class="support-cloud-summary__card">
            <span class="support-cloud-summary__label">Secure Score</span>
            <strong class="support-cloud-summary__value support-cloud-summary__value--compact" data-scr-secure-score>-</strong>
        </article>
        <article class="support-cloud-summary__card">
            <span class="support-cloud-summary__label">Alertas high</span>
            <strong class="support-cloud-summary__value" data-scr-alerts-high>0</strong>
        </article>
        <article class="support-cloud-summary__card">
            <span class="support-cloud-summary__label">Incidentes activos</span>
            <strong class="support-cloud-summary__value" data-scr-incidents-active>0</strong>
        </article>
    </section>

    <section class="support-cloud-card support-cloud-progress-card" data-scr-progress-card hidden>
        <div class="support-cloud-section-header">
            <div>
                <div class="support-cloud-kicker">Progreso</div>
                <h2 class="support-cloud-section-title">Generacion en curso</h2>
                <p class="support-cloud-section-subtitle" data-scr-progress-message>Preparando solicitud...</p>
            </div>
        </div>
        <div class="support-cloud-progress">
            <div class="support-cloud-progress__track">
                <span data-scr-progress-bar></span>
            </div>
            <ol class="support-cloud-progress__steps" data-scr-progress-steps></ol>
        </div>
    </section>

    <section class="support-cloud-card support-cloud-report-output" data-scr-report-card hidden>
        <div class="support-cloud-section-header">
            <div>
                <div class="support-cloud-kicker">Informe HTML</div>
                <h2 class="support-cloud-section-title">Resultado generado</h2>
            </div>
            <div class="support-cloud-modal__actions">
                <button type="button" class="btn btn-outline-secondary" data-scr-open-report disabled>Abrir HTML</button>
            </div>
        </div>
        <div class="support-cloud-report-result">
            <span class="support-cloud-summary__label">Registro Dataverse</span>
            <strong data-scr-report-id>-</strong>
        </div>
        <div class="support-cloud-report-preview">
            <iframe title="Previsualizacion del informe generado" sandbox data-scr-report-frame></iframe>
        </div>
    </section>

    <section class="support-cloud-training-grid">
        <article class="support-cloud-card">
            <div class="support-cloud-section-header">
                <div>
                    <div class="support-cloud-kicker">Snapshot</div>
                    <h2 class="support-cloud-section-title">Datos Microsoft 365</h2>
                </div>
            </div>
            <div class="support-cloud-breakdown" data-scr-snapshot-summary>
                <div class="support-cloud-placeholder support-cloud-placeholder--compact">
                    El snapshot se mostrara despues de generar el informe.
                </div>
            </div>
        </article>
        <article class="support-cloud-card">
            <div class="support-cloud-section-header">
                <div>
                    <div class="support-cloud-kicker">Historial</div>
                    <h2 class="support-cloud-section-title">Consultar reportes</h2>
                </div>
                <button type="button" class="btn btn-outline-secondary" data-scr-load-history>Consultar</button>
            </div>
            <div class="support-cloud-report-history-controls">
                <label class="support-cloud-form__field">
                    <span class="support-cloud-form__label">Mes</span>
                    <select class="form-select" data-scr-history-month></select>
                </label>
                <label class="support-cloud-form__field">
                    <span class="support-cloud-form__label">Ano</span>
                    <select class="form-select" data-scr-history-year></select>
                </label>
            </div>
            <div class="support-cloud-table-wrap">
                <table class="table align-middle support-cloud-table support-cloud-report-history-table">
                    <thead>
                        <tr>
                            <th>Cliente</th>
                            <th>Periodo</th>
                            <th>Estado</th>
                            <th>Generado</th>
                            <th class="text-end">Accion</th>
                        </tr>
                    </thead>
                    <tbody data-scr-history-rows></tbody>
                </table>
            </div>
            <div class="support-cloud-empty" data-scr-history-empty hidden>
                No hay informes generados para el periodo seleccionado.
            </div>
        </article>
    </section>

    <div class="support-cloud-modal support-cloud-loading-modal" data-scr-loading-modal hidden>
        <div class="support-cloud-modal__backdrop"></div>
        <div class="support-cloud-modal__dialog support-cloud-loading-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="supportCloudReportLoadingTitle" aria-describedby="supportCloudReportLoadingMessage">
            <div class="support-cloud-loading-modal__spinner" aria-hidden="true"></div>
            <div>
                <div class="support-cloud-kicker">Procesando</div>
                <h2 class="support-cloud-modal__title" id="supportCloudReportLoadingTitle">Generando informe</h2>
                <p class="support-cloud-modal__subtitle" id="supportCloudReportLoadingMessage" data-scr-loading-message>
                    Recolectando datos y preparando el reporte. Este proceso puede tardar unos minutos.
                </p>
            </div>
        </div>
    </div>

    <div class="support-cloud-modal" data-scr-consent-modal hidden>
        <div class="support-cloud-modal__backdrop" data-scr-close-consent></div>
        <div class="support-cloud-modal__dialog support-cloud-consent-dialog" role="dialog" aria-modal="true" aria-labelledby="supportCloudConsentTitle">
            <div class="support-cloud-modal__header">
                <div>
                    <div class="support-cloud-kicker">Nuevo consentimiento</div>
                    <h2 class="support-cloud-modal__title" id="supportCloudConsentTitle">Conectar Microsoft 365</h2>
                    <p class="support-cloud-modal__subtitle">
                        Selecciona el cliente, genera la URL de admin consent y abre Microsoft para completar el permiso.
                    </p>
                </div>
                <button type="button" class="btn btn-outline-secondary" data-scr-close-consent>Cerrar</button>
            </div>

            <div class="support-cloud-status" data-scr-consent-status role="status" aria-live="polite"></div>

            <div class="support-cloud-consent-steps">
                <article class="support-cloud-consent-step">
                    <span class="support-cloud-consent-step__number">1</span>
                    <div>
                        <h3>Datos del cliente</h3>
                        <p>El tenant puede ser un dominio como contoso.com o un tenantId.</p>
                    </div>
                    <div class="support-cloud-form__grid support-cloud-form__field--span-2">
                        <label class="support-cloud-form__field">
                            <span class="support-cloud-form__label">Cliente</span>
                            <select class="form-select" data-scr-consent-client>
                                <option value="">Cargando clientes...</option>
                            </select>
                        </label>
                        <label class="support-cloud-form__field">
                            <span class="support-cloud-form__label">Tenant ID o dominio</span>
                            <input type="text" class="form-control" placeholder="contoso.com" data-scr-tenant />
                        </label>
                    </div>
                    <div class="support-cloud-modal__actions">
                        <button type="button" class="btn btn-primary" data-scr-connect>Generar URL de consentimiento</button>
                    </div>
                </article>

                <article class="support-cloud-consent-step" data-scr-consent-card hidden>
                    <span class="support-cloud-consent-step__number">2</span>
                    <div>
                        <h3>Admin consent</h3>
                        <p>Abre la URL, acepta los permisos como administrador y vuelve a este modulo para actualizar la tabla.</p>
                    </div>
                    <div class="support-cloud-consent-url-row">
                        <input type="text" class="form-control support-cloud-report-url" readonly data-scr-consent-url />
                        <a class="btn btn-outline-primary" href="#" target="_blank" rel="noopener" data-scr-consent-link>Abrir Microsoft</a>
                    </div>
                    <div class="support-cloud-breakdown" data-scr-permissions></div>
                </article>
            </div>
        </div>
    </div>
</div>
    </div>
</div>

@section Scripts {
    <script src="~/js/support-cloud.js" asp-append-version="true"></script>
    <script src="~/js/support-cloud-surveys.js" asp-append-version="true"></script>
    <script src="~/js/support-cloud-reports.js" asp-append-version="true"></script>
}
