        }

        prorationSearchTimer = setTimeout(async () => {
            prorationClientResults = await clientSearch(q);
            if (!prorationClientResults.length) {
                hideProrationClientSuggestions();
                return;
            }

            positionFullWidthSuggestions(prorationClientSuggestions, prorationClientInput);
            prorationClientSuggestions.innerHTML = prorationClientResults.map((c, idx) => `
                <div class="suggestion-item" data-proration-client-idx="${idx}">
