    function createScenario(name) {
        const id = uid();
 return { id, name: name || "Escenario", dealType: 0, requiresProration: false, startDate: "", endDate: "", prorationClient: null, prorationRenewalOptions: [], prorationRenewalError: "", lines: [], lastResult: null };    }
function toDateInputValue(value) {
        if (!value) return "";
        const str = String(value);
        if (str.length >= 10) return str.substring(0, 10);
        return str;
    }

    function normalizeInlineMessage(value) {
        if (value === null || value === undefined) return "";
        return String(value).replace(/\s+/g, " ").trim();
    }

    function shortenInlineMessage(value, maxLength = 90) {
        const normalized = normalizeInlineMessage(value);
        if (!normalized) return "";
        if (normalized.length <= maxLength) return normalized;
        return `${normalized.slice(0, maxLength - 3)}...`;
    }

    function buildApiErrorMessage(payload, fallbackMessage) {
        if (!payload || typeof payload !== "object") return fallbackMessage;

        const parts = [];
        if (payload.message) parts.push(normalizeInlineMessage(payload.message));
        if (payload.detail) parts.push(`Detalle: ${normalizeInlineMessage(payload.detail)}`);
        if (payload.traceId) parts.push(`TraceId: ${normalizeInlineMessage(payload.traceId)}`);

        return parts.filter(Boolean).join(" ") || fallbackMessage;
    }

    async function readErrorResponseMessage(res, fallbackMessage) {
        let rawBody = "";
        try {
            rawBody = await res.text();
        } catch {
            return fallbackMessage;
        }

        const trimmedBody = rawBody.trim();
        if (!trimmedBody) return fallbackMessage;

        try {
            return buildApiErrorMessage(JSON.parse(trimmedBody), fallbackMessage);
        } catch {
            return normalizeInlineMessage(trimmedBody) || fallbackMessage;
        }
    }

    function formatDateOptionLabel(value) {
        const normalized = toDateInputValue(value);
        if (!normalized) return "";
        const parts = normalized.split("-");
        if (parts.length !== 3) return normalized;
        return `${parts[2]}/${parts[1]}/${parts[0]}`;
    }

    function buildLegacyRenewalOption(value) {
        const normalized = toDateInputValue(value);
        if (!normalized) return null;

        return {
            recordId: "",
            dateValue: normalized,
            displayDate: formatDateOptionLabel(normalized)
        };
    }

    function getProrationRenewalOptions(s) {
        if (!s) return [];
        if (Array.isArray(s.prorationRenewalOptions) && s.prorationRenewalOptions.length) {
            return s.prorationRenewalOptions;
        }

        const legacy = buildLegacyRenewalOption(s.endDate);
        return legacy ? [legacy] : [];
    }

    function renderProrationEndDateOptions() {
        const s = getActiveScenario();
        if (!s) return;

        const options = getProrationRenewalOptions(s)
            .filter((option, index, all) => option.dateValue && index === all.findIndex(other => other.dateValue === option.dateValue));
        const hasClient = Boolean(s.prorationClient?.id);
        let placeholder = "Busca y selecciona un cliente";

        if (!s.requiresProration) {
            placeholder = "Prorrateo desactivado";
        } else if (s.prorationRenewalError) {
            placeholder = shortenInlineMessage(s.prorationRenewalError, 72) || "Error consultando fechas";
        } else if (hasClient && options.length) {
            placeholder = "Selecciona una fecha";
        } else if (hasClient) {
            placeholder = "No se encontraron fechas";
        }

        endDate.innerHTML = [
            `<option value="">${placeholder}</option>`,
            ...options.map(option => `<option value="${option.dateValue}">${option.displayDate || formatDateOptionLabel(option.dateValue)}</option>`)
        ].join("");

        endDate.disabled = !s.requiresProration || !options.length;
        endDate.title = s.prorationRenewalError || "";
        endDate.value = s.endDate && options.some(option => option.dateValue === s.endDate)
            ? s.endDate
            : "";
    }

    function syncProrationInputs() {
        const s = getActiveScenario();
        if (!s) return;

        prorationClientRow.style.display = s.requiresProration ? "" : "none";
        prorationClientInput.value = s.prorationClient?.name || "";
        renderProrationEndDateOptions();
    }

    function mapStoredScenario(stored) {
        const requiresProration = Boolean(stored.requiresProration);

        return {
            id: stored.scenarioId || uid(),
            name: stored.scenarioName || "Escenario",
            dealType: requiresProration ? CROSS_SALE_DEAL_TYPE : Number(stored.dealType || 0),
            requiresProration,
            startDate: toDateInputValue(stored.startDate),
            endDate: toDateInputValue(stored.endDate),
            prorationClient: stored.prorationClient?.id
                ? {
                    id: stored.prorationClient.id || "",
                    name: stored.prorationClient.name || ""
                }
                : null,
            prorationRenewalOptions: Array.isArray(stored.prorationRenewalOptions)
                ? stored.prorationRenewalOptions
                    .map(option => {
                        const dateValue = toDateInputValue(option.dateValue);
                        return {
                            recordId: option.recordId || "",
                            dateValue,
                            displayDate: option.displayDate || formatDateOptionLabel(dateValue)
                        };
                    })
                    .filter(option => option.dateValue)
                : [],
            prorationRenewalError: "",
            lines: Array.isArray(stored.lines) ? stored.lines.map(line => ({
                businessType: Number(line.businessType || 0),
                productId: line.productId || "",
                productDescription: line.productDescription || "",
                costUnit: Number(line.costUnit || 0),
                marginPercent: Number(line.marginPercent || 0),
                contractMonths: Number(line.contractMonths || 12),
                quantity: Number(line.quantity || 1),
                suggestedRetailPrice: Number(line.suggestedRetailPrice || 0),
                acelerador: Number(line.acelerador || 0),
                hasVat: Boolean(line.hasVat)
            })) : [],
            lastResult: stored.lastResult || null
        };
    }

    function syncScenarioPanel() {
        const s = getActiveScenario();
        if (!s) return;

        scenarioName.value = s.name;
        normalizeScenarioDealType(s);
        syncDealTypeInput();
        requiresProration.value = String(s.requiresProration);
        startDate.value = s.startDate || "";

        startDate.disabled = !s.requiresProration;
        syncProrationInputs();
        hideProrationClientSuggestions();

        renderScenarioBar();
        renderLines();
        renderResultsFromScenario();
                updateProrationHint();
    }

    function addScenario() {
        const s = createScenario(`Escenario ${scenarios.length + 1}`);
        scenarios.push(s);
        activeScenarioId = s.id;
        syncScenarioPanel();
    }

    function duplicateScenario() {
        const current = getActiveScenario();
        if (!current) return;

        const copy = JSON.parse(JSON.stringify(current));
        copy.id = uid();
        copy.name = `${current.name} (copia)`;
        scenarios.push(copy);
        activeScenarioId = copy.id;
        syncScenarioPanel();
    }

     async function deleteScenario() {
        if (scenarios.length <= 1) { alert("Debes mantener al menos 1 escenario."); return; }

        const scenarioIdToDelete = activeScenarioId;
        if (!scenarioIdToDelete) return;

        try {
            await deleteScenarioFromDataverse(scenarioIdToDelete);
        } catch (error) {
            alert(error?.message || "No se pudo eliminar el escenario.");
            return;
        }

        scenarios = scenarios.filter(s => s.id !== scenarioIdToDelete);
        activeScenarioId = scenarios[0].id;
        syncScenarioPanel();
    }

    function addLine(businessTypeKey) {
        const s = getActiveScenario();
        if (!s) return;

        s.lines.push({
            businessType: businessTypeKey,
            productId: "",
            productDescription: "",
            costUnit: 0,
            marginPercent: 0,
            contractMonths: 12,
            quantity: 1,
            suggestedRetailPrice: 0,
            acelerador: 0,
            hasVat: false
        });

        markScenarioDirty();
        renderLines();
        setTimeout(() => {
            const last = linesBody.querySelector(`tr[data-idx="${s.lines.length - 1}"] .product-input`);
            if (last) last.focus();
        }, 0);
    }

    function removeLine(index) {
        const s = getActiveScenario();
        if (!s) return;
        s.lines.splice(index, 1);
                markScenarioDirty();
        renderLines();
    }

    async function productSearch(q) {
        const res = await fetch(`/Calculator/ProductSearch?q=${encodeURIComponent(q)}`, { headers: { "Accept": "application/json" } });
        if (!res.ok) return [];
        return await res.json();
    }

     async function clientSearch(q) {
        const res = await fetch(`/Calculator/ClientSearch?q=${encodeURIComponent(q)}`, { headers: { "Accept": "application/json" } });
        if (!res.ok) return [];
        return await res.json();
    }

    async function clientRenewalDateSearch(clientId) {
        let res;
        try {
            res = await fetch(`/Calculator/ClientRenewalDates?clientId=${encodeURIComponent(clientId)}`, { headers: { "Accept": "application/json" } });
        } catch {
            throw new Error("No se pudo conectar con el servidor al consultar las fechas de renovacion.");
        }

        if (!res.ok) {
            throw new Error(await readErrorResponseMessage(res, "No se pudieron consultar las fechas de renovacion."));
        }

        let items;
        try {
            items = await res.json();
        } catch {
            throw new Error("El servidor devolvio un formato invalido al consultar las fechas de renovacion.");
        }

        if (!Array.isArray(items)) {
            throw new Error("El servidor no devolvio una lista valida de fechas de renovacion.");
        }

        return items
            .map(item => {
                const dateValue = toDateInputValue(item.dateValue);
                return {
                    recordId: item.recordId || "",
                    dateValue,
                    displayDate: item.displayDate || formatDateOptionLabel(dateValue)
                };
            })
            .filter(item => item.dateValue);
    }


    function positionFullWidthSuggestions(suggBox, inputEl) {
        const rect = inputEl.getBoundingClientRect();
        const top = Math.round(rect.bottom + 6);
        const maxH = Math.max(180, window.innerHeight - top - 16);

        suggBox.style.top = `${top}px`;
        suggBox.style.maxHeight = `${maxH}px`;
    }

    function wireLineEvents() {
        const s = getActiveScenario();
        if (!s) return;

        linesBody.querySelectorAll("tr[data-idx]").forEach(row => {
            const idx = Number(row.getAttribute("data-idx"));
            const line = s.lines[idx];

            const productInput = row.querySelector(".product-input");
            const suggBox = row.querySelector(".suggestions");

            const costInput = row.querySelector(".cost-input");
            const marginInput = row.querySelector(".margin-input");
            const monthsInput = row.querySelector(".months-input");
            const qtyInput = row.querySelector(".qty-input");
            const vatInput = row.querySelector(".vat-input");

            const btnDel = row.querySelector(".btn-del-line");
            btnDel.addEventListener("click", () => removeLine(idx));

            function refreshLineFromInputs() {
                line.costUnit = clampDec(costInput.value, 0);
                line.marginPercent = clampDec(marginInput.value, 0);
                line.contractMonths = clampInt(monthsInput.value, 1, 120, 12);
                line.quantity = clampInt(qtyInput.value, 1, 999999, 1);
                line.hasVat = Boolean(vatInput?.checked);

                if (containsPrepaidOrYear(line.productDescription)) {
                    line.contractMonths = 12;
                }
                                markScenarioDirty();
                renderLines();
            }

            costInput.addEventListener("change", refreshLineFromInputs);
            marginInput.addEventListener("change", refreshLineFromInputs);
            monthsInput.addEventListener("change", refreshLineFromInputs);
            qtyInput.addEventListener("change", refreshLineFromInputs);
            vatInput?.addEventListener("change", refreshLineFromInputs);

            let timer = null;
            let lastItems = [];

            function hideSuggestions() {
                suggBox.style.display = "none";
                suggBox.innerHTML = "";
            }

            productInput.addEventListener("focus", () => {
                if (suggBox.style.display === "block") {
                    positionFullWidthSuggestions(suggBox, productInput);
                }
            });

            productInput.addEventListener("input", () => {
                const q = productInput.value.trim();
                line.productDescription = q;
                markScenarioDirty();

                clearTimeout(timer);
                if (q.length < 2) {
                    hideSuggestions();
                    return;
                }

                timer = setTimeout(async () => {
                    lastItems = await productSearch(q);
                    if (!lastItems.length) {
                        hideSuggestions();
                        return;
                    }

                    positionFullWidthSuggestions(suggBox, productInput);

                    suggBox.innerHTML = lastItems.map((x, j) => `
                        <div class="suggestion-item" data-j="${j}">
                            <div style="font-weight:800;">${escapeHtml(x.description)}</div>
                            <div class="small muted">Purchase: ${x.purchasePrice ?? "—"} | Suggested: ${x.suggestedRetailPrice ?? "—"}</div>
                        </div>
                    `).join("");

                    suggBox.style.display = "block";
                }, 220);
            });

            const onScrollResize = () => {
                if (suggBox.style.display === "block") {
                    positionFullWidthSuggestions(suggBox, productInput);
                }
            };
            window.addEventListener("scroll", onScrollResize, true);
            window.addEventListener("resize", onScrollResize);

            suggBox.addEventListener("click", (e) => {
                const itemDiv = e.target.closest(".suggestion-item");
                if (!itemDiv) return;

                const j = Number(itemDiv.getAttribute("data-j"));
                const item = lastItems[j];
                if (!item) return;

                line.productId = item.id || "";
                line.productDescription = item.description || "";
                line.suggestedRetailPrice = Number(item.suggestedRetailPrice || 0);
                line.acelerador = Number(item.acelerador || 0);

                if (Number(line.businessType) === 0) {
                    line.costUnit = Number(item.purchasePrice || 0);
                } else {
                    line.costUnit = line.costUnit || 0;
                }

                if (containsPrepaidOrYear(line.productDescription)) {
                    line.contractMonths = 12;
                }
                markScenarioDirty();
                hideSuggestions();
            
                renderLines();
            });

            document.addEventListener("click", (e) => {
                if (e.target === productInput || suggBox.contains(e.target)) return;
                hideSuggestions();
            });
        });
    }

    function updateProrationHint() {
        const s = getActiveScenario();
        if (!s) return;
        const renewalOptions = getProrationRenewalOptions(s);

        if (!s.requiresProration) {
            prorationHint.style.display = "none";
            prorationHint.innerText = "";
            return;
        }

        if (!s.startDate) {
            prorationHint.style.display = "block";
            prorationHint.innerText = "Selecciona fecha inicio y fecha final para calcular días de prorrateo.";
            return;
        }

        if (s.prorationRenewalError) {
            prorationHint.style.display = "block";
            prorationHint.innerText = s.prorationRenewalError;
            return;
        }

        if (!s.prorationClient?.id && renewalOptions.length === 0) {
            prorationHint.style.display = "block";
            prorationHint.innerText = "Busca un cliente para cargar las fechas finales disponibles.";
            return;
        }

        if (s.prorationClient?.id && renewalOptions.length === 0) {
            prorationHint.style.display = "block";
            prorationHint.innerText = "El cliente seleccionado no tiene fechas de renovación disponibles.";
            return;
        }

        if (!s.endDate) {
            prorationHint.style.display = "block";
            prorationHint.innerText = "Selecciona una fecha final del dropdown para calcular dias de prorrateo.";
            return;
        }

        const sd = new Date(s.startDate);
        const ed = new Date(s.endDate);
        if (isNaN(sd.getTime()) || isNaN(ed.getTime()) || ed < sd) {
            prorationHint.style.display = "block";
            prorationHint.innerText = "Fechas inválidas. La fecha final debe ser >= fecha inicio.";
            return;
        }

        const ms = ed.getTime() - sd.getTime();
        const days = Math.floor(ms / (1000 * 60 * 60 * 24)) + 1;
        const factor = days / 365.0;

        prorationHint.style.display = "block";
        prorationHint.innerText = `Prorrateo: ${days} días. Factor aproximado: ${factor.toFixed(4)} (sobre 365).`;
    }

    function validateScenarioLines() {
        const s = getActiveScenario();
        if (!s) {
            alert("Selecciona un escenario activo.");
            return null;
        }

        normalizeScenarioDealType(s);

        if (!s.lines.length) { alert("Agrega al menos 1 línea."); return null; }

        const normalizedLines = [];
        for (const [i, line] of s.lines.entries()) {
            const productDescription = (line.productDescription || "").trim();
            if (!productDescription || productDescription.length < 2) {
                alert(`La línea ${i + 1} no tiene producto.`);
                return null;
            }
            const qty = Number(line.quantity || 0);
            if (qty <= 0) { alert(`La línea ${i + 1} tiene cantidad inválida.`); return null; }
            const months = Number(line.contractMonths || 0);
            if (months <= 0) { alert(`La línea ${i + 1} tiene duración inválida.`); return null; }

            normalizedLines.push({
                businessType: Number(line.businessType),
                productId: line.productId || "",
                productDescription,
                costUnit: Number(line.costUnit || 0),
                marginPercent: Number(line.marginPercent || 0),
                contractMonths: Number(months || 12),
                quantity: Number(qty || 1),
                suggestedRetailPrice: Number(line.suggestedRetailPrice || 0),
                acelerador: Number(line.acelerador || 0),
                hasVat: Boolean(line.hasVat)
            });
        }
   const licenseValidation = validateLicenseCaps(s, normalizedLines);
        if (licenseValidation) {
            alert(licenseValidation);
            return null;
        }

        return { scenario: s, lines: normalizedLines };
    }

