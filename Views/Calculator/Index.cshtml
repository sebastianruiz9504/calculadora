    prorationClientSuggestions.addEventListener("click", async (e) => {
        const s = getActiveScenario();
        if (!s) return;

        const itemDiv = e.target.closest(".suggestion-item");
        if (!itemDiv) return;

        const idx = Number(itemDiv.getAttribute("data-proration-client-idx"));
        const item = prorationClientResults[idx];
        if (!item) return;

        s.prorationClient = { id: item.id, name: item.name };
        s.prorationRenewalOptions = [];
        s.prorationRenewalError = "";
        s.endDate = "";
        prorationClientInput.value = item.name;
        hideProrationClientSuggestions();
        setProrationEndDateLoading();
        updateProrationHint();
        markScenarioDirty();

        const scenarioId = s.id;
        const selectedClientId = item.id;
        const targetScenario = scenarios.find(x => x.id === scenarioId);
        try {
            const renewalOptions = await clientRenewalDateSearch(selectedClientId);
            if (!targetScenario || targetScenario.prorationClient?.id !== selectedClientId) {
                return;
            }

            targetScenario.prorationRenewalOptions = renewalOptions;
            targetScenario.prorationRenewalError = "";
            if (!renewalOptions.some(option => option.dateValue === targetScenario.endDate)) {
                targetScenario.endDate = "";
            }
        } catch (err) {
            if (!targetScenario || targetScenario.prorationClient?.id !== selectedClientId) {
                return;
            }

            console.error("Error consultando fechas de prorrateo", {
                clientId: selectedClientId,
                error: err
            });
            targetScenario.prorationRenewalOptions = [];
            targetScenario.endDate = "";
            targetScenario.prorationRenewalError = err?.message || "No se pudieron consultar las fechas de renovacion.";
        }

        if (targetScenario?.id === activeScenarioId) {
            renderProrationEndDateOptions();
            updateProrationHint();
        }
    });

